; In-game cheat overlay - split out of savestate.a65 for clarity.
;
; Pauses the running game (combo L+R+Y+Left), takes over the PPU to draw a navigable
; cheat list with live ON/OFF toggles, then restores the COMPLETE PPU/VRAM/CGRAM
; state and resumes. The combo *probe* still lives in savestate.a65's in-game input
; flow (it runs every NMI as part of the savestate handler) and reaches here with a
; long `jml ss_overlay` (this object lives in $C1, the savestate handler in $C0).

.link page $c1
#include "memmap.i65"
#include "savestate.i65"
; This object was moved $C0 -> $C1 to free space in the (previously full) $C0 page.
; memmap.i65 re-asserts '.link page $c0' on include, so re-declare $c1 here AFTER
; the includes (last '.link page' wins, and they emit no bytes) so every byte of
; this object -- INCLUDING the shared cheatlist.i65 routines -- lands in $C1.  The
; cheatlist.i65 routines are self-contained (jsr among themselves, @long for data),
; so they run same-bank in $C1; only THIS file's own calls to $C0 symbols
; (genfonts / ss_exit / ss_overlay_restore) cross the bank -- those use jml/jsl.
.link page $c1
#include "cheatlist.i65"    ; shared list layout defines + render/input routines

; --- Cheat overlay (Phase 2): pause the running game, take over the PPU to draw
;     a full-screen text UI, then restore the COMPLETE PPU state and resume.
;     Entered from the combo probe (L+R+Y+Left) in savestate.a65's in-game input flow.
;
;     WHY A SAVESTATE-GRADE SNAPSHOT (and not a hand-picked subset): an earlier
;     version snapshotted ~13 chosen registers and only a VRAM *slice*. Games that
;     program $2105/$2107/$210B/$210D-E once at level-load and only push scroll/OAM
;     each NMI never repaired what we left wrong, so the game kept running (audio)
;     while the picture stayed broken ("beige resume"). The firmware already does
;     this correctly for savestates, so we reuse the same machinery here.
;
;     The game is frozen inside this NMI, so the FPGA live mirrors are static.
;     Snapshot (into the savestate's own scratch buffers, free outside a save):
;       VRAM  real readback via $2139 (ch1 B->A DMA) -> $F20000  (64KB)
;       CGRAM real readback via $213B                -> $F40000  (512 bytes)
;       PPU shadow $F90500 -> SRAM_PPU_BANK   (128 bytes, raw stride-2, like save_state)
;       $420X      $F90700 -> SRAM_OTH_BANK   (16 bytes)
;       DMA/HDMA   $4300    -> SRAM_DMA_BANK   (all 8 channels, 11 bytes each; games
;                                              like DKC drive CGRAM via HDMA on ch2/ch3)
;     VRAM/CGRAM are READ BACK from the PPU ($2139/$213B), NOT copied from the FPGA
;     ctx mirror ($F70000/$F90000): on the SA-1 core the ctx snoop drops a small
;     fraction of writes (its CLK2 is ~synchronous to the bus, so the calibrated
;     capture window misses a fixed fraction), leaving the mirror stale and
;     corrupting the restore -- readback is byte-exact on every core. The register
;     shadows ($21XX/$420X) still come from the mirror (write-only, no readback).
;     WRAM, OAM and APU are never touched, so they need no save/restore.
;
;     Draw: force blank, DMA the menu font (bank ^font) to VRAM $0000, mode 0 /
;     BG1 only / tilemap @ word $1000 / char base $0000, clear the map to spaces,
;     write "CHEATS", set CGRAM 0=bg 1-3=white, unblank.
;
;     Restore (mirror of load_write_table + register_restore_return): force blank,
;     DMA $F20000->VRAM (full 64KB) + $F40000->CGRAM (512B), then restore the full
;     $21XX file (skip data ports) + $420X + $420C/$2100/$4200, resume via ss_exit.
;     Phase 3 extends the draw/input into the real cheat list. ---
ss_overlay:
	sep #$20 : .as : rep #$10 : .xl

	; Halt the SA-1 coprocessor for the whole overlay (mk3 SA-1 core only; a
	; harmless no-op on base/DSP, where $202C has no decode). The SA-1 runs
	; autonomously while the SNES CPU is frozen, so without this it would both
	; contend the FPGA copier during the snapshot below and drift while the list
	; is open. This is a transparent halt (CCNT is untouched), cleared on exit in
	; ss_overlay_restore, so the SA-1 resumes exactly where it paused.
	lda #$01 : sta @$00202c                ; snapshot_pause = 1 (SA-1 core: halt SA-1)

; ---- snapshot interrupt + PPU state (game values, before we change anything) ----
	; Save the ORIGINAL $4200 first, then DISABLE NMI/IRQ immediately - before the
	; long snapshot - so the game's own IRQ can't fire mid-snapshot and crash the
	; SNES. IRQ-driven title screens (Bomberman: HDMA split) froze right here.
	; This mirrors save_state's ordering ($4200 saved, then disabled, then the
	; rest). The $420X loop starts at x=1 because byte 0 ($4200) is already saved
	; and would now read back the disabled $01.
	lda @$F90700 : sta @SRAM_OTH_BANK      ; original $4200 -> SRAM_OTH_BANK[0]
	lda #$01 : sta @$004200                ; NMI/IRQ off (auto-joypad stays on)
	; --- rest of $420X shadow $F90700[1..F] -> SRAM_OTH_BANK[1..F] ---
	ldx #$0001
ss_ovl_othsave:
	lda @$F90700, x : sta @SRAM_OTH_BANK, x
	inx : cpx #$0010 : bne ss_ovl_othsave
	; --- PPU register shadow $F90500 -> SRAM_PPU_BANK (128 bytes, raw stride-2
	;     copy, exactly like save_state; restored via the proven loop on exit) ---
	ldy #$0000
	tyx
ss_ovl_ppusave:
	lda @$F90500, x : sta @SRAM_PPU_BANK, x : inx
	lda @$F90500, x : sta @SRAM_PPU_BANK, x : inx
	iny
	cpy #$0040
	bne ss_ovl_ppusave
	; (CGRAM is snapshotted below by real $213B readback, after force blank --
	;  the ctx CGRAM mirror is not used: on the SA-1 core the snoop can drop a
	;  small fraction of PPU-port writes, and readback is exact on every core.)
	; --- DMA/HDMA regs: ALL 8 channels -> SRAM_DMA_BANK (11 bytes each, $43x0-$43xA,
	;     skipping the 5-byte gap), exactly like save_state. Restoring only ch0/ch1
	;     (the old 23-byte copy) broke HDMA-driven-CGRAM games: DKC paints its
	;     backgrounds' palette per scanline via HDMA on ch1/2/3, and leaving ch2/ch3
	;     (and the tail of ch1, incl. the indirect bank $43x7) un-restored left the
	;     palette garbled on close. save_state restores all 8 and is clean on DKC. ---
	ldx #$0000
	ldy #$0000
ss_ovl_dmasave:
	lda @$004300, x : sta @SRAM_DMA_BANK, x
	inx : iny
	cpy #$000b : bne ss_ovl_dmasave
	cpx #$007b : beq ss_ovl_dmasave_done
	inx : inx : inx : inx : inx
	ldy #$0000
	bra ss_ovl_dmasave
ss_ovl_dmasave_done:
	; (interrupts were already disabled at the very start of the snapshot)
	; Force-blank and disable the game's HDMA + GP-DMA BEFORE the copier. HDMA runs
	; in hardware every scanline even with the CPU frozen, writing the same PPU/VRAM
	; mirror the FPGA copier reads -> they contend and the copier hangs the SNES
	; (Bomberman's HDMA-driven title froze exactly at the copier trigger).
	lda #$80 : sta @$002100                ; force blank
	lda #$00 : sta @$00420b                ; GP-DMA off
	sta @$00420c                           ; HDMA off

	; ---- the resident savestate image dies here ----
	; Our backups live at $F20000 (VRAM), $F40000 (CGRAM) and $F45000/$F45080
	; (registers) -- all inside $F00000..$F4FFFF, which is exactly where the MCU
	; stages the .state that an in-game load replays. Snapshotting therefore
	; OVERWRITES the resident image with the CURRENT frame, and a later Start+L
	; would restore WRAM from the staged slot but VRAM/CGRAM from the moment this
	; overlay opened -- which is precisely the "animated tiles are wrong until the
	; camera reloads them" corruption. Declare the image invalid so load_state
	; re-stages it from the SD instead of replaying the wreckage.
	lda #$00 : sta @SS_STAGED_SLOT         ; (A is already 8-bit here; flags untouched)

; ---- snapshot VRAM + CGRAM: REAL readback via $2139/$213B -> $F2/$F4 ----
	; We are in forced blank with the game's DMA regs already saved, so read the
	; actual PPU memories back instead of trusting the FPGA's ctx mirror (exact
	; on every core; the mirror is only needed for the write-only $21xx/$42xx
	; register shadows). B->A DMA on ch1: VRAM 64KB from the $2139/$213A word
	; port, then CGRAM 512B from $213B. VMAIN/VMADD/CGADD are clobbered here and
	; restored on exit from the register shadow like every other PPU reg.
	; CPU copy loops (not DMA): a B->A DMA writing into PSRAM is a path no core
	; ever exercised (the cart's write-enable gating assumes CPU-timed writes),
	; and in hardware it corrupted a fraction of the bytes per pass, degrading
	; VRAM a little more on every open/close cycle. CPU reads of the PPU ports +
	; long stores into the patch window are both proven primitives. ~230ms.
	sep #$20 : .as
	lda #$80 : sta @$002115               ; VMAIN: word step after $213A read
	rep #$30 : .al : .xl
	; $2139 read semantics (dev manual book1 2-27-21 / 2-27-6): the read buffer
	; only advances ON READS -- after setting VMADD the FIRST read returns stale
	; buffer contents and must be discarded ("read as dummy data after the
	; address has been set"); that same dummy read loads word[VMADD] into the
	; buffer, so the loop then streams word 0, 1, 2... Do NOT re-write VMADD
	; after the dummy: the address write does not reload the buffer, it only
	; desyncs it (word 0 duplicated, everything shifted -- seen in hardware as
	; VRAM sliding one word further on every open/close cycle).
	lda #$0000 : sta @$002116             ; VMADD = 0
	lda @$002139                          ; dummy read (loads word 0, VMADD -> 1)
	ldx #$0000
ss_ovl_vramrb:
	lda @$002139                          ; 16-bit read = $2139+$213A (word)
	sta @$F20000, x                       ; VRAM backup
	inx : inx
	bne ss_ovl_vramrb                     ; 32768 words = full 64KB
	; --- CGRAM: real readback via $213B -> $F40000 (512 bytes) ---
	sep #$20 : .as
	lda #$00 : sta @$002121               ; CGADD = 0
	ldx #$0000
ss_ovl_cgrb:
	lda @$00213B
	sta @$F40000, x
	inx
	cpx #$0200
	bne ss_ovl_cgrb

; ---- take over the display (force-blank + GP-DMA/HDMA already off above) ----
	lda #$00
	sta @$002106                          ; mosaic off
	sta @$00212e                          ; window off (main)
	sta @$00212f                          ; window off (sub)
	sta @$002130                          ; color math off
	sta @$002131                          ; color math off
	; --- generate the mode-5 dual font: BG1 4bpp @ VRAM $0000, BG2 2bpp @ $4000
	;     (glyph N -> tile 2N). genfonts is the menu's own generator (bank $C0,
	;     resident in-game). It uses short addressing, so DBR=0 while it runs (the
	;     game's DBR is saved/restored around it). genfonts drives DMA channel 7,
	;     and it runs in the MIDDLE of the takeover: after the global $43xx snapshot
	;     above, but a whole overlay session before the exit restore. The exit
	;     restore itself DOES cover ch7 (ss_ovl_dmarst puts back all 8 channels,
	;     11 bytes each, from SRAM_DMA_BANK), so the game never resumes with
	;     genfonts' clobbered table pointer; this local pair is what keeps the
	;     game's ch7 register file intact for the WHOLE time the overlay is open,
	;     and it also covers $437B, the byte the 11-byte global copy skips. ---
	ldx #$0000
ss_ovl_ch7save:
	lda @$004370, x : sta @$F48130, x     ; ch7 regs $4370..$437B -> scratch $F48130
	inx : cpx #$000c : bne ss_ovl_ch7save
	lda #$80 : sta @$002115               ; VRAM incr after high byte
	phb
	pea $0000 : plb : plb                 ; DBR = 0 for genfonts' short addressing
	jsl @ovl_call_genfonts                ; genfonts lives in $C0 (main.a65) and ends in rts;
	                                       ; this object is $C1, so call the $C0 trampoline
	                                       ; (jsr genfonts : rtl) in savestate.a65 cross-bank.
	plb                                    ; restore the game's DBR
	lda #$80 : sta @$002115               ; re-assert increment mode after genfonts
	ldx #$0000
ss_ovl_ch7rst:
	lda @$F48130, x : sta @$004370, x     ; restore the game's ch7 regs
	inx : cpx #$000c : bne ss_ovl_ch7rst

	; --- HIDE the game's sprites for the duration of the overlay. THE FIX for the mode-5
	;     hi-res garble: the game's sprites (in OAM) steal PPU sprite-fetch bandwidth, which
	;     in mode 5 hi-res starves the BG1 (4bpp) tile fetch and truncates it on some rows
	;     (proven: clearing OAM makes every row render clean). The menu never hits this
	;     because setup_gfx clears OAM (oamhide). No save/restore: the game re-populates OAM
	;     from its own NMI on resume (confirmed the game never breaks on exit).
	;     HIDE: main table (512 B) = $F0 -> Y=240 (off the 224-line screen). HIGH table (32 B)
	;     = $00, NOT $F0: $F0 sets the per-sprite SIZE bit -> a LARGE sprite at Y=240 wraps
	;     past 256 back onto the top of the screen (still visible!) -> garble returns. $00 =
	;     all sprites small, X-high 0 -> Y=240 truly hides them. (forced blank here.) ---
	lda #$00 : sta @$002102 : sta @$002103    ; OAM addr = 0
	rep #$10 : .xl
	ldx #$0200                                ; main table: 512 bytes
	sep #$20 : .as
ss_ovl_oamclr:
	lda #$f0 : sta @$002104                   ; Y=240 -> all sprites off-screen (hidden)
	dex : bne ss_ovl_oamclr
	rep #$10 : .xl
	ldx #$0020                                ; high table: 32 bytes
	sep #$20 : .as
ss_ovl_oamclrhi:
	lda #$00 : sta @$002104                   ; size=small + X-high=0 -> no wrap onto screen
	dex : bne ss_ovl_oamclrhi

	; clear BOTH tilemaps (BG2 $5000, BG1 $5800; 32x32 = 1024 words each) to the
	; space entry ($20<<1 | $2000 = $2040) so rows we never draw show blank.
	rep #$30 : .al : .xl
	lda #OVL_BG2_MAP : sta @$002116
	lda #$2040
	ldx #$0400
ss_ovl_clr2:
	sta @$002118
	dex
	bne ss_ovl_clr2
	lda #OVL_BG1_MAP : sta @$002116
	lda #$2040
	ldx #$0400
ss_ovl_clr1:
	sta @$002118
	dex
	bne ss_ovl_clr1
	sep #$20 : .as

	; --- the list palette base MUST be set before the FIRST flush: ss_ovl_draw_title below (and
	;     every subsequent draw) uses the shared ovl_flush_abs -> `ora @ovl_pal`. $F4 PSRAM is stale
	;     (clear_wram does not zero it), so a stale value would tint the title/list. The $C0 fail-safe
	;     list is ALWAYS focused = palette 0. ---
	rep #$20 : .al
	lda #$2000 : sta @ovl_pal
	sep #$20 : .as
	; --- the localized "(no name)" the shared list draws for a cheat with an empty
	;     name MUST be staged before the first list paint (cheatlist.i65 only reads
	;     OVL_NONAME_BUF, and $F4 PSRAM comes up stale). ---
	jsl @ovl_fill_noname
	; --- title "CHEATS" (row 1) ---
	jsr ss_ovl_draw_title

	; --- init overlay state ---
	rep #$30 : .al : .xl
	lda @NUM_CHEATS                       ; count = min(NUM_CHEATS, CHEAT_LIST_MAX). The name
	cmp #CHEAT_LIST_MAX                    ;   window (CHEAT_OVL_MAX=64) slides to cover all of it.
	bcc ss_ovl_cnt_ok
	lda #CHEAT_LIST_MAX
ss_ovl_cnt_ok:
	sta @ovl_count
	cmp #OVL_ROWS                          ; visible = min(count, OVL_ROWS)
	bcc ss_ovl_vis_ok
	lda #OVL_ROWS
ss_ovl_vis_ok:
	sta @ovl_visible
	; --- keep the list POSITION across overlay sessions when the shell's persist magic is
	;     live (same session gate as the manual reading position; the MCU clears the magic on
	;     every game load, and PSRAM comes up stale after power). Clamped against the CURRENT
	;     count/visible before use. START-closing the shell relies on this to come back
	;     exactly where the user was. ---
	lda @IGM_POS_MAGIC_ADDR
	cmp #IGM_POS_MAGIC
	beq ss_ovl_pos_keep
	lda #$0000
	sta @ovl_top
	sta @ovl_selrow
	bra ss_ovl_pos_done
ss_ovl_pos_keep:
	lda @ovl_count
	sec : sbc @ovl_visible                 ; maxscroll (count >= visible by construction)
	cmp @ovl_top
	bcs ss_ovl_top_ok
	sta @ovl_top                           ; clamp top into range
ss_ovl_top_ok:
	lda @ovl_visible
	beq ss_ovl_pos_zero                    ; empty list -> both 0
	dec
	cmp @ovl_selrow
	bcs ss_ovl_pos_done
	sta @ovl_selrow                        ; clamp selrow to visible-1
	bra ss_ovl_pos_done
ss_ovl_pos_zero:
	lda #$0000
	sta @ovl_top
	sta @ovl_selrow
ss_ovl_pos_done:
	lda #$0000
	sta @ovl_flush_dst                     ; draw straight to VRAM (initial draw). MUST
	                                       ; precede ss_ovl_draw_rows: these live in PSRAM
	                                       ; ($F4), which clear_wram does NOT zero, so a
	                                       ; stale nonzero here would send the first draw
	                                       ; into OVL_TMBUF (blank list) instead of VRAM.
	sta @ovl_scroll_dirty                  ; no scroll rebuild pending
	sta @ovl_dma_pending                   ; no DMA pending
	sta @ovl_mq_xscroll                    ; marquee at the left too (same PSRAM stale risk)
	lda @$004218                           ; seed pprev with the current pad so the
	sta @ovl_pprev                         ; opening combo isn't read as fresh edges
	sep #$20 : .as
	lda #$00 : sta @ovl_dirty
	; Cursor ownership, cleared UNCONDITIONALLY and BEFORE the first list paint
	; (ss_ovl_draw_rows below) -- ss_ovl_draw_full_row (cheatlist.i65) reads it.
	; The fail-safe list needs to see 0 (it draws its own '>'), and PSRAM $F4 is
	; not auto-cleared, so cold-boot garbage or a 1 left by a previous shell
	; session would hide the cursor on the very first paint.
	sta @OVL_CUR_OFF                       ; A is still #$00 (snescom has no long stz)

	; --- ensure the name window is resident BEFORE the first draw. ss_ovl_mq_reset calls
	;     ovl_ensure_window, which slides the 64-name window; the window-relative name reads in
	;     ss_ovl_draw_rows depend on CHEAT_WIN_BASE being current (on a fail-safe reopen after
	;     scrolling past 64 it can be nonzero). Mirrors cheats_enter's order in the igmenu shell. ---
	jsr ss_ovl_mq_reset                    ; slide the window + measure the first name for the marquee
	; --- draw list (or "no cheats" message) ---
	rep #$20 : .al
	lda @ovl_count
	sep #$20 : .as
	beq ss_ovl_init_empty
	jsr ss_ovl_draw_rows
	bra ss_ovl_init_drawn
ss_ovl_init_empty:
	jsr ss_ovl_draw_empty
ss_ovl_init_drawn:
	jsr ss_ovl_draw_footer
	rep #$20 : .al
	lda #$0000 : sta @ovl_rep_cnt          ; no auto-repeat pending yet
	sep #$20 : .as

	; CGRAM sub-palette 0 = the menu font's own text colors (so glyph anti-aliasing
	; renders cleanly, not flattened), but color 0 swapped for our blue backdrop:
	;   0 = blue $5000 (bg)   1 = white $7FFF   2 = dark gray $18C6   3 = light gray $6318
	lda #$00 : sta @$002121
	lda #$00 : sta @$002122 : lda #$50 : sta @$002122   ; color 0 (blue bg)
	lda #$ff : sta @$002122 : lda #$7f : sta @$002122   ; color 1 (white)
	lda #$c6 : sta @$002122 : lda #$18 : sta @$002122   ; color 2 (dark gray)
	lda #$18 : sta @$002122 : lda #$63 : sta @$002122   ; color 3 (light gray)
	; palette 1 = the GREYED (unfocused / tab-bar level) list, selected via ovl_pal=$2400. BG2 2bpp
	; pal 1 = CGRAM 4-7, BG1 4bpp pal 1 = CGRAM 16-19; both a dimmed copy of 0-3 (bg + grey text).
	; Colours are HW-tunable. CGADD auto-advanced to 4 after color 3 above.
	lda #$00 : sta @$002122 : lda #$50 : sta @$002122   ; CGRAM 4  = blue bg (same)
	lda #$ef : sta @$002122 : lda #$3d : sta @$002122   ; CGRAM 5  = grey (was white)
	lda #$c6 : sta @$002122 : lda #$18 : sta @$002122   ; CGRAM 6  = dark grey
	lda #$4a : sta @$002122 : lda #$29 : sta @$002122   ; CGRAM 7  = dim grey
	lda #$10 : sta @$002121                              ; CGADD = 16 (BG1 4bpp palette 1)
	lda #$00 : sta @$002122 : lda #$50 : sta @$002122   ; CGRAM 16 = blue bg (same)
	lda #$ef : sta @$002122 : lda #$3d : sta @$002122   ; CGRAM 17 = grey
	lda #$c6 : sta @$002122 : lda #$18 : sta @$002122   ; CGRAM 18 = dark grey
	lda #$4a : sta @$002122 : lda #$29 : sta @$002122   ; CGRAM 19 = dim grey
	; palette 3 = the WINDOW-FRAME colour the scrollbar cell wears (ovl_sb_recolor stamps that
	; one cell as $2C00 so it matches the menu's own scrollbars, which hiprint in palette 3).
	; The $C2 shell themes this slot (igt_pal_apply); this fail-safe path hardcodes it like the
	; two palettes above, with the menu's baked pal3 bevel. BG2 2bpp pal3 = CGRAM 12-15, and the
	; bar sits on an EVEN column (BG2 only), so entry 12 (colour 0) stays transparent = backdrop.
	lda #$0d : sta @$002121                              ; CGADD = 13 (BG2 palette 3, colour 1)
	lda #$b1 : sta @$002122 : lda #$7f : sta @$002122   ; CGRAM 13 = light cyan (track glyph)
	lda #$a1 : sta @$002122 : lda #$24 : sta @$002122   ; CGRAM 14 = dark blue (edge/outline)
	lda #$ec : sta @$002122 : lda #$62 : sta @$002122   ; CGRAM 15 = teal (thumb glyph)

	; --- BG setup: MODE 5 hi-res. BG1 tilemap $5800 + BG2 tilemap $5000 (32x64),
	;     char base BG1=$0000 / BG2=$4000, BG1 H-scrolled $00fc against BG2=0 to
	;     interleave the 64 logical columns (the menu's hi-res text alignment).
	;     Window 2 clips the mode-5 subscreen edge garbage (px 0, 253..255), like
	;     the game-info screen. All these PPU regs are restored on exit. ---
	; --- MODE 5 is established via HDMA (base mode 3 -> mode 5 at line 1), NOT set
	;     statically: pure static mode 5 renders correctly on EVEN tile rows but
	;     garbles the BG1/BG2 hi-res interleave on ODD tile rows (verified: tilemap
	;     content + regs are correct; only the display garbles). The menu/game-info
	;     both establish mode 5 through this mode-3->mode-5 HDMA transition, which
	;     arms the interleave phase. ch1 (its regs are covered by the overlay's
	;     ch0/ch1 snapshot+restore); table in PSRAM scratch (can't use game WRAM). ---
	lda #$03 : sta @$002105               ; base mode 3 (HDMA flips to mode 5 below)
	; the HDMA table MUST live in WRAM (the sd2snes can't HDMA-fetch from ROM/PSRAM --
	; same reason the menu copies hdma_mode_src into WRAM). Borrow 5 game-WRAM bytes
	; ($7E0000..4), save them to $F48140, and put them back on exit (ss_overlay_restore).
	ldx #$0000
ss_ovl_hdmasave:
	lda @$7E0000, x : sta @$F48140, x
	inx : cpx #$0005 : bne ss_ovl_hdmasave
	lda #$01 : sta @$7E0000                ; BGMODE HDMA table: line 0 = mode 3,
	lda #$03 : sta @$7E0001
	lda #$01 : sta @$7E0002                ; line 1 = mode 5,
	lda #$05 : sta @$7E0003
	lda #$00 : sta @$7E0004                ; terminate -> mode 5 holds for lines 2..223
	lda #$00 : sta @$004310               ; ch1 DMAP: direct, 1 reg 1 byte, A->B
	lda #$05 : sta @$004311               ; B-bus = $2105 (BGMODE)
	lda #$00 : sta @$004312               ; A1T low  ($7E0000)
	lda #$00 : sta @$004313               ; A1T high
	lda #$7e : sta @$004314               ; A1T bank
	lda #($58|$02) : sta @$002107         ; BG1 tilemap word $5800, SC 32x64
	lda #($50|$02) : sta @$002108         ; BG2 tilemap word $5000, SC 32x64
	lda #$40 : sta @$00210b               ; char base: BG1 $0000, BG2 $4000 (word)
	lda #$08 : sta @$002133               ; pseudo-512 (menu's mode-5 text setup)
	lda #$fc : sta @$00210d : lda #$00 : sta @$00210d   ; BG1 H scroll = $00fc (write-twice)
	sta @$00210e : sta @$00210e           ; BG1 V scroll = 0
	sta @$00210f : sta @$00210f           ; BG2 H scroll = 0
	sta @$002110 : sta @$002110           ; BG2 V scroll = 0
	lda #$cc : sta @$002123               ; BG1+BG2 window-2 enable + invert (mask = OUTSIDE)
	lda #$00 : sta @$002125               ; OBJ/colour window off
	sta @$00212a                          ; BG window logic = OR
	lda #$01 : sta @$002128               ; window 2 left  = 1
	lda #252 : sta @$002129               ; window 2 right = 252
	lda #$03 : sta @$00212e               ; main: clip BG1+BG2 in their window area
	sta @$00212f                          ; sub:  same (kills the hi-res subscreen edge garbage)
	lda #$03 : sta @$00212c               ; main screen: BG1 + BG2
	sta @$00212d                          ; sub screen:  BG1 + BG2 (mode-5 H-512 needs sub=main)
	lda #$02 : sta @$00420c               ; enable ch1 HDMA (BGMODE switch) -- AFTER all the
	                                      ; GP-DMAs (font gen), per the game-info HDMA ordering

	; --- Phase-0 in-game TAB menu dispatch (igmenu.bin @ PSRAM $C2, staged+verified
	;     by the MCU this game-load). Two guards: the MCU-armed IGMENU_GATE, and a
	;     re-check of the bin's ABI version word here (catches a partial SD update
	;     where m3nu and igmenu.bin came from different releases). On both passing,
	;     run the tab shell -- it draws the tab bar over this already-built (still
	;     forced-blank) cheat screen, does its OWN unblank + input loop, and returns
	;     via rtl when the user closes it; we then take the normal apply+restore exit.
	;     ANY failure falls through to ovl_failsafe = the proven single-tab overlay.
	;     A is 8-bit here (.as); X is 16-bit and free (ovl_stage_theme uses it as a
	;     copy index). jsl/rtl is stack-balanced; the shell NEVER drops
	;     snescmd_unlock (that would unmap $C2). ---
	lda @IGMENU_GATE                      ; MCU staged+verified the bin?
	beq ovl_failsafe
	lda @$c20004                          ; bin ABI version byte ($C20004)
	cmp #IGMENU_ABI_VERSION
	bne ovl_failsafe
	jsr ovl_stage_theme                   ; publish the active theme for the $C2 shell
	jsl $c20008                           ; $C20008 = jml igmenu_main; rtl on close
	jmp ss_ovl_do_exit                    ; apply toggles (ovl_dirty) + savestate-grade restore
ovl_failsafe:
	lda #$0f : sta @$002100               ; unblank to full brightness

; ---- input loop: edge-detected pad. ovl_pprev was seeded with the opening
;      combo, so the still-held L+R+Y+Left produces no fresh edge (no instant
;      exit/toggle, no drain needed).
;        Up/Down = move cursor   A = toggle ON/OFF   B = close + apply ----
ss_overlay_loop:
	- lda @$004212 : bpl -                 ; wait until vblank (catches the rising edge)
	; Robust auto-joypad sync: wait for the read to START (bit0=1) THEN FINISH
	; (bit0=0). Just waiting for "finish" can catch the brief pre-read window
	; (bit0 not yet set) and read a STALE pad -> the press edge double-fires on two
	; non-adjacent frames (the "2x" auto-repeat). Both waits are safe here because
	; we entered exactly at the vblank rising edge, so bit0 always rises.
	- lda @$004212 : and #$01 : beq -      ; wait auto-joypad read START (bit0 set)
	- lda @$004212 : and #$01 : bne -      ; wait auto-joypad read DONE (bit0 clear)
	rep #$20 : .al
	lda @$004218                           ; current pad word ($4218 lo / $4219 hi) - now fresh
	sta @ovl_cur
	eor @ovl_pprev
	and @ovl_cur                           ; (cur ^ prev) & cur = newly pressed bits
	sta @ovl_edge
	lda @ovl_cur
	sta @ovl_pprev
	sep #$20 : .as
	; --- flush the list rebuilt LAST frame (if any) to VRAM via DMA, here in vblank ---
	lda @ovl_dma_pending
	beq ss_ovl_no_dma
	jsr ovl_dma_list
	lda #$00 : sta @ovl_dma_pending
ss_ovl_no_dma:
	; B ($8000) -> close + apply
	rep #$20 : .al
	lda @ovl_edge
	bit #$8000
	sep #$20 : .as
	beq ss_ovl_disp_a
	jmp ss_ovl_do_exit
ss_ovl_disp_a:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0080                             ; A (edge) -> toggle
	sep #$20 : .as
	beq ss_ovl_disp_lt                     ; (L/R = tab switch in the shell; no-op in the
	jsr ss_ovl_toggle                      ;  single-tab fail-safe -- ss_ovl_home/end removed)
ss_ovl_disp_lt:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0200                             ; Left (edge) -> page up
	sep #$20 : .as
	beq ss_ovl_disp_rt
	jsr ss_ovl_page_up
ss_ovl_disp_rt:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0100                             ; Right (edge) -> page down
	sep #$20 : .as
	beq ss_ovl_disp_nav
	jsr ss_ovl_page_down
ss_ovl_disp_nav:
	jsr ss_ovl_nav_vert                    ; Up/Down with auto-repeat
	jsr ss_ovl_marquee                     ; advance the selected-name marquee (paced)
	; --- if anything marked the list dirty (scroll, page, cursor move, marquee step),
	;     rebuild ALL rows into OVL_TMBUF now (active display, no vblank limit); the DMA
	;     at the top of the loop flushes it next vblank ---
	lda @ovl_scroll_dirty
	beq ss_ovl_no_rebuild
	jsr ovl_build_list_to_buf
	lda #$01 : sta @ovl_dma_pending
	lda #$00 : sta @ovl_scroll_dirty
ss_ovl_no_rebuild:
ss_ovl_loop_tail:
	- lda @$004212 : bmi -                 ; wait out of vblank (one sample/frame)
	jmp ss_overlay_loop

; ---- restore: full VRAM + full CGRAM + full PPU/$420X register file ----
;      Savestate-grade: mirrors load_write_table (data) + register_restore_return
;      (regs). Restores EVERYTHING we could have touched, so games that program
;      their PPU once at level-load come back intact (no partial-restore beige).
ss_overlay_restore:
	lda #$80 : sta @$002100               ; force blank during restore
	lda #$00 : sta @$00420b               ; GP-DMA off
	sta @$00420c                          ; HDMA off (re-enabled at the end; our BGMODE
	                                      ; ch1 HDMA stops here before ch1 is reused below)
	; --- put back the game WRAM bytes we borrowed for the BGMODE HDMA table ---
	ldx #$0000
ss_ovl_hdmarst:
	lda @$F48140, x : sta @$7E0000, x
	inx : cpx #$0005 : bne ss_ovl_hdmarst
	; (OAM is NOT restored -- the game re-populates it from its own NMI on resume.)
	; --- full VRAM: $F20000 -> VRAM $0000 (64KB) via GP-DMA ch1 ---
	lda #$80 : sta @$002115
	rep #$20 : .al
	lda #$0000 : sta @$002116
	sep #$20 : .as
	lda #$01 : sta @$004310                ; mode 1 (2 regs $2118/$2119), A->B
	lda #$18 : sta @$004311                ; B = $2118
	rep #$20 : .al
	lda #$0000 : sta @$004312              ; A addr
	sep #$20 : .as
	lda #$f2 : sta @$004314                ; A bank $F2
	rep #$20 : .al
	lda #$0000 : sta @$004315              ; size $0000 = full 64KB
	sep #$20 : .as
	lda #$02 : sta @$00420b                ; trigger ch1
	; --- full CGRAM: $F40000 -> CGRAM (512 bytes) via GP-DMA ch1 ---
	lda #$00 : sta @$002121                ; CGRAM addr 0
	lda #$00 : sta @$004310                ; mode 0 (1 reg), A->B
	lda #$22 : sta @$004311                ; B = $2122
	rep #$20 : .al
	lda #$0000 : sta @$004312
	sep #$20 : .as
	lda #$f4 : sta @$004314                ; A bank $F4
	rep #$20 : .al
	lda #$0200 : sta @$004315              ; size 512
	sep #$20 : .as
	lda #$02 : sta @$00420b                ; trigger ch1
	; --- restore ALL 8 DMA/HDMA channels from snapshot (11 bytes each, skip the gap;
	;     was ch0/ch1 only). So when $420C re-enables HDMA below, the game's full
	;     per-scanline state (ch2/ch3 + the tail of ch1, incl. indirect bank $43x7)
	;     is back -- the fix for HDMA-driven-CGRAM games like DKC. Mirrors save_state. ---
	ldx #$0000
	ldy #$0000
ss_ovl_dmarst:
	lda @SRAM_DMA_BANK, x : sta @$004300, x
	inx : iny
	cpy #$000b : bne ss_ovl_dmarst
	cpx #$007b : beq ss_ovl_dmarst_done
	inx : inx : inx : inx : inx
	ldy #$0000
	bra ss_ovl_dmarst
ss_ovl_dmarst_done:
	; --- restore the full $21XX register file (mirror of register_restore_return);
	;     DBR=0 so the absolute `sta $2100,y`/`sta $4200,x` land on the regs ---
	phb
	pea $0000 : plb : plb
	sep #$20 : .as : rep #$10 : .xl        ; A 8-bit, X/Y 16-bit (match register_restore_return)
	ldx #$0002
	ldy #$0001
ss_ovl_rr:
	cpy #$0002 : beq ss_ovl_rr_s           ; skip $2102/3/4 (OAM addr/data)
	cpy #$0003 : beq ss_ovl_rr_s
	cpy #$0004 : beq ss_ovl_rr_s
	cpy #$0018 : beq ss_ovl_rr_s           ; skip $2118/9 (VRAM data port)
	cpy #$0019 : beq ss_ovl_rr_s
	cpy #$0022 : beq ss_ovl_rr_s           ; skip $2122 (CGRAM data port)
	lda @SRAM_PPU_BANK, x : sta $2100, y : inx
	lda @SRAM_PPU_BANK, x : sta $2100, y : dex
ss_ovl_rr_s:
	inx : inx
	iny
	cpy #$0034
	bne ss_ovl_rr
	; --- restore $420X (skip $4201, $420B GP-DMA trig, $420C HDMA en) ---
	ldx #$0001
ss_ovl_oth:
	cpx #$0001 : beq ss_ovl_oth_s
	cpx #$000B : beq ss_ovl_oth_s
	cpx #$000C : beq ss_ovl_oth_s
	lda @SRAM_OTH_BANK, x : sta $4200, x
ss_ovl_oth_s:
	inx
	cpx #$000E
	bne ss_ovl_oth
	plb
	; Wait for the START of vblank before going live. The ~1.5-frame restore (the 64KB
	; VRAM GP-DMA alone spans >1 frame) leaves us at an arbitrary scanline; resuming
	; mid-frame makes the game's NMI palette upload (run by the hook stub right after
	; ss_exit) execute OFF-vblank, and its CGRAM writes corrupt against active-display
	; PPU reads (DKC: garbled ground palette). Sync to vblank so it runs in vblank.
	sep #$20 : .as
ss_ovl_vsync1:
	lda @$004212 : bmi ss_ovl_vsync1          ; wait until active display (bit7=0)
ss_ovl_vsync2:
	lda @$004212 : bpl ss_ovl_vsync2          ; wait until vblank starts (bit7=1)
	; --- HDMA enable, brightness, interrupt enable; then resume ---
	lda @SRAM_OTH_BANK|$000C : sta @$00420c   ; game's $420C
	lda @SRAM_PPU_BANK : sta @$002100         ; game's brightness (unblank)
	; --- per-game APU resync, before the game's interrupts come back ---
	; The overlay never touches the APU, but it does stop the S-CPU for seconds while the
	; SPC700 keeps running, and a game whose interrupt handler waits on a WRAM shadow of
	; the $214x handshake with an UNBOUNDED spin deadlocks there on resume if the two
	; drifted. Star Ocean is exactly that shape: its V-IRQ handler ($C0:0221) reaches
	; three copies of  lda $2140 : cmp $2140 : bne * : eor $4A : bpl *  with no timeout,
	; and $4A is the byte its savestate_fixes.yml entry (13B8) rewrites. That blob has
	; run on savestate save/load since forever (audio_fix in savestate.a65); running it
	; here as well makes the spin pass once, which is all it needs -- the game
	; re-establishes the phase itself with the next command it sends.
	; Gated per game by the firmware (SS_OVL_APUFIX_GATE, src/savestate.c) because a blob
	; is free-form code: some entries write immediates, one writes $2140 itself.
	; MUST run BEFORE the game's $4200 is re-armed below: I in P does NOT mask NMI --
	; only the still-disarmed $4200 keeps the blob (whose 13B8 spin is unbounded) from
	; being preempted. $420C/$2100 are already back, which is all the blob could care
	; about. NOTE the DBR/DP context differs from the other call site (audio_fix runs
	; with the handler's DBR/DP; here the game's DBR is already restored) -- fine for
	; blobs that are 100% long-addressing like 13B8, but a future blob using DP would
	; only break here. Contract: A 8-bit / X 16-bit / long addressing / ends in rtl.
	; Both widths hold here and the rep #$30 below re-establishes them regardless.
	lda @SS_OVL_APUFIX_GATE
	beq ss_ovl_no_apufix
	jsl @CS_FIXES
	.as : .xl
ss_ovl_no_apufix:
	; ACK the pending NMI (the vsync wait above left us at vblank start, so $4210.7 is
	; set) before re-enabling $4200: otherwise enabling NMI here would fire an interrupt
	; IMMEDIATELY and preempt the resume tail (combo clear + ss_exit) mid-code. With the
	; flag cleared, the hook stub runs the game's NMI cleanly in this vblank after
	; ss_exit. (The vblank sync is the actual fix for the off-vblank palette corruption.)
	lda @$004210                              ; ack pending NMI (clears $4210.7)
	lda @SRAM_OTH_BANK : sta @$004200         ; game's $4200
	; Resume the SA-1 coprocessor now that VRAM/CGRAM/PPU/regs are fully restored
	; (no-op on base/DSP). It picks up exactly where snapshot_pause halted it.
	lda #$00 : sta @$00202c                    ; snapshot_pause = 0 (SA-1 core: resume SA-1)
	rep #$30 : .al : .xl
	; Clear the combo probe's edge state. CS_INPUT_CUR froze at the opening combo
	; ($4230); if the next open lands all 4 buttons on one frame, PREV would inherit
	; that stale value and the edge check would see "already held" -> combo randomly
	; ignored (worked only when fingers staggered across frames).
	lda #$0000
	sta @CS_INPUT_CUR
	sta @CS_INPUT_PREV
	jmp @ss_exit                           ; ss_exit is in $C0 (savestate.a65); @ forces long jump cross-bank

; ======================================================================
;  In-game cheat overlay helpers (Phase 3, mode 5). Rows are built as 64
;  glyph codes in the OVL_RB line buffer then de-interleaved to the BG2
;  (even cols) / BG1 (odd cols) tilemaps by ovl_flush_abs. The top-level
;  draw entry points set DBR=$F4 so OVL_RB is absolute-addressable (the
;  name copy needs an abs,Y store -- there is no long,Y); ovl_row_clear /
;  ovl_flush_abs / ss_ovl_draw_full_row ASSUME DBR=$F4 (caller-set), the
;  main flow keeps the game's DBR. CHEAT_* and VRAM stay long-addressed.
;  VRAM increment stays $80 (word, after-high) from the draw setup. PBR =
;  $C1 (this object's bank) so the internal jsr/rts reach here; cross-bank refs
;  to the $C0 handler (ss_exit) and to genfonts use jml/jsl. Only run while we
;  own the screen.
; ======================================================================

; ---- close: apply the cheat changes (if any) and resume the game ----
ss_ovl_do_exit:
	sep #$20 : .as
	lda @ovl_dirty
	beq ss_ovl_exit_noapply
	; Ask the MCU (snes_main_loop) to reconcile the BSRAM flag mirror into
	; the canonical records and re-deploy cheats live. Fire-and-forget: the
	; MCU clears MCU_CMD when done; the game resumes meanwhile.
	lda #CMD_CHEAT_REPROGRAM
	sta @MCU_CMD
ss_ovl_exit_noapply:
	jsr ss_ovl_pad_drain                   ; don't hand the closing press to the game
	jmp ss_overlay_restore

; ---- ss_ovl_pad_drain: hold the close until every button is released.  The shell reads the
;      SAME $4218 the game does, and the game is live again ~1.5 frames from here, so a B or
;      START still held at close reaches it as a FRESH press -- a pause menu popping open, a
;      line of dialogue advancing, a jump.  Draining the pad is also the only fix that covers
;      games polling $4016 by hand instead of the auto-joypad: it removes the PRESS, not one
;      way of reading it.
;      WHERE this sits is load-bearing: auto-joypad is OURS here ($4200 = $01 since the open),
;      while the GAME's $4200 -- which may have auto-joypad DISABLED -- only goes back at the
;      tail of ss_overlay_restore, so $4218 is guaranteed live BEFORE the restore and not
;      after.  It also leaves the restore's closing vblank sync (the fix for the off-vblank
;      CGRAM corruption) immediately adjacent to the resume, with no frames wedged in between.
;      Bounded at 180 frames (~3 s): a physically stuck button must never strand the game --
;      hitting the ceiling just degrades to the old leak.  Reads with the same START-then-DONE
;      idiom as the input loop; a stale $4218 could read idle with a button still down.
;      Entry .as, X width not assumed.  Restores P. ----
ss_ovl_pad_drain:
	php
	rep #$30 : .al : .xl
	ldx #$00b4                             ; 180-frame ceiling (~3 s)
ss_ovl_pd_frame:
	sep #$20 : .as
	- lda @$004212 : bpl -                 ; wait for the vblank rising edge
	- lda @$004212 : and #$01 : beq -      ; auto-joypad read STARTED (bit0 set)
	- lda @$004212 : and #$01 : bne -      ; ...and FINISHED -> $4218 is fresh
	rep #$20 : .al
	lda @$004218
	beq ss_ovl_pd_done                     ; pad idle -> nothing left to leak
	sep #$20 : .as
	- lda @$004212 : bmi -                 ; wait out of vblank: one sample per frame
	rep #$30 : .al : .xl
	dex
	bne ss_ovl_pd_frame
ss_ovl_pd_done:
	plp
	rts

; ---- ovl_stage_theme: publish the ACTIVE menu theme into the PSRAM $F4 hand-off
;      block (IGM_THM_*) the $C2 shell reads. igmenu.bin is a separate link and
;      sees none of these symbols; this object ($C1) does, and in-game they
;      address the menu image resident in PSRAM, which theme_apply already
;      rewrote with the user's theme -- so copying from here is exactly what
;      makes the shell themed (same reason the overlay can call genfonts).
;      Entered from the dispatch with A 8-bit / X 16-bit and the GAME's DBR, so
;      every access is long (@): the sources live in $C0, this object in $C1 and
;      the destinations in PSRAM $F4. Leaves A 8-bit; X is clobbered (nothing
;      after the call reads it). IGM_THM_MAGIC is cleared first and stamped $A5
;      LAST, so a shell reached after an aborted copy sees an invalid block
;      instead of half a theme. ----
ovl_stage_theme:
	.as : .xl                              ; declared, not inherited: ss_ovl_pad_drain above
	                                       ;   leaves the ASSEMBLER in .al, which would size
	                                       ;   every `lda #imm` here 16-bit against 8-bit A
	lda #$00 : sta @IGM_THM_MAGIC          ; invalidate while we fill (no long stz)
	; --- backdrop gradient blob: hdma_pal_src -> IGM_THM_GRAD (55 B) ---
	ldx #$0000
ovl_thm_grad:
	lda @hdma_pal_src, x : sta @IGM_THM_GRAD, x
	inx : cpx #$0037 : bne ovl_thm_grad
	; --- BAR colour-math table: hdma_math_src -> IGM_THM_MATH (19 B) ---
	ldx #$0000
ovl_thm_math:
	lda @hdma_math_src, x : sta @IGM_THM_MATH, x
	inx : cpx #$0013 : bne ovl_thm_math
	; --- BAR colours (normal + highlight): hdma_bar_color_src -> IGM_THM_BARCOL (8 B) ---
	ldx #$0000
ovl_thm_bar:
	lda @hdma_bar_color_src, x : sta @IGM_THM_BARCOL, x
	inx : cpx #$0008 : bne ovl_thm_bar
	; --- four sub-palettes out of the menu's raw 512 B `palette` block. Sub-palette
	;     N is palette+N*8 (4 colours x 2 B); the shell wants them packed in ITS
	;     order: 0 (text), 6 (grey), 2 (green), 3 (frame). ---
	ldx #$0000
ovl_thm_pal:
	lda @palette, x     : sta @IGM_THM_PAL, x       ; pal0 -> +0  (CGRAM 0-3,   text)
	lda @palette+$30, x : sta @IGM_THM_PAL+$08, x   ; pal6 -> +8  (CGRAM 24-27, grey)
	lda @palette+$10, x : sta @IGM_THM_PAL+$10, x   ; pal2 -> +16 (CGRAM 8-11,  green)
	lda @palette+$18, x : sta @IGM_THM_PAL+$18, x   ; pal3 -> +24 (CGRAM 12-15, frame)
	inx : cpx #$0008 : bne ovl_thm_pal
	lda #$a5 : sta @IGM_THM_MAGIC          ; complete -> valid (written LAST)
	rts

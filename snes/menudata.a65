menu_enttab_filesel_favorites_context:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
; The 5 entry rows live in ctxrows_favorites.i65 -- shared with the ShowGameInfo == 2
; variant in contextdata.a65 ($C1). Edit the rows there.
#include "ctxrows_favorites.i65"

 .byt  0

; dead code removed: mfunc_set_bsx_time was unreferenced.
 .as
 .byt 0,0,0,0,0,0,0,0   ; 8
 .byt 0,0,0,0,0,0,0,0   ; 8
 .byt 0                 ; 1  -> 17 bytes

mfunc_isenabled_always:
  sec
  rtl

mfunc_isenabled_never:
  clc
  rtl

mfunc_isenabled_hooks:
  lda @CFG_ENABLE_INGAME_HOOK
  eor #$ff
  ror
  rtl

; Game Info sub-option greying. ShowGameInfo is now 0/1/2 (off / on / context), so
; the eor/ror trick used by the 0/1 toggles above would flag value 2 as OFF -> branch
; on != 0 instead, like mfunc_isenabled_covers below. Note that "context" still opens
; the info screen (from the file context menu), it only drops the auto-show before
; boot, so the Video/Music children stay enabled in that mode.
; Carry set = drawn disabled.
;
; The music child needs Game Info != 0 AND Show video != 0 (the .pcm only plays
; alongside the clip), so it tests the video flag and then FALLS THROUGH into the
; ShowGameInfo test, sharing both epilogues with mfunc_isenabled_gameinfo.
mfunc_isenabled_gameinfo_music:
  lda @CFG_GAME_INFO_VIDEO
  beq mfunc_isenabled_gi_grey  ; no video -> no video music
mfunc_isenabled_gameinfo:
  lda @CFG_SHOW_GAME_INFO
  bne mfunc_isenabled_gi_on    ; on (1) or context (2) -> the info screen exists
mfunc_isenabled_gi_grey:
  sec                          ; game info off -> grey the sub-option
  rtl
mfunc_isenabled_gi_on:
  clc
  rtl

; dead code removed: mfunc_isdisabled_hooks was an unreferenced inverse of
; mfunc_isenabled_hooks.  4 bytes zero-filled to keep menu-binary alignment
; (was 8; the pair of predicates above grew when they stopped using eor/ror).
 .byt 0,0,0,0           ; 4 bytes total

; Grey the "Favorites/Recents" sub-option whenever Show covers is Off. ShowCovers
; holds 0/1/2 (off/large/small), so the eor/ror trick used above (assumes 0/1)
; would mis-flag value 2 -> branch on != 0 instead. Carry set = drawn disabled.
mfunc_isenabled_covers:
  lda @CFG_SHOW_COVERS
  bne mfunc_isenabled_covers_on
  sec                        ; covers off -> grey the sub-option
  rtl
mfunc_isenabled_covers_on:
  clc                        ; covers on (large/small) -> enabled
  rtl

mfunc_isenabled_savestate:
  lda @CFG_ENABLE_INGAME_SAVESTATE
  and @CFG_ENABLE_INGAME_HOOK
  eor #$ff
  ror
  rtl

mfunc_isenabled_scic:
  lda @CFG_PAIR_MODE_ALLOWED
  and @ST_PAIRMODE
  eor #$ff
  ror
  rtl

mfunc_isenabled_autosave:
  lda @CFG_ENABLE_AUTOSAVE
  eor #$ff
  ror
  rtl

; Random music only means something while the menu music itself is on.
mfunc_isenabled_menumusic:
  lda @CFG_ENABLE_MENU_MUSIC
  eor #$ff
  ror
  rtl

mfunc_chg_brightness:
  sta @tgt_bright
  sta @menu_brightness
  rtl

mfunc_chg_ledbright:
  sta @CFG_LED_BRIGHTNESS
  lda #CMD_LED_BRIGHTNESS
- sta @MCU_CMD
  cmp @SNES_CMD
  bne -
  rtl

mfunc_chg_language:
  ; A = new language (fired on each kv8 scroll). Switch the menu's active language
  ; live; persistence is handled by the dialog commit (writes CFG_LANGUAGE + sends
  ; SAVE_CFG), and show_menu re-shows the main menu when cur_lang != menu_drawn_lang.
  sta @cur_lang
  rtl

; ======================================================================
;  The kv_* value tables moved to snes/contextdata.a65 ($C1).  They are pure
;  data (~600 bytes of them) and both readers of a kv table are bank-explicit:
;  menu_edit_value loads the entry's bank byte into w_kvtab_bank and does
;  `pha : plb` before jsr menu_kv_lookup (menu.a65), and menu_value_dialog_kv8
;  does the same from w_preset_bank -- so a table is free to live outside $C0.
;  Moved for the usual reason (see menu_enttab_mm / menu_enttab_chip there):
;  $C0 is the page that runs out, $C1 has tens of KB free.
; ======================================================================

menu_enttab_test:
; HEADER
 .byt 1
 .word !test_mtext_title
 .byt  ^test_mtext_title
; ENTRIES
 .byt  MTYPE_VALUE
 .word !test_mtext_entry_byte
 .byt  ^test_mtext_entry_byte
 .word !test_mtext_entry_byte_ptab
 .byt  ^test_mtext_entry_byte_ptab
 .byt  OPTTYPE_BYTE
 .word $F000
 .byt  $7F
 .byt  MTYPE_VALUE
 .word !test_mtext_entry_word
 .byt  ^test_mtext_entry_word
 .word !test_mtext_entry_word_ptab
 .byt  ^test_mtext_entry_word_ptab
 .byt  OPTTYPE_WORD
 .word $F001
 .byt  $7F
 .byt  MTYPE_VALUE
 .word !test_mtext_entry_string
 .byt  ^test_mtext_entry_string
 .word $0008
 .byt  0
 .byt  OPTTYPE_STRING
 .word $F003
 .byt  $7F
 .byt  MTYPE_VALUE
 .word !test_mtext_entry_kvbyte
 .byt  ^test_mtext_entry_kvbyte
 .word !test_mtext_entry_kvbyte_ptab
 .byt  ^test_mtext_entry_kvbyte_ptab
 .byt  OPTTYPE_KVBYTE
 .word $F00B
 .byt  $7F
 .byt  MTYPE_VALUE
 .word !test_mtext_entry_kvword
 .byt  ^test_mtext_entry_kvword
 .word !test_mtext_entry_kvword_ptab
 .byt  ^test_mtext_entry_kvword_ptab
 .byt  OPTTYPE_KVWORD
 .word $F00C
 .byt  $7F
 .byt  MTYPE_VALUE
 .word !test_mtext_entry_file
 .byt  ^test_mtext_entry_file
 .word !test_mtext_entry_file_path
 .byt  ^test_mtext_entry_file_path
 .byt  OPTTYPE_FILESEL
 .word $F00E
 .byt  $7F

 .byt 0

test_mtext_title              .byt "Test Menu", 0
test_mtext_entry_byte         .byt "Byte Select", 0
test_mtext_entry_word         .byt "Word Select", 0
test_mtext_entry_string       .byt "String Select", 0
test_mtext_entry_kvbyte       .byt "8bit Key-Value Select", 0
test_mtext_entry_kvword       .byt "16bit Key-Value Select", 0
test_mtext_entry_file         .byt "File Select", 0
test_mtext_entry_byte_ptab    .word $000e, $00e9
test_mtext_entry_word_ptab    .word $0052, $fecd
test_mtext_entry_kvbyte_ptab  .word $0000, !text_on : .byt ^text_on
                              .word $0003, !text_off : .byt ^text_off
                              .word $0001, !text_yes : .byt ^text_yes
                              .word $000e, !text_no : .byt ^text_no
                              .word $0004, !text_fast : .byt ^text_fast
                              .word $ffff

test_mtext_entry_kvword_ptab  .word $10f0, !text_50Hz : .byt ^text_50Hz
                              .word $20e3, !text_60Hz : .byt ^text_60Hz
                              .word $0008, !text_normal : .byt ^text_normal
                              .word $0133, !text_rtc : .byt ^text_rtc
                              .word $010a, !text_auto : .byt ^text_auto
                              .word $ffff

test_mtext_entry_file_path    .byt TYPE_IPS : .word !rootdir : .byt ^rootdir

 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
; The 5 entry rows live in ctxrows_file.i65 so the ShowGameInfo == 2 variant in
; contextdata.a65 ($C1) can include the SAME source instead of copying them.
; Add/remove a row THERE, not here -- both tables pick it up automatically.
#include "ctxrows_file.i65"

 .byt  0

menu_enttab_recent_context:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
; The 6 entry rows live in ctxrows_recent.i65 -- shared with the ShowGameInfo == 2
; variant in contextdata.a65 ($C1). Edit the rows there.
#include "ctxrows_recent.i65"

 .byt  0

; ---- per-patch context menu, opened with Y on the patch selector ----
; The "Header mode" entry edits PATCH_HDR_SEL, a scratch byte patchsel_contextmenu
; seeds from (and folds back into) the patch's packed flags byte, so the generic
; MTYPE_VALUE machinery never has to know that layout.  It greys out on a .bps row
; (mfunc_isenabled_patch_hdr): BPS encodes its sizes explicitly, so there is no
; header convention to choose.
menu_enttab_patch_context:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
 .byt  MTYPE_VALUE
 .word !mtext_patch_header_mode
 .byt  ^mtext_patch_header_mode
 .word !kv_patch_hdrmode
 .byt  ^kv_patch_hdrmode
 .byt  OPTTYPE_KVBYTE
 .word !PATCH_HDR_SEL
 .byt  ^PATCH_HDR_SEL
 .word !mdesc_patch_header_mode
 .byt  ^mdesc_patch_header_mode
 .byt  0,0,0
 .byt  0,0,0
 .word !(mfunc_isenabled_patch_hdr-1)
 .byt  ^(mfunc_isenabled_patch_hdr-1)

 .byt  MTYPE_FUNC_CLOSE
 .word !mtext_patch_create_rom
 .byt  ^mtext_patch_create_rom
 .word !patch_create_rom-1
 .byt  ^patch_create_rom-1
 .byt  0
 .byt  0,0,0
 .word !mdesc_patch_create_rom
 .byt  ^mdesc_patch_create_rom
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0                                ; no greying predicate: built on every config
 .byt  0


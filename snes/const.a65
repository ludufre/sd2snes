gfxptr_info     .byt "_GFXPTR_"
                .word font
                .word logo_pal
                .word hdma_math_src
                .word hdma_bar_color_src
                .word hdma_pal_src
                .word oam_data_l
                .word oam_data_h
                .word palette
                .word logo_tiles
; slot 0 (font) lives in bank $C1 while every other themed region is in $C0. A
; .word only carries the low 16 bits, so the MCU can't know the font's bank from
; gfxptr[0] alone. Emit the font's bank byte here (assembler-resolved, robust to
; future relocations) so theme.c can address the font for the outline-off remap.
                .byt ^font

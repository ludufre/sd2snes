; Hint line drawn over the bottom border row.
; Tile $19 (decimal 25) = window_sh (south horizontal bar), drawn in
; palette 3 so it reads as one continuous frame with the corner tiles.
; The text in the middle stays in palette 0 (white). cheat_tab_hint_bars
; is sized for the longer (left) side; the draw routine prints just 7
; of these for the right side.
cheat_tab_hint_bars .byt 25,25,25,25,25,25,25,25,0
cheat_tab_hint_text .byt " A:Enable/Disable   B:Save & Exit ", 0


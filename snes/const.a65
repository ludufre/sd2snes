.link page $c0

version         .byt "                            v0.1",0
zero            .word  0
oamhide         .word  $f0f0   ; OAM fill: Y=$f0 (off-screen) hides every sprite
oamlarge        .word  $aaaa   ; OAM hi-table fill: size=1 (16x16) + X bit8=0 for 4 sprites
oamsmall        .word  $0000   ; OAM hi-table fill: size=0 (8x8) + X bit8=0 (small cover)
bg2tile         .byt $20
hdma_pal_src
  .byt 56
  .byt $00, $00
  .byt 12
  .byt $00, $00
  .byt 12
  .byt $00, $04
  .byt 12
  .byt $20, $08
  .byt 12
  .byt $40, $10
  .byt 12
  .byt $40, $14
  .byt 12
  .byt $60, $18
  .byt 12
  .byt $80, $20
  .byt 12
  .byt $80, $24
  .byt 12
  .byt $a0, $2c
  .byt 12
  .byt $c0, $30
  .byt 12
  .byt $e0, $34
  .byt 12
  .byt $e0, $3c
  .byt 12
  .byt $00, $41
  .byt 12
  .byt $20, $49
  .byt $00
  ; pad to the 55-byte region size: main.a65 DMAs a fixed #55 into the
  ; hdma_pal WRAM buffer, and HDMA stops at the $00 above, so these are
  ; never fetched -- they only keep the region (and theme_slot_max[4]) at 55.
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00

hdma_cg_addr_src
  .byt $f0
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $f0
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00, $00, $00, $00, $00, $00, $00, $00
  .byt $00
hdma_mode_src   .byt 56, $03, $01, $05, $00
hdma_bg1scroll_src
  .byt 56
  .byt $00, $00, $ff, $03
  .byt 127
  .byt $fc, $00, $0d, $00
  .byt 24
  .byt $fc, $00, $0d, $00
  .byt 1
  .byt $fc, $00, $0f, $00
  .byt $00
hdma_bg2scroll_src
  .byt 56
  .byt $ff, $03
  .byt 127
  .byt $0d, $00
  .byt 24
  .byt $0d, $00
  .byt 1
  .byt $0f, $00
  .byt 0

; colors (sd2snes+ default):
; upper border: + #5400ff -> 10,0,31
; selection bar:+ #5400ff -> 10,0,31
; lower border: 1/2 #5400ff
; NB: the two COLDATA bytes below that differ from the classic look (offsets 5 and
; 11) are overwritten every time by set_bar_color (ui.a65) out of
; hdma_bar_color_src, so this block's real contribution is offsets 6..18. Kept in
; sync with the theme anyway so a .thm round-trip through here is faithful.
hdma_math_src
  .byt 1 ; these are filled in...
  .byt $00, $2a
  .byt 1 ; ...to move the color bar
  .byt $00, $40
  .byt 1
  .byt $23, $9f   ; $2131: BG1+BG2+backdrop color math (OBJ bit cleared so the
  .byt 7          ;        cover sprites stay OPAQUE over the selection bar)
  .byt $23, $00
  .byt 1
  .byt $63, $00
  .byt 1
  .byt $00, $e0
  .byt 0

hdma_bar_color_src
  .byt $2a, $40, $9f, $00 ; normal color
  .byt $36, $40, $8a, $00 ; highlight color (active editing)

oam_data_l
  .byt 88, 56, 0, $08
  .byt 96, 56, 1, $08
  .byt 104, 56, 2, $08
  .byt 112, 56, 3, $08
  .byt 120, 56, 4, $08
  .byt 128, 56, 5, $08
  .byt 136, 56, 6, $08
  .byt 88, 64, 7, $08
  .byt 96, 64, 8, $08
  .byt 104, 64, 9, $08
  .byt 112, 64, 10, $08
  .byt 88, 72, 14, $08
  .byt 96, 72, 15, $08
  .byt 157, 56, 21, $0a
  .byt 172, 56, 22, $0c
  .byt 180, 56, 23, $0c
  .byt 172, 64, 24, $0c
  .byt 172, 72, 26, $0c
  .byt 172, 80, 28, $0c
  .byt 172, 88, 30, $0c
  .byt 172, 96, 32, $0c
  .byt 194, 56, 34, $0e
  .byt 194, 64, 35, $0e
  .byt 194, 72, 36, $0e
oam_data_h
  .byt 0, 0, 0, 0, 0, 0, 0, 0, 0

space64
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $20, $20, $20, $20, $20, $20, $20, $20
  .byt $00


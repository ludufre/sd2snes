; Folders that open as their MSU-1 game.
;
; An MSU-1 game ships as a folder: the ROM, its .msu and dozens of <stem>-N.pcm tracks. When
; the ONLY ROM in a folder has a matching .msu, pressing A on the folder acts like pressing
; A on that ROM (the game info screen or the boot, as ShowGameInfo decides). A folder with
; two or more ROMs opens as a plain folder.
;
; The firmware decides (scan_dir, gated by CFG_OPEN_MSU_FOLDERS) and answers in the READDIR
; reply: MCU_PARAM+7 = 'M' and MCU_PARAM+4..5 = the ROM's index in the sorted listing.
; filesel_request_filelist zeroes +7 before every READDIR, so an older firmware answers "no".
;
; Such a folder IS the game as far as browsing goes, so the user never ends up inside it:
; - select_dir (the user's A on a folder) asks, and sel_is_dir opens the ROM straight away
;   through the very same gameinfo_select_file an A press on a ROM uses -- BEFORE the browser
;   loop repaints. Running it after the repaint (the first version) flashed the folder's
;   listing for a frame ahead of the info screen.
; - If that returns (B on the info screen, the patch dialog cancelled, a refused load),
;   gameinfo_select_file calls msu_folder_leave (filesel.a65), which undoes the select_dir:
;   the parent listing comes back with the folder highlighted where it was. msu_inside says
;   whether there is anything to undo, because the next item can move the browser in or out.
; - Up/Down on the info screen step between the games of a listing, and such a folder is one
;   of them (gameinfo.a65, gnav_core): from its ROM the step backs out to the parent first,
;   and a folder it lands on is asked about (CMD_MSU_PROBE, a cheap walk that stops at the
;   second ROM) and, on a yes, entered like the A above -- so the panel shows its game.
; - The reset-to-menu / browser restore walk (filesel_nav_last) asks after entering the LAST
;   folder of the path, and backs out the same way, landing on the folder in its parent
;   instead of on the ROM inside it.
; B to a parent, the refresh after a delete and the manual viewer's rebuild never look.

.link page $c1
#include "memmap.i65"
; memmap.i65 re-asserts '.link page $c0' on include; re-declare $c1 AFTER it (last
; '.link page' wins and they emit no bytes) so every byte of this object lands in $C1.
.link page $c1

; ---------------------------------------------------------------------------
; msu_folder_arm: end of select_dir, right after its READDIR.
; Out: carry SET = this folder opens as a game, A (16-bit) = the ROM's entry index.
;      Carry CLEAR = plain folder. Returns .al/.xl on both paths.
msu_folder_arm:
  sep #$20 : .as
  rep #$10 : .xl
  lda @MCU_PARAM+7
  cmp #$4d                  ; 'M'
  bne mfa_plain
  lda #$01                  ; inside it now; msu_folder_leave drops this
  sta @msu_inside
  rep #$20 : .al
  lda @MCU_PARAM+4
  sec
  rtl
mfa_plain:
  rep #$20 : .al
  clc
  rtl


; ---------------------------------------------------------------------------
; Back from the game info screen to the browser. gi_dc_restore rebuilds the menu graphics
; with empty tile buffers and the browser repaints them only in fileselloop's next pass --
; row by row on a lit screen, the bar on the first row until the cursor is placed: the
; list was seen building up. Now the screen stays black through that and fades in once
; the list is complete.
; ---------------------------------------------------------------------------

; gi_back_dark: B on the game info screen opened from the BROWSER (gi_query_fill = 1; the
; Recents/Favorites returns repaint their own windows). Before gi_dc_restore. Any widths. rtl.
gi_back_dark:
  php
  sep #$20 : .as
  lda @gi_query_fill
  beq gbd_out
  lda #$01
  sta @gi_relight
gbd_out:
  .as
  plp
  rtl

; gi_light: gi_dc_restore's last step, A = the menu brightness. Lit at once, or held black
; (forced blank) for gi_relight_check. Any widths in (A's low byte used). rtl.
gi_light:
  php
  sep #$20 : .as
  pha
  lda @gi_relight
  cmp #$01
  beq gli_dark
  pla
  sta @cur_bright
  sta @tgt_bright
  sta @$002100
  plp
  rtl
gli_dark:
  .as
  pla
  lda #$00
  sta @cur_bright
  sta @tgt_bright           ; the NMI's fade holds it at 0
  lda #$80
  sta @$002100
  plp
  rtl

; gi_relight_check: fileselloop finished a repaint. Its buffers go up in the next VBlank,
; before the NMI's fade takes its first step: fade in from black over the whole list.
; Any widths. rtl.
gi_relight_check:
  php
  sep #$20 : .as
  lda @gi_relight
  cmp #$01
  bne grc_out
  lda #$00
  sta @gi_relight
  sta @fade_count
  lda @menu_brightness
  sta @tgt_bright
  lda #$01
  sta @fade_speed
grc_out:
  .as
  plp
  rtl

; ---------------------------------------------------------------------------
; msu_probe_visible: the browser loop's repaint, right before filesel_redraw draws the page.
; A folder that opens as its MSU-1 game gets the game icon (diricon.a65), and telling one
; takes a walk through the folder. scan_dir does not walk them -- a folder of 300 MSU-1 games
; took seconds to list -- it leaves each subfolder's size string as '?' + the folder's start
; cluster. Here, when a row about to be drawn still holds '?', one CMD_MSU_PROBE_PAGE asks the
; firmware to settle the rows of the page ('M' = game icon, ' ' = folder), so only the
; folders anybody looks at are ever walked. Older firmware never leaves a '?': no command.
; While a direction is held (pad1delay counting the auto-repeat) nothing is asked: each
; folder costs a walk of its entries (~40 ms for an MSU-1 game folder on a Mk.III), and
; asking for every row that scrolls in made a held d-pad crawl. The rows keep the folder
; icon until the d-pad stops, then msu_probe_idle repaints and this asks for the page once.
; A cover load in flight owns the command channel: the same, asked again on the next frame.
; jsl from fileselloop (DP = 0); preserves P, DP and DBR.
msu_probe_visible:
  php
  phd
  rep #$30 : .al : .xl
  pea $0000
  pld
  sep #$20 : .as
  lda @CFG_OPEN_MSU_FOLDERS
  beq mpv_out
  lda @filesel_state        ; 0 = the file list (what filesel_redraw draws)
  bne mpv_out
  ldx #$0000                ; row
  ldy #$0000                ; its entry in the directory table (4 bytes each)
mpv_row:
  .as : .xl
  txa
  cmp @listdisp
  bcs mpv_out               ; every row of the page is settled
  iny
  iny
  lda [dirptr_addr], y      ; the name's bank in the table, 0 = end of the directory
  beq mpv_out
  clc
  adc #$c0
  sta print_ptr+2
  iny
  lda [dirptr_addr], y      ; type
  cmp #TYPE_SUBDIR
  bne mpv_next
  rep #$20 : .al
  dey
  dey
  dey
  lda [dirptr_addr], y
  sta print_ptr             ; -> the size string, first byte = the icon mark
  iny
  iny
  iny
  sep #$20 : .as
  lda [print_ptr]
  cmp #$3f                  ; '?' = DIR_MARK_UNPROBED (src/filetypes.h)
  beq mpv_ask
mpv_next:
  .as : .xl
  iny
  inx
  bra mpv_row
mpv_ask:
  .as : .xl
  lda @pad1delay            ; scrolling
  bne mpv_later
  lda @cover_request_pending
  bne mpv_later
  lda #$00                  ; wait_mcu_ready: the firmware back at its command poll
  sta @MCU_CMD
  ldx #$0000
mpv_ready:
  .as : .xl
  lda @SNES_CMD
  cmp #$55
  beq mpv_send
  dex
  bne mpv_ready
mpv_send:
  .as : .xl
  rep #$20 : .al
  lda dirptr_addr           ; the page's first entry: bank:addr is also its PSRAM address
  sta @MCU_PARAM
  sep #$20 : .as
  lda dirptr_addr+2
  sta @MCU_PARAM+2
  lda @listdisp
  sta @MCU_PARAM+3
  lda #$00
  sta @SNES_CMD
  lda #CMD_MSU_PROBE_PAGE
  sta @MCU_CMD
  jsl @WRAM_WAIT_MCU
mpv_out:
  .as : .xl
  pld
  plp
  rtl
mpv_later:
  .as : .xl
  lda #$01
  sta @msu_probe_wait
  bra mpv_out

; ---------------------------------------------------------------------------
; msu_probe_idle: every pass of the browser loop that does not repaint. Once the d-pad is
; released (and no cover load is in flight), the page msu_probe_visible left unprobed is
; repainted, which asks for it. jsl from fileselloop; preserves P.
msu_probe_idle:
  php
  sep #$20 : .as
  lda @msu_probe_wait
  beq mpi_out
  lda @pad1delay
  bne mpi_out
  lda @cover_request_pending
  bne mpi_out
  lda #$00
  sta @msu_probe_wait
  lda #$01
  sta @filesel_dirty
mpi_out:
  .as
  plp
  rtl

; CX4 in-game savestate: capture / restore of the coprocessor state.
;
; Split out of savestate.a65 into its OWN object because the $C0 page is full
; (222 free bytes in two holes, the largest 118 B) and this handler costs ~1.3 KB.
; savestate.a65 is `.link page $c0` directly, so the routines live here in $C1
; (~22.9 KB free, covered by the same IS_PATCH window -- address.v) and are
; reached with `jsl @<routine>`; each of the six call sites in savestate.a65 is
; then only 4 bytes of $C0.  Precedent: cheatoverlay.a65.  The bottom of the file
; carries one NON-CX4 routine for the same reason (ss_hot_mask_build, the
; init-time builder for the handler's fast-reject mask) -- see the banner there.
;
; MODEL: run-to-stop.  The handler asks the core to halt EARLY (ss_cx4_early, at
; the same instant the SNES CPU is cut) and the FPGA lets the CX4 CPU run to its
; next clean boundary (CPU/cache/DMA idle) before reporting frozen; a saturating
; ~46 ms timeout latches "dirty" instead of hanging.  Everything is then reached
; through the $E8:00xx scan window (offsets $00-$27 = state block, $E0-$E2 stage
; cpu_idb, $E3 commit, $E4 readback index, $F0 normalize, $FE halt ctl, $FF magic
; $5C) plus the NATIVE $00:6000-$7FFF space (3 KB data RAM, MMIO, vectors, GPR),
; which stays bus-visible while frozen.  The program cache is NOT captured: it is
; REPLAYED on restore through the native $7F48-$7F4E MMIO, whose cache FSM is not
; pause-gated and so runs under the freeze.  The core is left FROZEN after both
; capture and restore; ss_cx4_release runs at the real game resume (return_align).

.link page $c1
#include "memmap.i65"
#include "savestate.i65"
; memmap.i65 re-asserts '.link page $c0' on include, so re-declare $c1 here AFTER
; the includes (last '.link page' wins, and they emit no bytes) -- same trap the
; cheat overlay documents.  Every byte of this object must land in $C1.
.link page $c1

; --- early halt request (save AND load paths) -------------------------------
;     Requested at the CPU cut so the core has the whole capture phase to
;     converge on a boundary.  Idempotent; the capture re-asserts it.
ss_cx4_early:
	.as : .xl
	lda @SS_CX4_GATE
	beq ss_cx4_early_x
	lda #$01
	sta @SS_CX4_WINDOW|$00FE
ss_cx4_early_x:
	rtl

; --- halt release, at the REAL game resume ----------------------------------
;     Called from both return_align exits (direct-IRQ resume and the NMI path
;     after the CS_STATE==2 wait) so the CX4 wakes in lockstep with the SNES.
ss_cx4_release:
	.as : .xl
	lda @SS_CX4_GATE
	beq ss_cx4_rel_x
	lda #$00
	sta @SS_CX4_WINDOW|$00FE
ss_cx4_rel_x:
	rtl

; --- capture ----------------------------------------------------------------
;     NORMALIZE-FIRST: $F0 is written BEFORE any read, so (a) a capture that
;     timed out dirty cannot keep hammering the bus (a stuck cpu_cache_en fires
;     spurious fills) during the ~15-18 ms copy, and (b) the image we take is
;     already the clean boundary the restore reproduces.  Bounded spin.
ss_cx4_capture:
	.as : .xl
	lda @SS_CX4_GATE
	bne ss_cx4_cap_go
	rtl
ss_cx4_cap_go:
	lda #$01
	sta @SS_CX4_WINDOW|$00FE               ; ensure halt requested
	jsr ss_cx4_wait_frozen                 ; C=1 -> escape counter blew
	php                                    ; keep the carry across the copy
	lda #$01
	sta @SS_CX4_WINDOW|$00F0               ; NORMALIZE-FIRST
	; --- core registers via the $E4 readback mux -> $00-$02 ---
	lda #$00 : sta @SS_CX4_WINDOW|$00E4
	lda @SS_CX4_WINDOW|$0000 : sta @SS_CX4_CORE_SCRATCH+0
	lda @SS_CX4_WINDOW|$0001 : sta @SS_CX4_CORE_SCRATCH+1
	lda @SS_CX4_WINDOW|$0002 : sta @SS_CX4_CORE_SCRATCH+2
	lda #$08 : sta @SS_CX4_WINDOW|$00E4
	lda @SS_CX4_WINDOW|$0000 : sta @SS_CX4_CORE_SCRATCH+3
	lda @SS_CX4_WINDOW|$0001 : sta @SS_CX4_CORE_SCRATCH+4
	lda @SS_CX4_WINDOW|$0002 : sta @SS_CX4_CORE_SCRATCH+5
	lda #$0C : sta @SS_CX4_WINDOW|$00E4
	lda @SS_CX4_WINDOW|$0000 : sta @SS_CX4_CORE_SCRATCH+6
	lda @SS_CX4_WINDOW|$0001 : sta @SS_CX4_CORE_SCRATCH+7
	lda @SS_CX4_WINDOW|$0002 : sta @SS_CX4_CORE_SCRATCH+8
	lda #$13 : sta @SS_CX4_WINDOW|$00E4
	lda @SS_CX4_WINDOW|$0000 : sta @SS_CX4_CORE_SCRATCH+9
	lda @SS_CX4_WINDOW|$0001 : sta @SS_CX4_CORE_SCRATCH+10
	lda @SS_CX4_WINDOW|$0002 : sta @SS_CX4_CORE_SCRATCH+11
	lda #$1C : sta @SS_CX4_WINDOW|$00E4
	lda @SS_CX4_WINDOW|$0000 : sta @SS_CX4_CORE_SCRATCH+12
	lda @SS_CX4_WINDOW|$0001 : sta @SS_CX4_CORE_SCRATCH+13
	lda @SS_CX4_WINDOW|$0002 : sta @SS_CX4_CORE_SCRATCH+14
	; --- linear image of window $04-$27 (36 B) ---
	ldx #$0004
ss_cx4_cap_win:
	lda @SS_CX4_WINDOW, x
	sta @SS_CX4_WIN_SCRATCH, x
	inx
	cpx #$0028
	bne ss_cx4_cap_win
	; --- flag "captured without a clean freeze" in bit4 of the diag byte ---
	plp
	bcc ss_cx4_cap_nat
	lda @SS_CX4_WIN_SCRATCH+$1A
	ora #$10                               ; bit4 = dirty
	sta @SS_CX4_WIN_SCRATCH+$1A
ss_cx4_cap_nat:
	; --- native page $00:7F40-$7FAF (112 B: MMIO + status + vectors + GPR) ---
	ldx #$0040
ss_cx4_cap_nl:
	lda @$007F00, x
	sta @SS_CX4_NAT_SCRATCH, x
	inx
	cpx #$00B0
	bne ss_cx4_cap_nl
	; --- data RAM 3 KB, 16-bit words ---
	rep #$20 : .al
	ldx #$0000
ss_cx4_cap_dr:
	lda @$006000, x
	sta @SS_CX4_DATRAM_SCRATCH, x
	inx : inx
	cpx #$0C00
	bne ss_cx4_cap_dr
	sep #$20 : .as
	; NOTE: the CX4 is deliberately left FROZEN here (same reason as SA-1/GSU):
	; releasing it now would let it free-run and drift while the SNES stays
	; frozen through the MCU save and the resume wait.  return_align releases it.
	rtl

; --- restore ----------------------------------------------------------------
;     LOAD path only (CS_SA1_LOAD != 0): on a SAVE the core never left the frozen
;     capture state, so rewriting it would only risk a capture/restore asymmetry.
;     ORDER MATTERS: (1) cache replay first -- the fill consumes pgmoff/pgmpage
;     and WRITES cachetag/cachevalid; (2) pagemem before the final pgmpage,
;     because the $7F4C latch copies the current pgmpage; (3) DMA before the data
;     RAM, since arming $7F47 inevitably fires a transfer that dirties one byte
;     (neutralised to dmalen=$0001 -- $0000 would underflow to 65536 transfers);
;     (4) data RAM, overwriting that byte; (5) GPR, which only accepts writes
;     while frozen; (6) $7F4F after pgmpage; (7) window-only fixups after every
;     side effect; (8) the core registers last; (9) $F0 closes.
;     INVARIANT: every wait has an escape counter.
ss_cx4_restore:
	.as : .xl
	lda @SS_CX4_GATE
	bne ss_cx4_rst_g1
	rtl
ss_cx4_rst_g1:
	lda @CS_SA1_LOAD
	bne ss_cx4_rst_go
	rtl                                    ; SAVE path: no write-back
ss_cx4_rst_go:
	lda #$01 : sta @SS_CX4_WINDOW|$00FE    ; ensure halt requested
	jsr ss_cx4_wait_frozen                 ; carry ignored: proceed either way
	lda #$01 : sta @SS_CX4_WINDOW|$00F0    ; NORMALIZE-FIRST (kills a stuck
	                                       ; cpu_cache_en / BUSY_CPU /
	                                       ; cx4_cpu_datram_we)
	; ---- 1. program-cache replay through the NATIVE MMIO ----
	lda @SS_CX4_NAT_SCRATCH+$49 : sta @$007F49
	lda @SS_CX4_NAT_SCRATCH+$4A : sta @$007F4A
	lda @SS_CX4_NAT_SCRATCH+$4B : sta @$007F4B
	lda #$00 : sta @SS_CX4_WINDOW|$0017    ; cachevalid = 00 -> force the fills
	lda @SS_CX4_WIN_SCRATCH+$17
	and #$01
	beq ss_cx4_rst_p1
	lda @SS_CX4_WIN_SCRATCH+$0C : sta @$007F4D
	lda @SS_CX4_WIN_SCRATCH+$0D : sta @$007F4E
	lda #$00 : sta @$007F48
	jsr ss_cx4_busywait
ss_cx4_rst_p1:
	lda @SS_CX4_WIN_SCRATCH+$17
	and #$02
	beq ss_cx4_rst_pm
	lda @SS_CX4_WIN_SCRATCH+$0E : sta @$007F4D
	lda @SS_CX4_WIN_SCRATCH+$0F : sta @$007F4E
	lda #$01 : sta @$007F48
	jsr ss_cx4_busywait
ss_cx4_rst_pm:
	; ---- 2. pagemem[] via the NATIVE $7F4C side effect ----
	lda @SS_CX4_WIN_SCRATCH+$10 : sta @$007F4D
	lda @SS_CX4_WIN_SCRATCH+$11 : sta @$007F4E
	lda #$01 : sta @$007F4C
	lda @SS_CX4_WIN_SCRATCH+$12 : sta @$007F4D
	lda @SS_CX4_WIN_SCRATCH+$13 : sta @$007F4E
	lda #$02 : sta @$007F4C
	; ---- 3. DMA with the trigger neutralised ----
	lda @SS_CX4_NAT_SCRATCH+$40 : sta @$007F40
	lda @SS_CX4_NAT_SCRATCH+$41 : sta @$007F41
	lda @SS_CX4_NAT_SCRATCH+$42 : sta @$007F42
	lda #$01 : sta @$007F43                ; dmalen = $0001 (NEVER $0000: the
	lda #$00 : sta @$007F44                ; counter underflows to 65536 bytes)
	lda @SS_CX4_NAT_SCRATCH+$45 : sta @$007F45
	lda @SS_CX4_NAT_SCRATCH+$46 : sta @$007F46
	lda @SS_CX4_NAT_SCRATCH+$47 : sta @$007F47   ; fires the 1-byte DMA
	jsr ss_cx4_busywait
	lda @SS_CX4_NAT_SCRATCH+$43 : sta @$007F43
	lda @SS_CX4_NAT_SCRATCH+$44 : sta @$007F44
	; ---- 4. data RAM 3 KB (overwrites the byte the DMA dirtied) ----
	rep #$20 : .al
	ldx #$0000
ss_cx4_rst_dr:
	lda @SS_CX4_DATRAM_SCRATCH, x
	sta @$006000, x
	inx : inx
	cpx #$0C00
	bne ss_cx4_rst_dr
	sep #$20 : .as
	; ---- 5. vectors + GPR ($7F60-$7FAF; GPR only accepts writes while frozen) ----
	ldx #$0060
ss_cx4_rst_vg:
	lda @SS_CX4_NAT_SCRATCH, x
	sta @$007F00, x
	inx
	cpx #$00B0
	bne ss_cx4_rst_vg
	; ---- 6. remaining MMIO + final pgmpage/pc ----
	;      Writing $7F4F pulses cpu_go_en_r for one cycle, but both of its
	;      consumers sit under cx4_cpu_en == 0 while frozen, so the pulse dies
	;      with no effect; the cachepage side effect is undone by step 7 ($18).
	;      That is what saves a window offset for the program counter.
	lda @SS_CX4_NAT_SCRATCH+$50 : sta @$007F50
	lda @SS_CX4_NAT_SCRATCH+$51 : sta @$007F51
	lda @SS_CX4_NAT_SCRATCH+$52 : sta @$007F52
	lda @SS_CX4_NAT_SCRATCH+$4D : sta @$007F4D
	lda @SS_CX4_NAT_SCRATCH+$4E : sta @$007F4E
	lda @SS_CX4_NAT_SCRATCH+$4F : sta @$007F4F
	; ---- 7. window-only fixups ----
	ldx #$0014
ss_cx4_rst_sc:
	lda @SS_CX4_WIN_SCRATCH, x             ; $14 page_stack, $15 sp, $16 flags,
	sta @SS_CX4_WINDOW, x                  ; $17 cachevalid, $18 cachepage, $19 savepage
	inx
	cpx #$001A
	bne ss_cx4_rst_sc
	ldx #$0020
ss_cx4_rst_ps:
	lda @SS_CX4_WIN_SCRATCH, x             ; $20-$27 cpu_pc_stack[0..7]
	sta @SS_CX4_WINDOW, x
	inx
	cpx #$0028
	bne ss_cx4_rst_ps
	; ---- 8. core registers (UNROLLED: no txa/adc/tax) ----
	; 8a. multiplier -- cpu_a is the vehicle for mul_a
	lda @SS_CX4_WIN_SCRATCH+$04 : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_WIN_SCRATCH+$05 : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_WIN_SCRATCH+$06 : sta @SS_CX4_WINDOW|$00E2
	lda #$00 : sta @SS_CX4_WINDOW|$00E3     ; commit 0: cpu_a = mul_a
	lda @SS_CX4_WIN_SCRATCH+$08 : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_WIN_SCRATCH+$09 : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_WIN_SCRATCH+$0A : sta @SS_CX4_WINDOW|$00E2
	lda #$05 : sta @SS_CX4_WINDOW|$00E3     ; commit 5: mul_a<=cpu_a, mul_b<=idb
	; 8b. romdata / ramdata / busaddr / ramaddr
	lda @SS_CX4_CORE_SCRATCH+3  : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_CORE_SCRATCH+4  : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_CORE_SCRATCH+5  : sta @SS_CX4_WINDOW|$00E2
	lda #$01 : sta @SS_CX4_WINDOW|$00E3
	lda @SS_CX4_CORE_SCRATCH+6  : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_CORE_SCRATCH+7  : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_CORE_SCRATCH+8  : sta @SS_CX4_WINDOW|$00E2
	lda #$02 : sta @SS_CX4_WINDOW|$00E3
	lda @SS_CX4_CORE_SCRATCH+9  : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_CORE_SCRATCH+10 : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_CORE_SCRATCH+11 : sta @SS_CX4_WINDOW|$00E2
	lda #$03 : sta @SS_CX4_WINDOW|$00E3
	lda @SS_CX4_CORE_SCRATCH+12 : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_CORE_SCRATCH+13 : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_CORE_SCRATCH+14 : sta @SS_CX4_WINDOW|$00E2
	lda #$04 : sta @SS_CX4_WINDOW|$00E3
	; 8c. the REAL cpu_a last (step 8a used it as the mul_a vehicle)
	lda @SS_CX4_CORE_SCRATCH+0  : sta @SS_CX4_WINDOW|$00E0
	lda @SS_CX4_CORE_SCRATCH+1  : sta @SS_CX4_WINDOW|$00E1
	lda @SS_CX4_CORE_SCRATCH+2  : sta @SS_CX4_WINDOW|$00E2
	lda #$00 : sta @SS_CX4_WINDOW|$00E3
	; ---- 9. final normalize ----
	lda #$01 : sta @SS_CX4_WINDOW|$00F0
	rtl                                    ; stays FROZEN until return_align

; --- bounded wait for the freeze ack ($FE bit0). Exits with C=1 on timeout. ---
ss_cx4_wait_frozen:
	.as : .xl
	ldx #$0000
ss_cx4_wf_l:
	lda @SS_CX4_WINDOW|$00FE
	and #$01
	bne ss_cx4_wf_ok
	inx
	cpx #$4000
	bne ss_cx4_wf_l
	sec
	rts
ss_cx4_wf_ok:
	clc
	rts

; --- bounded wait for cx4_active ($00:7F53 bit6) to drop -------------------
ss_cx4_busywait:
	.as : .xl
	ldx #$0000
ss_cx4_bw_l:
	lda @$007F53
	and #$40
	beq ss_cx4_bw_out
	inx
	cpx #$2000
	bne ss_cx4_bw_l
ss_cx4_bw_out:
	rts

; ============================================================================
; $C1 ANNEX FOR THE SAVESTATE HANDLER (not CX4 -- it just shares this object)
; ============================================================================
; --- ss_hot_mask_build: one-shot builder for the handler's fast-reject mask ---
; ss_init (savestate.a65) calls this once per game load and it patches the
; immediate operand of ss_hot_mask, the BIT the handler runs on every interrupt
; that carries a button.  The mask is one bit that EVERY armed gesture REQUIRES,
; OR'd together: a pad carrying none of them cannot complete any gesture, so the
; frame is dropped in ~80 cycles instead of ~219 -- which is what keeps a held
; button from pushing a vblank-saturated game's DMA tail past the end of vblank
; (the picture-jitter class).
;   Correctness rule: only REQUIRED bits may go in (a bit that merely appears in
; some gesture is fine, a bit that is optional is not), and losing any armed
; gesture is unacceptable, so anything unexpected falls back to $FFFF = never
; filter, i.e. exactly the behaviour from before the optimisation.
;   Bit choice: save and load are always the same gesture with one button swapped
; (Start+R/Start+L, X+R/X+L, Select+Y+R/Select+Y+L, ...), so the bits they SHARE
; are the modifier button -- the rare one -- and the lowest of those covers both
; combos with a single bit.  The menu combo is armed per game load, so its bit is picked at
; run time: every bit of it is REQUIRED (the probe matches a subset), and a shoulder is
; preferred because it is held far less often in play than A/B/X/Y or a direction.
;   This routine is also the single resolver of that combo, which keeps ~20 bytes of the
; scarce $C0 page free.  OUT: A = fast-reject mask, X = resolved combo (never 0).
;   Lives here rather than in $C0 purely for space, like the CX4 routines above.
; Runs with A/X/Y 16-bit and clobbers A and X (ss_init has pushed both).
; Accumulates in a LOCAL word and returns the finished mask in A: the caller in
; $C0 (ss_init) does the actual  sta @ss_hot_mask+1  itself, so every store with
; a +1 addend stays same-object -- a cross-object symbol+addend reference is a
; linker pattern this tree has never exercised, and a silently mis-applied addend
; there would rewrite the BIT opcode instead of its operand on the hot path of
; every game. A mask of $0000 (overlay gate off AND CS_CTRL 0) filters EVERY
; frame, which is correct: nothing below the reject can fire in that config.
ss_hot_mask_build:
	.al : .xl
	; --- Resolve the armed in-game menu combo -> ss_hmb_ovl ----------------------
	; Published per game load as a word plus its complement: a new m3nu.bin can run against
	; an old MCU that never writes here, so a nonzero word proves nothing on its own.
	lda @MENU_COMBO
	beq ss_hmb_combo_dflt        ; never published (old firmware)
	eor @MENU_COMBO_INV          ; the firmware also wrote ~combo, so this is $FFFF ...
	inc                          ; ... and this wraps to 0 exactly when the pair is intact
	bne ss_hmb_combo_dflt
	lda @MENU_COMBO
	bra ss_hmb_combo_have
ss_hmb_combo_dflt:
	lda #$4230                   ; L=$0020 R=$0010 Y=$4000 Left=$0200
ss_hmb_combo_have:
	sta @ss_hmb_ovl
	lda #$0000
	sta @ss_hmb_acc
	lda @CHEAT_OVL_GATE
	and #$00FF
	beq ss_hmb_ctrl
	; Prefer a shoulder, L before R, so the default $4230 still yields $0020 (ss_hmb_lowbit
	; would pick R: $0010 is the lower bit).
	lda @ss_hmb_ovl
	beq ss_hmb_all               ; cannot happen (resolved above) -- never filter if it does
	and #$0020                   ; L?
	bne ss_hmb_ovl_have          ; A = $0020
	lda @ss_hmb_ovl
	and #$0010                   ; R?
	bne ss_hmb_ovl_have          ; A = $0010
	lda @ss_hmb_ovl              ; no shoulder in this combo: any required bit will do
	jsr ss_hmb_lowbit
ss_hmb_ovl_have:
	sta @ss_hmb_acc
ss_hmb_ctrl:
	lda @CS_CTRL
	and #$00FF
	beq ss_hmb_done              ; overlay-only mode: nothing else can fire
	lda @CS_SLOT_INPUT           ; slot-load = Select + d-pad
	beq ss_hmb_all
	jsr ss_hmb_lowbit
	ora @ss_hmb_acc
	sta @ss_hmb_acc
	lda @CS_SAVE_INPUT
	beq ss_hmb_all
	and @CS_LOAD_INPUT           ; bits BOTH combos require
	beq ss_hmb_all               ; nothing in common -> do not filter
	jsr ss_hmb_lowbit
	ora @ss_hmb_acc
	sta @ss_hmb_acc              ; sta leaves Z alone: the bne below still tests
	bne ss_hmb_done              ; the ora result (do not insert a load here)
ss_hmb_all:
	lda #$FFFF                   ; unexpected input config -> every frame takes the
	sta @ss_hmb_acc              ; full path, exactly like before this optimisation
ss_hmb_done:
	lda @ss_hmb_ovl              ; OUT: X = resolved combo.  Staged here, after the last
	tax                          ; ss_hmb_lowbit call, which pops into X and would clobber
	                             ; it.  No long-addressed LDX exists, hence lda/tax.
	lda @ss_hmb_acc              ; OUT: A = the fast-reject mask
	rtl

ss_hmb_acc:
	.word 0                      ; builder scratch, only live during ss_init
ss_hmb_ovl:
	.word 0                      ; builder INPUT (the combo passed in A), same lifetime

; A = lowest set bit of A (v & -v), 16-bit.  Clobbers X (pushed by ss_init).
ss_hmb_lowbit:
	.al : .xl
	pha
	eor #$FFFF
	inc
	and 1,s
	plx
	rts

; --- ss_wait_bail: the NMI resume wait timed out -----------------------------
; Called from return_wait_irq (savestate.a65) when the nested entry that bumps
; CS_STATE to 2 never arrived.  That entry is delivered by the FPGA -- the NMI
; vector has to be hijacked into the hook AND branch1 has to route to the
; savestate arm, which with the buttons long released rides on
; savestate_force_entry still being latched in cheat.v -- so the SNES side cannot
; guarantee it and must not bet the console on it: the wait runs with the PPU
; force-blanked and the coprocessor frozen, so a missed re-entry is a black
; screen that only MENU_RESET clears (measured on SMRPG/SA-1).
;   Job here: make the state the successful path would have made, so the caller
; can fall straight into the shared release/restore tail.
;   (1) breadcrumb, (2) interrupts off, (3) land on a vblank edge, (4) ack the NMI
; we are about to re-arm past, (5) CS_STATE = the post-resume cooldown.
;   (5) is the load-bearing one: leaving CS_STATE at 1 would make the NEXT hook
; entry take ss_irq_inc OUTSIDE a nested interrupt -- 9 bytes stripped off the
; stack of the game and an RTI into nothing.
;   (3) exists because the caller exits through the hook stub straight into the
; real NMI vector of the game: entering that ISR mid-frame would run its vblank
; DMA queue during active display.  Both halves of the edge search are bounded
; (~3 frames each) and simply give up into the ack -- this is already the failure
; path, it must not add a second way to hang.
; Enters and leaves with A 8-bit / X,Y 16-bit; X is the dead counter of the caller
; (the X of the game is on the stack), Y is untouched.
ss_wait_bail:
	.as : .xl
	; Breadcrumb: nonzero = "the resume wait timed out", bit7 = the NMI enable of
	; the RESTORED $4200 (0 there means the wait was unwinnable by construction --
	; see the ora #$80 note at return_enable_nmi), bit6 = this marker.  Byte is
	; SS_DIAG_REJECT+1, the free half of the diagnostic word ss_init zeroes on
	; every game load (ss_pad_reject only ever touches the low byte).
	lda @SRAM_OTH_BANK
	ora #$40
	sta @SS_DIAG_REJECT+1
	; Interrupts off for the edge search (keep auto-joypad exactly as the state had
	; it).  Without this the NMI we forced on at return_enable_nmi could fire in the
	; middle of the tail below, and with CS_STATE already at 2 that entry would exit
	; through nmi_exit -- dropping snescmd_unlock, i.e. the $C0-FF identity window
	; this very code is executing from.
	lda @SRAM_OTH_BANK
	and #$01
	sta @$004200
	; Wait out the rest of the current vblank ...
	ldx #$4000
ss_wb_active:
	lda @$004212
	bpl ss_wb_edge
	dex
	bne ss_wb_active
	bra ss_wb_ack
	; ... then for the start of the next one.
ss_wb_edge:
	ldx #$4000
ss_wb_vbl:
	lda @$004212
	bmi ss_wb_ack
	dex
	bne ss_wb_vbl
ss_wb_ack:
	lda @$004210                       ; ack the pending NMI flag
	lda #$02                           ; post-save/load cooldown: ss_start_skip
	sta @CS_STATE                      ; drains 2..15,0
	rtl

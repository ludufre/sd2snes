.link page $c1
#include "memmap.i65"
; memmap.i65 re-asserts '.link page $c0' on include; re-declare $c1 AFTER it (the
; last '.link page' wins and they emit no bytes) so every byte lands in bank $C1.
.link page $c1

; ===========================================================================
; ghlaunch.a65 -- the deferred half of game_handshake (snes/main.a65).
;
; With the menu music playing, the launched game must not inherit a live echo buffer
; in ARAM, and wiping ARAM costs a WARM RESET of the SNES.  That reset clears VRAM
; and re-inits the menu, so running it at the top of game_handshake destroyed the
; screen the iris was about to close over (and zeroed screen_dma_disable, making the
; iris pick the MENU HDMA set instead of the ficha one).  It now runs AFTER iris_out,
; in forced blank, where nothing it destroys is visible -- and since the MCU must not
; be mid-load when the reset fires, the launch command is deferred with it.
;
; Cost: with music on the iris no longer overlaps the MCU's work.  Music off, the
; wipe is a no-op and the command goes out before the iris exactly as before.
; ===========================================================================

; ===========================================================================
; gh_deferred_launch -- warm reset for the ARAM wipe, then hand the MCU the launch
; command.  jsl from bank $C0 right after iris_out, NMI off, IRQs masked, screen in
; forced blank.  Called UNCONDITIONALLY: $C0 cannot spare the gating test, so the
; BGM_STATE check lives here and returns at once when no wipe is pending.
; ===========================================================================
gh_deferred_launch:
    php
    phb
    sep #$20 : rep #$10 : .as : .xl

    ; Nothing was deferred unless the music is playing -- the caller cannot afford the
    ; two-instruction test in bank $C0, so it lives here and the call is unconditional.
    lda @BGM_STATE
    cmp #$01
    beq gh_dl_run
    plb
    plp
    rtl
gh_dl_run:
    lda #$00
    pha
    plb                         ; DB = 0: the $21xx/$42xx writes below are absolute,
                                ; and bank $C1 has no register mirror

    lda @gh_cmd_bak
    jsl gh_bcal_trampoline      ; warm reset (no-op if the music stopped meanwhile);
                                ; returns A = the launch command it carried across
    sta @gh_cmd_bak

    ; The warm boot ran the menu's own init, which turned the screen and the NMI back
    ; on and re-armed HDMA.  Put the PPU back exactly as iris_out left it, or the boot
    ; that follows flashes a freshly drawn menu for a few frames.
    sei
    stz $4200                   ; NMI/auto-joypad off
    stz $420c                   ; all HDMA off
    lda #$80
    sta $2100                   ; forced blank

    ; Now it is safe to start the MCU.
    lda #$00
    sta @SNES_CMD
    lda @gh_cmd_bak
    sta @MCU_CMD
    lda #$00
    sta @LOAD_NACK              ; refusal flag: anything set from here on is OURS

    plb
    plp
    rtl


; Savestate handler based on practice ROM save state code by acmlm, total, Myria
; adapted for usb2snes / sd2snes hardware support by RedGuy
; modified for standalone operation from USB EXE (2C00) + dedicated PSRAM
; space by FURiOUS
; Ported to snescom and further modified for standalone operation from in-game
; hook and default menu ROM space and IRQ support by ikari_01

; Currently this code is heavily optimized for size and not necessarily CPU
; cycle count.

; TODO do not execute from Bank C0 anymore; HDMA can fetch while handler is mapped,
; causing glitches or crashes (Notably Star Fox)

.link page $c0
#include "memmap.i65"
#include "savestate.i65"

.byt "SAVESTATE_START"
savestate_handler:
; * = $FE1000

; print "Savestate Bank Starting at: ", pc
	php : rep #$30 : .al : .xl : pha
	; Fast-exit on mid-frame IRQs (vblank flag clear): with the IRQ hook active
	; every IRQ lands here, and games like Super Mario RPG fire timing-critical
	; H-IRQs mid-frame -- running the full handler inside those delays the game
	; ISR every frame and can lose an interrupt-reconfig race (seen in hardware
	; as a hard freeze minutes into gameplay with $4200 stuck at $01). The combo
	; probe only needs the once-per-frame vblank entry (NMI or vblank IRQ).
	sep #$20 : .as
	lda @$004212
	bpl ss_midframe_entry        ; not vblank -> mid-frame IRQ pre-check (below).
	                             ; The vblank path falls through on purpose: it runs
	                             ; on EVERY frame a button is held, so every branch
	                             ; on it is paid ~60 times a second.
; --- Vblank entry ------------------------------------------------------------
; $4212 bit0 = the auto-joypad shift register is BUSY.  The stub at nmihook.a65:9
; sampled $4218 ~25-30 cycles into the interrupt; the hardware starts filling that
; register 18us (~386 master cycles, "48 machine cycles with 2.68MHz") after
; vblank begins and the read runs for ~215us (~4610 master, "3.4 scanning
; lines"), so on a PUNCTUAL entry the stub reads BEFORE the fill starts and gets
; the complete pad of the previous frame, while a read taken during the fill
; returns the pad SHIFTED RIGHT by the bits that have not arrived yet (dev manual
; book1 2-13-1: the register "cannot be read properly" there, and $4212 bit0 is
; the flag that says so).
;   That question is NOT answered here any more.  It used to be captured in the
; CARRY and carried down to the gate in ss_input, and that channel had three
; writers -- this entry, the cooldown branch (cmp #$01 leaves C SET), the
; mid-frame pre-check (clc) -- plus a first entry per game load on which ss_init
; runs several hundred cycles in between.  The flag that reached the gate was
; therefore often neither fresh nor the one this path set, and the gate has no way
; to tell.  ss_input reads $4212 itself now, once, immediately before it touches
; $4218: same two instructions, no cross-path state, and the answer is the one
; that holds at the instant it is acted on.
;   X and Y are NOT usable as scratch anywhere on this path: the hook runs before
; the game's own ISR has saved anything, so the only registers we may destroy are
; the ones the stub already pushed (A and P).  That is why the pad travels through
; memory below and not in a register; the bounded wait in ss_input borrows X
; through the stack (phx/plx), which leaves the game's value untouched.
	rep #$20 : .al
savestate_start:
	jmp ss_init

ss_midframe_entry:
	.as : .xl                    ; reached with A still 8-bit from the $4212 read
	; Savestate in flight (CS_STATE != 0): do NOT fast-exit.  The resume-wait
	; loop needs the NEXT hook entry to bump CS_STATE, and in IRQ-driven scenes
	; that entry can be a MID-FRAME IRQ (e.g. an SA-1 RPC IRQ left pending across
	; the freeze fires the instant return_align does CLI).  Fast-exiting it would
	; also exit the nmihook stub, dropping snescmd_unlock and clearing the FPGA's
	; savestate_force_entry -- after which no IRQ is ever redirected again and
	; the game parks in return_wait_irq forever (seen in hardware on a SMRPG
	; field save).  The game is frozen while a savestate is in flight, so the
	; anti-freeze fast path only matters when CS_STATE == 0.
	lda @CS_STATE
	beq ++                       ; not in flight -> normal fast-exit checks
	rep #$20 : .al
	jmp savestate_start          ; in flight -> full path (ss_irq_inc handles it)
++
	.as : .xl
	; Mid-frame entry (IRQ).  Games like Star Ocean run with NMI OFF and a V-IRQ at
	; V=0 as the frame tick (measured: 58/58 handler entries at V=0, 0% in vblank),
	; so the vblank gate alone rejects every entry and the overlay can never open.
	; Cheap pre-check on the pad the nmihook stub just stored to NMI_PAD: only a
	; deliberately-held savestate GESTURE proceeds to the full probe; anything else
	; exits as fast as before (~20-40 cycles), preserving the anti-freeze property
	; for raster-H-IRQ games (the SMRPG class).  The gesture is the ARMED in-game menu
	; combo OR the ARMED save/load/slot combo -- without the latter, save/load/slot were
	; swallowed on every mid-frame IRQ entry, so X+R/X+L never fired in IRQ-driven
	; scenes (e.g. Yoshi's Island on the GSU).  Masked match: extra held bits are
	; ignored, and "all mask bits held" == (~pad & mask) == 0.
	;   MENU_COMBO is read here rather than patched like the probe below: this path can run
	; before ss_init, so a patched operand would deadlock a remapped combo in an IRQ-only
	; frame loop.  A zero word (old MCU) must not be used as a mask.
	rep #$20 : .al
	lda @MENU_COMBO
	bne ss_pre_combo_have        ; named label: the anonymous +/- chains here must not shift
	lda #$4230                   ; unpublished -> historical L+R+Y+Left
ss_pre_combo_have:
	eor #$FFFF                   ; ~combo: the ORA below is $FFFF iff every bit is held
	ora @NMI_PAD
	inc                          ; $FFFF -> 0
	beq ss_precheck_pass
	; save/load/slot: only while savestates are active (CS_CTRL != 0) and only for
	; the ARMED value (a 0 mask would match every frame and defeat the fast-exit).
	; "all mask bits held" == (~NMI_PAD & mask) == 0 -- no stack, no clobbered Z.
	sep #$20 : .as
	lda @CS_CTRL
	beq ss_precheck_fail
	rep #$20 : .al
	lda @CS_SAVE_INPUT
	beq +
	lda @NMI_PAD : eor #$FFFF : and @CS_SAVE_INPUT
	beq ss_precheck_pass
+	lda @CS_LOAD_INPUT
	beq +
	lda @NMI_PAD : eor #$FFFF : and @CS_LOAD_INPUT
	beq ss_precheck_pass
+	lda @CS_SLOT_INPUT           ; slot = Select+d-pad; require a d-pad bit too so
	beq ss_precheck_fail16       ; Select alone can't keep the handler alive
	lda @NMI_PAD : eor #$FFFF : and @CS_SLOT_INPUT
	bne ss_precheck_fail16
	lda @NMI_PAD
	and #$0F00                   ; up/down/left/right present?
	bne ss_precheck_pass
ss_precheck_fail16:
	sep #$20 : .as
ss_precheck_fail:
	jmp ss_exit
ss_precheck_pass:
	; Mid-frame entries need no auto-read arbitration and get none: the ~4200-cycle
	; window only exists at the top of vblank (this path is only reached with the
	; vblank flag CLEAR), so $4212 bit0 reads 0 when ss_input samples it and the pad
	; is taken from the settled $4218 -- or from the stub's manual $4016 read when
	; auto-joypad is off.  The bounded wait in ss_input is therefore unreachable
	; from here, which matters: mid-frame the HDMA is fetching tables through the
	; open IS_PATCH window and the handler must stay short.
	rep #$20 : .al
	jmp savestate_start

save_write_table
	; Disable DMA
	.word $1000|$420B, $0000
	.word $1000|$420C, $0000
	; Turn PPU off
	.word $1000|$2100, $0080
	; temp
	.word $0000|$2116, $0000  ; VRAM address >> 1.
	.word $8000|$2139, $0000  ; VRAM dummy read.
	; Done
	.word $0000, save_return

load_write_table
	; Disable DMA
	.word $1000|$420B, $00
	.word $1000|$420C, $00
	; Turn PPU off
	.word $1000|$2100, $80
	; Single address, A bus -> B bus.  B address = reflector to WRAM ($2180).
	.word $0000|$4310, $8000  ; direction = A->B, B addr = $2180
	; Copy F00000-F0FFFF to WRAM 7E0000-7EFFFF.
	.word $0000|$4312, $0000  ; A addr = $xx0000
	.word $0000|$4314, $00F0  ; A addr = $F0xxxx, size = $xx00
	.word $0000|$4316, $0000  ; size = $00xx ($0000), unused bank reg = $00.
	.word $0000|$2181, $0000  ; WRAM addr = $xx0000
	.word $1000|$2183, $00    ; WRAM addr = $7Exxxx  (bank is relative to $7E)
	.word $1000|$420B, $02    ; Trigger DMA on channel 1
	; Copy F10000-F1FFFF to WRAM 7F0000-7FFFFF.
	.word $0000|$4312, $0000  ; A addr = $xx0000
	.word $0000|$4314, $00F1  ; A addr = $F1xxxx, size = $xx00
	.word $0000|$4316, $0000  ; size = $00xx ($0000), unused bank reg = $00.
	.word $0000|$2181, $0000  ; WRAM addr = $xx0000
	.word $1000|$2183, $01    ; WRAM addr = $7Fxxxx  (bank is relative to $7E)
	.word $1000|$420B, $02    ; Trigger DMA on channel 1
	; Address pair, A bus -> B bus.  B address = VRAM write ($2118).
	.word $0000|$4310, $1801  ; direction = A->B, B addr = $2118
	.word $1000|$2115, $80    ; VRAM address increment mode.
	; Copy F20000-F2FFFF to VRAM 0000-FFFF.
	.word $0000|$2116, $0000  ; VRAM address >> 1.
	.word $0000|$4312, $0000  ; A addr = $xx0000
	.word $0000|$4314, $00F2  ; A addr = $F2xxxx, size = $xx00
	.word $0000|$4316, $0000  ; size = $00xx ($0000), unused bank reg = $00.
	.word $1000|$420B, $02    ; Trigger DMA on channel 1
	; TODO: add audio
	; Copy F40000-F401FF to CGRAM 000-1FF.
	.word $1000|$2121, $00    ; CGRAM address
	.word $0000|$4310, $2200  ; direction = A->B, byte reg, B addr = $2122
	.word $0000|$4312, $0000  ; A addr = $xx0000
	.word $0000|$4314, $00F4  ; A addr = $F4xxxx, size = $xx00
	.word $0000|$4316, $0002  ; size = $02xx ($0200), unused bank reg = $00.
	.word $1000|$420B, $02    ; Trigger DMA on channel 1
	; Copy F40200-F4041F to OAM 000-21F.
	.word $0000|$2102, $0000  ; OAM address
	.word $0000|$4310, $0400  ; direction = A->B, byte reg, B addr = $2104
	.word $0000|$4312, $0200  ; A addr = $xx0200
	.word $0000|$4314, $20F4  ; A addr = $F4xxxx, size = $xx20
	.word $0000|$4316, $0002  ; size = $02xx ($0220), unused bank reg = $00.
	.word $1000|$420B, $02    ; Trigger DMA on channel 1
	; Done
	.word $0000, load_return

; general register restore
register_restore_return
	sep #$20 : .as
	rep #$10 : .xl

; restore $21XX
	ldx #$0002
	ldy #$0001

-	cpy #$0002 : beq +
	cpy #$0003 : beq +
	cpy #$0004 : beq +
	cpy #$0018 : beq +
	cpy #$0019 : beq +
	cpy #$0022 : beq +

	lda @SRAM_PPU_BANK, x : sta $2100, y : inx
	lda @SRAM_PPU_BANK, x : sta $2100, y : dex

+	inx : inx
	iny
	cpy #$0034
	beq +
	bra -

; restore $420X
+	ldx #$0001

-	cpx #$0001 : beq +
	cpx #$000B : beq +
	cpx #$000C : beq +
	lda @SRAM_OTH_BANK, x
	sta $4200, x

+	inx
	cpx #$000E
	bne -
	
	rep #$30 : .al : .xl
	ply
	plx
	pla
	pld
	plb

	sep #$20 : .as

return_align
	; align back with the NMI/IRQ
; TODO persistent entry flag ("entered hook via NMI or IRQ when saving the state?")
;      when saving state, then restore when loading and align with correct
;      type of interrupt when resuming game.
	lda @BRAM_RETURN_VECTOR ; HACK read back FPGA injected return vector low byte
	cmp #$EA  ; entered via NMI?
	beq return_enable_nmi
return_enable_irq
	; Direct resume for IRQ entries -- no CLI, no nested re-entry wait.  In
	; RPC-IRQ scenes (SMRPG field: the frame tick IS the SA-1->S-CPU RPC IRQ,
	; SFR bit7 pending on every entry) the CLI+wait protocol parks forever:
	; the redirect never re-fires with the buttons released (seen in hardware,
	; crumb $A3 with CS_STATE stuck at 1).  It is also unnecessary here: we
	; entered at the IRQ vector fetch, so the game's original interrupt context
	; is still on the stack and the level IRQ is still pending; exiting through
	; the hook stub jumps to the game's real IRQ vector with I still set -- the
	; game ISR runs, serves the RPC, and RTIs into the resumed mainline.
	lda @$004211 ; ack any pending PPU timer IRQ (cart IRQ is level, unaffected)
	lda #$31     ; mask off NMI enable
	and @SRAM_OTH_BANK
	sta @$4200
	lda #$02     ; post-save/load cooldown: ss_start_skip drains 2..15,0
	sta @CS_STATE
	; release the SA-1/GSU halt NOW (mirrors the post-wait block below)
	lda @SS_SA1_GATE
	beq +
	lda #$00
	sta @SS_SA1_WINDOW|$07FF
+	lda @SS_GSU_GATE
	beq +
	lda #$00
	sta @SS_GSU_WINDOW|$00FE
+	jsl @ss_cx4_release                ; CX4: released at the SAME point -- it was
	.as : .xl                          ; kept frozen through the whole save/load
	; reset picture + re-enable the game's interrupt mask (field games keep
	; NMI off in $4200, so no spurious NMI can fire before the ISR runs)
	lda @SRAM_PPU_BANK
	sta @$2100
	lda @SRAM_OTH_BANK
	sta @$4200
	; Re-arm HDMA with the pre-freeze $420C (captured before the disable).
	; NMI-scene games rewrite $420C every frame so the wait path never needed
	; this, but SMRPG's field only arms HDMA on scene events -- its window
	; shapes are HDMA-driven per scanline, and the register restore leaves
	; $2126/$2127 at the last-scanline value (empty inverted window = whole
	; screen masked): without re-arming, the picture stays BLACK until the
	; next scene re-init even though the game runs fine underneath.
	lda @SRAM_OTH_BANK|$C
	sta @$00420C
	jmp ss_exit
return_enable_nmi
	lda @$004210 ; ack NMI
	lda #$81     ; mask off IRQ enables
	and @SRAM_OTH_BANK ; stored $4200 flags
	; The wait below is fed by the NEXT NMI, so the NMI enable is NOT optional for
	; the duration of that wait -- and SRAM_OTH_BANK is the $4200 of the state being
	; RESTORED, not of the scene we were called from.  On a cross-scene load (state
	; taken where the game ran on IRQ with NMI off, e.g. a Super Mario RPG field
	; scene, replayed from an NMI entry such as the title/map/menu) the mask above
	; comes back with bit7 CLEAR, no NMI can ever fire, the nested entry that bumps
	; CS_STATE to 2 never arrives and the handler parks in return_wait_irq forever
	; with the PPU still force-blanked: black screen, CS_STATE stuck at 1, only
	; MENU_RESET recovers.  Force the bit while we wait; the untouched saved value
	; is written back below, before the game gets control, so the mask the game sees is
	; unchanged either way.  When the saved mask already has NMI on -- every
	; same-scene load, i.e. everything validated so far -- this is a no-op.
	;   The NMI it lets through never reaches the game: the FPGA redirects it into
	; this handler, which takes the CS_STATE==1 arm (ss_irq_inc) and RTIs straight
	; back into the loop below.
	ora #$80
	sta @$4200
return_wait_irq:
	; BOUNDED wait for the nested entry that bumps CS_STATE to 2.  It used to be an
	; unbounded spin on an event that only the FPGA can deliver (NMI redirected into
	; the hook AND branch1 routed to the savestate arm, which with the buttons long
	; released depends on savestate_force_entry still being latched in cheat.v), and
	; every way that delivery can fail turns into the same dead end: PPU force-blanked,
	; coprocessor still frozen, CS_STATE stuck at 1, MENU_RESET the only way out --
	; measured in hardware on SMRPG/SA-1.  The re-entry is at most one frame away when
	; the protocol is working, so ~65535 iterations (~0.25 s, 15 NTSC frames) is more
	; than an order of magnitude of margin and can never fire on a healthy resume.
	;   X still belongs to the GAME here (register_restore_return pulled it), hence the
	; push/pull around the loop; the nested entry touches neither X nor Y, so it is
	; safe to hold the counter across it.  A stays 8-bit throughout, which is what the
	; release block below expects.
	phx
	ldx #$ffff
ss_wait_loop:
	lda @CS_STATE
	cmp #$2
	beq ss_wait_done
	dex
	bne ss_wait_loop
	; Timed out.  ss_wait_bail ($C1) disarms interrupts, lands on the next vblank
	; edge so the game ISR still starts at the top of a frame, acks the NMI it just
	; armed past and forces CS_STATE to the post-resume cooldown -- WITHOUT that last
	; part the next hook entry would take ss_irq_inc outside a nested interrupt, strip
	; 9 bytes off the stack and RTI into hyperspace.  Then we fall into the SAME
	; release/restore tail as the successful path, so the worst case is one frame
	; resumed a little late instead of a hung console.  It also leaves a breadcrumb in
	; SS_DIAG_REJECT+1 saying the wait died and whether the restored $4200 had NMI on.
	jsl @ss_wait_bail
	.as : .xl
ss_wait_done:
	plx

	; SA-1: release the halt only NOW, at the real game resume, so the SA-1
	; wakes in lockstep with the SNES from the captured/restored state (it was
	; kept frozen through the whole save/load -- see the capture block note).
	lda @SS_SA1_GATE
	beq +
	lda #$00
	sta @SS_SA1_WINDOW|$07FF
+	lda @SS_GSU_GATE
	beq +
	lda #$00
	sta @SS_GSU_WINDOW|$00FE
+	jsl @ss_cx4_release                ; CX4: released at the SAME point -- it was
	.as : .xl                          ; kept frozen through the whole save/load

	; reset picture
	lda @SRAM_PPU_BANK
	sta @$2100

	; re-enable all interrupts
	lda @SRAM_OTH_BANK
	sta @$4200
	; Re-arm HDMA with the pre-freeze $420C, exactly like the direct-IRQ resume above.
	; The save/load write tables cleared $420C and register_restore_return deliberately
	; skips it, so until now the NMI resume path handed the game back with HDMA OFF and
	; relied on the scene rewriting $420C on its next frame. NMI-driven scenes that do
	; rewrite it every frame never noticed (this is a no-op for them); a scene that arms
	; HDMA only on scene events comes back with the register file restored to the LAST
	; SCANLINE values its HDMA had left ($2126/$2127 = an empty inverted window with
	; $212E set) and no HDMA to move them again -- the whole screen stays masked, i.e. a
	; BLACK picture with the game running fine underneath. That is the same failure the
	; IRQ path was fixed for in SMRPG field scenes; the NMI path kept the old commented
	; -out stub. We are a few cycles into vblank here (the nested entry that bumped
	; CS_STATE to 2 can only have been the NMI -- the IRQ enables were masked off above),
	; which is the safe edge to arm $420C: arming mid-frame would run the rest of the
	; frame off the game's STALE A2A, and the channel files were already restored by
	; load_dma_regs_start / the save path snapshot.
	lda @SRAM_OTH_BANK|$C
	sta @$00420C

; Code to run before returning back to the game
ss_exit
	rep #$30 : .al : .xl : pla : plp
	rtl ; go back to in-game hook

; Cross-bank trampoline for the cheat overlay ($C1). genfonts (main.a65) lives in
; this $C0 page and ends in rts, so it can't be reached with jsl directly from $C1.
; The overlay does `jsl ovl_call_genfonts`; we run genfonts same-bank (jsr) so its
; rts returns here, then rtl back to $C1. DBR is set by the caller and left intact.
ovl_call_genfonts:
	jsr genfonts
	rtl

; SMC (Self Modifying Code) to init on first pass
ss_init
	rep #$30 : .al : .xl
	pha
	phx
	phy

	lda #ss_start
	sta @savestate_start+1

	rep #$20 : .al
	; save/load state machine.  16-bit store on purpose: ss_start reads CS_STATE as a
	; WORD (one 6-cycle access instead of sep + 8-bit load + rep on the path every
	; held-button frame walks), so the unallocated byte above it must be zero.  The
	; firmware only clears the low byte ($FE100C, savestate.c), and this runs before
	; any word read of it -- savestate_start reaches ss_init first on every game load.
	lda #$0000
	sta @CS_STATE

; removed game specific controller RAM location injection here:
; 1. with IRQ support it now works OOTB without specific workarounds
; 2. should a workaround be required it will be prepared by firmware before runtime

	sta @CS_SAVE_REQ
	; Clear the combo probe's edge state on first handler entry of this game load.
	; These live in PSRAM and survive menu resets/game reloads; a stale CUR equal to
	; the overlay-opening combo makes the edge check see "already held" and randomly
	; swallow the combo (mirrors the same clear on overlay exit in cheatoverlay.a65).
	sta @CS_INPUT_CUR
	sta @CS_INPUT_PREV
	; Clear both diagnostic counters (16-bit store covers the pair). PSRAM survives
	; resets, so without this they would carry over from the previous game.
	sta @SS_DIAG_REJECT
	; Same for the two pad breadcrumbs the partial-sample gate keeps (one word each,
	; adjacent, so two stores cover both): a value left over from the previous game
	; would read as evidence about this one.
	sta @SS_DIAG_WHOLE
	sta @SS_DIAG_PARTIAL
	; And for the throttle counter of the bounded fill wait (word store; the high
	; byte has to be zero because ss_input reads and masks the pair 16-bit).
	sta @SS_FILL_TICK

; --- Build the hot-path mask and arm the in-game menu combo ------------------
; One bit that EVERY armed gesture requires, OR'd together, patched straight into
; the immediate operand of the fast reject.  Lives in $C1 (savestate_cx4.a65, the
; same annex the CX4 routines use) because it is init-time only and the $C0 page
; is the scarce one; this call site is 4 bytes.
;   The builder also resolves the menu combo and returns it in X (it needs the combo for the
; mask anyway, and resolving in the annex keeps ~20 bytes of $C0 free).  All three +1 addends
; are same-object stores, done here for that reason.
	jsl @ss_hot_mask_build
	.al : .xl
	sta @ss_hot_mask+1           ; A = fast-reject mask
	txa                          ; X = the resolved combo
	sta @ss_ovl_mask_cur+1       ; probe: is every combo bit held THIS frame?
	sta @ss_ovl_mask_prev+1      ; probe: was it NOT already held last frame? (edge)

	ply
	plx
	pla

ss_start:
	; A/X/Y are 16 bits wide here.  Nothing on this path carries flags any more:
	; ss_input samples $4212 itself, so the cmp #$01 below and the cooldown branch
	; are free to clobber the carry (they always did -- the gate simply used to
	; believe them).
	; CS_STATE is read as a WORD (ss_init keeps the byte above it zero): one 6-cycle
	; access instead of sep + 8-bit load + rep, on the path every held-button frame
	; walks.  It has to stay AHEAD of the fast reject below: a savestate in flight
	; resumes through the nested entry that bumps CS_STATE, and that entry arrives
	; with the buttons RELEASED (forced by the FPGA), which the reject would drop;
	; and the post-save cooldown only drains on entries that get here.
	lda @CS_STATE
	beq ss_input
	sep #$20 : .as
	cmp #$01
	bne ss_start_skip

	; THIS PART (ss_irq_inc) MUST NEVER BE REACHED OUTSIDE A NESTED NMI/IRQ!
	; It expects to RTI to the calling handler, NEVER to the game!
ss_irq_inc:
	;signal flag
	lda @CS_STATE
	inc
	sta @CS_STATE

	; remove 9 bytes from stack to return from this nested NMI/IRQ
	; and rti to wait loop in function register_restore_return
	; 3 from 'pha : php'             in savestate_handler
	; 3 from 'jsl savestate_handler' in nmihook
	; 3 from 'pha : php'             in nmihook
	; this puts us back in the wait loop for CS_STATE to become #$02
	; after load/save.
	; the fpga needs to be careful and not treat the nested NMI as an exit.
	rep #$21 : .al ; and clear carry
	tsc
	adc #$0009
	tcs
	sep #$20 : .as
	lda @$4210 ; load $4210 and $4211 to ack NMI+IRQ
	lda @$4211
	; TODO this isn't optimal because the nested IRQ architecture makes it
	;      impossible to align with IRQ without altering the IRQ pending flag
	;      in $4211. ISRs that depend on the $4211 result will have altered
	;      behaviour. Ideally get rid of the nested interrupts entirely
	;      and wait for IRQ+NMI by WAI+polling the VBlank flag respectively.
ss_rti
	rti
	
ss_start_skip
	inc
	; skip 16 additional frames after last save to avoid blowing out the stack on nested handlers
	; FIXME: get controls working where we don't repeat when holding buttons
	and #$0F
	sta @CS_STATE
	rep #$30 : .al : .xl

; input handling
ss_input:
	;%cgram()
; --- Take a COMPLETE pad for this entry -------------------------------------
; This runs BEFORE the fast reject on purpose, and that ordering is the whole
; point: the reject tests one bit that every armed gesture requires, and a pad
; sampled inside the auto-joypad fill has been SHIFTED RIGHT past that bit.
; Yoshi's Island mid-level measures X+R ($0050) as $0050>>6 = $0001 -- no X, no L,
; no Select -- so with the gate placed after the reject the frame died at the
; reject and the gate never ran at all (hardware: SS_DIAG_PARTIAL stayed $0000
; while every gesture and the overlay combo were dead).  Nothing downstream may
; see a value that has not passed this block.
;   $4212 bit0 = the auto-joypad shift register is filling RIGHT NOW.  Read here,
; two instructions before the register it describes, rather than inherited from
; the handler entry: see the banner up there for why the carry was not a usable
; channel.  A is 16 bits, so the load also picks up $4213 in the high byte; the
; lsr shifts it out of the way and it is discarded with A on the next load.
	lda @$004212
	lsr                          ; C = the auto-joypad window is running now
	bcs ss_pad_filling
; Window NOT running: $4218 holds a COMPLETE pad this instant -- either the fill
; has not opened yet (and it is last frame's settled read) or it has already
; closed (and it is this frame's).  Both are usable, and taking the live register
; is what makes a punctual entry and a very late one behave the same.
;   Auto-joypad OFF is the exception: bit0 never sets, $4218 is a stale leftover
; and the stub's manual $4016 read in NMI_PAD is the only truth, so the live $4200
; shadow decides ($F90700, the same read save_state uses to preserve the
; auto-joypad bit while it masks off NMI/IRQ).
	lda @$F90700                 ; A is 16-bit here: $F90700/01 = $4200/$4201 shadow
	and #$0001
	beq ss_pad_from_stub
	lda @$004218
	bra ss_pad_have
ss_pad_from_stub:
	lda @NMI_PAD
	bra ss_pad_have
ss_pad_filling:
; Window RUNNING: $4218 is unusable and the only candidate is the stub's sample
; from ~80 cycles ago.  It is complete exactly when it PREDATES the fill, and that
; is decidable without waiting for anything: a sample taken inside THIS fill can
; only have grown since ($4218_now = A<<d | new bits, d >= 1 because ~80 cycles is
; longer than the ~44-cycle bit period), so A < $4218_now PROVES the stub read
; inside the fill, and A >= $4218_now means it predates it -- the healthy case
; every working combo has always run on, since the register only holds a couple of
; top bits at this point while a complete pad with any button held is >= $0010.
;   Accepting the A == $4218_now tie as "predates" is deliberate: on the first
; frame of a press the previous pad is $0000 and the young fill reads $0000 too,
; and treating that as complete costs one frame of latency on a gesture the user
; is holding, while spinning on it would tax every button press in a punctual game
; (the fighting-game case that must never pay anything here).
	lda @NMI_PAD
	cmp @$004218
	bcs ss_pad_have
; --- Proven mid-fill sample: finish the read instead of losing the frame -----
; This is the state Yoshi's Island sits in permanently once a level is populated:
; its VRAM DMA queue runs in a V=216 IRQ that overruns the top of vblank by the
; same amount every frame, so the stub always lands ~10 bits into the fill and a
; complete sample never happens.  Dropping the frame (what this code did before)
; is therefore not "wait for a better frame", it is "never again": save, load and
; the overlay combo were all dead mid-level while working at level start.
;   The fill ends at a FIXED point in the frame (~830 CPU cycles into vblank), so
; waiting it out does not add a variable delay -- it moves the handler's return to
; an absolute instant less than four scanlines into a 38-line vblank, and only for
; entries that were ALREADY inside the window, i.e. already late.  A punctual
; entry never reaches this code at all (its sample predates the fill), which is
; what keeps the tight-vblank games that the old 219-cycle hot path used to shake
; at exactly the cost they have today.
;   Two bounds keep the worst case small:
;   - SS_FILL_SPIN iterations (~15 cycles each) cap one wait at ~300 cycles, about
;     7 bit periods.  Yoshi's Island needs ~4 (measured: 6 bits missing at the stub
;     read, ~1.5 of them arriving before this point).  A wait that blows the cap
;     drops the frame exactly as before, so the cap can only ever cost time, never
;     correctness.
;   - the wait runs at most once every SS_FILL_MASK+1 entries.  The reject cannot
;     be consulted first (a shifted pad has no mask bit -- that is the bug this
;     block exists to fix), so there is no way to know whether a gesture is under
;     the shifted value; the throttle bounds the cost instead of guessing.  A
;     gesture is HELD, and one complete sample is all the matcher needs since the
;     two-frame rule is gone, so sampling one entry in four costs at most ~67ms of
;     latency and divides the added cost by four.
	sta @SS_DIAG_PARTIAL         ; breadcrumb: the shifted value we could not use
	lda @SS_FILL_TICK            ; 16-bit: the high byte stays 0 through the and
	inc
	and #SS_FILL_MASK
	sta @SS_FILL_TICK
	bne ss_pad_drop
	phx                          ; X belongs to the game; borrow it through the stack
	ldx #SS_FILL_SPIN
ss_fill_wait:
	lda @$004212
	lsr
	bcc ss_fill_done
	dex
	bne ss_fill_wait
	plx                          ; capped out: the fill had further to go than we
	                             ; are willing to wait -- drop the frame as before
ss_pad_drop:
	lda @NMI_PAD                 ; deliberate reload (A was clobbered above): CUR
	sta @CS_INPUT_CUR            ; must NOT be written before ss_hot_full, or PREV
	                             ; inherits the shifted value and the overlay edge
	                             ; check degenerates into auto-repeat
	pla                          ; same tail as the fast reject below
	plp
	rtl
ss_fill_done:
	plx
	lda @$004218                 ; the pad the hardware has just finished assembling
ss_pad_have:
; --- Fast reject: the pad cannot complete ANY armed gesture ------------------
; The FPGA calls this handler on EVERY interrupt with ANY button held, so in a
; game where something is pressed most frames (a fighting game, a platformer with
; run held) everything below is added to the game's NMI latency 60 times a second.
; A game whose vblank DMA queue already ends near the end of vblank then pushes
; its tail into active display and the picture jitters -- so the common case has
; to be cheap.  ss_init pre-computed one bit that every armed gesture REQUIRES;
; if the pad carries none of them nothing below can fire, and the frame costs
; ~80 cycles instead of ~219.
;   BIT #imm is used rather than AND so the pad survives in A for the store.
;   CS_INPUT_CUR is still written, so a rejected frame is remembered honestly: it
; becomes PREV on the next frame that gets past this test, which is what makes the
; overlay combo edge-triggered (a frame that carried no mask bit certainly did not
; carry the overlay combo either).  CS_INPUT_PREV is NOT shifted here on purpose --
; it only ever has to hold the frame before a frame that reaches the matcher, and
; that frame does the shift itself (below) from the CUR this path keeps up to date.
;   The pad this path records is a COMPLETE controller read: the block above
; guarantees it, and it has to, because a shifted sample loses exactly the mask
; bits this test looks for.
; NOTE: the programmable trigger (CS_SAVE_REQ, below) is dead code today (its only
; writer is cleared by ss_init before it can ever be seen), but if it is ever
; revived it sits BEHIND this reject: a pad carrying no mask bit will never reach
; it. Re-arming it means adding its own bit to the mask builder.
ss_hot_mask:
	bit #$FFFF                   ; operand patched per game load by ss_init
	bne ss_hot_full
	sta @CS_INPUT_CUR
	pla                          ; same tail as ss_exit; A/X/Y are already 16-bit,
	plp                          ; so its rep #$30 would be dead weight
	rtl
ss_hot_full:
	sta @SS_DIAG_WHOLE           ; breadcrumb: the last COMPLETE pad that carried a
	                             ; mask bit, i.e. the last value the matcher was
	                             ; allowed to see.  Reading it after a failed combo
	                             ; attempt says whether a complete pad carrying the
	                             ; gesture ever reached this point in that scene.
	                             ; Its counterpart SS_DIAG_PARTIAL is written in
	                             ; ss_input, upstream of the reject, because a
	                             ; shifted sample cannot get this far.
	; Shift the history and publish ~pad in CS_PAD_INV: every "are all bits of MASK
	; held" test below is then one AND against the mask with a zero result, which is
	; an instruction shorter and 6 cycles cheaper than the old load/and/cmp triple.
	sta @CS_PAD_INV
	lda @CS_INPUT_CUR
	sta @CS_INPUT_PREV
	lda @CS_PAD_INV
	sta @CS_INPUT_CUR
	eor #$FFFF
	sta @CS_PAD_INV

; --- In-game menu entry: software combo -> ss_overlay. ------------------------
;     The in-game savestate handler runs every frame; we detect the combo here
;     (edge-detected via CUR vs PREV, fires once per press) and jump into the
;     overlay. The accumulator is 16-bit here; MASKED match so extra held bits are
;     ignored.
;     The mask is the ARMED combo (config.yml: IngameButtonsMenu), patched into both
;     operands by ss_init. The default $4230 = L+R+Y+Left carries Y, which no reserved
;     gesture uses; a custom combo gets that property from cfg_check_menu_combo(). ---
	lda @CS_PAD_INV              ; ~pad: zero after the AND means every bit is held
ss_ovl_mask_cur:
	and #$4230                   ; ARMED combo; operand patched per game load by ss_init
	bne ss_probe_done
	lda @CS_INPUT_PREV
	eor #$FFFF
ss_ovl_mask_prev:
	and #$4230                   ; same operand, patched by ss_init (edge: NOT held last frame)
	beq ss_probe_done
	; Gated: the firmware arms CHEAT_OVL_GATE at game load to CFG.enable_cheat_overlay
	; (src/cheat.c). The real per-core gate is in savestate.c (core_has_snapshot):
	; without a supported core this handler is never installed, so by the time this
	; probe runs the overlay works on base/DSP/SA-1/OBC1/S-DD1/CX4/GSU -- only
	; SPC7110 and SGB lack the machinery. 0 -> don't open (user toggled it off in
	; In-game hook). Acc is 16-bit here and the flag is a byte, so mask the low
	; byte before testing.
	lda @CHEAT_OVL_GATE
	and #$00FF
	beq ss_probe_done
	; Scene gate: this hook also fires when the game frame loop is NOT running
	; (Super Mario RPG parks the S-CPU mid-RPC across a scene transition and runs a
	; stub vblank handler); opening the overlay there hangs the game on resume.
	; SS_SCENE_GATE is armed per game by the firmware (savestate.c), so a game that
	; does not need it pays one load and a branch and never touches the bus below.
	; When armed, bit0 of SS_SCENE_FRESH is the FPGA liveness bit (cheat.v): the
	; S-CPU wrote the pad to SA-1 IRAM $3010/$3011 or polled $4218/$4219 within the
	; last ~49-73ms, with hook-window traffic excluded so the stub reading $4218 at
	; nmihook.a65:9 cannot re-arm it.
	;   STALE-CORE DISCRIMINANT (same shape as ss_sa1_probe_halt below): the firmware
	; arms the gate from the ROM checksum, which says nothing about the fpga_sa1 on
	; the CARD implementing the $F90720 serve -- and updating only firmware+menu is
	; the common habit. On an old core $F90720 is plain PSRAM inside the IS_PATCH
	; identity window, reads 0, and the gate would wedge the overlay shut forever
	; with no way to tell why. So WRITE $A5 first: the new core serves that address
	; READ-ONLY (7 zero bits + fresh, so $00 or $01, never $A5 -- the write still
	; lands in PSRAM, the mux arm only affects reads), an old core echoes it. Echo
	; => no serve => open exactly as before the feature existed.
	; The 16-bit store also puts $00 in $F90721; both
	; cells are dead (ctx.v shadows $42xx at $F90700+addr[8:0], so $F90720 would be
	; $4220, which no code writes, and the two $F90700 read loops stop at x<$10).
	; Acc is 16-bit here, so every load masks down to the byte/bit that matters.
	; NAMED labels are used deliberately: the anonymous +/- chain here must not shift.
	; (No apostrophes above on purpose -- cpp reads one as an unterminated char
	; literal and stops expanding macros until the next one; a swallowed
	; SS_SCENE_* would assemble as an undefined symbol.)
	lda @SS_SCENE_GATE
	and #$00FF
	beq ss_scene_ok                      ; 0 = this game does not need the gate
	lda #$00A5
	sta @SS_SCENE_FRESH                  ; inert on a real core (read-only serve)
	lda @SS_SCENE_FRESH
	and #$00FF
	cmp #$00A5
	beq ss_scene_ok                      ; echo -> stale core, no serve -> open as before
	and #$0001
	beq ss_probe_done                    ; stale scene -> do not open this frame
ss_scene_ok:
	jmp @ss_overlay                      ; overlay lives in $C1 (cheatoverlay.a65); @ forces long jump cross-bank
ss_probe_done:

	; Overlay-only mode: when in-game savestates are OFF the firmware still installs this
	; handler (so the cheat-overlay probe above can run) but sets CS_CTRL=0.  In that case
	; skip ALL save/load/slot handling below -- the save/load inputs are unconfigured
	; ($0000) and would otherwise match every frame.  CS_CTRL != 0 = savestates active.
	sep #$20 : .as
	lda @CS_CTRL
	bne ss_actions_on
	rep #$30 : .al : .xl
	jmp ss_exit
ss_actions_on:
	.as                  ; reached via bne with A still 8-bit (sep above); keep snescom in sync
	lda @CS_SLOT
	rep #$30 : .al : .xl
	beq skipslot
	bpl checkslot
	jmp ss_exit

checkslot
; loadstate input check
	lda @CS_PAD_INV              ; ~pad
	and @CS_SLOT_INPUT
	bne skipslot
	; Pad-source validity (see the routine at the end of this file).  A rejected pad
	; drops the WHOLE frame, not just the slot: nothing read this frame can be
	; trusted.  Named label + jmp because the tail is far out of branch range; A/X/Y
	; are already 16-bit, which is what ss_exit expects.
	lda @CS_SLOT_INPUT
	jsr ss_pad_confirm
	bcs ss_slot_ok
	jmp ss_exit
ss_slot_ok:
	sep #$20 : .as
	lda @CS_INPUT_CUR+1
	bit #$08 : beq + : lda #$01 : bra loadslot
+	bit #$04 : beq + : lda #$03 : bra loadslot
+	bit #$02 : beq + : lda #$04 : bra loadslot
+	bit #$01 : beq skipslot : lda #$02
loadslot
	; load last savestate slot
	sta @MCU_PARAM
	ora #$80
	sta @CS_SLOT
	lda #CMD_LOADSTATE
	sta @MCU_CMD
skipslot
	rep #$30 : .al : .xl

; savestate input check
	lda @CS_PAD_INV              ; ~pad
	and @CS_SAVE_INPUT
	beq ss_match_save

; loadstate input check
	lda @CS_PAD_INV
	and @CS_LOAD_INPUT
	beq ss_match_load

	; check programmable trigger
	lda @CS_SAVE_REQ ; loads both
	beq save_state_jump_exit
	phx
	tax
	lda #$0000
	sta @CS_SAVE_REQ
	txa
	plx
	and #$00FF
	bne save_state
	jmp load_state

; Pad-matched save/load.  ONE frame is enough, on purpose: the pad that got here
; is a complete controller read (the partial-sample gate in ss_input either waited
; the fill out or dropped the frame), so the shifted-read forgeries the old
; two-frame rule existed to
; swallow -- Down+Right or A+L reading as X+R, X+A reading as X+L -- can no longer
; reach this point at all.  Requiring two frames on top of that was not extra
; safety, it was the bug: in a scene where the NMI is chronically late the complete
; samples are the RARE ones and never land back to back, so the rule rejected the
; genuine gesture forever (Yoshi's Island mid-level: five rejects, zero saves).
; ss_pad_confirm still runs as the second opinion for the window that is still
; filling when we look.
ss_match_save
	lda @CS_SAVE_INPUT
	jsr ss_pad_confirm
	bcs save_state
	bra save_state_jump_exit
ss_match_load
	lda @CS_LOAD_INPUT
	jsr ss_pad_confirm
	bcc save_state_jump_exit
	jmp load_state

save_state_jump_exit
	jmp ss_exit
	
save_state
	; check if this is SM
	rep #$20 : .al
	lda @$00FFDE
	cmp #$F8DF
	bne +
	; if SM, check return address and make sure it's not in the sound loading code $808059-$808110
	lda 10,s
	cmp #$8059
	bcc +
	cmp #$8111
	bcs +
	sep #$20 : .as
	bra save_state_jump_exit
	
+	sep #$20 : .as

	lda @CS_STATE
	bne save_state_jump_exit
	inc
	sta @CS_STATE

	; --- DSP1-4: freeze the DSP EARLY (aligned with the CPU cut at T) ---
	; The DSP free-runs on CLK2; if we only halt it later in save_return it
	; drifts to T+delta while the (frozen) SNES is still at T, desyncing the
	; CPU<->DSP handshake on resume -> one bad HUD-tile DMA after load. Halting
	; here captures the DSP consistent with everything else. A is 8-bit here.
	; (save_return still reads the now-frozen window and unhalts.)
	lda @SS_DSP_GATE
	beq ss_dsp_early_done
	lda #$01
	sta @SS_DSP_WINDOW|$07FF
ss_dsp_early_done:

	; --- SA-1: freeze the coprocessor EARLY (aligned with the CPU cut at T) ---
	; The SA-1 CPU free-runs on CLK2; halting it here, at the same instant the
	; SNES CPU is cut, captures it consistent with the frozen SNES instead of
	; letting it drift to T+delta while we set up the copier. The FPGA freezes
	; it at an instruction boundary (or after a saturating timeout) so nothing
	; hangs. save_return reads the now-frozen window and unhalts. A is 8-bit.
	lda @SS_SA1_GATE
	beq ss_sa1_early_done
	; The gate only proves the FIRMWARE saw an SA-1 core; it cannot tell a core
	; that HAS the $E8 savestate window from an older fpga_sa1 that does not, so
	; the halt request itself lives inside ss_sa1_probe_halt (tail of this file):
	; it probes the window first and only then writes $E8:07FF.  A failed probe
	; zeroes the gate instead, and every later SA-1 touchpoint re-tests the gate,
	; so the whole save degrades to a plain no-SA-1-state one rather than halting
	; and capturing raw PSRAM.  No re-test needed here: nothing follows the call.
	; NOTE: no mid-RPC defer here.  In SMRPG's field scenes the frame tick IS
	; the SA-1->S-CPU RPC IRQ, so SFR bit7 is pending on EVERY hook entry --
	; a defer-and-retry can never find a clean entry and silently eats every
	; save/load (seen in hardware: probe matched, save never started).  Mid-RPC
	; freezing is safe: the entry is at the IRQ vector fetch (the game's ISR has
	; not run), the level IRQ stays pending across the freeze, and the direct
	; IRQ resume in return_align hands it to the game ISR on exit.
	jsr ss_sa1_probe_halt
ss_sa1_early_done:
	; --- GSU: request the savestate halt EARLY.  The FPGA lets a mid-program
	; GSU run to completion (GO -> 0) before freezing, so requesting here gives
	; it the whole capture phase to converge; save_return waits on the ack.
	lda @SS_GSU_GATE
	beq ss_gsu_early_done
	lda #$01
	sta @SS_GSU_WINDOW|$00FE
ss_gsu_early_done:
	; --- CX4: request the savestate halt EARLY too.  The FPGA runs the CX4 CPU
	; to its next clean boundary (run-to-stop) before reporting frozen, so asking
	; here gives it the whole capture phase to converge; ss_cx4_capture waits on
	; the ack.  The routine lives in $C1 (savestate_cx4.a65) and preserves P.
	jsl @ss_cx4_early
	.as : .xl
	lda #$00
	sta @CS_SA1_LOAD                   ; SAVE path: the shared restore block is a no-op

	; disable interrupts
	lda @$F90700|$0000
	sta @SRAM_OTH_BANK
	and #$01
	sta @$004200
	
	phb
	phd
	rep #$30 : .al : .xl
	pha
	phx
	phy
	
	sep #$20 : .as
	; wait until release save input
	;--
	;- bit $4212 : bpl -
	;- bit $4212 : bmi -
	;lda @$4219
	;and @CS_INPUT_CUR
	;cmp @CS_INPUT_CUR
	;beq --
	
	; disable DMA
	lda @$F90700|$000C
	sta @SRAM_OTH_BANK|$C
	lda #$00
	sta @$00420B
	sta @$00420C
	
	; save $21XX
	sep #$20 : .as
	ldy #$0000
	tyx

-	lda @$F90500|$0000, x : sta @SRAM_PPU_BANK, x : inx
	lda @$F90500|$0000, x : sta @SRAM_PPU_BANK, x : inx
	iny
	cpy #$0040
	bne -
	 
	; save $420X
	sep #$20 : .as
	ldx #$0001  

-	lda @$F90700|$0000, x
	sta @SRAM_OTH_BANK, x
ss_skip420c
	inx
	cpx #$000C
	beq ss_skip420c
	cpx #$0010
	bne -
	
	; save DMA registers
	sep #$20 : .as
	ldy #$0000
	tyx
	
-	lda @$004300, x
	sta SRAM_DMA_BANK, x
	inx
	iny
	cpy #$000B
	bne -
	cpx #$007B
	beq +
	inx : inx : inx : inx : inx
	ldy #$0000
	bra -
	
+	rep #$30 : .al : .xl
	ldy #save_write_table

	; run the unified VM. This covers save/load and all ROM mode types
run_vm
	pea SS_BANK
	plb
	plb
	jmp vm
	
save_return
	rep #$30 : .al : .xl

	; copy region -- WRAM mirrors F5-F6 -> state buffer F0-F1 only.  Split from
	; the original single F5..F9:04FF op: VRAM ($F2) and CGRAM ($F4:0000-01FF)
	; are captured by REAL $2139/$213B readback below instead (the ctx mirror
	; drops a fraction of PPU-port writes under heavy traffic -- measured 4k+
	; stale VRAM bytes on the DSP core, seen as garbled HUD/text tiles after a
	; load -- while readback is exact on every core), so no copier op may write
	; those buffer ranges after the readback.
	lda #$F5F0    ; srcBank:dstBank
	sta @$002020
	lda #$0000    ; srcOffset
	sta @$002022
	lda #$0000    ; dstOffset
	sta @$002024
	lda #$0000    ; length[15:0]
	sta @$002026
	sep #$20 : .as
	lda #$02  ; length[23:16] -> $020000 = WRAM mirrors only
	sta @$002028
	; opcode[4:0], loop, dir, enable
	lda #$05
	sta @$002029
	; second op: ARAM mirror F8 + CGRAM/OAM/reg shadows F9:0000-04FF -> F3 +
	; F4:0000-04FF (queues behind the first op; the copier trigger queue is one
	; deep).  It still copies the CGRAM mirror into F4:0000-01FF, but the CGRAM
	; readback below runs after the ~230ms VRAM readback, long after this op has
	; drained, and overwrites that range with exact data.
	rep #$20 : .al
	lda #$F8F3    ; srcBank:dstBank
	sta @$002020
	lda #$0000    ; srcOffset
	sta @$002022
	lda #$0000    ; dstOffset
	sta @$002024
	lda #$0500    ; length[15:0]
	sta @$002026
	sep #$20 : .as
	lda #$01  ; length[23:16] -> $010500
	sta @$002028
	lda #$05
	sta @$002029

	; --- DSP1-4 savestate capture -------------------------------------
	; Halt was requested early in save_state; the DSP now freezes at an IDLE
	; instruction boundary (or after the FPGA's 256-cycle timeout). Wait until
	; it reports frozen (ss_halted = $7FF bit0) before reading, so the cut is
	; at a clean CPU<->DSP transaction boundary. Then copy the data-RAM +
	; register-file window into PSRAM bank F3. A is 8-bit, X 16-bit here.
	; Bounded spin -> hang-proof.
	lda @SS_DSP_GATE
	beq ss_dsp_cap_done
	lda #$01
	sta @SS_DSP_WINDOW|$07FF        ; ensure halt requested
	ldx #$0000
ss_dsp_cap_wait:
	lda @SS_DSP_WINDOW|$07FF        ; bit0 = frozen
	and #$01
	bne ss_dsp_cap_go
	inx
	cpx #$2000
	bne ss_dsp_cap_wait
ss_dsp_cap_go:
	ldx #$0000
ss_dsp_cap_loop:
	lda @SS_DSP_WINDOW, x           ; $000-$1FF data RAM, $600-$6FF registers
	sta @SS_DSP_SCRATCH, x
	inx
	cpx #$0700
	bne ss_dsp_cap_loop
	lda #$00
	sta @SS_DSP_WINDOW|$07FF        ; release halt -> DSP resumes
ss_dsp_cap_done:
	; -------------------------------------------------------------------

	; --- VRAM + CGRAM: REAL readback via $2139/$213B -> F2 / F4:0000-01FF ---
	; Same proven sequence as the cheat overlay (snes/cheatoverlay.a65, see the
	; $2139 read-buffer semantics documented there).  We are in forced blank
	; (save_write_table wrote $2100=$80) with GP-DMA/HDMA off.  VMAIN/VMADD/
	; CGADD are clobbered here; the save resume path goes through
	; register_restore_return, which restores them from the register shadow
	; like every other PPU reg.  ~230ms; also the ordering barrier that lets
	; the second copier op above drain before CGRAM is overwritten.
	sep #$20 : .as
	lda #$80 : sta @$002115               ; VMAIN: word step after $213A read
	rep #$30 : .al : .xl
	lda #$0000 : sta @$002116             ; VMADD = 0
	lda @$002139                          ; dummy read (loads word 0, VMADD -> 1)
	ldx #$0000
ss_save_vramrb:
	lda @$002139                          ; 16-bit read = $2139+$213A (word)
	sta @$F20000, x                       ; VRAM -> state buffer
	inx : inx
	bne ss_save_vramrb                    ; 32768 words = full 64KB
	; CGRAM: real readback via $213B (512 bytes)
	sep #$20 : .as
	lda #$00 : sta @$002121               ; CGADD = 0
	ldx #$0000
ss_save_cgrb:
	lda @$00213B
	sta @$F40000, x
	inx
	cpx #$0200
	bne ss_save_cgrb
	; OAM: real readback via $2138 -> F4:0200 (544 bytes), same reason as VRAM/CGRAM.
	; The copier op above already staged the ctx OAM mirror into F4:0200-041F, but that
	; mirror drops a fraction of OAM writes under load (measured on VRAM; OAM shares the
	; snoop) -- seen as a garbled HUD sprite (SMK's lap counter) restored on top of the
	; position box.  Reading the live OAM back is exact.  OAMADD is clobbered here and
	; restored on resume by register_restore_return like every other PPU reg; $2138 has
	; no dummy-read quirk (unlike $2139).  The auto-increment walks the 512-byte low
	; table then the 32-byte high table = 544 bytes, mirroring the load-table write.
	lda #$00 : sta @$002102               ; OAMADDL = 0
	lda #$00 : sta @$002103               ; OAMADDH = 0 (word addr 0, no priority rotation)
	ldx #$0000
ss_save_oamrb:
	lda @$002138
	sta @$F40200, x
	inx
	cpx #$0220
	bne ss_save_oamrb

	; --- WRAM: ground-truth capture via CPU reads of $7E/$7F -> F0/F1 ---
	; The copier op above staged the ctx WRAM MIRROR (F5/F6), but that bus-snoop
	; mirror drops writes under load like the VRAM mirror did -- a corrupted WRAM
	; value the game reads after load makes it draw a garbled HUD tile (the box by
	; the position/timer that survived the VRAM/CGRAM/OAM readback fixes).  The SNES
	; reads its own WRAM directly ($7E/$7F, not intercepted by the cart), so overwrite
	; the state buffer with an exact copy.  Runs last, long after the copier op drained
	; during the ~230ms VRAM readback, so it wins.  Same SNES-writes-PSRAM-then-load-
	; DMA-reads-it path proven by the F2 VRAM readback (F0/F1 are in the IS_PATCH
	; identity window while the handler holds snescmd_unlock).  ~440ms (128 KB).
	rep #$30 : .al : .xl
	ldx #$0000
ss_save_wram_lo:
	lda @$7E0000, x
	sta @$F00000, x
	inx : inx
	bne ss_save_wram_lo                   ; 32768 words = 64KB ($7E0000-$7EFFFF -> F0)
	ldx #$0000
ss_save_wram_hi:
	lda @$7F0000, x
	sta @$F10000, x
	inx : inx
	bne ss_save_wram_hi                   ; 32768 words = 64KB ($7F0000-$7FFFFF -> F1)

	; --- SA-1 savestate capture ---------------------------------------
	; Halt was requested early in save_state; the SA-1 now freezes at an
	; instruction boundary (or after the FPGA's saturating timeout). Wait until
	; it reports frozen ($7FF bit0) before reading, so the cut is at a clean
	; boundary. Then snapshot the three memories into the F4 PSRAM scratch:
	;   IRAM   $00:3000-37FF (2 KB)   -> F4:7000
	;   BW-RAM $40:0000-7FFF (32 KB)  -> F4:8000
	;   window $E8:0000-00FF (256 B)  -> F4:7800  (committed regs + MMIO config)
	; IRAM/BW-RAM are read through the SNES bus (exact ground truth, same reason
	; as WRAM above -- SA-1 protection is not enforced against these reads while
	; frozen; BW-RAM is always read as the full 32 KB, SAVERAM_MASK mirroring
	; makes that safe for smaller carts). The F4 scratch is inside the F0-F4
	; state file so it is persisted for free. Bounded spin -> hang-proof.
	sep #$20 : .as
	lda @SS_SA1_GATE
	bne +                                  ; block > 127 bytes: short branch is out of range
	jmp ss_sa1_cap_done
+	lda #$01
	sta @SS_SA1_WINDOW|$07FF               ; ensure halt requested
	ldx #$0000
ss_sa1_cap_wait:
	lda @SS_SA1_WINDOW|$07FF               ; bit0 = frozen
	and #$01
	bne ss_sa1_cap_go
	inx
	cpx #$2000
	bne ss_sa1_cap_wait
ss_sa1_cap_go:
	; IRAM 2 KB, 16-bit words
	rep #$20 : .al
	ldx #$0000
ss_sa1_cap_iram:
	lda @$003000, x
	sta @SS_SA1_IRAM_SCRATCH, x
	inx : inx
	cpx #$0800
	bne ss_sa1_cap_iram
	; BW-RAM 32 KB, 16-bit words
	ldx #$0000
ss_sa1_cap_bwram:
	lda @$400000, x
	sta @SS_SA1_BWRAM_SCRATCH, x
	inx : inx
	cpx #$8000
	bne ss_sa1_cap_bwram
	; state block 256 B, 8-bit
	sep #$20 : .as
	ldx #$0000
ss_sa1_cap_regs:
	lda @SS_SA1_WINDOW, x
	sta @SS_SA1_REGS_SCRATCH, x
	inx
	cpx #$0100
	bne ss_sa1_cap_regs
	; NOTE: the SA-1 is intentionally left FROZEN here.  Releasing it now would
	; let it free-run (and drift/desync) while the SNES stays frozen through the
	; MCU save and the resume wait -- and its full-speed ROM fetches starve the
	; MCU of PSRAM slots (the .state write never completes; seen in hardware).
	; The release happens at the real game resume, after the CS_STATE==2 wait.
ss_sa1_cap_done:
	; --- GSU savestate capture (mk3) --------------------------------------
	; Halt was requested early; wait until the core reports frozen (window $FE
	; bit0 -- it lets an in-flight GSU program finish first, FPGA-side timeout
	; ~44ms), then snapshot: window state block (regs) -> F4:7800, instruction
	; cache image ($00:3100, live while frozen) -> F4:7000, cart RAM
	; ($70:0000, 32 KB) -> F4:8000.  All inside the persisted F0-F4 state.
	; Left FROZEN afterwards (release at the real game resume). Bounded spins.
	sep #$20 : .as
	lda @SS_GSU_GATE
	bne +                                  ; long block: short branch out of range
	jmp ss_gsu_cap_done
+	ldx #$0000
ss_gsu_cap_wait:
	lda @SS_GSU_WINDOW|$00FE               ; bit0 = frozen
	and #$01
	bne ss_gsu_cap_go
	inx
	cpx #$4000
	bne ss_gsu_cap_wait
ss_gsu_cap_go:
	; window state block 256 B, 8-bit
	ldx #$0000
ss_gsu_cap_regs:
	lda @SS_GSU_WINDOW, x
	sta @SS_GSU_REGS_SCRATCH, x
	inx
	cpx #$0100
	bne ss_gsu_cap_regs
	; instruction cache 512 B via the native $3100 image
	ldx #$0000
ss_gsu_cap_cache:
	lda @$003100, x
	sta @SS_GSU_CACHE_SCRATCH, x
	inx
	cpx #$0200
	bne ss_gsu_cap_cache
	; cart RAM 32 KB, 16-bit words
	rep #$20 : .al
	ldx #$0000
ss_gsu_cap_ram:
	lda @$700000, x
	sta @SS_GSU_RAM_SCRATCH, x
	inx : inx
	cpx #$8000
	bne ss_gsu_cap_ram
	sep #$20 : .as
ss_gsu_cap_done:
	; --- CX4 savestate capture (mk2/mk3) ---------------------------------
	; Halt was requested early; the routine waits for the freeze ack, normalizes
	; the core to a canonical boundary and snapshots data RAM / native page /
	; scan window into the F4 scratch.  Left FROZEN (release at the game resume).
	; Lives in $C1 (savestate_cx4.a65); enters and leaves in .as/.xl.
	jsl @ss_cx4_capture
	.as : .xl
	; --- S-DD1 savestate capture (mk2/mk3) -------------------------------
	; The S-DD1's SNES-visible state is the DMA-decompress config block at
	; $00:4800-$4807, read back through the register mux while the CPU is
	; frozen.  Snapshot the six bytes that carry state: $4800 (channel-enable
	; mask), $4801 (transfer-enable, encoded readback) and the four bank maps
	; $4804-$4807, into F4:7000.  $4802/$4803 have no state (read $00).  The
	; decompressor FSM is never mid-transfer at an NMI boundary (its GP-DMA is
	; atomic), so there is nothing else to capture.  8-bit reads, A already .as.
	lda @SS_SDD1_GATE
	beq ss_sdd1_cap_done                   ; short block: beq reaches
	lda @$004800
	sta @SS_SDD1_SCRATCH
	lda @$004801
	sta @SS_SDD1_SCRATCH+1
	lda @$004804
	sta @SS_SDD1_SCRATCH+2
	lda @$004805
	sta @SS_SDD1_SCRATCH+3
	lda @$004806
	sta @SS_SDD1_SCRATCH+4
	lda @$004807
	sta @SS_SDD1_SCRATCH+5
ss_sdd1_cap_done:
	; --- OBC1 savestate capture (mk2/mk3) --------------------------------
	; The OBC1 is purely reactive, so there is no FSM to halt: just snapshot
	; the whole SNES-visible window $00:7800-$7FFF (2 KB = obc_lower/obc_upper
	; mirror image + the 8 regs) into F4:7000.  16-bit word copy, no wait.
	; This is the state VISIBLE to the SNES, which is all that matters for
	; continuity (OBC1 reads have no side effects).
	lda @SS_OBC1_GATE
	beq ss_obc1_cap_done                   ; short block: beq reaches
	rep #$20 : .al
	ldx #$0000
ss_obc1_cap:
	lda @$007800, x
	sta @SS_OBC1_SCRATCH, x
	inx : inx
	cpx #$0800
	bne ss_obc1_cap
	.as                                    ; fall through: the rep below re-enters .al either way
ss_obc1_cap_done:
	; -------------------------------------------------------------------

	rep #$20 : .al
	tsc
	sta @SRAM_SAVED_SP
	
	;%cgram()
	
	sep #$20 : .as
	pea $0000
	plb
	plb

	; wait until release save input
saveinputloop
	- bit $4212 : bpl -
	- bit $4212 : bmi -
	lda @$4218
	and @CS_SAVE_INPUT
	cmp @CS_SAVE_INPUT
	beq saveinputloop
 
	; send cmd to write the state inside the sd
	lda @CS_SLOT
	bne +
	lda #$01
+	sta @MCU_PARAM
	; there is a race with saving twice and then changing the slot
	; before the second save writes to SD, but it seems unlikely to hit.
	; the following commented code protects against it, however, it
	; also delays the save->load time which users may not like
;	ora #$80
;	sta @CS_SLOT
	lda #CMD_SAVESTATE
	sta @MCU_CMD

	;rep #$20 : .al
	
	;lda $2B00|$004E
	;sta @SRAM_SAVED_40

	jmp audio_fix

load_state_jump_exit
	jmp ss_exit

load_state
	; check if this is SM
	rep #$20 : .al
	lda @$00FFDE
	cmp #$F8DF
	bne +
	; if SM, check return address and make sure it's not in the sound loading code $808159-$808110
	lda 10,s
	cmp #$8059
	bcc +
	cmp #$8111
	bcs +
	sep #$20 : .as
	bra load_state_jump_exit

+ sep #$20 : .as

	jsr ss_stage_slot                  ; carry set = abort (empty slot / MCU timeout)
	bcs load_state_jump_exit

	lda @CS_STATE
	bne load_state_jump_exit
	inc
	sta @CS_STATE

	; --- SA-1: freeze the coprocessor EARLY (aligned with the CPU cut) ---
	; Mirror save_state's early halt: park the SA-1 at a boundary before we tear
	; down interrupts/DMA so load_return can write the restored state into a
	; quiesced core. A is 8-bit here. (release happens after the restore in
	; load_return.)
	lda @SS_SA1_GATE
	beq ss_sa1_ld_early_done
	; No mid-RPC defer (see the save path note).  Same helper as the save path:
	; it probes the $E8 window and only then requests the halt; on a failed probe
	; it zeroes the gate instead and every later SA-1 touchpoint skips itself.
	jsr ss_sa1_probe_halt
ss_sa1_ld_early_done:
	; --- GSU: same early halt as the save path ---
	lda @SS_GSU_GATE
	beq ss_gsu_ld_early_done
	lda #$01
	sta @SS_GSU_WINDOW|$00FE
ss_gsu_ld_early_done:
	; --- CX4: same early halt as the save path ---
	jsl @ss_cx4_early
	.as : .xl
	lda #$01
	sta @CS_SA1_LOAD                   ; LOAD path: run the SA-1/GSU restore block

	; disable interrupts
	lda @$F90700|$0000
	and #$01
	sta @$4200
	
	phb
	phd
	rep #$30 : .al : .xl
	pha
	phx
	phy

	pea $0000
	plb
	plb

+	ldy #load_write_table
	jmp run_vm

load_return
	rep #$30 : .al : .xl
	lda @SRAM_SAVED_SP
	tcs
	
	pea $0000
	plb
	plb
	
	; wait delay frames
	sep #$20 : .as
	lda @CS_DELAY                  ; @: absolute would read game WRAM $00:100E
ss_frameloop
	- bit $4212 : bpl -
	- bit $4212 : bmi -
	dec
	bpl ss_frameloop

audio_fix
	jsl @CS_FIXES
	jmp load_dma_regs_start
	
load_dma_regs_start
	sep #$20 : .as
	ldx #$0000
	txy
	
-	lda @SRAM_DMA_BANK, x
	sta $4300, x
	inx
	iny
	cpy #$000B
	bne -
	cpx #$007B
	beq +
	inx : inx : inx : inx : inx
	ldy #$0000
	bra -
	
	; --- DSP1-4 savestate restore: halt -> wait frozen-at-boundary -> copy F3
	;     snapshot back into the $E8 scan window -> unhalt LAST. Writes data RAM
	;     ($000-$1FF, port B) + register file ($600-$6FF, write-demux). port-A
	;     RAM write is gated off while frozen so it can't race. A is 8-bit, X
	;     16-bit here. Unhalt only AFTER the last write or the core runs over the
	;     restored regs. Bounded spin -> hang-proof.
+	lda @SS_DSP_GATE
	beq ss_dsp_rst_done
	lda #$01
	sta @SS_DSP_WINDOW|$07FF        ; request halt
	ldx #$0000
ss_dsp_rst_wait:
	lda @SS_DSP_WINDOW|$07FF        ; bit0 = frozen
	and #$01
	bne ss_dsp_rst_go
	inx
	cpx #$2000
	bne ss_dsp_rst_wait
ss_dsp_rst_go:
	ldx #$0000
ss_dsp_rst_loop:
	lda @SS_DSP_SCRATCH, x          ; F4 scratch snapshot -> $E8 scan window
	sta @SS_DSP_WINDOW, x
	inx
	cpx #$0700
	bne ss_dsp_rst_loop
	lda #$00
	sta @SS_DSP_WINDOW|$07FF        ; release halt -> DSP resumes restored state
ss_dsp_rst_done:

	; --- SA-1 savestate restore: halt -> wait frozen-at-boundary -> write the
	;     F4 PSRAM snapshot back, then unhalt LAST. Order matters: BW-RAM and
	;     IRAM first, then the state block ASCENDING ($000-$0FF) so the $F0
	;     resume-shape/normalize byte lands near the end (it re-idles the SA-1
	;     FSMs for a clean refetch from the restored PC). Unhalt only after the
	;     last write or the core would run over the restored regs. A is 8-bit,
	;     X 16-bit at entry. Bounded spin -> hang-proof.
	sep #$20 : .as
	lda @SS_SA1_GATE
	bne +                           ; block > 127 bytes: short branch is out of range
	jmp ss_sa1_rst_done
	; SAVE path skip: the SA-1 stayed frozen from the capture on, so its state
	; never drifted -- rewriting it here would only risk a capture/restore
	; asymmetry corrupting a running game.  Only a LOAD needs the write-back.
+	lda @CS_SA1_LOAD
	bne +
	jmp ss_sa1_rst_done
	; Stale-scratch guard.  A .state written by a firmware/core that did NOT
	; capture the SA-1 (gate off, or the probe above rejected a stale fpga_sa1)
	; still carries whatever bytes happened to sit in the F4 scratch, and the
	; state file persists F0-F4 wholesale -- so loading that file AFTER the core
	; is updated would find the gate armed and write pure garbage into a real
	; SA-1.  A legitimate capture copies the whole window INCLUDING offset $FF,
	; which is the read-only $5A magic, so the snapshot carries its own proof of
	; provenance and the check costs nothing on valid states.
	;   On failure skip to ss_sa1_rst_done, and deliberately WITHOUT touching the
	; gate: the early halt was already requested back in load_state (the probe
	; passed, or we would not be past the gate test above), and the release in
	; return_align is gated on that same gate.  Zeroing it here would strand the
	; SA-1 frozen forever.  Leaving it set means the SA-1 resumes its own
	; pre-load state while WRAM/VRAM/regs were rolled back to the snapshot --
	; on an SA-1 title that mismatch likely misbehaves/corrupts the session, but
	; it never hangs and never writes junk INTO the SA-1, which is the point.
+
	lda @SS_SA1_REGS_SCRATCH+$FF    ; capture copied window $FF ($5A magic) here
	cmp #$5A
	beq +                           ; valid snapshot -> restore it
	jmp ss_sa1_rst_done             ; stale scratch -> leave the SA-1 alone
+
	lda #$01
	sta @SS_SA1_WINDOW|$07FF        ; request halt
	ldx #$0000
ss_sa1_rst_wait:
	lda @SS_SA1_WINDOW|$07FF        ; bit0 = frozen
	and #$01
	bne ss_sa1_rst_go
	inx
	cpx #$2000
	bne ss_sa1_rst_wait
ss_sa1_rst_go:
	; BW-RAM 32 KB, 16-bit words
	rep #$20 : .al
	ldx #$0000
ss_sa1_rst_bwram:
	lda @SS_SA1_BWRAM_SCRATCH, x
	sta @$400000, x
	inx : inx
	cpx #$8000
	bne ss_sa1_rst_bwram
	; IRAM 2 KB, 16-bit words
	ldx #$0000
ss_sa1_rst_iram:
	lda @SS_SA1_IRAM_SCRATCH, x
	sta @$003000, x
	inx : inx
	cpx #$0800
	bne ss_sa1_rst_iram
	; state block 256 B ascending, 8-bit ($F0 normalize lands near the end)
	sep #$20 : .as
	ldx #$0000
ss_sa1_rst_regs:
	lda @SS_SA1_REGS_SCRATCH, x
	sta @SS_SA1_WINDOW, x
	inx
	cpx #$0100
	bne ss_sa1_rst_regs
	; NOTE: intentionally left FROZEN (same reason as the capture path); the
	; release happens after the CS_STATE==2 resume wait, so the SA-1 resumes in
	; lockstep with the SNES from the restored state.
ss_sa1_rst_done:

	; --- GSU savestate restore (mk3): halt -> wait frozen -> write back the
	;     cache image ($3100) and cart RAM ($70:0000) first, then the window
	;     state block ASCENDING (native reg semantics for $00-$3F; the exact
	;     cache-valid mask at $44-$47 lands after the cache image's spurious
	;     line-valid side effects, and the $F0 normalize near the end re-idles
	;     the exe pipeline).  Left frozen; released at the game resume.
	sep #$20 : .as
	lda @SS_GSU_GATE
	bne +                           ; long block: short branch out of range
	jmp ss_gsu_rst_done
+	lda @CS_SA1_LOAD
	bne +
	jmp ss_gsu_rst_done             ; SAVE path: no write-back
+	lda #$01
	sta @SS_GSU_WINDOW|$00FE        ; ensure halt requested
	ldx #$0000
ss_gsu_rst_wait:
	lda @SS_GSU_WINDOW|$00FE        ; bit0 = frozen
	and #$01
	bne ss_gsu_rst_go
	inx
	cpx #$4000
	bne ss_gsu_rst_wait
ss_gsu_rst_go:
	; instruction cache 512 B
	ldx #$0000
ss_gsu_rst_cache:
	lda @SS_GSU_CACHE_SCRATCH, x
	sta @$003100, x
	inx
	cpx #$0200
	bne ss_gsu_rst_cache
	; cart RAM 32 KB, 16-bit words
	rep #$20 : .al
	ldx #$0000
ss_gsu_rst_ram:
	lda @SS_GSU_RAM_SCRATCH, x
	sta @$700000, x
	inx : inx
	cpx #$8000
	bne ss_gsu_rst_ram
	; window state block 256 B ascending, 8-bit
	sep #$20 : .as
	ldx #$0000
ss_gsu_rst_regs:
	lda @SS_GSU_REGS_SCRATCH, x
	sta @SS_GSU_WINDOW, x
	inx
	cpx #$0100
	bne ss_gsu_rst_regs
ss_gsu_rst_done:
	; --- CX4 savestate restore (mk2/mk3): halt -> wait frozen -> normalize ->
	;     cache replay / pagemem / DMA / data RAM / GPR / window fixups / core
	;     registers -> final normalize.  LOAD path only (the routine tests
	;     CS_SA1_LOAD itself).  Left frozen; released at the game resume.
	;     Lives in $C1 (savestate_cx4.a65); enters and leaves in .as/.xl.
	jsl @ss_cx4_restore
	.as : .xl

	; --- OBC1 savestate restore (mk2/mk3): the OBC1 is purely reactive, so
	;     there is no halt.  Order matters because of the register-write side
	;     effects: writing $7FF0-$7FF4 also scribbles obc_lower/obc_upper at
	;     the OLD (still-live) reg indices.  So (1) write the 8 regs
	;     $7FF0-$7FF7 first (accept the transient scribble), then (2) rewrite
	;     the linear window $7800-$7FEF, whose non-reg writes address obc_lower
	;     (addr[9:0]) and obc_upper (addr[5:0]) directly -- independent of the
	;     obc_bank reg -- overwriting the scribble with the true image.  Only a
	;     LOAD needs the write-back; the SAVE resume skips it (rewriting a
	;     running game's window would fire those reg side effects for nothing).
	sep #$20 : .as
	lda @SS_OBC1_GATE
	beq ss_obc1_rst_done            ; short block: beq reaches
	lda @CS_SA1_LOAD
	beq ss_obc1_rst_done            ; SAVE path: no write-back
	; (1) the 8 registers $7FF0-$7FF7, from scratch offset $07F0
	ldx #$07F0
ss_obc1_rst_regs:
	lda @SS_OBC1_SCRATCH, x
	sta @$007800, x
	inx
	cpx #$07F8
	bne ss_obc1_rst_regs
	; (2) the linear window $7800-$7FEF (16-bit words), overwriting the scribble
	rep #$20 : .al
	ldx #$0000
ss_obc1_rst_win:
	lda @SS_OBC1_SCRATCH, x
	sta @$007800, x
	inx : inx
	cpx #$07F0
	bne ss_obc1_rst_win
	.as                             ; register_restore_return does its own sep
ss_obc1_rst_done:

	; --- S-DD1 savestate restore (mk2/mk3): the S-DD1 is configured through the
	;     bus-visible register block $4800-$4807.  Restore only the FSM-neutral
	;     state: the four bank maps $4804-$4807 and the channel-enable mask $4800
	;     (exact readback value, including 0).  Deliberately DO NOT rewrite $4801:
	;     a write there arms the decompressor FSM (WAIT_DMA_TRIGGERED), which would
	;     inject a phantom decompression on the next $420B and desync the source
	;     address.  Leaving the FSM idle is self-healing -- the game's next real
	;     $4801 reloads everything through START_DECOMPRESSION.  The DMA source/size
	;     shadows were already rebuilt for free by the $43xx replay above
	;     (load_dma_regs_start).  LOAD path only; the SAVE resume skips the
	;     write-back (rewriting a running game's config would be pointless).
	sep #$20 : .as
	lda @SS_SDD1_GATE
	beq ss_sdd1_rst_done            ; short block: beq reaches
	lda @CS_SA1_LOAD
	beq ss_sdd1_rst_done            ; SAVE path: no write-back
	lda @SS_SDD1_SCRATCH+2
	sta @$004804
	lda @SS_SDD1_SCRATCH+3
	sta @$004805
	lda @SS_SDD1_SCRATCH+4
	sta @$004806
	lda @SS_SDD1_SCRATCH+5
	sta @$004807
	lda @SS_SDD1_SCRATCH
	sta @$004800
ss_sdd1_rst_done:

	; Restore registers and return.
	jmp register_restore_return
	
vm
	; Data format: xx xx yy yy
	; xxxx = little-endian address to write to .vm's bank
	; yyyy = little-endian value to write
	; If xxxx has high bit set, read and discard instead of write.
	; If xxxx has bit 12 set ($1000), byte instead of word.
	; If xxxx is $0000, end the VM.
	
	rep #$20 : .al;
	; Read address to write to
	lda $0000, y
	beq vm_done
	iny
	iny
	; Check for read mode (high bit of address)
	; Save off in carry flag for use later
	cmp #$8000
	and #$7FFF
	tax
	; Check for byte mode
	bit #$1000
	beq vm_word_mode
	and #$EFFF
	tax
	sep #$20 : .as
vm_word_mode
	; Read value
	lda $0000, y
	iny
	iny
vm_write
	bcs vm_read
	sta @$000000, x
	bra vm
vm_read
	lda @$000000, x
	bra vm

vm_done
	; A, X and Y are 16-bit at exit.
	; Return to caller.  The word in the table after the terminator is the
	; code address to return to.
	tyx
	jmp ($0002,x)
; ---- ss_sa1_probe_halt: prove the SA-1 savestate WINDOW, then halt ------------
;      THE early-halt request for the SA-1, called from BOTH sites (save_state /
;      load_state) right after their SS_SA1_GATE test.  The halt write lives in
;      here, behind the probe, so no caller can ever poke $E8 unvalidated -- and
;      neither site needs to re-test the gate afterwards, since nothing follows
;      the call.  Lives with ss_stage_slot because the SA-1 blocks it serves are
;      straight-line code; the jsr-callable helpers all sit in this tail section.
;        Why probe at all: SS_SA1_GATE only says that the FIRMWARE saw a
;      fpga_conf of SA1.  It says nothing about the core actually IMPLEMENTING
;      the $E8 scan window.  With a stale fpga_sa1 on the card, $E8 falls through
;      to the IS_PATCH identity window = raw PSRAM: the $01 written to $E8:07FF reads
;      straight back, the frozen spin passes on the very first poll, and the
;      handler captures (and later restores) 256 bytes of PSRAM garbage as if it
;      were SA-1 state.  Two real skews produce exactly that: Mk.II (window core
;      still in preparation) and Mk.III with an out-of-date fpga_sa1.bi3 on the SD.
;        Discriminate by WRITING.  Offset $FF of the state block is the magic $5A,
;      served combinationally and READ-ONLY by the core (sa1.v: the ss_cap read
;      mux answers $FF with $5A unconditionally, and the restore write decoder has
;      no $FF case AND is gated on ss_frozen, which is still 0 here) -- so on a
;      good core the $A5 is swallowed twice over and the read still yields $5A.
;      On raw PSRAM the $A5 sticks and reads back; on an unmapped/absent window we
;      read junk.  Anything but $5A fails.  Cost on a good core: one inert write
;      and one read per save/load ($E8:00FF is written by ss_sa1_rst_regs on every
;      restore anyway, so the address is not new traffic).
;        On failure ZERO the gate and DO NOT halt.  Every SA-1 touchpoint in this
;      handler tests the gate first, so one store skips all SA-1 capture/restore
;      for this save/load.  NOTE the resulting .state has NO BW-RAM/IRAM/register
;      capture: loading it later leaves the SA-1 running its pre-load state, which
;      on an SA-1 title likely misbehaves.  The win is a PREDICTABLE degrade (and
;      the load-side magic guard refusing to write garbage into a live SA-1)
;      instead of restoring 256 B of PSRAM junk.  Leaving the halt unrequested is
;      what keeps that safe: the halt
;      release in return_align is gated on the same (now zero) gate, so nothing is
;      left frozen.  The firmware re-arms the gate at the next game load, so the
;      clear is not sticky and the probe re-runs against the new core.
;      Entered and left with A 8-bit (both call sites are .as); X/Y untouched.
ss_sa1_probe_halt:
	.as                                ; both call sites are 8-bit; keep snescom in sync
	lda #$A5
	sta @SS_SA1_WINDOW|$00FF           ; inert on a real core (read-only, and not frozen yet)
	lda @SS_SA1_WINDOW|$00FF
	cmp #$5A                           ; magic intact -> window present
	bne ss_sa1_probe_bad
	lda #$01
	sta @SS_SA1_WINDOW|$07FF           ; window proven -> request the early halt
	rts
ss_sa1_probe_bad:
	lda #$00
	sta @SS_SA1_GATE                   ; stale/absent core -> degrade, never guess
	rts
; ---- ss_stage_slot: make the PSRAM image match the slot in CS_SLOT ------------
;      Called from load_state BEFORE it claims CS_STATE, so an abort is a plain
;      return. Returns carry CLEAR = the wanted image is resident, go ahead;
;      carry SET = do not restore (empty slot, or the MCU never answered).
;      Entered with A 8-bit and X/Y 16-bit; leaves them that way.
ss_stage_slot:
	; The restore below is a pure PSRAM->console replay: run_vm DMAs back whatever
	; image sits at $F00000, and nothing on this path ever touches the SD. The MCU
	; puts an image there at game load and on CMD_LOADSTATE -- which is what the
	; Select+d-pad combo fires, and why the combo has always been a PRELOAD rather
	; than a mere selection. Picking a slot anywhere else (the STATES tab) only moves
	; CS_SLOT, so without this the load would faithfully replay the PREVIOUS slot.
	;   So: if the wanted slot is already resident (SS_STAGED_SLOT, published by the
	; MCU), restore straight away -- the common case, zero SD I/O. Otherwise ask for
	; it and wait. Doing it HERE, and not when the slot is picked, is what keeps the
	; overlay safe: a .state load writes $F00000..$F4FFFF, right over the overlay's
	; VRAM/CGRAM/register backups, so it must never run while the overlay is open.
	;   Runs BEFORE CS_STATE is claimed, so every abort below can just exit.
	; Both early-outs RETURN instead of branching to the tail: the body below is
	; longer than a short branch reaches, and snescom only WARNS on that.
	lda @CS_SLOT
	and #$7f
	bne ss_ld_chk                      ; 0 = slots off -> single image, always resident
	clc
	rts
ss_ld_chk:
	cmp @SS_STAGED_SLOT
	bne ss_ld_need                     ; already resident -> restore straight away
	clc
	rts
ss_ld_need:
	; Not resident. Refuse EMPTY slots outright: the MCU would keep the old image and
	; we would replay it as if it were this slot (a silent, wrong "load").
	pha                                ; A = wanted slot (1..4)
	sec : sbc #$01
	rep #$20 : .al
	and #$00ff                         ; X/Y are 16-bit here: clear A's hidden high
	tax                                ; byte or tax would carry it into the count
	sep #$20 : .as
	lda @SS_SLOT_STATUS
ss_ld_bit:
	cpx #$0000
	beq ss_ld_bit_done
	lsr
	dex
	bra ss_ld_bit
ss_ld_bit_done:
	and #$01
	bne ss_ld_ask
	pla                                ; empty slot -> nothing to load
	sec
	rts
ss_ld_ask:
	pla                                ; A = wanted slot
	sta @MCU_PARAM
	ora #$80                           ; bit7 = MCU busy; the MCU clears it when done
	sta @CS_SLOT
	; ---- quiesce the frame BEFORE waiting -------------------------------------
	; We are about to sit inside the hook for as long as the MCU takes to read the
	; .state. The hook holds snescmd_unlock, which maps $C0-FF to PSRAM, and the
	; game's HDMA keeps fetching its tables EVERY scanline: any table living in
	; $C0-FF then reads menu PSRAM instead of ROM. That is the documented Star Fox
	; mechanism, and over hundreds of ms it repaints the whole screen with garbage.
	; The handler normally exits in microseconds, which is why nothing else here
	; needs this. So: HDMA off, NMI/IRQ off (keep auto-joypad) for the duration.
	; Saved on the stack and put back only on the abort paths -- when the load goes
	; ahead, load_write_table disables both anyway and the restore re-establishes
	; them from the snapshot.
	lda @$F9070C                       ; live shadow of $420C (HDMA enable)
	pha
	lda @$F90700                       ; live shadow of $4200
	pha
	and #$01
	sta @$004200
	lda #$00
	sta @$00420c
	lda #CMD_LOADSTATE
	sta @MCU_CMD
	; Bounded ACK spin (the MCU clears MCU_CMD when the ~320KB read is done). We poll
	; MCU_CMD in the snescmd BRAM, not PSRAM, so the poll itself does not fight the
	; MCU for the bus it is writing the image over. On timeout we abort rather than
	; replay a stale image; CS_SLOT keeps its busy bit only until the MCU finishes,
	; which also re-arms the next attempt. X/Y are already 16-bit here.
	ldx #$0020
ss_ld_wait_o:
	ldy #$0000
ss_ld_wait_i:
	lda @MCU_CMD
	beq ss_ld_staged
	dey
	bne ss_ld_wait_i
	dex
	bne ss_ld_wait_o
	pla : sta @$004200                 ; MCU never answered: hand the frame back
	pla : sta @$00420c                 ; untouched and restore nothing
	sec
	rts
ss_ld_staged:
	pla                                ; drop the saved $4200/$420C: the restore
	pla                                ; re-establishes both from the snapshot
	clc
	rts
ss_pad_reject
	.al : .xl
	sep #$20 : .as
	lda @SS_DIAG_REJECT
	inc
	sta @SS_DIAG_REJECT
	rep #$20 : .al
	rts

; --- Pad-source validity, checked ONLY when a save/load/slot combo matched ----
; The value the match was computed from came from the stub at nmihook.a65:9, which
; samples $4218 in the first instructions of the interrupt.  The console starts
; filling that register 48 master cycles into vblank and needs ~4224 more; a read
; taken while it fills returns the pad SHIFTED RIGHT by the bits that have not
; arrived yet.  A shifted read of one button pair looks exactly like another pair
; (X+A read one bit late IS X+L), so a game whose NMI is chronically late -- a
; pre-vblank DMA queue that overruns the same amount every frame -- forges the
; same wrong combo frame after frame and defeats the two-frame rule.  That is the
; Yoshi Island case; the same shape produced the "Mega Man X2 loads by itself"
; report (Down+Right, Right+X and A+L all forge X+R).
;   The test that closes it costs nothing and waits for nothing: if $4212 bit0 is
; CLEAR the fill is over, so $4218 holds the COMPLETE pad right now.  Compare it
; with what we matched on.  Equal means the stub read a whole pad and the match is
; real (a held combo does not change between the two reads).  Different means the
; stub read a partial one -- so take the complete pad, re-run the SAME test on it,
; and only then decide: still holding the gesture means it was genuine and merely
; sampled late (that is what makes a 2-button combo usable in a game whose NMI is
; chronically late), not holding it means the match was a forgery and the frame is
; dropped.  Either way CS_INPUT_CUR keeps the truth for the next frame.
;   If bit0 is SET the register is mid-fill and there is nothing to compare
; against, so the match stands as before.  That used to be the hole the two-frame
; rule half-covered; it is now closed upstream of here instead, by the
; partial-sample gate in ss_input -- a match can only be computed from a pad that
; predates the fill (the previous frame's settled read), from one taken after it,
; or from one the bounded wait there let the hardware finish, so what reaches this
; routine is never a shifted value in the first place.  This routine is what is left of the guard: the free second opinion for
; the frames whose fill happens to end while the handler is still running.
;   Auto-joypad OFF is the third case: bit0 never sets, $4218 is a stale leftover
; and NMI_PAD came from the stub's manual $4016 read, so the comparison must not
; run at all -- the live $4200 shadow decides.
; in:  A = the combo mask that matched; A/X/Y 16-bit; CS_INPUT_CUR = the value the
;      match was computed from
; out: C set = go ahead; C clear = drop this frame (SS_DIAG_REJECT bumped)
; clobbers A and CS_PAD_INV (rebuilt from CS_INPUT_CUR before returning, so the
; tests after a slot load keep working).
ss_pad_confirm
	.al : .xl
	sta @CS_PAD_INV                    ; scratch
	sep #$20 : .as
	lda @$004212
	lsr                                ; C = auto-joypad still filling
	bcs ss_pad_confirm_yes
	lda @$F90700                       ; live $4200 shadow
	and #$01
	bne ss_pad_confirm_late
ss_pad_confirm_yes:                    ; mid-fill, or auto-joypad off: nothing to
	rep #$20 : .al                     ; compare against -- behave as before
	sec
	bra ss_pad_confirm_out
ss_pad_confirm_late:
	rep #$20 : .al
	lda @$004218                       ; fill is over: this is the complete pad
	cmp @CS_INPUT_CUR
	beq ss_pad_confirm_yes2            ; stub read a whole pad -> match is real
	sta @CS_INPUT_CUR                  ; partial read: keep the truth instead ...
	eor #$FFFF
	and @CS_PAD_INV                    ; ... and re-run the SAME test on it
	beq ss_pad_confirm_yes2            ; really held -> the gesture is genuine, the
	                                   ; stub just sampled it late (this is what
	                                   ; makes a 2-button combo usable again in a
	                                   ; game whose NMI is chronically late)
	jsr ss_pad_reject
	clc
	bra ss_pad_confirm_out
ss_pad_confirm_yes2:
	sec
ss_pad_confirm_out:
	php                                ; the rebuild must not disturb the verdict
	lda @CS_INPUT_CUR
	eor #$FFFF
	sta @CS_PAD_INV
	plp
	rts

.byt "SAVESTATE_END"

; print "Savestate Bank Ending at: ", pc

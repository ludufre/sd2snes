# Makefile -- builds atari_snes.bin, the SNES-side player of the Mk.II Atari 2600
# core (verilog/sd2snes_atari, the STorm2600 core by AndinhoNFS, GPL-2.0-or-later).
#
# TOOLCHAIN NOTE: assembled with cc65 (ca65 + ld65), not asar (snes/a26, snes/sms,
# snes/gbc) nor snescom (the menu). prepare.sh provisions cc65 on the build server.
# font_txt.inc is generated by gen_font.py and committed.
#
# Not part of the menu build -- build.sh calls this explicitly for the Mk.II.
# The core and the player ship together: /sd2snes/fpga_atari.bit without
# /sd2snes/atari_snes.bin aborts every .a26 load on the Mk.II with SUPPLFILE.

CA65 ?= ca65
LD65 ?= ld65
OUT   = ../../misc/atari_snes.bin
OBJ   = atari_snes.o

all: $(OUT)

$(OUT): atari_snes.s font_txt.inc lorom.cfg fix_snes_checksum.py
	@mkdir -p $(@D)
	@rm -f $(OUT) $(OBJ)
	$(CA65) -o $(OBJ) atari_snes.s
	$(LD65) -C lorom.cfg -o $(OUT) $(OBJ)
	python3 fix_snes_checksum.py $(OUT) >/dev/null
	@rm -f $(OBJ)
	@test -s $(OUT) || { echo "*** atari_snes assembly produced no output"; exit 1; }

clean:
	rm -f $(OUT) $(OBJ)

.PHONY: all clean

; Context-menu entry-table VARIANTS carrying the "Game info" entry.
;
; ShowGameInfo is tri-state (0 = off, 1 = on, 2 = context).  In mode 2 the info screen is
; no longer auto-shown before boot; it is reached from a context menu (Y) instead -- from
; the browser, from the recent-games list and from the favorites list.  Rather than
; grey/hide a row at runtime -- the greying predicate at entry offset +20 is COSMETIC ONLY
; (menu_check_disabled_func just picks a palette; neither the MTYPE_FUNC_CLOSE dispatch nor
; menu_edit_value has an early-out) -- each wrapper in menu.a65 picks a whole DIFFERENT
; table, so the entry is not merely greyed but truly absent in modes 0/1.
;
; WHY $C1: every reader of an entry table is bank-explicit, so a table is free to live
; outside $C0.  show_menu captures the caller's DBR into w_menu_bank (`phb : pla`) and
; every subsequent access goes through the direct-page LONG pointer [w_menu_addr] --
; menu_measure, show_menu_entries, menu_edit_value, menu_desc_draw and
; show_menu_func_close all reload the bank from w_menu_bank (phb/plb or the long read)
; instead of assuming $C0.  The menu.a65 wrappers already pass the bank via
; `lda #^table : pha : plb`, so pointing one at a $C1 table needs no reader change.
;
; WHY IT MATTERS: $C0 is the page that runs out (a few hundred bytes of tail before the
; fixed $C0FF00 block), while $C1 has tens of KB free.  The three variants below come to
; 452 bytes together (143 + 166 + 143) -- more than the entire $C0 tail.
;
; NO DRIFT BY CONSTRUCTION: each variant is header + the "Game info" row + the SAME
; ctxrows_*.i65 file the plain table in menudata.a65 includes + terminator.  There is no
; copy left to keep in sync: a row added to ctxrows_recent.i65 shows up in both the mode-0/1
; and the mode-2 recents menu automatically.  (Those .i65 files are #include'd, so they may
; only carry `//` comments -- a `;` in one dies with "Error: What is".)

.link page $c1
#include "memmap.i65"
; memmap.i65 re-asserts '.link page $c0' on include; re-declare $c1 AFTER it (last
; '.link page' wins and they emit no bytes) so every byte of this object lands in $C1.
.link page $c1

; ---------------------------------------------------------------------------
; gi_ctx_request: the "Game info" row's MTYPE_FUNC_CLOSE action, shared by all three
; variants -- the row means the same thing everywhere, and it is the CALLER that knows
; which list the raised flag refers to (browser / recents / favorites).
;
; It does NOT run the info screen.  It only raises a flag; the actual dispatch happens in
; the caller (filesel_key_y, select_last_file_context_menu, select_favorite_file_context_menu)
; AFTER show_menu has closed and unwound, so the ficha runs with the very same DP / DBR /
; window-stack state as the normal A-press path.  Running it from inside the menu FUNC would
; instead enter with the show_menu AllocStack frame still live and DP != 0 -- exactly the
; condition that corrupted the cover art when Recents/Favorites opened it from a menu FUNC.
;
; There is deliberately NO mode check here: the variant table IS the gate.  A `cmp #$02`
; hidden in the action would only mask a mis-wired table (the row would be reachable in a
; mode that should not have it and would silently do nothing instead of failing loudly).
;
; Reached via show_menu_func_close's `rtl`, so it must end in rtl.  DBR is whatever the
; menu left behind, hence the absolute-LONG store (snescom has no long `stz`, so the
; value goes through A).
gi_ctx_request:
  php
  sep #$20 : .as
  lda #$01
  sta @gi_ctx_pending
  plp
  rtl

; ---------------------------------------------------------------------------
; The "Game info" row itself is written out once per variant below (13 source lines, 23
; bytes).  Two things about it are the same in all three:
;
;  - The routine pointer is PARENTHESIZED, `^(gi_ctx_request-1)`, unlike every row in the
;    ctxrows_*.i65 files: those all target $C0 symbols, where a bank byte that came out one
;    short would be caught instantly, whereas this is the only table entry whose target
;    lives in $C1.  Parenthesizing makes "bank of (symbol-1)" explicit and is the form
;    menudata.a65 already uses for its isEnabled pointers, so the cross-bank case cannot
;    hinge on how the assembler associates `^` with the trailing `-1`.
;
;  - It goes FIRST, ahead of the shared rows, so "Game info" is the selection the menu
;    opens on.

; ---------------------------------------------------------------------------
; Browser file context menu (Y on a .sfc/.nes), ShowGameInfo == 2 variant.
; 6 entries = 1 + the 5 of ctxrows_file.i65.
menu_enttab_filesel_context_file_gi:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
#include "ctxrow_gameinfo.i65"

#include "ctxrows_file.i65"

 .byt  0

; ---------------------------------------------------------------------------
; Recent games list context menu, ShowGameInfo == 2 variant.
; 7 entries = 1 + the 6 of ctxrows_recent.i65 -- still inside MENU_VISMAX, so the list
; does not start scrolling.
menu_enttab_recent_context_gi:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
#include "ctxrow_gameinfo.i65"

#include "ctxrows_recent.i65"

 .byt  0

; ---------------------------------------------------------------------------
; Favorites list context menu, ShowGameInfo == 2 variant.
; 6 entries = 1 + the 5 of ctxrows_favorites.i65.
menu_enttab_filesel_favorites_context_gi:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_filesel_selected_file ; window title
 .byt  ^text_filesel_selected_file ; for this menu
; ENTRIES
#include "ctxrow_gameinfo.i65"

#include "ctxrows_favorites.i65"

 .byt  0

; ---------------------------------------------------------------------------
; Chip options menu (moved here from menudata.a65).  Not a context variant --
; it lives in this object purely for the bank: the parent SUBMENU entry stores
; `^menu_enttab_chip` and show_menu_submenu sets DBR from it, so relocating the
; table to $C1 needs no reader change and returns its bytes to the starving $C0.
menu_enttab_chip:
; HEADER
 .byt 1
 .word !mtext_cfg_chip
 .byt  ^mtext_cfg_chip
; ENTRIES
 .byt  MTYPE_VALUE
 .word !mtext_chip_cx4_speed
 .byt  ^mtext_chip_cx4_speed
 .word !kv_cx4_speed
 .byt  ^kv_cx4_speed
 .byt  OPTTYPE_KVBYTE
 .word !CFG_CX4_SPEED
 .byt  ^CFG_CX4_SPEED
 .word !mdesc_chip_cx4_speed
 .byt  ^mdesc_chip_cx4_speed
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_VALUE
 .word !mtext_chip_gsu_speed
 .byt  ^mtext_chip_gsu_speed
 .word !kv_gsu_speed
 .byt  ^kv_gsu_speed
 .byt  OPTTYPE_KVBYTE
 .word !CFG_GSU_SPEED
 .byt  ^CFG_GSU_SPEED
 .word !mdesc_chip_gsu_speed
 .byt  ^mdesc_chip_gsu_speed
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_VALUE
 .word !mtext_chip_msu1_volume_boost
 .byt  ^mtext_chip_msu1_volume_boost
 .word !kv_volume_boost
 .byt  ^kv_volume_boost
 .byt  OPTTYPE_KVBYTE
 .word !CFG_MSU_VOLUME_BOOST
 .byt  ^CFG_MSU_VOLUME_BOOST
 .word !mdesc_chip_msu1_volume_boost
 .byt  ^mdesc_chip_msu1_volume_boost
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_VALUE
 .word !mtext_a26_width
 .byt  ^mtext_a26_width
 .word !kv_a26_width
 .byt  ^kv_a26_width
 .byt  OPTTYPE_KVBYTE
 .word !CFG_A26_VIDEO_WIDTH
 .byt  ^CFG_A26_VIDEO_WIDTH
 .word !mdesc_a26_width
 .byt  ^mdesc_a26_width
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_VALUE
 .word !mtext_chip_cc_time_limit
 .byt  ^mtext_chip_cc_time_limit
 .word !kv_cc_time_limit
 .byt  ^kv_cc_time_limit
 .byt  OPTTYPE_KVBYTE
 .word !CFG_CC_TIME_LIMIT
 .byt  ^CFG_CC_TIME_LIMIT
 .word !mdesc_chip_cc_time_limit
 .byt  ^mdesc_chip_cc_time_limit
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt 0

; Competition Cart round timer, 0..15 = 3..18 minutes = the 4-bit DIP bank of the
; physical event boards.  The row shows the bare minute count (the entry title
; carries the "(min)" unit): values 3-14 reuse the neutral number strings the LED
; brightness table already pays for in $C0; only 15-18 are new, and they live here
; in $C1 -- resolve_str passes any pointer outside the translated pool through.
kv_cc_time_limit:
.word $0000, !text_3 : .byt ^text_3
.word $0001, !text_4 : .byt ^text_4
.word $0002, !text_5 : .byt ^text_5
.word $0003, !text_6 : .byt ^text_6
.word $0004, !text_7 : .byt ^text_7
.word $0005, !text_8 : .byt ^text_8
.word $0006, !text_9 : .byt ^text_9
.word $0007, !text_10 : .byt ^text_10
.word $0008, !text_11 : .byt ^text_11
.word $0009, !text_12 : .byt ^text_12
.word $000a, !text_13 : .byt ^text_13
.word $000b, !text_14 : .byt ^text_14
.word $000c, !text_ccmin_15 : .byt ^text_ccmin_15
.word $000d, !text_ccmin_16 : .byt ^text_ccmin_16
.word $000e, !text_ccmin_17 : .byt ^text_ccmin_17
.word $000f, !text_ccmin_18 : .byt ^text_ccmin_18
.word $ffff

text_ccmin_15  .byt "15", 0
text_ccmin_16  .byt "16", 0
text_ccmin_17  .byt "17", 0
text_ccmin_18  .byt "18", 0

; ======================================================================
;  menu_enttab_mm -- the MAIN menu (START in the browser).  Lives here, in $C1,
;  for the same reason menu_enttab_chip does: it outgrew the $C0 page, and every
;  reader of an entry table is bank-explicit (mainmenu sets DBR from
;  ^menu_enttab_mm before jsr show_menu; show_menu itself captures the caller's
;  DBR in w_menu_bank and reads entries long).  Moved from snes/menudata.a65.
; ======================================================================
menu_enttab_mm:
; HEADER
 .byt  1              ; listsel_step=1
 .word !text_mainmenu ; window title
 .byt  ^text_mainmenu ; for this menu
; ENTRIES
 .byt  MTYPE_FUNC
 .word !text_mm_last
 .byt  ^text_mm_last
 .word !select_last_file-1
 .byt  ^select_last_file-1
 .byt  0
 .byt  0,0,0
 .word !mdesc_mm_last
 .byt  ^mdesc_mm_last
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_FUNC
 .word !text_mm_favorites
 .byt  ^text_mm_favorites
 .word !select_favorite_file-1
 .byt  ^select_favorite_file-1
 .byt  0
 .byt  0,0,0
 .word !mdesc_mm_favorites
 .byt  ^mdesc_mm_favorites
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_FUNC
 .word !mtext_mm_sysinfo
 .byt  ^mtext_mm_sysinfo
 .word !show_sysinfo-1
 .byt  ^show_sysinfo-1
 .byt  0
 .byt  0,0,0
 .word !mdesc_mm_sysinfo
 .byt  ^mdesc_mm_sysinfo
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

; RAM connection test, next to System Information because it is the other half of
; "what is wrong with my cartridge".  The handler lives in bank $C1 (snes/memtest.a65)
; and that is fine: MTYPE_FUNC is dispatched through a LONG pointer, so a screen does
; not have to fit in the nearly-full $C0 page to be reachable from here.
 .byt  MTYPE_FUNC
 .word !mtext_mm_memtest
 .byt  ^mtext_mm_memtest
 .word !show_memtest-1
 .byt  ^show_memtest-1
 .byt  0
 .byt  0,0,0
 .word !mdesc_mm_memtest
 .byt  ^mdesc_mm_memtest
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_SUBMENU
 .word !mtext_mm_cfg
 .byt  ^mtext_mm_cfg
 .word !menu_enttab_cfg
 .byt  ^menu_enttab_cfg
 .byt  0
 .byt  0,0,0
 .word !mdesc_mm_cfg
 .byt  ^mdesc_mm_cfg
 .byt  0,0,0
 .byt  0,0,0
 .byt  0,0,0

 .byt  MTYPE_VALUE
 .word !text_mm_language
 .byt  ^text_mm_language
 .word !kv_language
 .byt  ^kv_language
 .byt  OPTTYPE_KVBYTE
 .word !CFG_LANGUAGE
 .byt  ^CFG_LANGUAGE
 .word !mdesc_mm_language
 .byt  ^mdesc_mm_language
 .word !(mfunc_chg_language-1)
 .byt  ^(mfunc_chg_language-1)
 .byt  0,0,0
 .byt  0,0,0

 .byt  0

; ======================================================================
;  kv_* value tables -- the preset lists behind every OPTTYPE_KVBYTE menu
;  entry.  Moved here from snes/menudata.a65 for space: they are ~600 bytes
;  of pure data and $C0 had run down to a few dozen bytes of tail.
;
;  Safe because both readers take the bank from the entry itself, never from
;  DBR: menu_edit_value stashes the entry's bank byte in w_kvtab_bank and does
;  `pha : plb` around jsr menu_kv_lookup, and menu_value_dialog_kv8 does the
;  same from w_preset_bank.  menu_kv_lookup itself reads `lda !$0,y` -- DBR
;  relative -- which is exactly why the callers set it.
; ======================================================================
kv_language:
.word $0000, !text_lang_en : .byt ^text_lang_en
.word $0001, !text_lang_ptbr : .byt ^text_lang_ptbr
.word $0002, !text_lang_es : .byt ^text_lang_es
.word $0003, !text_lang_de : .byt ^text_lang_de
.word $0004, !text_lang_fr : .byt ^text_lang_fr
.word $0005, !text_lang_it : .byt ^text_lang_it
.word $0006, !text_lang_ru : .byt ^text_lang_ru
.word $0007, !text_lang_nl : .byt ^text_lang_nl
.word $ffff

kv_bsx_timesource:
.word $0000, !text_rtc : .byt ^text_rtc
.word $0001, !text_custom : .byt ^text_custom
.word $ffff

kv_onoff:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
.word $ffff

; Tri-state for the two font-edge options (TEXT_EDGE_* in src/theme.h).  Not a bool
; because the font remap can only REMOVE an edge: with a plain on/off the .thm always
; had the last word, so "On" did nothing visible on a theme that asks for outline-off.
; THEME is 0 so an old config.yml -- and anything cfg.c clamps -- lands on it.
kv_text_edge:
.word $0000, !text_theme : .byt ^text_theme
.word $0001, !text_on : .byt ^text_on
.word $0002, !text_off : .byt ^text_off
.word $ffff

; Copier-header convention of one IPS patch, edited through PATCH_HDR_SEL.
; Values match PATCH_HDR_AUTO/HEADERED/HEADERLESS >> PATCH_FLAG_HDR_SHIFT.
kv_patch_hdrmode:
.word $0000, !text_patch_hdrsel_auto : .byt ^text_patch_hdrsel_auto
.word $0001, !text_patch_hdrsel_on : .byt ^text_patch_hdrsel_on
.word $0002, !text_patch_hdrsel_off : .byt ^text_patch_hdrsel_off
.word $ffff

; cover size: 1=large (legacy "on"), 2=small (half, 8x8 sprites), 0=off. Cycle
; order large->small->off; CFG default is 1 so an existing "ShowCovers: true"
; config (parsed to 1) shows "Large".
kv_cover_size:
.word $0001, !text_cover_large : .byt ^text_cover_large
.word $0002, !text_cover_small : .byt ^text_cover_small
.word $0000, !text_off : .byt ^text_off
.word $ffff

; ShowGameInfo is tri-state: 0 = off, 1 = on (auto-show before boot), 2 = context
; (no auto-show; the info screen is reachable from the file context menu instead).
; Listed in NUMERIC order, unlike kv_cover_size above: that one is reordered so the
; "value not in the table -> fall back to the first row" sanitize lands on a sane
; default, but here cfg_load clamps ShowGameInfo into 0..2, so every stored value is
; always present in the table and that fallback is unreachable. With nothing to gain
; from reordering, keep the shape of kv_onoff / kv_patch_hdrmode and let the scroll
; order read Off -> On -> Context.
kv_gameinfo_mode:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
.word $0002, !text_gameinfo_context : .byt ^text_gameinfo_context
.word $ffff

kv_rst_to_menu:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
.word $0002, !text_nav_folder : .byt ^text_nav_folder
.word $0003, !text_nav_rom : .byt ^text_nav_rom
; Duration keeps the PHYSICAL short/long detection alive (values 1..3 short-circuit
; it in snes.c and make every press a long reset): a short press just resets the
; running game, a long one goes to the menu exactly like ROM does.
.word $0004, !text_nav_duration : .byt ^text_nav_duration
.word $ffff

kv_enabledisable:
.word $0000, !text_enabled : .byt ^text_enabled
.word $0001, !text_disabled : .byt ^text_disabled
.word $ffff

kv_yesno:
.word $0000, !text_no : .byt ^text_no
.word $0001, !text_yes : .byt ^text_yes
.word $ffff

kv_vmode:
.word $0002, !text_auto : .byt ^text_auto
kv_vmode_noauto:
.word $0001, !text_50Hz : .byt ^text_50Hz
.word $0000, !text_60Hz : .byt ^text_60Hz
.word $ffff

kv_cx4_speed:
.word $0000, !text_normal : .byt ^text_normal
.word $0001, !text_fast : .byt ^text_fast
.word $ffff

kv_gsu_speed:
.word $0000, !text_normal : .byt ^text_normal
.word $0001, !text_fast : .byt ^text_fast
.word $ffff

; Atari 2600 picture width, shipped to the core as feat16[5]: 0 = the native
; 160 px TIA raster 1:1 (pillarboxed), 1 = 256 px (5 source pixels stretched to
; 8) filling the screen. cfg_load clamps A26VideoWidth into 0..1, so the
; "value not in the table -> first row" fallback is unreachable; numeric order.
kv_a26_width:
.word $0000, !text_a26_w160 : .byt ^text_a26_w160
.word $0001, !text_a26_w256 : .byt ^text_a26_w256
.word $ffff

kv_sgb_clock:
.word $0000, !text_sgb_clock1 : .byt ^text_sgb_clock1
.word $0001, !text_sgb_clock2 : .byt ^text_sgb_clock2
.word $ffff

; GbcMode (CFG+$1D1): 0 Auto / 1 Prefer SGB / 2 Prefer GBC -- gbc_mode_t in
; src/gbc.h. cfg_load clamps it into 0..2, so every stored value is in the table;
; numeric order.
kv_gbc_mode:
.word $0000, !text_auto : .byt ^text_auto
.word $0001, !text_gbc_prefer_sgb : .byt ^text_gbc_prefer_sgb
.word $0002, !text_gbc_prefer_gbc : .byt ^text_gbc_prefer_gbc
.word $ffff

; GbcSync (CFG+$1D2): 0 Genlock / 1 Exact -- gbc_sync_t in src/gbc.h.
kv_gbc_sync:
.word $0000, !text_gbc_genlock : .byt ^text_gbc_genlock
.word $0001, !text_gbc_exact : .byt ^text_gbc_exact
.word $ffff

; mfunc_isenabled_gbc -- greying predicate of the three Game Boy Color rows of the
; SGB menu (menudata.a65).  The GBC core has no Spartan-3 build and the Mk.II
; firmware ignores GbcMode/GbcSync/GbcStretch, so the rows are drawn disabled whenever the
; board flag ST_IS_MK2 is set.  Carry set = drawn disabled.  COSMETIC only, like
; every mfunc_isenabled_* (menu_check_disabled_func only picks a palette), hence
; the "Mk.III only" in every description.  Entered by rtl from
; menu_check_disabled_func with A in 8 bits, which is also why it may live in $C1.
mfunc_isenabled_gbc:
  .as
  lda @ST_IS_MK2
  cmp #$01                   ; C = 1 for any non-zero flag (Mk.II)
  rtl

kv_screensaver_timeout:
.word $0001, !text_1min : .byt ^text_1min
.word $0002, !text_2min : .byt ^text_2min
.word $0003, !text_3min : .byt ^text_3min
.word $0004, !text_4min : .byt ^text_4min
.word $0005, !text_5min : .byt ^text_5min
.word $000a, !text_10min : .byt ^text_10min
.word $000f, !text_15min : .byt ^text_15min
.word $0014, !text_20min : .byt ^text_20min
.word $001e, !text_30min : .byt ^text_30min
.word $002d, !text_45min : .byt ^text_45min
.word $003c, !text_60min : .byt ^text_60min
.word $ffff

kv_volume_boost:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_3_5db : .byt ^text_3_5db
.word $0002, !text_6db : .byt ^text_6db
.word $0003, !text_9_5db : .byt ^text_9_5db
.word $0004, !text_12db : .byt ^text_12db
.word $ffff

kv_bright_limit:
.word $0008, !text_minus7 : .byt ^text_minus7
.word $0009, !text_minus6 : .byt ^text_minus6
.word $000a, !text_minus5 : .byt ^text_minus5
.word $000b, !text_minus4 : .byt ^text_minus4
.word $000c, !text_minus3 : .byt ^text_minus3
.word $000d, !text_minus2 : .byt ^text_minus2
.word $000e, !text_minus1 : .byt ^text_minus1
.word $000f, !text_off : .byt ^text_off
.word $ffff

kv_savestates:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
;.word $0001, !text_on_p1 : .byt ^text_on_p1
;.word $0002, !text_on_p2 : .byt ^text_on_p2
.word $ffff

opt_0_to_30:
.word $0000, $001E

opt_1_to_2:
.word $0001, $0002

kv_led_bright:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_1 : .byt ^text_1
.word $0002, !text_2 : .byt ^text_2
.word $0003, !text_3 : .byt ^text_3
.word $0004, !text_4 : .byt ^text_4
.word $0005, !text_5 : .byt ^text_5
.word $0006, !text_6 : .byt ^text_6
.word $0007, !text_7 : .byt ^text_7
.word $0008, !text_8 : .byt ^text_8
.word $0009, !text_9 : .byt ^text_9
.word $000a, !text_10 : .byt ^text_10
.word $000b, !text_11 : .byt ^text_11
.word $000c, !text_12 : .byt ^text_12
.word $000d, !text_13 : .byt ^text_13
.word $000e, !text_14 : .byt ^text_14
.word $000f, !text_15_max : .byt ^text_15_max
.word $ffff

; ======================================================================
;  menu_enttab_cfg -- Settings (Main menu > Settings). Moved here from
;  snes/menudata.a65 for the $C0 room; the last row replays the first-boot tour.
; ======================================================================
menu_enttab_cfg:
; HEADER
 .byt 1               ; listsel_step=1

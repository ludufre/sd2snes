; igmenu.a65 -- Phase-0 in-game TAB menu shell.
;
; Assembled SEPARATELY from m3nu.bin into igmenu.bin (org bank $C2) and loaded by the
; MCU (src/igmenu.c igmenu_stage) into PSRAM $C20000 every game-load. The $C0 cheat
; overlay (cheatoverlay.a65) draws its cheat screen in forced blank, then -- IF the MCU
; armed IGMENU_GATE and the ABI version word matches -- does `jsl $C20008` here. This
; shell adds a tab bar + tab dispatch on top of the ALREADY-drawn (still forced-blank)
; cheat screen, does its own unblank + input loop, and returns via `rtl` when the user
; presses B; the $C0 hook then takes the normal apply + savestate-grade restore exit.
;
; INVARIANTS (durable):
;  - This runs under the same handler as the $C0 overlay: PPU taken over (savestate-grade
;    snapshot in $C0), SA-1 paused, NMI/IRQ off, IS_PATCH ($C0-FF identity) live. NEVER
;    drop snescmd_unlock (that would UNMAP $C2 = the code executing).
;  - Entry is jsl/rtl balanced (no self-modifying code, no jml-without-push).
;  - PSRAM is NOT zeroed by clear_wram -> igmenu_main zeroes the shell vars explicitly.
;  - VRAM writes only in forced blank (tab switches force-blank) or via the OVL_TMBUF DMA
;    pipeline in the vblank window (the Cheats list scroll). Bar/footer/body: forced blank.
;  - .as/.al declared at the entry of every routine (snescom leaks the last directive in
;    SOURCE order -> a wrong-width immediate becomes a stray byte / BRK).
;  - Bank-alto vars ($F4/$C2) are ALWAYS @long or DBR=$F4 abs -- a bare symbol assembles
;    absolute (DBR-relative) and links with NO error but reads the wrong bank.

#include "memmap.i65"              ; brings CHEAT_*/IGMENU_* defines (this sets .link page $c0)
.link page $c2                     ; OUR code lives in bank $C2 -- override memmap's $c0

; ===== HEADER (fixed layout, first emitted bytes -> $C20000). The MCU + $C0 hook read
;       these by absolute offset, so this block MUST come before any other emission. =====
igmenu_header:
	.byt "IGMN"                    ; $C20000 magic (4)
	.byt IGMENU_ABI_VERSION        ; $C20004 ABI version (1)
	.byt $00                       ; $C20005 reserved (1)
	.word $0000                    ; $C20006 crc16(body from $C20008), patched by the build (2)
	jmp igmenu_main                ; $C20008 in-bank jump past the shared routines to igmenu_main
	                               ;  (3 bytes; PBR is $C2 after the $C0 `jsl $c20008`). snescom
	                               ;  has no `jml`; a near jmp is right since both are in bank $C2.

#include "cheatlist.i65"           ; shared cheat-list layout defines + render/input routines
                                   ; (OWN copy in $C2; SEPARATE link -> no symbol collision)
#include "igmenu_lang.i65"         ; GENERATED: HELP tab i18n string tables + IGM_HELP_NLINES/
                                   ; IGM_LANG_COUNT (bank $C2 data, jumped over -- included
                                   ; BEFORE help_enter so its #defines are in scope)

; --- shell scratch vars (PSRAM $F4, ABOVE the overlay's ovl_* block $F48100-$F48127 and
;     BELOW the snapshot scratch $F48130-$F48144; the $F48128-$F4812F gap). Zeroed by
;     igmenu_main (PSRAM stale). Accessed @long. ---
#define active_tab      $F48128    ; 0=Cheats 1=Savestate 2=SaveGame 3=Guides 4=Help
#define igmenu_tabcount $F4812A    ; visible tab count (Phase 0 = 5)
#define igmenu_flags    $F4812C    ; bit0 = manual viewer sub-mode; bit1 = content focused (two-level
                                   ;   nav: clear = tab bar owns L/R, set = the active tab owns input)
#define igmenu_prevtab  $F4812E    ; previous tab (for leave/enter on switch)

; --- HELP tab (Phase 2) scratch, in the reserved i18n/handoff gap $F48160-7F ---
#define help_lang       $F48160    ; CFG.language clamped 0..IGM_LANG_COUNT-1 (word)
#define help_lineno     $F48162    ; HELP line loop counter 0..IGM_HELP_NLINES-1 (word)
#define IG_HELP_MAXCOL  62         ; stop the per-line copy before the 64-col row edge

; --- STATES tab (Phase 3) scratch, in the SAME reserved gap, AFTER help_lineno (word at
;     $F48162 occupies $F48162-63, so the next free byte is $F48164). All words; the
;     first three persist across frames (read by states_input), the rest are transient
;     helper args. STATES and HELP are never the active tab at the same time, so sharing
;     the gap is safe; states_enter re-derives cursor/active/disabled/lang every entry
;     (PSRAM is stale, and enter always runs before any states_input via the dispatch). ---
#define sst_cursor      $F48164    ; local navigation cursor, slot 1..4 (persistent)
#define sst_active      $F48166    ; committed active slot 1..4 (mirrors CS_SLOT&$7F)
#define sst_disabled    $F48168    ; 1 = savestate slots off -> ignore input (persistent)
#define sst_lang        $F4816A    ; CFG.language clamped 0..IGM_LANG_COUNT-1
#define sst_row         $F4816C    ; transient: absolute tile row for a centered draw
#define sst_tmp         $F4816E    ; transient: string index scratch (draw_centered)
#define sst_scr_slot    $F48170    ; transient: slot 1..4 being drawn/recoloured (locates the row)
#define sst_scr_coff    $F48172    ; transient: generic 2nd arg (i18n token index / SAVEINFO offset)
#define sst_scr_entry   $F48174    ; transient: generic 3rd arg (end column / guide count)
#define sst_idx         $F48176    ; FREE. Was the string-index scratch the old `*5` row
                                   ; arithmetic needed; the power-of-two stride indexes
                                   ; with shifts alone, so nothing writes here anymore.
                                   ; (all within the reserved $F48160-7F gap, ends $F48177)

; --- tab bar i18n scratch (same reserved gap, AFTER sst_idx; transient, only live during
;     igmenu_draw_tabbar, which never overlaps STATES/HELP -- the bar redraws BEFORE the
;     destination tab's enter runs, and enter re-derives its own lang). Words. ---
#define igm_tab_lang    $F48178    ; CFG.language clamped 0..IGM_LANG_COUNT-1
#define igm_tab_len     $F4817A    ; encoded label length (0..IGM_TAB_FIELD)
#define igm_tab_src     $F4817C    ; source byte offset of the label within bank $C2
                                   ; (ends $F4817D; reserved gap ends $F4817F)

; --- Slice 2 scratch (PSRAM $F4, free gap ABOVE OVL_RB $F48200-$F4823F, below OVL_TMBUF
;     $F49000). Args + temps for ig_recolor; ig_notch_end passes the notch title span from
;     ig_win_title to ig_draw_window. Always written before read. Accessed @long. Words.
;     (Defined HERE, before the first use in sst_/svs_draw_slot_row -- snescom resolves
;     #define constants in SOURCE order, unlike jsr label targets.) ---
#define ig_rc_row    $F48240
#define ig_rc_col    $F48242
#define ig_rc_end    $F48244    ; exclusive end column
#define ig_rc_pal    $F48246    ; palbase ($2800 green / $2C00 amber / $2400 dim)
#define ig_rc_tmp    $F48248
#define ig_rc_ei     $F4824A
#define ig_rc_addr   $F4824C
#define ig_notch_end $F4824E
#define sst_moved    $F48250    ; States/Saves: 1 if the cursor/active changed this frame -> repaint

; --- THEME scratch + the borrowed-state save areas (ig_theme_init / ig_theme_teardown).
;     HDMA cannot fetch its table from ROM/PSRAM (same reason the menu copies hdma_*_src into
;     WRAM and the $C0 hook borrows $7E0000-4 for its BGMODE table), so both of our tables live
;     in GAME WRAM, borrowed with a save/restore:
;       $7E0005..$7E0060 (92 B) = ch2 backdrop-gradient table ($2121/$2122, transfer mode 3)
;       $7E0061..$7E0073 (19 B) = ch5 selection-BAR colour-math table ($2131/$2132, mode 1)
;     $7E0000-4 belongs to the $C0 hook (its BGMODE flip table) -- NEVER touch it. The whole
;     borrowed run is saved to PSRAM and put back before the shell returns; the $43xx files of
;     the three channels we reprogram are saved/restored alongside (the $C0 exit restores all 8
;     channels from the game snapshot too, this just keeps the shell self-contained). ---
#define ig_hdma_mask   $F482F0  ; byte: $420C mask this session arms -- $2E (ch1|ch2|ch3|ch5)
                                ;   themed, $2A (ch1|ch3|ch5) on the baked fallback (no gradient
                                ;   channel; ch3 = the scanline-0 window mask, always on).
                                ;   $F482F1 is deliberate alignment padding, keep it unallocated.

; --- selection BAR (ig_bar_sync) scratch, in the block reserved for it above ig_hdma_mask
;     ($F482F2..$F482FF). Pure transients: ig_bar_sync writes all three every call before it
;     reads them, so nothing here survives a frame. Words, accessed @long. ---
#define ig_bar_row   $F482F2    ; target ABSOLUTE tile row (0-based) of the bar
#define ig_bar_xl    $F482F4    ; target left edge in LOGICAL columns (0..63, 4 window px each)
#define ig_bar_wl    $F482F6    ; target width in logical columns
#define ig_bar_tmp   $F482F8    ; scratch (word in the tab-capsule maths, byte in the reg writes)
#define mn_list_live $F482FA    ; word: 1 = the GUIDES tab body currently shows the guide LIST
                                ;   (manual_enter zeroes it on entry, mn_list sets it right before
                                ;   guides_list_draw). igb_t_guides keys the BAR off THIS instead of
                                ;   re-deriving the mn_chk_present gate, which would miss the error
                                ;   screen (man_error is consumed when drawn). Never read before
                                ;   manual_enter ran: focusing the tab implies its enter drew it.
; Spans per target, in logical columns. The body window's interior is cols 2..61 (see
; ig_frame_if_static), so 2/60 is a full-width row; the slot/guide spans are narrower so the
; bar hugs the text instead of the whole line.
#define IGB_LIST_XL   2         ; Cheats list row: the full interior width
#define IGB_LIST_WL   60
; (The old IGB_SLOT_*/IGB_GUIDE_* fixed spans are gone: the slot/guide BAR now spans the
;  content frame's INTERIOR, derived at sync time from ig_win_x/ig_win_w.)
#define ig_thm_wsave   $F48300  ; 120 B: image of $7E0005..$7E007C as we found it
#define ig_thm_ch2save $F48380  ; 12 B: game's $4320-$432B
#define ig_thm_ch5save $F4838C  ; 12 B: game's $4350-$435B
#define ig_thm_ch3save $F48398  ; 12 B: game's $4330-$433B (line-0 mask channel)
#define igm_tab_tint   $F483A8  ; word: tab-bar border palette this redraw -- $2C00 live (amber)
                                ;   or $2400 greyed (content focused, like the menu's disabled look)
#define igm_pos_focus  $F483AA  ; word: igmenu_flags bit1 at the last close, under the session
                                ;   magic -- a START-close from inside a list reopens INTO it
#define igm_pos_slot   $F483AC  ; word: sst_cursor at the last close (STATES/SAVES share it) --
                                ;   restored on a focused reopen so the BAR lands on the same slot
#define ig_win_x       $F483A4  ; per-tab frame geometry loaded by ig_frame_if_static (bytes):
#define ig_win_y       $F483A5  ;   x ODD and x+w-1 EVEN by table construction (left border
#define ig_win_w       $F483A6  ;   cell -> BG1, right -> BG2, the same parity split the old
#define ig_win_h       $F483A7  ;   fixed full-body frame relied on)
; (IGM_THM_GRAD_A, the 16-bit abs alias for the abs,Y reads in igt_grad_build, lives in
;  memmap.i65 right below IGM_THM_GRAD so the two can never drift apart silently.)

; --- MANUAL/GUIDES viewer. The viewer is SHARED SOURCE (snes/manviewer.i65 + its #define
;     companion below); it reaches the shell's transients and pad words through neutral
;     CONTRACT names, bound here. Macro-to-macro: snescom expands them nested at the use
;     site, so these lines stay comment-free (a trailing `;` would ride along). The viewer is
;     a modal sub-loop (man_modal bit0) that never runs concurrently with STATES/SAVES/HELP,
;     which is exactly why aliasing their sst_* draw transients is safe. ---
#define man_t_tmp       sst_tmp
#define man_t_slot      sst_scr_slot
#define man_t_coff      sst_scr_coff
#define man_t_entry     sst_scr_entry
#define man_t_row       sst_row
#define man_pad_cur     ovl_cur
#define man_pad_edge    ovl_edge
#define man_modal       igmenu_flags
#include "manviewer_defs.i65"      ; viewer scratch map + MN_POS_MAGIC/MN_TIMEOUT_HI/MN_Z_*/
                                   ; MN_S1_*/MN_FR_*/MN_HUD_* (the code include needs them
                                   ; in scope; the SAVES tab borrows MN_TIMEOUT_HI too)

; GUIDES tab-level scratch: the guide LIST cursor. Lives in the same $F4814A..$F4815F gap
; (hence the $F4814C hole in manviewer_defs.i65) but the viewer never touches it, so it stays
; host-side. Zeroed by igmenu_main -- PSRAM is stale.
#define man_list_cursor $F4814C    ; guide-list cursor when count>1

; SAVEINFO+42 = selected/next SRAM slot (0..3). SAVEINFO ($FF0730)|$2A does NOT reach $FF075A
; (low-nibble carry), so name the absolute byte here. Lockstep with SAVES tab SRM slot selector.
#define SRM_SEL_SLOT    $FF075A

; savestate active-slot byte (savestate.a65 CS_SLOT; NOT in memmap.i65 -> local define,
; lockstep with snes/savestate.i65). $FE100F is in the IS_PATCH $C0-FF window in-game, so
; @long reads/writes reach it exactly like the handler does. Byte semantics: 0 = slots
; off; 1..4 = active slot; bit7 = MCU-busy flag (we mask it on read, NEVER set it).
#define CS_SLOT         $FE100F

; STATES i18n string indices -- lockstep with STATES_LABELS order in gen_igmenu_lang.py.
#define IGM_ST_TITLE    0
#define IGM_ST_SLOT     1
#define IGM_ST_FULL     2
#define IGM_ST_EMPTY    3
#define IGM_ST_HINT     4
#define IGM_ST_DISABLED 5

; STATES layout (tile rows/logical columns; body is rows 4..23). WS-C: there are no marker
; glyphs -- the selection BAR shows the local cursor and a GREEN "SLOT n" label shows the
; committed active slot.
#define SST_HDR_ROW     6          ; centered header row
#define SST_SLOT_ROW0   9          ; first slot row
#define SST_SLOT_STEP   2          ; rows between slots -> 9,11,13,15
#define SST_HINT_ROW    19         ; centered save/load hint row
#define SST_DIS_ROW     13         ; centered "slots disabled" message row
                                   ; cols 18/20 (the retired '*' cursor / '>' active markers) are
                                   ;   deliberately left EMPTY: the selection BAR marks the cursor
                                   ;   and a GREEN label marks the committed slot (see ig_bar_sync)
#define SST_LABEL_COL   24         ; "SLOT" word column
#define SST_STATUS_COL  36         ; occupied/empty status column

; SAVES i18n string indices -- lockstep with SAVES_LABELS order in gen_igmenu_lang.py.
#define IGM_SV_TITLE    0
#define IGM_SV_NOSRAM   1
#define IGM_SV_FILE     2
#define IGM_SV_EXISTS   3
#define IGM_SV_MISSING  4
#define IGM_SV_SIZE     5
#define IGM_SV_WRITE    6
#define IGM_SV_AUTOSAVE 7
#define IGM_SV_ON       8
#define IGM_SV_OFF      9
#define IGM_SV_HINT_ON  10
#define IGM_SV_HINT_OFF 11
#define IGM_SV_SLOTTITLE 12        ; CICLO 2 SRAM slot selector (EnableSramSlots on)
#define IGM_SV_SLOT     13
#define IGM_SV_SLOTHINT 14

; SAVES tab layout (tile rows / logical columns; body is rows 4..23). Status-only. Left
; labels at SV_LABEL_COL, values at SV_VALUE_COL. The raw size/datetime strings come from
; the SAVEINFO ($FF0730) BSRAM block staged by the MCU; the end columns bound the raw copy
; (defence -- the MCU already NUL-terminates each field). Rows for size/write are only
; painted when the .srm exists (bit1); the body was cleared before enter, so blank is fine.
#define SV_TITLE_ROW    6          ; centered title row
#define SV_FILE_ROW     9          ; ".srm file:" + EXISTS/MISSING
#define SV_SIZE_ROW     11         ; "Size:" + raw size string
#define SV_WRITE_ROW    13         ; "Last write:" + raw datetime string
#define SV_AUTO_ROW     15         ; "Autosave:" + ON/OFF
#define SV_HINT_ROW     19         ; centered footer hint
#define SV_NOSRAM_ROW   13         ; centered "no battery save" message (bit0 == 0)
#define SV_LABEL_COL    16         ; left label column
#define SV_VALUE_COL    36         ; value / status column
#define SV_SIZE_OFF     1          ; SAVEINFO+1  size string (16B ASCII NUL)
#define SV_DT_OFF       17         ; SAVEINFO+17 datetime string (24B ASCII NUL)
#define SV_SIZE_ENDCOL  51         ; SV_VALUE_COL + 15 (size copy cap; snescom has no '/' or
#define SV_DT_ENDCOL    59         ;   safe '+' in defines -> precomputed end columns)

; MANUAL/GUIDES tab i18n string indices -- lockstep with MANUAL_LABELS order in gen_igmenu_lang.py.
#define IGM_MN_TITLE    0
#define IGM_MN_READ     1
#define IGM_MN_PAGES    2
#define IGM_MN_NOTFOUND 3
#define IGM_MN_ERROR    4
#define IGM_MN_GUIDE    5          ; fallback title word ("GUIDE N")
#define IGM_MN_SELECT   6          ; guide-list header (count>1)
#define IGM_MN_KEYS1    7          ; control legend line 1 (zoom / page turn)
#define IGM_MN_KEYS2    8          ; control legend line 2 (pan / close)
; document-type labels for an official GameDB doc, chosen by the `.man` header slug (title[0]=1..5).
; CONTIGUOUS so the slug maps to the index: IGM_MN_SLUG_MANUAL + (slug-1). Lockstep with MANUAL_LABELS.
#define IGM_MN_SLUG_MANUAL 9      ; slug 1 -> Manual
#define IGM_MN_SLUG_GUIDE  10     ; slug 2 -> Guide
#define IGM_MN_SLUG_MAP    11     ; slug 3 -> Map
#define IGM_MN_SLUG_INSERT 12     ; slug 4 -> Insert
#define IGM_MN_SLUG_OTHER  13     ; slug 5 -> Other

; MANUAL tab-level (mode-5 prompt) layout rows.
#define MN_TITLE_ROW    6          ; centered "GAME MANUAL"
#define MN_PAGES_ROW    11         ; centered "<N> pages"
#define MN_READ_ROW     15         ; centered "A: Read the manual"
#define MN_MSG_ROW      13         ; centered "not found" / "error" message
; Control legend. It lives on the TAB screen, not in the viewer: the 2x viewer draws its HUD
; from OBJ tiles, and the OBJ char base is only 16KB-alignable, which leaves exactly 16 tiles
; between VRAM 0 and the image pool -- 15 are already spent on "Pg", digits and '/'. Here the
; full menu font is available AND the text goes through the normal i18n path. The 1x view now
; also carries a compact neutral legend ("A:2X  L/R:Pg") drawn from its own OBJ glyphs (indices
; 15-18, uploaded on the 1x path only, where the OBJ base still has spare VRAM); the 2x view
; stays legend-less -- the 16-tile wall above is unchanged there.
#define MN_KEYS1_ROW    18
#define MN_KEYS2_ROW    19

; Shell mode-5 VRAM save. The shell footprint is NON-contiguous (confirmed vs main.a65
; genfonts + cheatoverlay setup): BG1 4bpp font @ VRAM word $0000-$1FFF (16KB), BG2 2bpp
; font @ word $4000-$4FFF (8KB), tilemaps @ word $5000/$5800. The viewer's mode-3 tiles
; (word $0000-$6FFF) clobber ALL of these. The 24KB MANUAL_SHELLSAVE buffer holds the two
; FONTS (16KB+8KB, packed at +0 and +$4000; CGRAM 512B at +$6000 per the contract); the
; tilemaps are REBUILT on exit (draw_tabbar/footer/manual_enter). genfonts is a $C0-only
; label the igmenu $C2 link cannot reference, so the font MUST be saved/restored (not
; regenerated).
#define MN_BG1_BYTES    $4000      ; BG1 font save/restore span (8192 words = 16KB) @ buf +0
#define MN_BG2_VMADD    $4000      ; BG2 font VRAM word base
#define MN_BG2_BYTES    $2000      ; BG2 font save/restore span (4096 words = 8KB)
#define MN_BUF_BG2      $4000      ; buffer byte offset of the BG2 font save ($C44000)
#define MN_BUF_CG       $6000      ; buffer byte offset of the CGRAM save ($C46000)

; --- GUIDES list (count>1): one row per guide, title from the MANUAL_GUIDES record; the
;     selection BAR (not a glyph) marks man_list_cursor. ---
#define GD_HDR_ROW      5          ; centered "SELECT A GUIDE" header
#define GD_LIST_ROW0    7          ; first guide row (up to 8 guides -> rows 7..14)
                                   ; col 16 (the retired '*' cursor) is left EMPTY -- the selection
                                   ;   BAR marks the guide-list cursor now (see ig_bar_sync)
#define GD_TITLE_COL    18         ; guide title column

#define IGMENU_TABS     4          ; AJUDA (tab 4) removed from the BAR by request -- its
                                   ;   code/tables stay (5 entries) for a future options screen
#define TABBAR_ROW      1          ; tab bar tile row (over the $C0 "CHEATS" title)
#define TABBAR_COL0     2          ; first tab's base logical column (tabs at 2/14/26/38/50)
#define IGM_TAB_FIELD   13         ; label field width (4 tabs x 15 = 60 cols)
                                   ;   guarded in gen_igmenu_lang.py (TAB_LABEL_MAX)
#define TABBAR_SLOT     15         ; sep(1) + field(13) + sep(1); bases 2/17/32/47
; Footer is PER FOCUS LEVEL x tab (igmenu_draw_footer reads igmenu_flags bit1): at the tab-bar
; level a universal tab-nav line; at the content level a per-tab line (Cheats advertises X /
; ON-OFF, the others a generic SELECT / BACK). All three live in ig_footer_str, concatenated in
; this order (tab-bar, Cheats-content, generic-content); the draw picks (offset, len, col).
#define IG_FT_TAB_COL   17         ; tab-bar footer start column ((64-30)/2)
#define IG_FT_TAB_LEN   30
#define IG_FT_CHT_COL   10         ; Cheats content footer start column ((64-44)/2)
#define IG_FT_CHT_LEN   44
#define IG_FT_GEN_COL   24         ; generic content footer start column ((64-15)/2)
#define IG_FT_GEN_LEN   15

; Master cheat switch status line (CHEATS tab only): row 2, between the tab bar (row 1)
; and the list body (rows 4..23). 11 chars: "CHEATS: ON " / "CHEATS: OFF".
#define IG_MASTER_ROW   3          ; row 2 belongs to the tab boxes' bottom border now
#define IG_MASTER_COL   26         ; (64-11)/2
#define IG_MASTER_LEN   11

; ======================================================================
;  Entry. Runs in forced blank (the $C0 hook fires BEFORE its unblank).
; ======================================================================
igmenu_main:
	sep #$20 : .as : rep #$10 : .xl
	; --- zero the shell vars (PSRAM is stale-from-last-open) ---
	rep #$30 : .al : .xl
	lda #$0000
	sta @igmenu_flags                       ; (active_tab is NOT cleared here: it persists across
	sta @igmenu_prevtab                     ;  close/reopen -- the session gate below inits it once)
	sta @man_list_cursor                    ; GUIDES tab-level cursor (host scratch; the viewer
	                                        ;   never reads it, so it is NOT in man_state_reset)
	jsr man_state_reset                     ; MANUAL viewer scratch + $ffff sentinels -- ONE
	                                        ;   source of truth, shared with the menu-side host
	                                        ;   (snes/manviewer.i65). Clobbers A; the next line
	                                        ;   reloads it.
	; --- reading position: keep it if a previous open in THIS game session saved one, otherwise
	;     initialise (PSRAM is stale, and page 0 is a legitimate value -- hence the magic). ---
	lda @man_pos_magic
	cmp #MN_POS_MAGIC
	beq igm_pos_kept
	lda #$0000
	sta @active_tab                             ; new game session -> open on Cheats (tab 0)
	sta @man_pos_guide
	sta @man_pos_block
	sta @man_pos_zoom
	sta @man_pos_zx
	sta @man_pos_zy
	sta @man_pos_s1y                            ; A still 0 -> saved 1x scroll defaults to top
	sta @igm_pos_focus                          ; fresh session -> open at the tab-bar level
	lda #MN_FR_X0 : sta @man_pos_frx            ; and the box to centre, for a fresh session
	lda #MN_FR_Y0 : sta @man_pos_fry
	lda #MN_POS_MAGIC : sta @man_pos_magic
igm_pos_kept:
	; --- reopen straight into the CONTENT when the shell was START-closed while focused
	;     (igm_pos_focus persists bit1 under the same magic; bit0/viewer never persists --
	;     the fresh-session path above just zeroed it, so this is safe on both paths) ---
	lda @igm_pos_focus
	and #$0002
	sta @igmenu_flags
	lda #IGMENU_TABS : sta @igmenu_tabcount
	; --- VRAM increment = +1 word after high byte (the $C0 draw setup already set this;
	;     re-assert so the bar/footer/body flushes are self-contained) ---
	sep #$20 : .as
	lda #$80 : sta @$002115
	; --- the selection BAR is now the ONLY cursor marker in the shell, so tell the shared cheat
	;     list to stop drawing its own '>' (cheatlist.i65 gates on this byte). The $C0 overlay
	;     zeroes it on every open BEFORE its first list paint, so this must be set before ours.
	;     A BYTE store: $F482E9 is deliberately unallocated (the reader does a 16-bit lda). ---
	lda #$01 : sta @OVL_CUR_OFF
	; --- restage the localized "(no name)" in OUR language table: the $C1 overlay
	;     already staged its own copy, but the shell owns every list paint from here on
	;     and must not depend on which host ran first. ---
	jsr igm_fill_noname
	rep #$30 : .al : .xl
	jsr ig_theme_init                        ; THEME: menu gradient/palettes + the BAR infrastructure
	                                         ;   (falls back to ig_init_palettes' baked palettes when
	                                         ;    the overlay staged no valid IGM_THM_* block)
	jsr ig_obj_load                          ; Sprites: upload tab icons to OBJ VRAM + enable OBJ
	; --- clear the tilemap rows NOBODY paints: 0 (above the tab bar) and 26/27 (below the
	;     footer). Neither the $C0 init nor ig_clear_body touches them, so they showed the
	;     GAME's leftover VRAM as a dashed garbage line across the top of the screen.
	;     DBR=$F4 first: ovl_row_clear/ovl_flush_abs address OVL_RB abs,X (same phb pattern
	;     as igmenu_draw_tabbar -- calling them without it fills a phantom bank and flushes
	;     whatever that bank held, which painted the rows with DENSER garbage on hardware). ---
	phb
	pea $f4f4 : plb : plb                   ; DBR = $F4, width-independent (we are in .al here
	                                        ;   and the code below stays .al -- no sep/rep)
	jsr ovl_row_clear
	ldx #$0000 : jsr ovl_flush_abs
	jsr ovl_row_clear
	ldx #$001a : jsr ovl_flush_abs
	jsr ovl_row_clear
	ldx #$001b : jsr ovl_flush_abs
	plb
	; --- draw the tab bar (row 1, over the "CHEATS" title) + footer (row 25). The Cheats
	;     list (rows 4-23) is ALREADY in VRAM from the $C0 init -> tab 0 needs no redraw. ---
	jsr igmenu_draw_tabbar
	jsr igmenu_draw_footer
	; --- draw the RESTORED tab's body (forced blank). Tab 0 (Cheats) is already in VRAM from the
	;     $C0 init and only needs its master-switch row; a restored non-zero tab needs its own body,
	;     so clear the $C0 Cheats chrome (master row + list) first, then enter that tab. ---
	lda @active_tab
	bne igm_open_other
	; tab 0 (Cheats): we open at the TAB-BAR level, so GREY the list (the $C0 init drew it normal,
	;   with a cursor). Still in forced blank; ovl_flush_dst=0 (VRAM) from the $C0 init.
	lda #$2400 : sta @ovl_pal               ; default: greyed (tab-bar level)...
	lda @igmenu_flags
	bit #$0002
	beq igm_open_pal_ok
	lda #$2000 : sta @ovl_pal               ; ...but START-closed while focused -> straight back in
igm_open_pal_ok:
	jsr ig_master_draw                      ; master-switch status, tinted via ovl_pal
	jsr ss_ovl_draw_rows                    ; repaint the list greyed (no cursor). THIS is also
	                                        ;   what erases the '>' the $C0 init drew before
	                                        ;   OVL_CUR_OFF was set: every visible row is rebuilt
	                                        ;   from a cleared OVL_RB and flushed straight to VRAM,
	                                        ;   so no extra ovl_scroll_dirty pass is needed (that
	                                        ;   would only queue a redundant rebuild+DMA a frame later)
	bra igm_open_drawn
igm_open_other:
	jsr ig_master_clear                     ; wipe the Cheats master row the $C0 init drew
	jsr ig_clear_body                       ; clear rows 4-23 (the $C0 Cheats list)
	lda @active_tab : asl : tax
	jsr (tab_enter_tbl, x)                  ; draw the restored tab's body
	jsr ig_frame_if_static                  ; Slice 1: beveled window frame (static tabs)
igm_open_drawn:
	; --- focused reopen of STATES/SAVES: put the slot cursor back where it was at the
	;     START-close (the tab's enter above re-initialised it to the active slot). Only the
	;     cursor VAR moves -- the committed-slot green recolor is untouched and the BAR sync
	;     below lands on the restored row. Clamped to the 1..4 slot range. ---
	lda @igmenu_flags
	bit #$0002
	beq igm_no_slotpos
	lda @active_tab : and #$00ff
	dec
	cmp #$0002                               ; tabs 1 (STATES) and 2 (SAVES) only
	bcs igm_no_slotpos
	lda @igm_pos_slot
	dec
	cmp #$0004                               ; saved cursor valid (1..4)?
	bcs igm_no_slotpos
	lda @igm_pos_slot
	sta @sst_cursor
igm_no_slotpos:
	jsr ig_obj_tabbar                        ; Sprites: build the tab-icon OAM (active highlighted)
	jsr ig_bar_sync                          ; place the selection BAR before the $420C arm: the
	                                         ;   restored tab's enter has run, so its cursor vars
	                                         ;   are live and the bar is right on the FIRST frame
	; --- seed pprev with the held opening combo so it makes no fresh edge.  Samples the
	;     LIVE pad, so it is agnostic to which combo is armed (IngameButtonsMenu). ---
	lda @$004218 : sta @ovl_pprev
	; --- arm the theme's HDMA channels. LAST thing before the unblank, not inside
	;     ig_theme_init: HDMA keeps running in forced blank, so an armed gradient channel
	;     (which drives $2121/$2122 every band) would cut into the CGRAM address/data pairs
	;     ig_obj_load and the tab draws still write above.
	;     ON A VBLANK EDGE: enabling a channel MID-frame makes the hardware run the REST of
	;     that frame with the channel's STALE A2A pointer (the A1T reload only happens at
	;     V=0 init) -> one frame of garbage fetches sprayed at $2121/$2122/$2131 -- seen on
	;     hardware as permanently shredded CGRAM (the writes land before our palettes are
	;     ever re-written). At vblank start no visible lines remain, so zero stale transfers
	;     happen before the clean V=0 init. ---
	sep #$20 : .as
	- lda @$004212 : bmi -                   ; wait until active display...
	- lda @$004212 : bpl -                   ; ...then the vblank START edge
	lda @ig_hdma_mask : sta @$00420c         ; ch1|ch3|ch5 baked ($2A) / +ch2 themed ($2E)
	; --- unblank ---
	lda #$0f : sta @$002100
	; --- START-closed from inside the manual viewer: dive straight back in (same as pressing
	;     A on the saved guide; the viewer's own position resume handles page/zoom). Guarded by
	;     the present/abi gate -- if the .man vanished between sessions, stay on the tab. ---
	rep #$20 : .al
	lda @igm_pos_focus
	and #$0001
	beq igm_no_autoview
	lda @active_tab : and #$00ff
	cmp #$0003
	bne igm_no_autoview
	sep #$20 : .as
	lda @MANUAL_META|$0002
	cmp #MANUAL_META_ABI
	bne igm_no_autoview_s
	lda @MANUAL_META
	and #$01
	beq igm_no_autoview_s
	rep #$20 : .al
	lda @man_pos_guide : sta @man_sel_guide ; the guide the saved position belongs to
	jsr manual_viewer_enter
	bra igm_no_autoview
igm_no_autoview_s:
	rep #$20 : .al
igm_no_autoview:

; ---- input loop: mirrors the $C0 overlay boilerplate (vblank sync + auto-joypad
;      START-then-DONE + edge detect). Left/Right = tab switch (top level), L/R = first/last
;      tab; B = close (rtl); A focuses the active tab's content. ----
igmenu_loop:
	sep #$20 : .as
	- lda @$004212 : bpl -                  ; wait until vblank
	- lda @$004212 : and #$01 : beq -       ; auto-joypad read START (bit0 set)
	- lda @$004212 : and #$01 : bne -       ; auto-joypad read DONE (bit0 clear)
	rep #$20 : .al
	lda @$004218                            ; fresh pad
	sta @ovl_cur
	eor @ovl_pprev
	and @ovl_cur                            ; (cur ^ prev) & cur = newly pressed
	sta @ovl_edge
	lda @ovl_cur
	sta @ovl_pprev
	sep #$20 : .as
	; --- flush the Cheats list rebuilt last frame (if any), here in vblank ---
	lda @ovl_dma_pending
	beq ig_no_dma
	jsr ovl_dma_list
	lda #$00 : sta @ovl_dma_pending
ig_no_dma:
	; --- reposition the selection BAR for the CURRENT state, still inside the vblank window:
	;     the ch5 HDMA re-reads its table pointer at V=0, so rewriting the two count bytes and
	;     the window regs here is atomic from the PPU's point of view. Unconditional (the
	;     routine itself early-outs in the manual viewer, where HDMA is off entirely). ---
	jsr ig_bar_sync
	; --- START = leave the in-game menu IMMEDIATELY, from any tab/focus level. Everything
	;     needed to come back "exactly here" persists in PSRAM (active_tab + manual position
	;     via the session magic; the cheat-list top/selrow are kept by the $C0 init under the
	;     same magic). Not inside the manual viewer: its input owns the pad there. ---
	rep #$20 : .al
	lda @igmenu_flags
	bit #$0001
	sep #$20 : .as
	bne ig_start_viewer                     ; viewer open -> unwind it first (below)
	rep #$20 : .al
	lda @ovl_edge
	bit #$1000                              ; START (fresh edge)
	sep #$20 : .as
	beq ig_no_start
	jmp ig_close                            ; same teardown+rtl as B at the tab-bar level
ig_start_viewer:
	rep #$20 : .al
	lda @ovl_edge
	bit #$1000                              ; START inside the manual viewer: exit the viewer
	sep #$20 : .as                          ;   exactly like B (saves the reading position +
	beq ig_no_start                         ;   restores the shell), then close on top of it
	jsr man_viewer_exit
	rep #$20 : .al
	lda #$0003 : sta @igm_pos_focus         ; focused + VIEWER: the reopen dives back into the
	sep #$20 : .as                          ;   manual (position resume does the rest)
	jmp ig_close_done
ig_no_start:
	; --- MANUAL viewer sub-mode (Phase 5): while igmenu_flags bit0 is set the image
	;     viewer owns all input -- route to manual_viewer_input and skip B-close / L / R /
	;     tab dispatch entirely (L/R disabled in the viewer). ---
	rep #$20 : .al
	lda @igmenu_flags
	bit #$0001
	sep #$20 : .as
	beq ig_not_viewer
	jsr manual_viewer_input
	jmp ig_loop_tail
ig_not_viewer:
	; --- FOCUS LEVEL (igmenu_flags bit1): SET = content focused -- the active tab owns Up/Down / L /
	;     R / A, and B backs out to the tab bar (does NOT close). CLEAR = tab bar -- Left/Right switch
	;     tabs 1-by-1, L/R jump to first/last tab, A focuses the content, B closes. This is what puts
	;     the Cheats list "at a second level": greyed while Left/Right switch tabs, then A focuses it
	;     and L/R become Top/Bottom of the list (B -> tab bar). ---
	rep #$20 : .al
	lda @igmenu_flags
	bit #$0002
	sep #$20 : .as
	beq ig_tabbar_lvl
	; === content-focused level: the active tab owns input; B leaves focus (back to the tab bar) ===
	rep #$20 : .al
	lda @ovl_edge
	bit #$8000                              ; B -> back to the tab bar (re-grey), NOT close
	sep #$20 : .as
	beq ig_content_disp
	jsr ig_focus_leave
	jmp ig_loop_tail
ig_content_disp:
	jsr ig_dispatch_input                   ; active tab's input (A / L R / <- -> / Up Down)
	jsr ig_dispatch_tick                    ; active tab's tick (Cheats marquee)
	; rebuild the Cheats list if dirty (active display); the DMA at loop top flushes it next vblank
	lda @ovl_scroll_dirty
	bne ig_cd_rebuild                       ; dirty -> rebuild (short branch, in range)
	jmp ig_loop_tail                        ; not dirty -> tail. (Inverted + jmp: the tab-bar block
	                                         ;   below grew, pushing ig_loop_tail out of beq range.)
ig_cd_rebuild:
	jsr ovl_build_list_to_buf
	lda #$01 : sta @ovl_dma_pending
	lda #$00 : sta @ovl_scroll_dirty
	jmp ig_loop_tail
ig_tabbar_lvl:
	; === tab-bar level: L/R jump to FIRST/LAST tab, Left/Right switch tabs 1-by-1, A focuses the
	;     content, B closes. (Mirrors the content level: shoulder = extremes, d-pad = increment.) ===
	rep #$20 : .al
	lda @ovl_edge
	bit #$8000                              ; B -> close (return to the $C0 hook -> ss_ovl_do_exit)
	sep #$20 : .as
	beq ig_tb_chk_l
ig_close:
	rep #$20 : .al
	lda @igmenu_flags
	and #$0002
	sta @igm_pos_focus                      ; persist the focus level: a START-close from inside
	                                        ;   a list reopens straight into that list
	lda @sst_cursor
	sta @igm_pos_slot                       ; and the STATES/SAVES slot cursor (harmless for
	                                        ;   the other tabs; only consumed for tabs 1/2)
	sep #$20 : .as
ig_close_done:
	jsr ig_theme_teardown                   ; give the borrowed game WRAM + ch2/ch5 back BEFORE
	                                        ;   the hook's restore runs (the ONLY exit from here)
	rtl
ig_tb_chk_l:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0020                              ; L -> FIRST tab (começo)
	sep #$20 : .as
	beq ig_tb_chk_r
	jsr ig_tab_first
	jmp ig_loop_tail
ig_tb_chk_r:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0010                              ; R -> LAST tab (fim)
	sep #$20 : .as
	beq ig_tb_chk_lt
	jsr ig_tab_last
	jmp ig_loop_tail
ig_tb_chk_lt:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0200                              ; Left (d-pad) -> previous tab (1 by 1)
	sep #$20 : .as
	beq ig_tb_chk_rt
	jsr ig_tab_prev
	jmp ig_loop_tail
ig_tb_chk_rt:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0100                              ; Right (d-pad) -> next tab (1 by 1)
	sep #$20 : .as
	beq ig_tb_chk_a
	jsr ig_tab_next
	jmp ig_loop_tail
ig_tb_chk_a:
	rep #$20 : .al
	lda @ovl_edge
	bit #$0080                              ; A -> focus the active tab's content
	sep #$20 : .as
	beq ig_loop_tail
	jsr ig_focus_enter
	jmp ig_loop_tail
ig_loop_tail:
	sep #$20 : .as
	- lda @$004212 : bmi -                  ; wait out of vblank
	jmp igmenu_loop

; ======================================================================
;  Tab dispatch. Each tab = {enter, input, tick, leave}; tab 0 (Cheats) reuses the
;  cheatlist.i65 routines, tabs 1-4 have their own handlers. Indirect jsr through the tables
;  (jsr (tbl,x), x = active_tab*2), same pattern as menu.a65's value-dialog dispatch.
; ======================================================================
ig_dispatch_input:
	php
	rep #$30 : .al : .xl
	lda @active_tab : asl : tax
	jsr (tab_input_tbl, x)
	plp
	rts

ig_dispatch_tick:
	php
	rep #$30 : .al : .xl
	lda @active_tab : asl : tax
	jsr (tab_tick_tbl, x)
	plp
	rts

; ---- two-level focus: A at the tab bar drills into the active tab's content (per-tab handler via
;      tab_focus_tbl); B at the content level backs out. igmenu_flags bit1 = "content focused"
;      (bit0 is the deeper manual-viewer sub-mode). ----
ig_focus_enter:
	php
	rep #$30 : .al : .xl
	lda @active_tab : asl : tax
	jsr (tab_focus_tbl, x)
	plp
	rts

; ---- B at the content level: drop content focus and return to the tab bar. Only the Cheats tab
;      has a focused-vs-greyed visual, so re-grey + repaint just that one (forced blank). ----
ig_focus_leave:
	php
	rep #$30 : .al : .xl
	lda @igmenu_flags : and #$fffd : sta @igmenu_flags   ; clear bit1 (content focus)
	sep #$20 : .as
	lda #$80 : sta @$002100                              ; force blank (both paths redraw the footer)
	rep #$30 : .al : .xl
	lda @active_tab
	bne ifl_footer                                        ; non-Cheats tabs have no grey list
	lda #$2400 : sta @ovl_pal                            ; greyed (palette 1); cursor hidden
	lda #$0000 : sta @ovl_flush_dst                      ; draw straight to VRAM
	lda #$0000 : sta @ovl_mq_xscroll                     ; no marquee shift on the greyed selection
	jsr ig_master_draw                                    ; master row (greyed via ovl_pal)
	jsr ss_ovl_draw_rows                                  ; the list, greyed
ifl_footer:
	jsr igmenu_draw_tabbar                                ; re-tint the bar LIVE (bit1 cleared above)
	jsr igmenu_draw_footer                                ; tab-bar footer (bit1 cleared above)
	jsr ig_bar_sync                                       ; BAR back onto the tab capsule, BEFORE
	                                                      ;   the unblank (no 1-frame lag)
	sep #$20 : .as
	lda #$0f : sta @$002100                              ; unblank
	rep #$30 : .al : .xl
	plp
	rts

; ---- tab_focus_tbl[1..4]: STATES/SAVES/GUIDES/HELP just take content focus (their input handler
;      becomes live); no grey visual. (GUIDES: manual_input then handles A -> enter the viewer.) ----
ig_focus_setbit1:
	php
	rep #$30 : .al : .xl
	lda @igmenu_flags : ora #$0002 : sta @igmenu_flags   ; content focus (bit1)
	sep #$20 : .as
	lda #$80 : sta @$002100                              ; force blank
	rep #$30 : .al : .xl
	jsr igmenu_draw_tabbar                                ; re-tint the bar GREYED (bit1 set above)
	jsr igmenu_draw_footer                                ; content-level footer (generic tab)
	jsr ig_bar_sync                                       ; BAR onto this tab's content cursor
	sep #$20 : .as
	lda #$0f : sta @$002100                              ; unblank
	rep #$30 : .al : .xl
	plp
	rts

; ---- tab_focus_tbl[0]: focus the Cheats list -- take content focus, un-grey + repaint with the
;      cursor (forced blank). ----
cheats_focus:
	php
	rep #$30 : .al : .xl
	lda @igmenu_flags : ora #$0002 : sta @igmenu_flags   ; content focus (bit1)
	sep #$20 : .as
	lda #$80 : sta @$002100                              ; force blank
	rep #$30 : .al : .xl
	lda #$2000 : sta @ovl_pal                            ; focused (palette 0), cursor shown
	lda #$0000 : sta @ovl_flush_dst
	jsr ig_master_draw
	jsr ss_ovl_mq_reset                                   ; restart marquee for the selection
	jsr ss_ovl_draw_rows                                  ; list, normal ('>' suppressed by OVL_CUR_OFF)
	jsr igmenu_draw_tabbar                                ; re-tint the bar GREYED (bit1 set above)
	jsr igmenu_draw_footer                                ; content-level footer (Cheats list hints)
	jsr ig_bar_sync                                       ; BAR onto the selected list row
	sep #$20 : .as
	lda #$0f : sta @$002100                              ; unblank
	rep #$30 : .al : .xl
	plp
	rts

; ---- R: next tab (clamp at tabcount-1) ----
ig_tab_next:
	php
	rep #$30 : .al : .xl
	lda @active_tab
	inc
	cmp @igmenu_tabcount
	bcs ig_tn_stay                          ; >= count -> stay
	jsr ig_switch_to                        ; A = new tab
ig_tn_stay:
	plp
	rts

; ---- L: previous tab (clamp at 0) ----
ig_tab_prev:
	php
	rep #$30 : .al : .xl
	lda @active_tab
	beq ig_tp_stay                          ; already 0
	dec
	jsr ig_switch_to                        ; A = new tab
ig_tp_stay:
	plp
	rts

; ---- shoulder-L: jump to the FIRST tab (começo) ----
ig_tab_first:
	php
	rep #$30 : .al : .xl
	lda @active_tab
	beq ig_tf_stay                          ; already on tab 0
	lda #$0000
	jsr ig_switch_to                        ; A = 0 (first tab)
ig_tf_stay:
	plp
	rts

; ---- shoulder-R: jump to the LAST tab (fim = tabcount-1) ----
ig_tab_last:
	php
	rep #$30 : .al : .xl
	lda @igmenu_tabcount
	dec                                     ; A = last tab index
	cmp @active_tab
	beq ig_tl_stay                          ; already on the last tab
	jsr ig_switch_to                        ; A = tabcount-1 (last tab)
ig_tl_stay:
	plp
	rts

; ---- switch to tab in A: leave(prev) -> set active -> forced-blank redraw (bar + clear
;      body + enter(new)) -> unblank. Forced blank means a brief flash on switch, which is
;      fine for a menu and sidesteps the vblank budget for a whole-body redraw. ----
ig_switch_to:                                   ; A (16-bit) = new tab index
	php
	rep #$30 : .al : .xl
	pha                                     ; stash new tab
	lda @active_tab : sta @igmenu_prevtab
	asl : tax
	jsr (tab_leave_tbl, x)                   ; leave(prevtab)
	jsr ig_fade_out                          ; brightness ramp down + blank (kills the hard
	                                         ;   black blink the instant $80 write had)
	pla                                     ; new tab
	sta @active_tab
	; kill any pending Cheats pipeline so a stale list DMA can't paint over the new tab
	lda #$0000
	sta @ovl_scroll_dirty
	sta @ovl_dma_pending
	sep #$20 : .as
	lda #$80 : sta @$002115                 ; VRAM inc +1 word (safety)
	rep #$30 : .al : .xl
	lda #$2000 : sta @ovl_pal                ; chrome + non-Cheats bodies draw in palette 0 (the
	                                         ;   Cheats tab_enter re-greys to $2400 for its list only)
	jsr igmenu_draw_tabbar                   ; re-highlight the active tab
	jsr igmenu_draw_footer                   ; hints are per tab (X only exists on CHEATS)
	jsr ig_clear_body                        ; clear rows 4-23
	lda @active_tab : asl : tax
	jsr (tab_enter_tbl, x)                    ; draw the new tab's body (forced blank)
	jsr ig_frame_if_static                    ; Slice 1: beveled window frame (static tabs)
	jsr ig_obj_tabbar                         ; Sprites: rebuild the tab-icon OAM (active highlight)
	jsr ig_bar_sync                           ; BAR onto the NEW tab's capsule, before the unblank
	jsr ig_fade_in                            ; brightness ramp back up
	plp
	rts

; ======================================================================
;  Tab 0 = Cheats (reuses cheatlist.i65). L/R are the tab switch now, so NO home/end.
; ======================================================================
cheats_enter:                                   ; forced blank: repaint the cheat list
	php
	rep #$30 : .al : .xl
	lda #$0000 : sta @ovl_flush_dst          ; draw straight to VRAM (not OVL_TMBUF)
	lda #$2400 : sta @ovl_pal                 ; entered at the tab-bar level -> greyed (palette 1)
	jsr ig_master_draw                        ; master-switch status line (row 2)
	jsr ss_ovl_mq_reset                       ; restart the marquee for the selection
	lda @ovl_count
	beq ce_empty
	jsr ss_ovl_draw_rows
	bra ce_done
ce_empty:
	jsr ss_ovl_draw_empty
ce_done:
	plp
	rts

cheats_input:
	php
	; A ($0080) -> toggle
	rep #$20 : .al
	lda @ovl_edge : bit #$0080
	sep #$20 : .as
	beq ci_no_a
	jsr ss_ovl_toggle
ci_no_a:
	; Left ($0200) -> page up
	rep #$20 : .al
	lda @ovl_edge : bit #$0200
	sep #$20 : .as
	beq ci_no_lt
	jsr ss_ovl_page_up
ci_no_lt:
	; Right ($0100) -> page down
	rep #$20 : .al
	lda @ovl_edge : bit #$0100
	sep #$20 : .as
	beq ci_no_rt
	jsr ss_ovl_page_down
ci_no_rt:
	; L ($0020) -> jump to the FIRST cheat (Top). At the content-focus level L/R are OURS now --
	;   the tab bar owns them only when the list is not focused (the two-level model).
	rep #$20 : .al
	lda @ovl_edge : bit #$0020
	sep #$20 : .as
	beq ci_no_l
	jsr ss_ovl_home
ci_no_l:
	; R ($0010) -> jump to the LAST cheat (Bottom)
	rep #$20 : .al
	lda @ovl_edge : bit #$0010
	sep #$20 : .as
	beq ci_no_r
	jsr ss_ovl_end
ci_no_r:
	; X ($0040) -> MASTER cheat switch (Cheats tab only: cheats_input dispatches for
	;   active_tab 0; the other tabs use their own input handler, so X is inert there)
	rep #$20 : .al
	lda @ovl_edge : bit #$0040
	sep #$20 : .as
	beq ci_no_x
	jsr ig_master_toggle
ci_no_x:
	jsr ss_ovl_nav_vert                       ; Up/Down with auto-repeat
	plp
	rts

; ---- X: MASTER cheat switch -- the SAME global on/off the L+R+Start+A (on) and
;      L+R+Start+B (off) combos drive. It is NOT a per-cheat toggle: the CHEAT_FLAGS
;      mirror is left untouched, so switching the master back ON restores exactly the
;      selection the user had.
;        The switch itself lives in the FPGA (cheat_enable in cheat.v). cheat.v decodes
;      a write of $82/$83 to MCU_CMD ($002A00) made under snescmd_unlock -- which is
;      precisely how the combos work (nmi_echocmd echoes NMI_CMD into MCU_CMD) -- so the
;      store below flips ROM cheats AND WRAM cheats (branch_wram = cheat_enable &
;      wram_present) the instant it lands, with the game still frozen.
;        The MCU sees the same command and syncs CFG.enable_cheats (main.c), so a later
;      cheat_program() -- e.g. the CMD_CHEAT_REPROGRAM fired when the overlay closes --
;      cannot silently undo it. That sync is why we spin for the ACK before returning:
;      leaving the command unread would let the close-time CHEAT_REPROGRAM overwrite
;      MCU_CMD first. The spin is bounded (saves_wait_ack) and can never hang the SNES.
;        CHEAT_MASTER ($FF071A) is the UI mirror: written here, read by ig_master_draw,
;      republished by the firmware on every cheat_program. ----
ig_master_toggle:
	php
	sep #$20 : .as
	rep #$10 : .xl
	lda @CHEAT_MASTER
	beq igm_ms_on                             ; currently OFF -> turn ON
	lda #$00 : sta @CHEAT_MASTER              ; currently ON -> turn OFF
	jsr ig_master_draw                        ; repaint row 2 while still in vblank
	lda #$83                                  ; CMD_DISABLE_CHEATS
	bra igm_ms_send
igm_ms_on:
	lda #$01 : sta @CHEAT_MASTER
	jsr ig_master_draw
	lda #$82                                  ; CMD_ENABLE_CHEATS
igm_ms_send:
	sta @MCU_CMD                              ; FPGA applies it on this very write
	jsr saves_wait_ack                        ; bounded: MCU clears MCU_CMD when synced
	plp
	rts

; ---- master-switch status line, absolute tile row IG_MASTER_ROW (2 -- between the tab
;      bar on row 1 and the list body on 4..23). Drawn on entering the CHEATS tab and on
;      every X toggle; ig_master_clear wipes it when leaving the tab, so the line only
;      ever shows where X actually does something. One full row = one flush, which fits
;      the vblank budget (the list redraw batches TWO rows per frame). ----
ig_master_draw:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                      ; DBR=$F4 (OVL_RB abs writes)
	rep #$30 : .al : .xl
	jsr ovl_row_clear
	lda @CHEAT_MASTER
	and #$00ff                                ; byte value (the next BSRAM byte is not ours)
	beq igm_md_off
	ldx #$0000                                ; "CHEATS: ON "
	bra igm_md_copy
igm_md_off:
	ldx #IG_MASTER_LEN                        ; "CHEATS: OFF"
igm_md_copy:
	ldy #IG_MASTER_COL
	sep #$20 : .as
igm_md_l:
	lda @ig_master_str, x
	sta OVL_RB, y
	inx : iny
	cpy #(IG_MASTER_COL+IG_MASTER_LEN)
	bne igm_md_l
	rep #$30 : .al : .xl
	ldx #IG_MASTER_ROW
	jsr ovl_flush_abs
	plb
	plp
	rts

; ---- wipe the status line (leaving the CHEATS tab). Forced blank (ig_switch_to). ----
ig_master_clear:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb
	rep #$30 : .al : .xl
	jsr ovl_row_clear                         ; OVL_RB = 64 spaces
	ldx #IG_MASTER_ROW
	jsr ovl_flush_abs
	plb
	plp
	rts

; ---- stage the localized "(no name)" the shared cheat list draws for a cheat whose
;      YAML carries no name. The firmware sends an EMPTY CHEAT_NAMES entry for those and
;      cheatlist.i65 (shared source, no host symbols) reads the string from
;      OVL_NONAME_BUF, so each host stages it in its own language before the first paint.
;      Same shape as help_enter: CFG.language from the CFG BSRAM mirror, clamped, then
;      one NUL-terminated font-encoded run out of igmenu_lang.i65 (bank $C2). ----
igm_fill_noname:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                       ; DBR=$F4 (OVL_NONAME_A abs,Y stores)
	lda @CFG_LANGUAGE                           ; CFG.language 0=EN..4=FR ($FF01B7)
	cmp #IGM_LANG_COUNT
	bcc ifn_lang_ok
	lda #$00                                    ; out of range -> English (column 0)
ifn_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	asl                                        ; igm_cheats_tbl has ONE line -> lang*2
	tax
	lda @igm_cheats_tbl, x                      ; A = string offset within bank $C2
	tax
	ldy #$0000
	sep #$20 : .as
ifn_copy:
	lda @$c20000, x                             ; long,X source byte (bank $C2)
	beq ifn_done
	sta OVL_NONAME_A, y                        ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #(OVL_NONAME_MAX-1)
	bne ifn_copy
ifn_done:
	lda #$00
	sta OVL_NONAME_A, y
	plb
	plp
	rts

cheats_tick:
	jsr ss_ovl_marquee
	rts

cheats_leave:
	jsr ig_master_clear                       ; X is CHEATS-only -> so is its status line
	rts

ig_noop:
	rts

; ======================================================================
;  Tab 4 (HELP): static i18n controls/hooks reference. Forced blank (direct VRAM).
;  Reads CFG.language from the CFG BSRAM mirror ($FF01B7 = CFG_LANGUAGE, readable
;  in-game under IS_PATCH exactly like CHEAT_FLAGS), clamps to 0..IGM_LANG_COUNT-1,
;  then draws IGM_HELP_NLINES font-encoded lines from igmenu_lang.i65. The row +
;  start column per line come from igm_help_rows/igm_help_cols (layout, language-
;  independent). Each source string is a NUL-terminated, already-encoded run in bank
;  $C2, read via `lda @$c20000, x` (long,X). Input/tick are ig_noop for this tab.
; ======================================================================
help_enter:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                       ; DBR=$F4 (OVL_RB abs writes)
	lda @CFG_LANGUAGE                           ; CFG.language 0=EN..4=FR ($FF01B7)
	cmp #IGM_LANG_COUNT
	bcc he_lang_ok
	lda #$00                                    ; out of range -> English (column 0)
he_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	sta @help_lang
	lda #$0000 : sta @help_lineno
he_loop:
	lda @help_lineno
	cmp #IGM_HELP_NLINES
	bcc he_body
	jmp he_done
he_body:
	jsr ovl_row_clear                          ; OVL_RB = 64 spaces (DBR=$F4)
	; --- dest column = igm_help_cols[lineno] -> Y ---
	lda @help_lineno : tax
	sep #$20 : .as
	lda @igm_help_cols, x                       ; long,X byte (bank $C2)
	rep #$30 : .al : .xl
	and #$00ff
	tay                                        ; Y = dest column in OVL_RB
	; --- source offset = igm_help_tbl[(lineno*IGM_LANG_STRIDE + lang)*2] ---
	;     IGM_LANG_SHIFT asl == *IGM_LANG_STRIDE. The row stride is a power of two
	;     precisely so adding a language never touches this arithmetic; the generator
	;     hard-fails the build if the language count ever outgrows the stride.
	lda @help_lineno
	asl : asl : asl                            ; lineno*8 (IGM_LANG_STRIDE)
	clc : adc @help_lang                       ; + lang column
	asl                                        ; *2 (word index)
	tax
	lda @igm_help_tbl, x                        ; A = string offset within bank $C2
	tax                                        ; X = source byte offset
	sep #$20 : .as
he_copy:
	lda @$c20000, x                             ; long,X source byte (bank $C2)
	beq he_copy_done
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #IG_HELP_MAXCOL
	bne he_copy
he_copy_done:
	; --- section headers (line 0 = IN-GAME CONTROLS, line 6 = MENU KEYS) in cyan accent ---
	rep #$30 : .al : .xl
	lda @help_lineno
	beq hh_hdr
	cmp #$0006
	beq hh_hdr
	lda #$2000 : sta @ovl_pal
	bra hh_paldone
hh_hdr:
	lda #$2c00 : sta @ovl_pal
hh_paldone:
	; --- flush the built row to igm_help_rows[lineno] ---
	lda @help_lineno : tax
	sep #$20 : .as
	lda @igm_help_rows, x                       ; long,X row byte (bank $C2)
	rep #$30 : .al : .xl
	and #$00ff
	tax                                        ; X = absolute tile row
	jsr ovl_flush_abs                           ; de-interleave OVL_RB -> BG1/BG2 (clobbers X/Y)
	lda @help_lineno : inc : sta @help_lineno
	jmp he_loop
he_done:
	lda #$2000 : sta @ovl_pal                    ; restore white for later draws
	plb
	plp
	rts

; ======================================================================
;  Tab 1 (STATES): savestate slot selector (SELECTION-ONLY -- save/load stay on the
;  Start+R / Start+L combos). states_enter draws the whole body in forced blank (called
;  from ig_switch_to). Afterwards only COLOUR changes, so states_input does cheap
;  single-cell tilemap recolours in the input loop (the vblank window, like the cheat
;  overlay's ss_ovl_draw_cursor/flag) -- NO full-body redraw outside forced blank.
;    WS-C: no marker glyphs any more. The selection BAR (ig_bar_sync) shows the local
;    cursor; the committed active slot (from CS_SLOT) is the row whose "SLOT n" label is
;    GREEN. Up/Down move the cursor (edge, no auto-repeat -- only 4 items) and draw
;    nothing at all; A commits the cursor to CS_SLOT (pure byte 1..4, bit7 NEVER set) and
;    moves the green label. Slots off -> a message and input ignored.
;    states_tick/leave = ig_noop (in the dispatch tables).
; ======================================================================
states_enter:                                   ; forced blank (ig_switch_to)
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                      ; DBR=$F4 (OVL_RB abs writes)
	; --- language (0..IGM_LANG_COUNT-1) ---
	lda @CFG_LANGUAGE                           ; $FF01B7
	cmp #IGM_LANG_COUNT
	bcc se_lang_ok
	lda #$00
se_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	sta @sst_lang
	; --- slots enabled? (CFG mirror $FF01A5) ---
	sep #$20 : .as
	lda @CFG_ENABLE_SAVESTATE_SLOTS
	rep #$30 : .al : .xl
	and #$00ff
	bne se_enabled
	; disabled: one centered message, input ignored (states_input early-outs)
	lda #$0001 : sta @sst_disabled
	lda #IGM_ST_DISABLED : ldx #SST_DIS_ROW
	jsr sst_draw_centered
	plb
	plp
	rts
se_enabled:
	lda #$0000 : sta @sst_disabled
	; --- active slot = CS_SLOT & $7F, 0 -> 1, clamp 1..4 ---
	sep #$20 : .as
	lda @CS_SLOT                               ; $FE100F
	and #$7f
	rep #$30 : .al : .xl
	and #$00ff
	bne se_have_slot
	lda #$0001                                ; 0 -> slot 1
se_have_slot:
	cmp #$0005
	bcc se_slot_ok                            ; < 5 -> in range
	lda #$0004                                ; clamp to 4
se_slot_ok:
	sta @sst_active
	sta @sst_cursor                           ; cursor starts on the active slot
	; --- header (cyan accent, the menu frame palette) ---
	lda #$2c00 : sta @ovl_pal
	lda #IGM_ST_TITLE : ldx #SST_HDR_ROW
	jsr sst_draw_centered
	lda #$2000 : sta @ovl_pal
	; --- 4 slot rows (slot 1..4) ---
	lda #$0001 : sta @sst_scr_slot
se_row_loop:
	jsr sst_draw_slot_row                      ; reads sst_scr_slot (unchanged)
	lda @sst_scr_slot : inc : sta @sst_scr_slot
	cmp #$0005
	bcc se_row_loop
	; --- save/load hint ---
	lda #IGM_ST_HINT : ldx #SST_HINT_ROW
	jsr sst_draw_centered
	plb
	plp
	rts

; ---- build one slot row into OVL_RB and flush to its absolute tile row. sst_scr_slot
;      (word) = slot 1..4. Assumes DBR=$F4 (forced blank). Preserves sst_scr_slot. ----
sst_draw_slot_row:
	php
	rep #$30 : .al : .xl
	jsr ovl_row_clear                          ; OVL_RB = 64 spaces
	; WS-C: NO '*' cursor and NO '>' active marker any more -- cols 18/20 stay blank. The
	; selection BAR (ig_bar_sync) marks the CURSOR, which frees colour to mean "committed
	; slot": the green label recolour at the tail of this routine.
	; "SLOT" label; sst_copy returns Y = end column
	lda #IGM_ST_SLOT
	ldy #SST_LABEL_COL
	jsr sst_copy
	; digit right after the label (a space, then '0'+slot)
	iny
	sep #$20 : .as
	lda @sst_scr_slot
	clc : adc #$30                             ; '0' + slot
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	; status word: bit (slot-1) of SS_SLOT_STATUS -> OCCUPIED / EMPTY
	; (65816 has no ldx/stx long: keep the shift count in Y, the bitmask in A)
	rep #$20 : .al                             ; 16-bit A: tay must not inherit stale B
	lda @sst_scr_slot
	and #$00ff                                 ; canonical clean-high-byte before tay
	dec
	tay                                        ; Y = slot-1 (shift count)
	sep #$20 : .as
	lda @SS_SLOT_STATUS                        ; $FF0716 (byte)
	rep #$30 : .al : .xl
	and #$00ff                                 ; A = bitmask (clear stale high byte)
	cpy #$0000
	beq sd_bit_test
sd_bit_shr:
	lsr
	dey
	bne sd_bit_shr
sd_bit_test:
	and #$0001
	beq sd_status_empty
	lda #$2800 : sta @ig_rc_pal                ; Slice 2: OCCUPIED -> green
	lda #IGM_ST_FULL
	bra sd_status_copy
sd_status_empty:
	lda #$2400 : sta @ig_rc_pal                ; EMPTY -> dim (palette 1 grey)
	lda #IGM_ST_EMPTY
sd_status_copy:
	ldy #SST_STATUS_COL
	jsr sst_copy                               ; Y = end column of the status token
	lda #SST_STATUS_COL : sta @ig_rc_col        ; Slice 2: capture the token span for recolor
	tya : sta @ig_rc_end
	; flush to absolute row = SST_SLOT_ROW0 + (slot-1)*SST_SLOT_STEP
	lda @sst_scr_slot : dec
	asl                                        ; *2 (SST_SLOT_STEP)
	clc : adc #SST_SLOT_ROW0
	sta @ig_rc_row                             ; save row for the recolor
	tax                                        ; X = absolute tile row
	jsr ovl_flush_abs                          ; clobbers X/Y
	jsr ig_recolor                             ; recolor the status token green/dim
	; WS-C: the COMMITTED slot's "SLOT n" label goes GREEN (it used to be the '>' cell). The
	; cursor no longer tints anything -- the BAR is its marker -- so the two states never fight
	; over the same colour: green = "this is the active slot", bar = "this is where you are".
	lda @sst_scr_slot
	cmp @sst_active
	bne sd_no_hl
	lda #SST_LABEL_COL : sta @ig_rc_col
	lda #(SST_LABEL_COL+10) : sta @ig_rc_end    ; +10, not +8: the digit sits at 24+len+1 and the
	                                            ;   i18n cap allows 8-char labels (gen_igmenu_lang
	                                            ;   STATES_LABEL_MAX) -> digit up to col 33
	lda #$2800 : sta @ig_rc_pal
	jsr ig_recolor
sd_no_hl:
	plp
	rts

; ---- draw a centered STATES i18n string. A(16)=string index, X(16)=absolute tile row.
;      Assumes DBR=$F4 (forced blank). Uses sst_tmp/sst_row/sst_scr_coff (transient). ----
sst_draw_centered:
	php
	rep #$30 : .al : .xl
	sta @sst_tmp                               ; string index
	txa                                        ; (no stx long) absolute row via A
	sta @sst_row
	lda @sst_tmp
	jsr sst_strlen                             ; A = encoded length (0..60)
	sta @sst_scr_coff                          ; len
	lda #$0040
	sec : sbc @sst_scr_coff                    ; 64 - len
	lsr                                        ; / 2
	tay                                        ; Y = start column
	jsr ovl_row_clear                          ; preserves Y
	lda @sst_tmp
	jsr sst_copy                               ; copy string at Y
	lda @sst_row
	tax                                        ; X = absolute row
	jsr ovl_flush_abs
	plp
	rts

; ---- copy a NUL-terminated font-encoded STATES string into OVL_RB. A(16)=string index,
;      Y(16)=dest column; DBR=$F4. Returns Y = column after the last char. Bounded by
;      IG_HELP_MAXCOL. Uses sst_lang; leaves sst_tmp alone. ----
sst_copy:
	php
	rep #$30 : .al : .xl
	asl : asl : asl                            ; index*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @sst_lang                        ; + lang column
	asl                                        ; *2 (word index)
	tax
	lda @igm_states_tbl, x                      ; A = source byte offset within bank $C2
	tax                                        ; X = source offset
	sep #$20 : .as
sst_copy_l:
	lda @$c20000, x                             ; long,X source byte (bank $C2)
	beq sst_copy_d
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #IG_HELP_MAXCOL
	bne sst_copy_l
sst_copy_d:
	rep #$30 : .al : .xl
	plp
	rts

; ---- encoded length of a STATES string. A(16)=string index -> A(16)=length (cap 60).
;      Uses sst_lang. ----
sst_strlen:
	php
	rep #$30 : .al : .xl
	asl : asl : asl                            ; index*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @sst_lang
	asl
	tax
	lda @igm_states_tbl, x
	tax                                        ; X = source offset
	ldy #$0000
	sep #$20 : .as
sst_sl_l:
	lda @$c20000, x
	beq sst_sl_d
	inx
	iny
	cpy #60
	bne sst_sl_l
sst_sl_d:
	rep #$30 : .al : .xl
	tya                                        ; A = length
	plp
	rts

; ---- input handler (runs in the input loop = vblank window). Slots off -> ignore.
;      Up/Down move the cursor by one (edge only); A commits. Only a couple of tilemap
;      cells change, written straight to VRAM (@long, DBR-agnostic), which is safe in the
;      vblank window exactly like the cheat overlay's single-cell writes. ----
states_input:
	php
	rep #$30 : .al : .xl
	lda @sst_disabled
	beq si_active
	plp                                        ; slots disabled -> ignore all input
	rts
si_active:
	lda @ovl_edge : bit #$0800                 ; Up
	beq si_no_up
	lda @sst_cursor
	cmp #$0002
	bcc si_no_up                               ; cursor <= 1 -> top
	jsr sst_cursor_up                          ; variable only -- the BAR follows it next frame
si_no_up:
	lda @ovl_edge : bit #$0400                 ; Down
	beq si_no_dn
	lda @sst_cursor
	cmp #$0004
	bcs si_no_dn                               ; cursor >= 4 -> bottom
	jsr sst_cursor_down
si_no_dn:
	lda @ovl_edge : bit #$0080                 ; A -> confirm
	beq si_no_a
	jsr sst_confirm
si_no_a:
	plp
	rts

; ---- move the cursor up/down one slot. WS-C: NOTHING is drawn here any more -- no marker cell
;      to erase/redraw and no label recolour. The selection BAR follows the cursor from
;      ig_bar_sync, which runs once per frame inside the loop's vblank window, so moving the
;      variable IS the whole update. (Shared by the STATES and SAVES tabs: identical layout.) ----
sst_cursor_up:
	php
	rep #$30 : .al : .xl
	lda @sst_cursor : dec : sta @sst_cursor
	plp
	rts

sst_cursor_down:
	php
	rep #$30 : .al : .xl
	lda @sst_cursor : inc : sta @sst_cursor
	plp
	rts

; ---- recolor slot sst_scr_slot's "SLOT n" label (cols 24..31) to ig_rc_pal, single-cell in the
;      vblank window (no force-blank -> NO flash). Rebuilds the label into OVL_RB, then ig_recolor
;      recolours only those cells. Picks the States/Saves i18n table by active_tab. DBR set locally. ----
sst_label_recolor:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                        ; DBR=$F4 (OVL_RB abs)
	rep #$30 : .al : .xl
	jsr ovl_row_clear
	lda @active_tab : and #$00ff
	cmp #$0002
	beq slr_saves
	lda #IGM_ST_SLOT : ldy #SST_LABEL_COL : jsr sst_copy    ; "SLOT" (States i18n) at col 24
	bra slr_digit
slr_saves:
	lda #IGM_SV_SLOT : ldy #SST_LABEL_COL : jsr svs_copy    ; "SLOT" (Saves i18n)
slr_digit:
	iny
	sep #$20 : .as
	lda @sst_scr_slot : clc : adc #$30 : sta OVL_RB, y      ; '0' + slot digit
	rep #$30 : .al : .xl
	lda #SST_LABEL_COL : sta @ig_rc_col
	lda #(SST_LABEL_COL+10) : sta @ig_rc_end    ; +10, not +8: the digit sits at 24+len+1 and the
	                                            ;   i18n cap allows 8-char labels (gen_igmenu_lang
	                                            ;   STATES_LABEL_MAX) -> digit up to col 33
	lda @sst_scr_slot : dec
	asl                                         ; *2 (SST_SLOT_STEP)
	clc : adc #SST_SLOT_ROW0
	sta @ig_rc_row
	jsr ig_recolor
	plb
	plp
	rts

; ---- A: commit the cursor as the active slot -- move the GREEN label and write CS_SLOT.
;      WS-C: the '>' cell is gone, so "which slot is committed" is carried by the label colour:
;      repaint the OLD active label white and the NEW one green. Both are single-cell tilemap
;      recolours (ig_recolor writes entries only, no tiles), the same vblank-window budget the
;      retired cursor recolours already spent -- no forced blank, no flash. ----
sst_confirm:
	php
	rep #$30 : .al : .xl
	lda @sst_cursor
	cmp @sst_active
	beq sc_write                               ; unchanged -> just (re)write CS_SLOT
	lda @sst_active : sta @sst_scr_slot         ; old active slot's label -> normal white
	lda #$2000 : sta @ig_rc_pal
	jsr sst_label_recolor
	lda @sst_cursor : sta @sst_active
	sta @sst_scr_slot                          ; new active slot's label -> green
	lda #$2800 : sta @ig_rc_pal
	jsr sst_label_recolor
sc_write:
	sep #$20 : .as
	lda @sst_active
	and #$7f                                   ; pure byte 1..4, NEVER bit7 (MCU busy flag)
	sta @CS_SLOT                               ; $FE100F
	; Writing CS_SLOT is the WHOLE job: it picks the slot the next save writes AND the
	; one the next load restores. The load side used to ignore it because load_state
	; replays whatever image the MCU last staged in PSRAM; load_state now compares
	; CS_SLOT against SS_STAGED_SLOT and asks the MCU to stage the file if they differ
	; (see snes/savestate.a65). We must NOT stage it from here: the overlay is open, and
	; a .state load writes $F00000..$F4FFFF, i.e. straight over the overlay's own
	; VRAM/CGRAM/register backups -- the exit restore would then paint that into the PPU.
	rep #$30 : .al : .xl
	plp
	rts

; (WS-C: the single-cell marker helpers sst_cur_draw/sst_cur_erase/sst_act_draw/sst_act_erase
;  and their sst_cell writer are GONE -- there is no '*' or '>' cell left to move. The cursor
;  is the selection BAR and the committed slot is the green label; both States and Saves.)

; ======================================================================
;  Tab 2 (SAVES): STATUS-ONLY view of the battery (.srm) save. No actions. saves_enter
;  draws the whole body in forced blank (from ig_switch_to); input/tick = ig_noop.
;  Reads the SAVEINFO ($FF0730) BSRAM block staged by the MCU at game load (refreshed
;  after autosave): +0 flags (bit0 game-has-sram, bit1 srm-exists, bit2 autosave-on),
;  +1 size string (16B ASCII NUL), +17 datetime string (24B ASCII NUL). Flags are
;  re-read straight from BSRAM per test (stable during the draw) -- no shell var needed.
;  Reuses the STATES transients (sst_lang/sst_tmp/sst_row/sst_scr_*) since SAVES
;  is never the active tab at the same time as STATES.
; ======================================================================
saves_enter:                                    ; forced blank (ig_switch_to)
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                      ; DBR=$F4 (OVL_RB abs writes)
	; --- language (0..IGM_LANG_COUNT-1) ---
	lda @CFG_LANGUAGE                           ; $FF01B7
	cmp #IGM_LANG_COUNT
	bcc sv_lang_ok
	lda #$00
sv_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	sta @sst_lang
	; --- EnableSramSlots on? (CFG mirror $FF0246) -> SRAM slot selector instead of status ---
	sep #$20 : .as
	lda @CFG_ENABLE_SRAM_SLOTS
	rep #$30 : .al : .xl
	and #$00ff
	beq sv_status_view
	jsr saves_slots_enter
	plb
	plp
	rts
sv_status_view:
	; --- title (centered) ---
	lda #IGM_SV_TITLE : ldx #SV_TITLE_ROW
	jsr svs_draw_centered
	; --- bit0: game has battery save? ---
	sep #$20 : .as
	lda @SAVEINFO
	and #$01
	rep #$30 : .al : .xl
	bne sv_has_sram
	; no battery save -> single centered message, done
	lda #IGM_SV_NOSRAM : ldx #SV_NOSRAM_ROW
	jsr svs_draw_centered
	plb
	plp
	rts
sv_has_sram:
	; --- ".srm file:" + EXISTS/MISSING (bit1) ---
	lda #IGM_SV_FILE : sta @sst_scr_slot
	sep #$20 : .as
	lda @SAVEINFO
	and #$02                                   ; bit1 srm-exists
	rep #$30 : .al : .xl
	bne sv_file_exists
	lda #IGM_SV_MISSING : sta @sst_scr_coff
	bra sv_file_draw
sv_file_exists:
	lda #IGM_SV_EXISTS : sta @sst_scr_coff
sv_file_draw:
	ldx #SV_FILE_ROW
	jsr svs_kv_row
	; --- size + last-write rows ONLY when the .srm exists (bit1) ---
	sep #$20 : .as
	lda @SAVEINFO
	and #$02
	rep #$30 : .al : .xl
	beq sv_after_file
	; "Size:" + raw size string (SAVEINFO+1, cap 15)
	lda #IGM_SV_SIZE : sta @sst_scr_slot
	lda #SV_SIZE_OFF : sta @sst_scr_coff
	lda #SV_SIZE_ENDCOL : sta @sst_scr_entry
	ldx #SV_SIZE_ROW
	jsr svs_raw_row
	; "Last write:" + raw datetime string (SAVEINFO+17, cap 23)
	lda #IGM_SV_WRITE : sta @sst_scr_slot
	lda #SV_DT_OFF : sta @sst_scr_coff
	lda #SV_DT_ENDCOL : sta @sst_scr_entry
	ldx #SV_WRITE_ROW
	jsr svs_raw_row
sv_after_file:
	; --- "Autosave:" + ON/OFF (bit2) ---
	lda #IGM_SV_AUTOSAVE : sta @sst_scr_slot
	sep #$20 : .as
	lda @SAVEINFO
	and #$04                                   ; bit2 autosave-on
	rep #$30 : .al : .xl
	bne sv_auto_on
	lda #IGM_SV_OFF : sta @sst_scr_coff
	bra sv_auto_draw
sv_auto_on:
	lda #IGM_SV_ON : sta @sst_scr_coff
sv_auto_draw:
	ldx #SV_AUTO_ROW
	jsr svs_kv_row
	; --- footer hint (centered), ON/OFF variant per bit2 ---
	sep #$20 : .as
	lda @SAVEINFO
	and #$04
	rep #$30 : .al : .xl
	bne sv_hint_on
	lda #IGM_SV_HINT_OFF : ldx #SV_HINT_ROW
	jsr svs_draw_centered
	bra sv_done
sv_hint_on:
	lda #IGM_SV_HINT_ON : ldx #SV_HINT_ROW
	jsr svs_draw_centered
sv_done:
	plb
	plp
	rts

; ---- build a "label + i18n token" row: clear OVL_RB, copy label at SV_LABEL_COL, copy
;      token at SV_VALUE_COL, flush to X. Args: sst_scr_slot = label index,
;      sst_scr_coff = token index, X = dest tile row. Assumes DBR=$F4. ----
svs_kv_row:
	php
	rep #$30 : .al : .xl
	phx                                        ; save dest row
	jsr ovl_row_clear
	lda @sst_scr_slot
	ldy #SV_LABEL_COL
	jsr svs_copy
	lda @sst_scr_coff
	ldy #SV_VALUE_COL
	jsr svs_copy
	plx                                        ; X = dest row
	jsr ovl_flush_abs
	plp
	rts

; ---- build a "label + raw ASCII value" row: clear OVL_RB, copy label at SV_LABEL_COL,
;      copy the raw SAVEINFO string at SV_VALUE_COL, flush to X. Args: sst_scr_slot =
;      label index, sst_scr_coff = SAVEINFO source offset, sst_scr_entry = end column
;      (exclusive), X = dest tile row. Assumes DBR=$F4. ----
svs_raw_row:
	php
	rep #$30 : .al : .xl
	phx                                        ; save dest row
	jsr ovl_row_clear
	lda @sst_scr_slot
	ldy #SV_LABEL_COL
	jsr svs_copy
	lda @sst_scr_coff : tax                    ; X = SAVEINFO source byte offset
	ldy #SV_VALUE_COL
	jsr svs_raw_copy
	plx                                        ; X = dest row
	jsr ovl_flush_abs
	plp
	rts

; ---- copy a raw ASCII run from SAVEINFO+X into OVL_RB at Y until NUL or col == the end
;      column in sst_scr_entry. X = SAVEINFO source byte offset, Y = dest column; DBR=$F4.
;      ASCII == font codes (the MCU stages already-encoded digits/punctuation). ----
svs_raw_copy:
	php
	rep #$30 : .al : .xl
	sep #$20 : .as
svrc_l:
	lda @SAVEINFO, x                           ; long,X byte from $FF0730 + offset
	beq svrc_d
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	inx
	iny
	rep #$20 : .al
	tya
	cmp @sst_scr_entry                          ; stop at the end column (Y >= cap)
	sep #$20 : .as
	bcc svrc_l
svrc_d:
	rep #$30 : .al : .xl
	plp
	rts

; ---- draw a centered SAVES i18n string. A(16)=string index, X(16)=absolute tile row.
;      Assumes DBR=$F4. Mirrors sst_draw_centered but indexes igm_saves_tbl. Uses
;      sst_tmp/sst_row/sst_scr_coff (transient). ----
svs_draw_centered:
	php
	rep #$30 : .al : .xl
	sta @sst_tmp                               ; string index
	txa                                        ; (no stx long) absolute row via A
	sta @sst_row
	lda @sst_tmp
	jsr svs_strlen                             ; A = encoded length (0..60)
	sta @sst_scr_coff
	lda #$0040
	sec : sbc @sst_scr_coff                     ; 64 - len
	lsr                                        ; / 2
	tay                                        ; Y = start column
	jsr ovl_row_clear                           ; preserves Y
	lda @sst_tmp
	jsr svs_copy                               ; copy string at Y
	lda @sst_row
	tax                                        ; X = absolute row
	jsr ovl_flush_abs
	plp
	rts

; ---- copy a NUL-terminated font-encoded SAVES string into OVL_RB. A(16)=string index,
;      Y(16)=dest column; DBR=$F4. Bounded by IG_HELP_MAXCOL. Uses sst_lang. ----
svs_copy:
	php
	rep #$30 : .al : .xl
	asl : asl : asl                            ; index*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @sst_lang                         ; + lang column
	asl                                        ; *2 (word index)
	tax
	lda @igm_saves_tbl, x                       ; A = source byte offset within bank $C2
	tax                                        ; X = source offset
	sep #$20 : .as
svs_copy_l:
	lda @$c20000, x                             ; long,X source byte (bank $C2)
	beq svs_copy_d
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #IG_HELP_MAXCOL
	bne svs_copy_l
svs_copy_d:
	rep #$30 : .al : .xl
	plp
	rts

; ---- encoded length of a SAVES string. A(16)=string index -> A(16)=length (cap 60).
;      Uses sst_lang. ----
svs_strlen:
	php
	rep #$30 : .al : .xl
	asl : asl : asl                            ; index*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @sst_lang
	asl
	tax
	lda @igm_saves_tbl, x
	tax                                        ; X = source offset
	ldy #$0000
	sep #$20 : .as
svs_sl_l:
	lda @$c20000, x
	beq svs_sl_d
	inx
	iny
	cpy #60
	bne svs_sl_l
svs_sl_d:
	rep #$30 : .al : .xl
	tya                                        ; A = length
	plp
	rts

; ======================================================================
;  SAVES tab -- SRAM slot selector (EnableSramSlots on). Mirrors the STATES tab: 4 slots shown
;  as SLOT 1..4 (internal 1..4 -> file slot 0..3), occupancy from SRM_SLOT_STATUS ($FF0717),
;  the active/next slot from SAVEINFO+42 (SRM_SEL_SLOT, 0..3). WS-C: the selection BAR marks the
;  cursor and a GREEN "SLOT n" label marks the active slot -- no marker glyphs.
;  Up/Down move the cursor (edge; reuses the STATES sst_cursor_up/down -- identical layout
;  constants); A commits via SNES_CMD_SET_SRM_SLOT ($44, MCU persists the sidecar and applies on
;  the NEXT game load -- the live slot never changes). saves_enter drew the body in forced blank;
;  only the two label recolours happen afterwards (occupancy can't change from a selection, so no
;  full redraw is needed). Reuses the STATES/SAVES transients (never overlap).
; ======================================================================
saves_slots_enter:                              ; forced blank (from saves_enter, DBR=$F4)
	php
	rep #$30 : .al : .xl
	; active slot 1..4 = SRM_SEL_SLOT (0..3) + 1
	sep #$20 : .as
	lda @SRM_SEL_SLOT
	and #$03
	rep #$30 : .al : .xl
	and #$00ff
	inc
	sta @sst_active
	sta @sst_cursor                             ; cursor starts on the active slot
	; header (cyan accent)
	lda #$2c00 : sta @ovl_pal
	lda #IGM_SV_SLOTTITLE : ldx #SST_HDR_ROW
	jsr svs_draw_centered
	lda #$2000 : sta @ovl_pal
	; 4 slot rows
	lda #$0001 : sta @sst_scr_slot
sse_row_loop:
	jsr svs_draw_slot_row
	lda @sst_scr_slot : inc : sta @sst_scr_slot
	cmp #$0005
	bcc sse_row_loop
	; hint
	lda #IGM_SV_SLOTHINT : ldx #SST_HINT_ROW
	jsr svs_draw_centered
	plp
	rts

; ---- build one SAVES slot row (sst_scr_slot = slot 1..4) into OVL_RB and flush. DBR=$F4.
;      Status from SRM_SLOT_STATUS bit (slot-1); EXISTS/MISSING via the SAVES i18n table. ----
svs_draw_slot_row:
	php
	rep #$30 : .al : .xl
	jsr ovl_row_clear
	; WS-C: no '*' / '>' cells (see sst_draw_slot_row) -- BAR = cursor, green label = committed.
	lda #IGM_SV_SLOT
	ldy #SST_LABEL_COL
	jsr svs_copy
	iny
	sep #$20 : .as
	lda @sst_scr_slot
	clc : adc #$30                              ; '0' + slot
	sta OVL_RB, y
	; status: bit (slot-1) of SRM_SLOT_STATUS -> EXISTS / MISSING
	rep #$20 : .al
	lda @sst_scr_slot
	and #$00ff                                  ; clean high byte before tay
	dec
	tay                                        ; Y = slot-1 (shift count)
	sep #$20 : .as
	lda @SRM_SLOT_STATUS                        ; $FF0717 (byte)
	rep #$30 : .al : .xl
	and #$00ff
	cpy #$0000
	beq svsd_bit
svsd_shr:
	lsr
	dey
	bne svsd_shr
svsd_bit:
	and #$0001
	beq svsd_empty
	lda #$2800 : sta @ig_rc_pal                ; Slice 2: EXISTS -> green
	lda #IGM_SV_EXISTS
	bra svsd_status
svsd_empty:
	lda #$2400 : sta @ig_rc_pal                ; MISSING -> dim (palette 1 grey)
	lda #IGM_SV_MISSING
svsd_status:
	ldy #SST_STATUS_COL
	jsr svs_copy                               ; Y = end column
	lda #SST_STATUS_COL : sta @ig_rc_col        ; Slice 2: capture the token span for recolor
	tya : sta @ig_rc_end
	lda @sst_scr_slot : dec
	asl                                        ; *2 (SST_SLOT_STEP)
	clc : adc #SST_SLOT_ROW0
	sta @ig_rc_row                             ; save row for the recolor
	tax
	jsr ovl_flush_abs
	jsr ig_recolor                             ; recolor the status token green/dim
	; WS-C: the COMMITTED slot's "SLOT n" label goes GREEN (mirrors sst_draw_slot_row).
	lda @sst_scr_slot
	cmp @sst_active
	bne svsd_no_hl
	lda #SST_LABEL_COL : sta @ig_rc_col
	lda #(SST_LABEL_COL+10) : sta @ig_rc_end    ; +10, not +8: the digit sits at 24+len+1 and the
	                                            ;   i18n cap allows 8-char labels (gen_igmenu_lang
	                                            ;   STATES_LABEL_MAX) -> digit up to col 33
	lda #$2800 : sta @ig_rc_pal
	jsr ig_recolor
svsd_no_hl:
	plp
	rts

; ---- SAVES tab input (tab_input_tbl[2]). Only active when EnableSramSlots is on; the status
;      view has no input. Up/Down move the cursor (STATES helpers), A commits the slot. ----
saves_input:
	php
	rep #$30 : .al : .xl
	sep #$20 : .as
	lda @CFG_ENABLE_SRAM_SLOTS
	rep #$30 : .al : .xl
	and #$00ff
	bne svi_active
	plp
	rts
svi_active:
	lda @ovl_edge : bit #$0800                  ; Up
	beq svi_no_up
	lda @sst_cursor
	cmp #$0002
	bcc svi_no_up                               ; cursor <= 1 -> top
	jsr sst_cursor_up                            ; reuse the STATES cursor mover (variable only)
svi_no_up:
	lda @ovl_edge : bit #$0400                  ; Down
	beq svi_no_dn
	lda @sst_cursor
	cmp #$0004
	bcs svi_no_dn                               ; cursor >= 4 -> bottom
	jsr sst_cursor_down
svi_no_dn:
	lda @ovl_edge : bit #$0080                  ; A -> commit
	beq svi_no_a
	jsr svs_confirm
svi_no_a:
	plp
	rts

; ---- A: commit the cursor as the active slot. WS-C: move the GREEN label (reuse the STATES
;      sst_label_recolor, which picks the SAVES i18n table by active_tab), then persist via
;      SNES_CMD_SET_SRM_SLOT (MCU_PARAM low = slot-1, 0..3) with a bounded ACK spin. The MCU
;      refreshes SAVEINFO+42/SRM_SLOT_STATUS; occupancy is unchanged by a selection, so the two
;      label recolours ARE the post-ACK redraw. ----
svs_confirm:
	php
	rep #$30 : .al : .xl
	lda @sst_cursor
	cmp @sst_active
	beq svc_send                                ; unchanged -> just re-persist
	lda @sst_active : sta @sst_scr_slot          ; old active slot's label -> normal white
	lda #$2000 : sta @ig_rc_pal
	jsr sst_label_recolor
	lda @sst_cursor : sta @sst_active
	sta @sst_scr_slot                           ; new active slot's label -> green
	lda #$2800 : sta @ig_rc_pal
	jsr sst_label_recolor
svc_send:
	sep #$20 : .as
	lda @sst_active
	sec : sbc #$01                              ; slot 1..4 -> file slot 0..3
	and #$03
	sta @MCU_PARAM                              ; MCU_PARAM[0] = slot 0..3
	lda #CMD_SET_SRM_SLOT : sta @MCU_CMD        ; $44
	jsr saves_wait_ack                           ; bounded ACK spin (MCU clears MCU_CMD)
	rep #$30 : .al : .xl
	plp
	rts

; ---- bounded spin until the MCU ACKs (MCU_CMD -> 0). Same bound as the viewer's block spin.
;      Never hangs the SNES: on timeout it just returns (the write already landed). .as read. ----
saves_wait_ack:
	php
	sep #$20 : .as
	rep #$10 : .xl
	ldx #MN_TIMEOUT_HI
swa_outer:
	ldy #$0000
swa_inner:
	lda @MCU_CMD
	beq swa_done
	dey
	bne swa_inner
	dex
	bne swa_outer
swa_done:
	plp
	rts

; ======================================================================
;  Tab 3 (MANUAL/GUIDES): a game-manual image viewer. TWO levels (igmenu_flags bit0):
;    - TAB LEVEL (bit0=0, mode 5, tab bar visible): manual_enter draws a prompt
;      ("GAME MANUAL / N pages / A: Read the manual") from MANUAL_META, or an i18n
;      "not found"/"error" line. manual_input: A enters the viewer.
;    - VIEWER (bit0=1, mode 1 4bpp): the MCU stages ONE WHOLE page into PSRAM
;      (CMD_MANUAL_S1PAGE for 1x, CMD_MANUAL_ZPAGE for the 2x zoom) and the viewer pans
;      over it with pure PSRAM->VRAM DMA. A toggles 1x<->2x, L/R turn the page, the
;      d-pad pans; B returns to the tab level. Routed by the viewer bypass in igmenu_loop.
;  The shell's mode-5 VRAM (both fonts) is saved to MANUAL_SHELLSAVE on entry and
;  restored on exit; the tilemaps are rebuilt (draw_tabbar/footer/manual_enter). This is
;  self-contained in $C2 -- the $C0 hook stays byte-identical (fail-safe intact).
; ======================================================================
manual_enter:                                   ; forced blank (ig_switch_to / man_viewer_exit)
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                       ; DBR=$F4 (OVL_RB abs writes)
	; --- language (0..IGM_LANG_COUNT-1), same clamp as help_enter ---
	lda @CFG_LANGUAGE                           ; $FF01B7
	cmp #IGM_LANG_COUNT
	bcc mn_lang_ok
	lda #$00
mn_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	sta @sst_lang                              ; reuse the STATES/SAVES helper var (never overlap)
	lda #$0000 : sta @mn_list_live             ; no list on screen until mn_list draws one
	; --- a block request timed out? show the error line and clear the latch ---
	lda @man_error
	beq mn_chk_present
	lda #$0000 : sta @man_error
	lda #IGM_MN_ERROR : ldx #MN_MSG_ROW
	jsr mn_draw_centered
	plb
	plp
	rts
mn_chk_present:
	; --- guides present? MANUAL_META bit0 AND meta_abi (+2) == MANUAL_META_ABI (mismatched
	;     firmware<->igmenu.bin pairing degrades cleanly to "not found"). ---
	sep #$20 : .as
	lda @MANUAL_META|$0002                      ; meta_abi
	cmp #MANUAL_META_ABI
	bne mn_notpresent
	lda @MANUAL_META
	and #$01
	beq mn_notpresent
	; --- guide count: 1 -> prompt, >1 -> list ---
	lda @MAN_GD_COUNT
	rep #$30 : .al : .xl
	and #$00ff
	cmp #$0002
	bcs mn_list
	; count == 1 (present implies >=1): prompt for guide 0 (record title + "N pages" + "A: read")
	lda #$0000 : sta @man_sel_guide
	lda #$0000 : ldx #MN_TITLE_ROW
	jsr guide_title_centered
	jsr mn_draw_pages
	lda #IGM_MN_KEYS1 : ldx #MN_KEYS1_ROW
	jsr mn_draw_centered
	lda #IGM_MN_KEYS2 : ldx #MN_KEYS2_ROW
	jsr mn_draw_centered
	lda #IGM_MN_READ : ldx #MN_READ_ROW
	jsr mn_draw_centered
	plb
	plp
	rts
mn_list:
	lda #$0001 : sta @mn_list_live             ; the BAR (igb_t_guides) keys off this
	jsr guides_list_draw                       ; (returns .al/.xl + DBR untouched: its plp restores
	                                           ;  the P we arrived with and it never touches DBR)
	lda #IGM_MN_KEYS1 : ldx #MN_KEYS1_ROW      ; same legend as the count==1 prompt: the list only
	jsr mn_draw_centered                       ;   reaches row 14 (8 guides max), so 18/19 are free
	lda #IGM_MN_KEYS2 : ldx #MN_KEYS2_ROW
	jsr mn_draw_centered
	plb
	plp
	rts
mn_notpresent:
	rep #$30 : .al : .xl
	lda #IGM_MN_NOTFOUND : ldx #MN_MSG_ROW
	jsr mn_draw_centered
	plb
	plp
	rts

; ---- tab-level input. count<=1: A (edge) enters the viewer with guide 0. count>1: the guide
;      list owns Up/Down (cursor) + A (open). Gated on present + meta_abi like manual_enter. ----
manual_input:
	php
	rep #$30 : .al : .xl
	sep #$20 : .as
	lda @MANUAL_META|$0002                      ; meta_abi
	cmp #MANUAL_META_ABI
	bne mi_done
	lda @MANUAL_META
	and #$01
	beq mi_done
	lda @MAN_GD_COUNT
	rep #$30 : .al : .xl
	and #$00ff
	cmp #$0002
	bcs mi_list
	; single guide: A enters the viewer
	rep #$20 : .al
	lda @ovl_edge
	bit #$0080
	beq mi_ret
	lda #$0000 : sta @man_sel_guide
	jsr manual_viewer_enter
mi_ret:
	plp
	rts
mi_list:
	rep #$30 : .al : .xl
	jsr guides_list_input
	plp
	rts
mi_done:
	rep #$30 : .al : .xl
	plp
	rts

; ---- copy guide k's record title into OVL_RB at Y (or "GUIDE n" when the title is empty).
;      A(16)=guide 0..7, Y(16)=dest column; DBR=$F4. Bounded by IG_HELP_MAXCOL. Reuses the
;      STATES/SAVES transient sst_scr_slot (GUIDES tab never overlaps them) + mn_copy. ----
guide_title_copy:
	php
	rep #$30 : .al : .xl
	sta @sst_scr_slot                          ; stash guide index (for the fallback digit)
	asl : asl : asl : asl : asl                ; *MAN_GD_REC_STRIDE (32)
	clc : adc #MAN_GD_R_TITLE
	tax                                        ; X = record title byte offset within $FF9004
	sep #$20 : .as
	lda @MAN_GD_REC0, x                         ; first title byte
	rep #$30 : .al : .xl
	and #$00ff
	beq gtc_fallback                           ; 0 -> "GUIDE n" fallback (empty title)
	cmp #$0006                                 ; 1..5 = official document-type slug (6 = MAN_SLUG_MAX+1)?
	bcs gtc_verbatim                           ; >=6 -> free-text user-guide title (real font codes are >=$20)
	dec                                        ; slug 1..5 -> 0..4
	clc : adc #IGM_MN_SLUG_MANUAL              ; -> IGM_MN_SLUG_* string index
	jsr mn_copy                                ; render the TRANSLATED type label at Y (advances Y)
	bra gtc_done
gtc_verbatim:
	sep #$20 : .as
gtc_l:
	lda @MAN_GD_REC0, x                         ; long,X title byte (bank $FF)
	beq gtc_done
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #IG_HELP_MAXCOL
	bne gtc_l
	bra gtc_done
gtc_fallback:
	lda #IGM_MN_GUIDE
	jsr mn_copy                                ; "GUIDE" at Y, advances Y
	sep #$20 : .as
	lda #$20 : sta OVL_RB, y : iny             ; space
	rep #$30 : .al : .xl
	lda @sst_scr_slot
	clc : adc #$0031                           ; '1' + guide index (0-based -> 1-based)
	sep #$20 : .as
	sta OVL_RB, y
	iny
gtc_done:
	rep #$30 : .al : .xl
	plp
	rts

; ---- encoded length of guide k's title (record title, or "GUIDE n"). A(16)=guide -> A(16). ----
guide_title_len:
	php
	rep #$30 : .al : .xl
	asl : asl : asl : asl : asl                ; *32
	clc : adc #MAN_GD_R_TITLE
	tax
	sep #$20 : .as
	lda @MAN_GD_REC0, x
	rep #$30 : .al : .xl
	and #$00ff
	beq gtl_fallback                           ; 0 -> "GUIDE n" length
	cmp #$0006                                 ; 1..5 = document-type slug?
	bcs gtl_count                              ; >=6 -> count the verbatim title
	dec : clc : adc #IGM_MN_SLUG_MANUAL        ; slug -> IGM_MN_SLUG_* index
	jsr mn_strlen                              ; len(translated type label)
	plp
	rts
gtl_fallback:
	lda #IGM_MN_GUIDE
	jsr mn_strlen                              ; len("GUIDE")
	clc : adc #$0002                           ; + " n"
	plp
	rts
gtl_count:
	ldy #$0000
	sep #$20 : .as
gtl_l:
	lda @MAN_GD_REC0, x
	beq gtl_d
	inx
	iny
	cpy #60
	bne gtl_l
gtl_d:
	rep #$30 : .al : .xl
	tya
	plp
	rts

; ---- draw guide k's title centered on tile row X. A(16)=guide, X(16)=row; DBR=$F4. ----
guide_title_centered:
	php
	rep #$30 : .al : .xl
	sta @sst_tmp                               ; guide index
	txa                                        ; (no stx long) row via A
	sta @sst_row
	lda @sst_tmp
	jsr guide_title_len                        ; A = length
	sta @sst_scr_coff
	lda #$0040
	sec : sbc @sst_scr_coff                     ; 64 - len
	lsr
	tay                                        ; Y = start column
	jsr ovl_row_clear                           ; preserves Y
	lda @sst_tmp
	jsr guide_title_copy                        ; copy at Y
	lda @sst_row
	tax
	jsr ovl_flush_abs
	plp
	rts

; ---- GUIDES list (count>1): header + one row per guide; man_list_cursor is marked by the BAR.
;      Forced blank (ig_switch_to). Loop index in sst_row, count in sst_scr_entry -- neither
;      touched by guides_list_row / guide_title_copy / mn_copy. ----
guides_list_draw:
	php
	rep #$30 : .al : .xl
	lda #IGM_MN_SELECT : ldx #GD_HDR_ROW
	jsr mn_draw_centered                        ; clobbers sst_tmp/sst_row/sst_scr_coff
	sep #$20 : .as
	lda @MAN_GD_COUNT
	rep #$30 : .al : .xl
	and #$00ff
	sta @sst_scr_entry                          ; count (survives the row draws)
	; clamp the cursor to 0..count-1 (PSRAM stale on first entry)
	lda @man_list_cursor
	cmp @sst_scr_entry
	bcc gld_cur_ok
	lda #$0000 : sta @man_list_cursor
gld_cur_ok:
	lda #$0000 : sta @sst_row                   ; k = 0 (loop index)
gld_loop:
	lda @sst_row
	cmp @sst_scr_entry
	bcs gld_done
	jsr guides_list_row
	lda @sst_row : inc : sta @sst_row
	bra gld_loop
gld_done:
	plp
	rts

; ---- draw one guide row: k = sst_row -> just the title. WS-C: the '*' cursor cell is gone;
;      the selection BAR marks the row (ig_bar_sync, from the loop's vblank window). ----
guides_list_row:
	php
	rep #$30 : .al : .xl
	jsr ovl_row_clear
	lda @sst_row                                ; guide index
	ldy #GD_TITLE_COL
	jsr guide_title_copy
	lda @sst_row
	clc : adc #GD_LIST_ROW0                     ; absolute tile row
	tax
	jsr ovl_flush_abs
	plp
	rts

; ---- guide-list input (vblank window). Up/Down move the cursor (WS-C: variable only -- the
;      BAR follows it); A opens man_list_cursor. Count in sst_scr_entry (transient). ----
guides_list_input:
	php
	rep #$30 : .al : .xl
	sep #$20 : .as
	lda @MAN_GD_COUNT
	rep #$30 : .al : .xl
	and #$00ff
	sta @sst_scr_entry
	lda @ovl_edge : bit #$0800                  ; Up
	beq gli_no_up
	lda @man_list_cursor
	beq gli_no_up                               ; already 0
	jsr gld_cursor_up
gli_no_up:
	lda @ovl_edge : bit #$0400                  ; Down
	beq gli_no_dn
	lda @man_list_cursor
	inc
	cmp @sst_scr_entry
	bcs gli_no_dn                               ; >= count
	jsr gld_cursor_down
gli_no_dn:
	lda @ovl_edge : bit #$0080                  ; A -> open
	beq gli_done
	lda @man_list_cursor : sta @man_sel_guide
	jsr manual_viewer_enter
gli_done:
	plp
	rts

; ---- move the guide-list cursor up/down one row. WS-C: NOTHING is drawn -- the selection BAR
;      follows man_list_cursor from ig_bar_sync once per frame, so the variable IS the update.
;      (The old single-cell '*' writer gld_cell is gone with the marker.) ----
gld_cursor_up:
	php
	rep #$30 : .al : .xl
	lda @man_list_cursor : dec : sta @man_list_cursor
	plp
	rts
gld_cursor_down:
	php
	rep #$30 : .al : .xl
	lda @man_list_cursor : inc : sta @man_list_cursor
	plp
	rts

; ---- draw a centered MANUAL i18n string. A(16)=IGM_MN_* index, X(16)=absolute tile row.
;      Assumes DBR=$F4. Mirrors svs_draw_centered but indexes igm_manual_tbl. ----
mn_draw_centered:
	php
	rep #$30 : .al : .xl
	sta @sst_tmp
	txa
	sta @sst_row
	lda @sst_tmp
	jsr mn_strlen
	sta @sst_scr_coff
	lda #$0040
	sec : sbc @sst_scr_coff                     ; 64 - len
	lsr                                        ; / 2
	tay
	jsr ovl_row_clear                           ; preserves Y
	lda @sst_tmp
	jsr mn_copy
	lda @sst_row
	tax
	jsr ovl_flush_abs
	plp
	rts

; ---- copy a NUL-terminated font-encoded MANUAL string into OVL_RB. A(16)=index,
;      Y(16)=dest column; DBR=$F4. Bounded by IG_HELP_MAXCOL. Uses sst_lang. ----
mn_copy:
	php
	rep #$30 : .al : .xl
	asl : asl : asl                            ; index*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @sst_lang                         ; + lang column
	asl                                        ; *2 (word index)
	tax
	lda @igm_manual_tbl, x                       ; A = source byte offset within bank $C2
	tax
	sep #$20 : .as
mn_copy_l:
	lda @$c20000, x                             ; long,X source byte (bank $C2)
	beq mn_copy_d
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #IG_HELP_MAXCOL
	bne mn_copy_l
mn_copy_d:
	rep #$30 : .al : .xl
	plp
	rts

; ---- encoded length of a MANUAL string. A(16)=index -> A(16)=length (cap 60). ----
mn_strlen:
	php
	rep #$30 : .al : .xl
	asl : asl : asl                            ; index*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @sst_lang
	asl
	tax
	lda @igm_manual_tbl, x
	tax
	ldy #$0000
	sep #$20 : .as
mn_sl_l:
	lda @$c20000, x
	beq mn_sl_d
	inx
	iny
	cpy #60
	bne mn_sl_l
mn_sl_d:
	rep #$30 : .al : .xl
	tya
	plp
	rts

; ---- write A(16)=value 0..255 as decimal into OVL_RB at Y(16), no leading zeros.
;      DBR=$F4. Returns Y advanced past the digits; clobbers X. A hundreds digit
;      forces the tens digit to print (e.g. 105 -> "105", not "15"). ----
mn_put_dec:
	php
	rep #$30 : .al : .xl
	and #$00ff
	; --- hundreds (value / 100) ---
	ldx #$0000                                 ; X = hundreds count
mn_pd_huns:
	cmp #$0064                                 ; 100
	bcc mn_pd_hdone
	sec : sbc #$0064
	inx
	bra mn_pd_huns
mn_pd_hdone:
	cpx #$0000
	bne mn_pd_have_h
	pea $0000                                  ; no hundreds -> force-tens flag = 0
	bra mn_pd_tinit
mn_pd_have_h:
	pha                                        ; save remainder
	txa
	clc : adc #$0030                           ; '0' + hundreds
	sep #$20 : .as
	sta OVL_RB, y                              ; abs,Y (DBR=$F4)
	rep #$30 : .al : .xl
	iny
	pla                                        ; remainder back to A
	pea $0001                                  ; hundreds printed -> force-tens flag = 1
mn_pd_tinit:
	; A = value 0..99, [1,s] = force-tens flag (word 0/1)
	ldx #$0000                                 ; X = tens count
mn_pd_tens:
	cmp #$000a
	bcc mn_pd_tdone
	sec : sbc #$000a
	inx
	bra mn_pd_tens
mn_pd_tdone:
	pha                                        ; save units (force flag now at 3,s)
	cpx #$0000
	bne mn_pd_emit_tens                        ; tens count > 0 -> print
	lda $03, s                                 ; else check the force flag
	beq mn_pd_tskip                            ; not forced and 0 -> suppress tens
mn_pd_emit_tens:
	txa                                        ; X = tens digit (0 when forced)
	clc : adc #$0030                           ; '0' + tens
	sep #$20 : .as
	sta OVL_RB, y
	rep #$30 : .al : .xl
	iny
mn_pd_tskip:
	pla                                        ; units back to A (force flag at 1,s)
	clc : adc #$0030                           ; '0' + units
	sep #$20 : .as
	sta OVL_RB, y
	rep #$30 : .al : .xl
	iny
	pla                                        ; discard force flag
	plp
	rts

; ---- build "<N> pages" centered on MN_PAGES_ROW (N = MANUAL_META npages). DBR=$F4. ----
mn_draw_pages:
	php
	rep #$30 : .al : .xl
	jsr ovl_row_clear
	lda #IGM_MN_PAGES
	jsr mn_strlen                              ; A = "pages" word length
	sta @sst_scr_entry                         ; hold word length
	sep #$20 : .as
	lda @MANUAL_META|$0001                      ; npages ($FF0761)
	rep #$30 : .al : .xl
	and #$00ff
	sta @sst_tmp                               ; npages value
	cmp #$0064                                 ; >= 100 -> 3 digits
	bcc mn_dp_lt100
	lda #$0003
	bra mn_dp_nd
mn_dp_lt100:
	cmp #$000a
	bcc mn_dp_1d
	lda #$0002                                 ; 2 digits
	bra mn_dp_nd
mn_dp_1d:
	lda #$0001                                 ; 1 digit
mn_dp_nd:
	clc : adc @sst_scr_entry                    ; + word length
	inc                                        ; + 1 space
	sta @sst_scr_coff                          ; total length
	lda #$0040
	sec : sbc @sst_scr_coff                     ; 64 - total
	lsr                                        ; / 2
	tay                                        ; Y = start column
	lda @sst_tmp
	jsr mn_put_dec                             ; digits, Y advanced
	iny                                        ; skip the space (OVL_RB already space)
	lda #IGM_MN_PAGES
	jsr mn_copy                                ; "pages" word at Y
	ldx #MN_PAGES_ROW
	jsr ovl_flush_abs
	plp
	rts

; ======================================================================
;  MANUAL/GUIDES image viewer. The viewer body is SHARED SOURCE (snes/manviewer.i65,
;  assembled into THIS bank -- the include carries no .link, exactly like cheatlist.i65)
;  so the menu can reuse it. Everything after the include is the HOST half of that
;  contract: the three man_host_* hooks plus the two routines that can only live here
;  because they name $C2 shell state (MANUAL_SHELLSAVE, OVL_BG1_MAP/OVL_BG2_MAP).
; ======================================================================
#include "manviewer.i65"

; ---- HOST HOOK: viewer entry. Stop the Cheats list's rebuild/DMA pipeline (a shell-only
;      concern the shared viewer must not name) and snapshot the mode-5 screen. ----
man_host_enter:
	php
	rep #$30 : .al : .xl
	lda #$0000
	sta @ovl_scroll_dirty                        ; kill any cheats DMA pipeline (safety)
	sta @ovl_dma_pending
	jsr man_save_shell                           ; force blank + readback shell fonts + CGRAM
	plp
	rts

; ---- save the shell's mode-5 VRAM (both fonts, non-contiguous) + CGRAM to
;      MANUAL_SHELLSAVE via real PPU readback ($2139/$213B), same discipline as the
;      cheat overlay (set VMADD once per region, ONE dummy read, stream WITHOUT
;      re-writing VMADD). Force blank first. ----
man_save_shell:
	php
	sep #$20 : .as
	lda #$00 : sta @$00420c                      ; HDMA off FIRST: the theme's ch2 writes $2121
	                                             ;   (CGADD) per band even in forced blank and would
	                                             ;   desync the sequential $213B CGRAM readback below
	                                             ;   (man_s1_setup re-zeroes $420c right after us;
	                                             ;   man_host_chrome re-arms via ig_theme_rearm)
	lda #$80 : sta @$002100                      ; force blank
	lda #$80 : sta @$002115                      ; VMAIN: word step after $213A read
	rep #$30 : .al : .xl
	; --- BG1 4bpp font: VRAM word $0000-$1FFF (16KB) -> buffer +0 ---
	lda #$0000 : sta @$002116                    ; VMADD = 0
	lda @$002139                                 ; dummy read (loads word 0, VMADD -> 1)
	ldx #$0000
mss_bg1:
	lda @$002139                                 ; 16-bit read = $2139/$213A (word)
	sta @MANUAL_SHELLSAVE, x
	inx : inx
	cpx #MN_BG1_BYTES                            ; 8192 words = 16KB
	bne mss_bg1
	; --- BG2 2bpp font: VRAM word $4000-$4FFF (8KB) -> buffer +$4000 ---
	lda #MN_BG2_VMADD : sta @$002116             ; VMADD = word $4000
	lda @$002139                                 ; dummy read (loads word $4000, VMADD -> +1)
	ldx #$0000
mss_bg2:
	lda @$002139
	sta @MANUAL_SHELLSAVE|MN_BUF_BG2, x
	inx : inx
	cpx #MN_BG2_BYTES                            ; 4096 words = 8KB
	bne mss_bg2
	; --- CGRAM: real readback via $213B -> buffer +$6000 (512 bytes) ---
	sep #$20 : .as
	lda #$00 : sta @$002121                      ; CGADD = 0
	rep #$10 : .xl
	ldx #$0000
mss_cg:
	lda @$00213B
	sta @MANUAL_SHELLSAVE|MN_BUF_CG, x
	inx
	cpx #$0200
	bne mss_cg
	rep #$30 : .al : .xl
	plp
	rts

; ---- clear both mode-5 tilemaps (BG2 $5000, BG1 $5800; 32x32 = 1024 words each) to the
;      space entry ($2040), like the cheat overlay's ss_ovl_clr. $2115=$80 assumed. ----
man_clear_tilemaps:
	php
	rep #$30 : .al : .xl
	lda #OVL_BG2_MAP : sta @$002116
	lda #$2040
	ldx #$0400
mct_bg2:
	sta @$002118
	dex
	bne mct_bg2
	lda #OVL_BG1_MAP : sta @$002116
	lda #$2040
	ldx #$0400
mct_bg1:
	sta @$002118
	dex
	bne mct_bg1
	plp
	rts

; ---- HOST HOOK: put the shell's fonts + CGRAM back from MANUAL_SHELLSAVE (ch0). Called
;      from man_viewer_exit already in forced blank with $2115 = $80; returns with A 8-bit,
;      exactly as the inline code it replaced left it. ----
man_host_restore_gfx:
	php
	sep #$20 : .as                                 ; (source-order sync; A is already 8-bit)
	; --- restore BG1 font: buffer +0 -> VRAM word $0000 (16KB) via ch0 ---
	rep #$20 : .al
	lda #$0000 : sta @$002116                      ; VMADD = 0
	sep #$20 : .as
	lda #$01 : sta @$004300                         ; mode 1 (2 regs $2118/9), A->B
	lda #$18 : sta @$004301
	rep #$20 : .al
	lda #$0000 : sta @$004302                       ; A addr low ($C40000)
	sep #$20 : .as
	lda #$c4 : sta @$004304
	rep #$20 : .al
	lda #MN_BG1_BYTES : sta @$004305                ; 16KB
	sep #$20 : .as
	lda #$01 : sta @$00420b                          ; trigger ch0
	; --- restore BG2 font: buffer +$4000 -> VRAM word $4000 (8KB) via ch0 ---
	rep #$20 : .al
	lda #MN_BG2_VMADD : sta @$002116                ; VMADD = word $4000
	sep #$20 : .as
	lda #$01 : sta @$004300
	lda #$18 : sta @$004301
	rep #$20 : .al
	lda #MN_BUF_BG2 : sta @$004302                  ; A addr low ($C44000)
	sep #$20 : .as
	lda #$c4 : sta @$004304
	rep #$20 : .al
	lda #MN_BG2_BYTES : sta @$004305                ; 8KB
	sep #$20 : .as
	lda #$01 : sta @$00420b                          ; trigger ch0
	; --- restore CGRAM: buffer +$6000 -> CGRAM (512B) via ch0 ---
	lda #$00 : sta @$002121                          ; CGADD = 0
	lda #$00 : sta @$004300                          ; mode 0 (1 reg), A->B
	lda #$22 : sta @$004301
	rep #$20 : .al
	lda #MN_BUF_CG : sta @$004302                    ; A addr low ($C46000)
	sep #$20 : .as
	lda #$c4 : sta @$004304
	rep #$20 : .al
	lda #$0200 : sta @$004305                        ; 512
	sep #$20 : .as
	lda #$01 : sta @$00420b                          ; trigger ch0
	plp
	rts

; ---- HOST HOOK: rebuild the shell chrome the viewer's tiles clobbered, then UNBLANK. Last
;      thing man_viewer_exit does; entered in forced blank with A/X/Y 16-bit. ----
man_host_chrome:
	php
	rep #$30 : .al : .xl
	lda #$2000 : sta @ovl_pal                          ; chrome + the Manual prompt draw in palette 0
	jsr man_clear_tilemaps
	jsr igmenu_draw_tabbar
	jsr igmenu_draw_footer
	jsr manual_enter                                  ; prompt / error / not-found
	jsr ig_frame_if_static                             ; Slice 1: beveled window frame
	jsr ig_obj_load                                    ; Sprites: re-upload tab icons + re-enable OBJ
	jsr ig_obj_tabbar                                  ; Sprites: rebuild the tab-icon OAM
	sep #$20 : .as
	jsr ig_theme_rearm                                 ; re-enable ch1 (BGMODE 3->5) + the theme's
	                                                   ;   ch2/ch5 and the bar's window regs, LAST
	jsr ig_bar_sync                                    ; ...and put the BAR back where the GUIDES
	                                                   ;   tab left it (igt_win_regs re-collapsed
	                                                   ;   window 1; the viewer already cleared
	                                                   ;   man_modal bit0 before calling us)
	lda #$0f : sta @$002100                            ; unblank
	plp
	rts

; ======================================================================
;  Tab bar: 5 i18n labels on row 1, EVERY tab drawn as a capsule. Each tab is a
;  12-col slot (cap + 10-col field + cap); the label (<=10, guarded) is CENTERED
;  in the field, so the window_tl/window_tr caps (glyphs 28/29) sit at FIXED field
;  edges (base, base+11) and stay aligned regardless of the translated label's width.
;  The ACTIVE tab reads by COLOUR (the slot is recoloured below). Labels come from igm_tab_tbl (the
;  GENERATED i18n table, bank $C2), indexed by CFG.language exactly like help_enter.
;  Built in OVL_RB then flushed with ovl_flush_abs. Forced blank.
;  Clobbers ovl_idx/ovl_rowoff/ovl_cur + igm_tab_lang/igm_tab_len/igm_tab_src.
; ======================================================================
igmenu_draw_tabbar:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                      ; DBR=$F4
	; --- CFG.language clamped 0..IGM_LANG_COUNT-1 (same pattern as help_enter) ---
	lda @CFG_LANGUAGE                          ; $FF01B7
	cmp #IGM_LANG_COUNT
	bcc it_lang_ok
	lda #$00                                   ; out of range -> English (column 0)
it_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	sta @igm_tab_lang
	; --- the whole bar GREYS OUT while content is focused (menu-style disabled look) ---
	lda @igmenu_flags
	bit #$0002
	beq itb_live
	lda #$2400 : sta @igm_tab_tint
	bra itb_tinted
itb_live:
	lda #$2c00 : sta @igm_tab_tint
itb_tinted:
	jsr ovl_row_clear
	ldy #$0000                                ; Y = tab index 0..4
ig_tb_loop:
	; base col = TABBAR_COL0 + tab*TABBAR_SLOT(15 = 1 + 13 + 1)
	tya
	sta @ovl_rowoff                           ; tab (held for the whole iteration)
	asl : asl : asl : asl                     ; *16
	sec : sbc @ovl_rowoff                     ; *15 (= TABBAR_SLOT)
	clc : adc #TABBAR_COL0
	sta @ovl_idx                              ; base col
	; --- source offset = igm_tab_tbl[(tab*IGM_LANG_STRIDE + lang)*2] ---
	;     IGM_LANG_SHIFT asl == *IGM_LANG_STRIDE (see he_copy).
	lda @ovl_rowoff
	asl : asl : asl                           ; tab*8 (IGM_LANG_STRIDE)
	clc : adc @igm_tab_lang                   ; + lang column
	asl                                       ; *2 (word index)
	tax
	lda @igm_tab_tbl, x                        ; A = string offset within bank $C2
	sta @igm_tab_src
	; --- strlen (cap IGM_TAB_FIELD) -> igm_tab_len ---
	tax                                       ; X = source byte offset
	ldy #$0000
	sep #$20 : .as
it_len_l:
	lda @$c20000, x                            ; long,X source byte (bank $C2)
	beq it_len_d
	inx
	iny
	cpy #IGM_TAB_FIELD
	bne it_len_l
it_len_d:
	rep #$30 : .al : .xl
	tya                                       ; A = length (Y clean high from ldy #$0000)
	sta @igm_tab_len
	; --- dst start col = base + 1 + (IGM_TAB_FIELD - len)/2 (center in the field) ---
	lda #IGM_TAB_FIELD
	sec : sbc @igm_tab_len
	lsr                                       ; (field - len)/2
	clc : adc @ovl_idx                        ; + base
	inc                                       ; + 1 (skip the left cap cell)
	tay                                       ; Y = dst start column
	lda @igm_tab_src : tax                     ; X = source offset (16-bit A -> clean tax)
	sep #$20 : .as
it_copy_l:
	lda @$c20000, x                            ; long,X source byte (bank $C2)
	beq it_copy_d
	sta OVL_RB, y                             ; abs,Y (DBR=$F4)
	inx
	iny
	bra it_copy_l
it_copy_d:
	rep #$30 : .al : .xl
	; --- tab separators on EVERY tab: the menu dialogs' VERTICAL BORDER glyphs, WV(26) at
	;     base and EV(27) at base+IGM_TAB_FIELD+1 -- the exact border look the dialogs use.
	;     The active tab is told apart by COLOUR (recolor below) + the BAR. ---
	lda @ovl_idx : tax                          ; X = base col (16-bit A -> clean tax; LDX has no long)
	sep #$20 : .as
	lda #26 : sta OVL_RB, x                      ; window_wv border (left)
	rep #$20 : .al
	lda @ovl_idx : clc : adc #(IGM_TAB_FIELD+1) : tax   ; X = base+14 (16-bit A -> clean tax)
	sep #$20 : .as
	lda #27 : sta OVL_RB, x                       ; window_ev border (right)
	rep #$30 : .al : .xl
ig_tb_next:
	lda @ovl_rowoff
	inc
	tay                                       ; Y = next tab index
	cpy #IGMENU_TABS
	bne ig_tb_loop
	lda #$2000 : sta @ovl_pal                 ; labels: white when live...
	lda @igm_tab_tint : cmp #$2400 : bne itb_lbl_ok
	sta @ovl_pal                              ; ...palette 1 grey when the content owns focus
itb_lbl_ok:
	ldx #TABBAR_ROW
	jsr ovl_flush_abs
	; --- recolor the active tab's WHOLE slot (base .. base+11 = cap + label field + cap) to the
	;     frame cyan: with every tab capsuled, colour is the ONLY active marker. OVL_RB still holds
	;     the flushed bar row; DBR=$F4. base col = TABBAR_COL0 + active_tab*TABBAR_SLOT(12). ---
	lda @igm_tab_tint : cmp #$2c00
	bne itb_no_hl                             ; greyed bar = uniform, no active highlight
	lda @active_tab : and #$00ff
	sta @ovl_cur                              ; tab-bar scratch, dead after the loop
	asl : asl : asl : asl                     ; *16
	sec : sbc @ovl_cur                        ; *15 (= TABBAR_SLOT)
	clc : adc #TABBAR_COL0                    ; base col
	sta @ig_rc_col
	clc : adc #TABBAR_SLOT                    ; base + slot (exclusive end -> cols base..base+14)
	sta @ig_rc_end
	lda #TABBAR_ROW : sta @ig_rc_row
	lda #$2c00 : sta @ig_rc_pal
	jsr ig_recolor
itb_no_hl:
	; --- row 1's separators in the frame amber, ALL of them (the active-slot recolor above
	;     already made its own pair amber; repainting all 8 is idempotent). Single-cell VRAM
	;     writes, row 1: even col -> BG2 entry, odd -> BG1, entry index = 32 + col>>1. ---
	lda #$0000 : sta @ovl_rowoff              ; tab counter
igt_sep_l:
	lda @ovl_rowoff
	sta @ovl_cur
	asl : asl : asl : asl                     ; *16
	sec : sbc @ovl_cur                        ; *15 (= TABBAR_SLOT)
	clc : adc #TABBAR_COL0
	sta @ovl_cur                              ; current col = base (left separator)
	lda #$0034 : ora @igm_tab_tint            ; WV = (26<<1) | tint
	jsr igt_sep_cell
	lda @ovl_cur : clc : adc #(IGM_TAB_FIELD+1) : sta @ovl_cur
	lda #$0036 : ora @igm_tab_tint            ; EV = (27<<1) | tint
	jsr igt_sep_cell
	lda @ovl_rowoff : inc : sta @ovl_rowoff
	cmp #IGMENU_TABS
	bcc igt_sep_l
	; --- rows 0 and 2: the boxes' TOP and BOTTOM borders, the four tabs JOINED edge to edge
	;     (NE|NW and SE|SW corner pairs back to back at the shared edges) -- the dialogs'
	;     border look wrapped around every tab. Flushed in the frame amber. ---
	jsr ovl_row_clear
	ldy #$0000                                ; tab index
igt_top_l:
	tya : sta @ovl_cur
	asl : asl : asl : asl
	sec : sbc @ovl_cur                        ; *15
	clc : adc #TABBAR_COL0
	tax                                       ; X = base col (A clean 16-bit)
	phy
	sep #$20 : .as
	lda #20 : sta OVL_RB, x                   ; NW corner
	ldy #$000d                                ; 13 edge cells (the label field)
	lda #24                                   ; NH edge
igt_top_e:
	inx
	sta OVL_RB, x
	dey
	bne igt_top_e
	inx
	lda #21 : sta OVL_RB, x                   ; NE corner
	rep #$30 : .al : .xl
	ply
	iny
	cpy #IGMENU_TABS
	bne igt_top_l
	lda @igm_tab_tint : sta @ovl_pal
	ldx #$0000
	jsr ovl_flush_abs                         ; row 0 = top borders
	jsr ovl_row_clear
	ldy #$0000
igt_bot_l:
	tya : sta @ovl_cur
	asl : asl : asl : asl
	sec : sbc @ovl_cur
	clc : adc #TABBAR_COL0
	tax
	phy
	sep #$20 : .as
	lda #22 : sta OVL_RB, x                   ; SW corner
	ldy #$000d
	lda #25                                   ; SH edge
igt_bot_e:
	inx
	sta OVL_RB, x
	dey
	bne igt_bot_e
	inx
	lda #23 : sta OVL_RB, x                   ; SE corner
	rep #$30 : .al : .xl
	ply
	iny
	cpy #IGMENU_TABS
	bne igt_bot_l
	ldx #$0002
	jsr ovl_flush_abs                         ; row 2 = bottom borders
	lda #$2000 : sta @ovl_pal                 ; restore palette 0 for later draws
	plb
	plp
	rts
igt_sep_cell:                                 ; A = tilemap entry value; ovl_cur = column (row 1)
	sta @igm_tab_len                          ; entry value (temp)
	lda @ovl_cur
	lsr                                       ; col>>1; carry = bit0 (set = odd col -> BG1)
	bcs igt_sc_bg1
	clc : adc #(OVL_BG2_MAP + 32)             ; even col -> BG2, row 1 entries start at 32
	bra igt_sc_go
igt_sc_bg1:
	clc : adc #(OVL_BG1_MAP + 32)
igt_sc_go:
	sta @$002116
	lda @igm_tab_len
	sta @$002118
	rts

; ======================================================================
;  Footer (row 25): the new bindings. Copied from a $C2 string via long,X. Forced blank.
; ======================================================================
igmenu_draw_footer:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                      ; DBR=$F4
	rep #$30 : .al : .xl
	jsr ovl_row_clear
	; pick the footer by focus level (igmenu_flags bit1) then tab. ovl_idx counts the chars
	; left (the three strings differ in length AND start column).
	lda @igmenu_flags
	bit #$0002
	bne ig_ft_content                         ; content focus -> per-tab content line
	ldx #$0000                                ; tab-bar line (offset 0)
	ldy #IG_FT_TAB_COL
	lda #IG_FT_TAB_LEN
	bra ig_ft_go
ig_ft_content:
	lda @active_tab
	bne ig_ft_generic
	ldx #IG_FT_TAB_LEN                        ; Cheats content line (right after the tab-bar one)
	ldy #IG_FT_CHT_COL
	lda #IG_FT_CHT_LEN
	bra ig_ft_go
ig_ft_generic:
	ldx #(IG_FT_TAB_LEN+IG_FT_CHT_LEN)        ; generic content line (last)
	ldy #IG_FT_GEN_COL
	lda #IG_FT_GEN_LEN
ig_ft_go:
	sta @ovl_idx                              ; remaining characters
	sep #$20 : .as
ig_ft_loop:
	lda @ig_footer_str, x
	sta OVL_RB, y
	inx : iny
	rep #$20 : .al
	lda @ovl_idx : dec : sta @ovl_idx
	beq ig_ft_done
	sep #$20 : .as
	bra ig_ft_loop
ig_ft_done:
	rep #$30 : .al : .xl
	ldx #$0019                                ; absolute tile row 25
	jsr ovl_flush_abs
	plb
	plp
	rts

; ======================================================================
;  clear the body window (tile rows 3..24) to the space entry in both tilemaps. Covers the
;  list body (4..23) PLUS the frame's top (3) and bottom (24) border rows, so switching away
;  from a framed tab (e.g. to Cheats, which draws no frame) leaves no stray border behind.
;  Forced blank (direct VRAM); $2115=$80 assumed. .al/.xl.
; ======================================================================
ig_clear_body:
	php
	sep #$20 : .as : rep #$10 : .xl
	; GP-DMA fill (ch0): the old CPU loop was ~28k cycles (over a frame) and was most of the
	; visible black blink on tab switches. Two fixed-source DMAs per map: LOW bytes via $2118
	; with VMAIN=$00 (step after low), HIGH bytes via $2119 with VMAIN=$80. Source = the two
	; constant bytes ig_theme_init stages in borrowed WRAM ($7E007B/$7E007C = $40/$20 ->
	; entry $2040, space in palette 0).
	ldx #(OVL_BG2_MAP + 3*32)
	jsr ig_cb_fill                                  ; rows 3..24, BG2 map
	ldx #(OVL_BG1_MAP + 3*32)
	jsr ig_cb_fill                                  ; rows 3..24, BG1 map
	lda #$80 : sta @$002115                         ; restore word-step-after-high for the flushes
	plp
	rts
ig_cb_fill:                                        ; X = VRAM word base; fills 22 rows * 32 words
	rep #$20 : .al
	txa : sta @$002116
	sep #$20 : .as
	lda #$00 : sta @$002115                         ; step +1 word after each LOW byte write
	lda #$08 : sta @$004300                         ; ch0: mode 0 (1 reg), FIXED A address
	lda #$18 : sta @$004301                         ; B = $2118 (low bytes)
	rep #$20 : .al
	lda #$007b : sta @$004302                       ; A1T = $7E007B (the $40 constant)
	lda #(22*32) : sta @$004305                     ; 704 bytes
	sep #$20 : .as
	lda #$7e : sta @$004304
	lda #$01 : sta @$00420b                         ; fire (low bytes)
	rep #$20 : .al
	txa : sta @$002116
	sep #$20 : .as
	lda #$80 : sta @$002115                         ; step +1 word after each HIGH byte write
	lda #$08 : sta @$004300
	lda #$19 : sta @$004301                         ; B = $2119 (high bytes)
	rep #$20 : .al
	lda #$007c : sta @$004302                       ; A1T = $7E007C (the $20 constant)
	lda #(22*32) : sta @$004305
	sep #$20 : .as
	lda #$7e : sta @$004304
	lda #$01 : sta @$00420b                         ; fire (high bytes)
	rts

; ======================================================================
;  Slice 2: semantic BG palettes + a per-run recolour. The draw stays palette-0 (white); the
;  coloured tokens are repainted afterwards from OVL_RB (which still holds the flushed row).
;  Palette 2 = green (EXISTS/ON/OCCUPIED), palette 3 = amber (notch titles). Dim
;  (MISSING/OFF/EMPTY) reuses palette 1 grey ($2400). A coloured cell spans BOTH interleaved
;  layers, so each palette fills its BG2 (2bpp, CGRAM N*4) AND BG1 (4bpp, CGRAM N*16) block.
;  Entries 1..3 = ink shades; value 0 is transparent (shows the blue backdrop). Forced blank.
; ======================================================================
ig_init_palettes:
	php
	sep #$20 : .as
	rep #$10 : .xl
	lda #9  : sta @$002121                     ; green -> BG2 pal2 (CGRAM 9..11)
	jsr ig_pal_green
	lda #33 : sta @$002121                     ; green -> BG1 pal2 (CGRAM 33..35)
	jsr ig_pal_green
	lda #13 : sta @$002121                     ; frame -> BG2 pal3 (CGRAM 13..15)
	jsr ig_pal_frame
	lda #49 : sta @$002121                     ; frame -> BG1 pal3 (CGRAM 49..51)
	jsr ig_pal_frame
	plp
	rts
; green tuned to pal0's tone SPREAD so the 2-tone font stays crisp: value1 bright, value2
; DARK (the shading/outline that separates the glyph from the backdrop -- pal0's is $18C6),
; value3 mid. Flat-bright 2/3 made the shading glow as bright as the stroke -> "blurred".
ig_pal_green:                                  ; (.as; CGADD already set)
	lda #$e0 : sta @$002122 : lda #$03 : sta @$002122   ; value1 $03E0  G31  bright green
	lda #$c0 : sta @$002122 : lda #$00 : sta @$002122   ; value2 $00C0  G6   dark green (outline)
	lda #$00 : sta @$002122 : lda #$03 : sta @$002122   ; value3 $0300  G24  mid green
	rts
ig_pal_frame:                                  ; the MENU'S window-frame palette (palette.a65 pal3):
                                               ; light-cyan / dark-blue / teal bevel -- matches m3nu.
	lda #$b1 : sta @$002122 : lda #$7f : sta @$002122   ; value1 $7FB1  light cyan (core)
	lda #$a1 : sta @$002122 : lda #$24 : sta @$002122   ; value2 $24A1  dark blue (edge/outline)
	lda #$ec : sta @$002122 : lda #$62 : sta @$002122   ; value3 $62EC  teal (highlight)
	rts

; ======================================================================
;  THEME: apply the MENU's active theme to the shell -- backdrop gradient (HDMA ch2), themed
;  BG palettes, and the infrastructure the selection BAR rides on (HDMA ch5 colour-math table +
;  the colour window / CGWSEL regs). The $C0 overlay stages the THEMED bytes into the IGM_THM_*
;  PSRAM block right before the `jsl $c20008`; this bank is a separate link and sees none of the
;  menu symbols, so the block is our only source. IGM_THM_MAGIC = $A5 gates it: on anything else
;  (old overlay, aborted copy) we fall back to the baked palettes + a baked BAR table, which is
;  why the BAR half is armed UNCONDITIONALLY -- the bar must exist even without a theme.
;  Runs in forced blank from igmenu_main's init. Pairs with ig_theme_teardown at the exit rtl.
; ======================================================================
ig_theme_init:
	php
	sep #$20 : .as : rep #$10 : .xl
	; --- 1. save everything we borrow, BEFORE the magic test: the BAR half runs on both paths,
	;        so the WRAM run and both $43xx files are dirtied either way. ---
	ldx #$0000
igt_wsave:
	lda @$7E0005, x : sta @ig_thm_wsave, x
	inx : cpx #$0078 : bne igt_wsave             ; 120 B: $7E0005..$7E007C (grad+bar+line0+fill)
	ldx #$0000
igt_rsave:
	lda @$004320, x : sta @ig_thm_ch2save, x     ; ch2 $4320-$432B
	lda @$004330, x : sta @ig_thm_ch3save, x     ; ch3 $4330-$433B
	lda @$004350, x : sta @ig_thm_ch5save, x     ; ch5 $4350-$435B
	inx : cpx #$000c : bne igt_rsave
	; --- 2. the BAR's colour-math table, ALWAYS (themed if staged, baked otherwise) ---
	lda @IGM_THM_MAGIC
	cmp #$a5
	bne igt_math_baked
	ldx #$0000
igt_math_thm:
	lda @IGM_THM_MATH, x : sta @$7E0061, x
	inx : cpx #$0013 : bne igt_math_thm          ; 19 B
	; The staged table came from hdma_math_SRC, whose bar-colour slots the menu never updates
	; (set_bar_color rewrites the WRAM hdma_math copy, not the source) -- so stamp the theme's
	; NORMAL bar colour into the very slots ui.a65's set_bar_color uses: +2/+5/+8/+11.
	lda @IGM_THM_BARCOL+0 : sta @$7E0063
	lda @IGM_THM_BARCOL+1 : sta @$7E0066
	lda @IGM_THM_BARCOL+2 : sta @$7E0069
	lda @IGM_THM_BARCOL+3 : sta @$7E006c
	bra igt_math_done
igt_math_baked:
	ldx #$0000
igt_math_def:
	lda @ig_thm_math_def, x : sta @$7E0061, x    ; long,X read of our own bank-$C2 data
	inx : cpx #$0013 : bne igt_math_def
igt_math_done:
	; --- 3/4. gradient + palettes: themed, or the baked green/frame palettes as before ---
	lda @IGM_THM_MAGIC
	cmp #$a5
	beq igt_themed
	jsr ig_init_palettes                         ; no staged block -> baked semantic palettes
	lda #$2a : sta @ig_hdma_mask                 ; ch1 (BGMODE) + ch3 (line-0 mask) + ch5 (BAR)
	bra igt_chan5
igt_themed:
	jsr igt_grad_build                           ; blob -> ch2 HDMA table in the borrowed WRAM
	jsr igt_pal_apply                            ; themed CGRAM
	; --- 5a. ch2 = backdrop gradient. Transfer mode 3 writes B,B,B+1,B+1 = $2121,$2121,$2122,
	;         $2122, i.e. "CGRAM address 0, then the colour word" -- one channel does what the
	;         menu needs two (ch1 address + ch2 data) for. ---
	lda #$03 : sta @$004320                      ; DMAP: A->B, direct, transfer mode 3
	lda #$21 : sta @$004321                      ; B-bus = $2121 (CGADD) / $2122 (CGDATA)
	lda #$05 : sta @$004322                      ; A1T = $7E0005 (low byte). NO trailing
	                                             ;   backslash art here: this file goes through
	                                             ;   cpp, and a backslash at end-of-comment is a
	                                             ;   LINE CONTINUATION that swallows the next
	                                             ;   instruction (ate the A1T-high store once).
	lda #$00 : sta @$004323                      ; A1T high
	lda #$7e : sta @$004324                      ; A1T bank
	lda #$2e : sta @ig_hdma_mask                 ; ch1 (BGMODE) + ch2 (gradient) + ch3 + ch5 (BAR)
igt_chan5:
	; --- 5b. ch5 = the selection BAR's colour math, ALWAYS. Transfer mode 1 = two regs
	;         ($2131 CGADSUB + $2132 COLDATA), same shape the menu uses. ---
	lda #$01 : sta @$004350                      ; DMAP: A->B, direct, transfer mode 1
	lda #$31 : sta @$004351                      ; B-bus = $2131 / $2132
	lda #$61 : sta @$004352                      ; A1T = $7E0061 (low; same no-backslash rule)
	lda #$00 : sta @$004353                      ; A1T high
	lda #$7e : sta @$004354                      ; A1T bank
	; --- 5c. ch3 = scanline-0 mask, ALWAYS. The BGMODE flip only lands on line 1, so line 0
	;         renders the mode-5 data in MODE 3 -- the "dashed" garbage line at the top of the
	;         screen since the overlay exists. Drive window 2 ($2128/$2129) per scanline: line 0
	;         gets an EMPTY range (left>right; the $2123=$cc INVERT masks BG1+BG2 everywhere ->
	;         only the backdrop shows), line 1 restores the normal 1..252 edge mask. ---
	lda #$01 : sta @$7E0074                      ; 1 line:
	lda #$ff : sta @$7E0075                      ;   W2 left  = 255 (empty range,
	lda #$00 : sta @$7E0076                      ;   W2 right = 0    inverted -> mask ALL)
	lda #$01 : sta @$7E0077                      ; 1 line:
	lda #$01 : sta @$7E0078                      ;   W2 left  = 1  (the normal
	lda #$fc : sta @$7E0079                      ;   W2 right = 252 edge mask)
	lda #$00 : sta @$7E007A                      ; terminator
	lda #$40 : sta @$7E007B                      ; ig_clear_body DMA-fill constants: tilemap
	lda #$20 : sta @$7E007C                      ;   entry $2040 (space, pal 0), low/high
	lda #$01 : sta @$004330                      ; DMAP: A->B, direct, transfer mode 1
	lda #$28 : sta @$004331                      ; B-bus = $2128 / $2129
	lda #$74 : sta @$004332                      ; A1T = $7E0074 (low)
	lda #$00 : sta @$004333                      ; A1T high
	lda #$7e : sta @$004334                      ; A1T bank
	; --- 6. colour window + math region (always) ---
	jsr igt_win_regs
	plp
	rts

; ---- the BAR's PPU side: "colour math, but ONLY inside window 1", so the WINDOW *is* the bar
;      and the selection-BAR workstream positions it by moving $2126/$2127. Left=1 / right=0 is
;      an EMPTY (collapsed) window -> no bar visible until it does. $2131 is deliberately NOT
;      touched: the ch5 HDMA owns it every scanline. (.as) ----
igt_win_regs:
	lda #$20 : sta @$002125                      ; WOBJSEL: colour window 1 enabled, not inverted
	lda #$10 : sta @$002130                      ; CGWSEL: math INSIDE the colour window only,
	                                             ;   fixed colour ($2132) as the math operand
	lda #$01 : sta @$002126                      ; window 1 left  = 1  \ left > right = empty
	lda #$00 : sta @$002127                      ; window 1 right = 0  / (bar invisible for now)
	rts

; ---- ig_theme_rearm: put the theme back after a sub-mode that took the PPU over. The GUIDES
;      viewer runs its own BG mode with HDMA fully off and rebuilds the shell's mode-5 register
;      file on the way out (man_restore_mode5_regs), which zeroes exactly the colour-window and
;      CGWSEL bits the bar needs and re-enables only ch1 -- without this the gradient and the BAR
;      would die silently on the first guide the user opens. The WRAM tables and the ch2/ch5
;      $43xx files survive untouched (the viewer only clears $420C), so re-arming is just the
;      registers + the mask. Forced blank, called before the caller's unblank. ----
ig_theme_rearm:
	php
	sep #$20 : .as
	jsr igt_win_regs
	; Vblank-edge gate, same reason as igmenu_main's arm: a mid-frame enable runs the rest
	; of the frame on the channels' stale A2A pointers (V=0 does the A1T reload) and sprays
	; garbage at $2121/$2122/$2131.
	- lda @$004212 : bmi -                       ; wait until active display...
	- lda @$004212 : bpl -                       ; ...then the vblank START edge
	lda @ig_hdma_mask : sta @$00420c             ; ch1|ch3|ch5 baked ($2A) / +ch2 themed ($2E)
	plp
	rts

; ======================================================================
;  WS-C: the selection BAR. ig_theme_init built everything it rides on -- the ch5 colour-math
;  HDMA table in the borrowed game WRAM ($7E0061, 19 B = [count,$2131,$2132] x6 + terminator),
;  CGWSEL/WOBJSEL set to "math INSIDE colour window 1 only", and window 1 COLLAPSED
;  ($2126=1 > $2127=0) so nothing shows until we place it. Placing it is exactly the menu's
;  own NMI arithmetic (snes/reset.a65) applied to the shell's coordinates:
;
;    VERTICAL. y_px = the bar's top scanline. HDMA repeat counts are 7-bit, so the "lines
;      before the bar" run is SPLIT across the table's first two entries ($7E0061 and $7E0064,
;      the two count bytes whose $2131 is math-OFF):
;          y_px < 113 -> [0] = y_px, [3] = 1
;          else       -> [0] = 112,  [3] = y_px - 111
;      (Both spend y_px+1 lines, the HDMA's own one-line lead included; entries 2/3 are the
;      8 math-ON lines that ARE the bar.) The menu feeds this a 1-based bar_yl with
;      y_px = (bar_yl-1)*8; here the callers hand us ABSOLUTE 0-based tile rows, so
;      y_px = row*8. NOTE: a +-1 scanline trim (bar sitting one line above/below the glyph
;      box) is a HARDWARE call -- if it needs one, bias y_px right here, in ONE place.
;      Row 0 is never a target (a count byte of 0 would terminate the table early).
;
;    HORIZONTAL. The window regs are 256-px coordinates and one logical column is 4 of them
;      (mode 5 hires: 64 cols x 8 hires px, and the window works in the 256-px space):
;          WH0 ($2126) = xl*4 - 2,  WH1 ($2127) = WH0 + wl*4 + 1
;      Widest case is xl=2/wl=60 -> 6..247, so both fit a byte.
;
;  Called once per frame from igmenu_loop's vblank window (the ch5 HDMA reloads its table
;  pointer at V=0, so the rewrite is atomic to the PPU) AND from every transition before its
;  unblank, so the bar never trails a frame. Safe at ANY register width (php/rep/plp) and it
;  touches no index register at all.
; ======================================================================
ig_bar_sync:
	php
	rep #$30 : .al : .xl
	; --- manual viewer: it owns the PPU with $420C cleared, so there is no bar to place ---
	lda @igmenu_flags
	bit #$0001
	beq igb_live
	plp
	rts
igb_live:
	jsr igb_target_tab                           ; default target = the active tab's capsule
	lda @igmenu_flags
	bit #$0002
	bne igb_content                              ; (inverted + jmp: the per-tab blocks below put
	jmp igb_place                                ;  igb_place way out of beq range. Tab-bar level
	                                             ;  -> the capsule IS the target.)
igb_content:
	lda @active_tab : and #$00ff
	beq igb_t_cheats
	cmp #$0001 : beq igb_t_states
	cmp #$0002 : beq igb_t_saves
	cmp #$0003 : beq igb_t_guides
	jmp igb_place                                ; tab 4 (HELP) is static -> keep the capsule

igb_t_cheats:
	lda @ovl_count
	bne igb_c_row
	jmp igb_place                                ; empty list ("no cheats" message) -> capsule
igb_c_row:
	lda @ovl_selrow                              ; SCREEN row 0..visible-1
	clc : adc #OVL_LIST_ROW0
	sta @ig_bar_row
	lda #IGB_LIST_XL : sta @ig_bar_xl
	lda #IGB_LIST_WL : sta @ig_bar_wl
	jmp igb_place

igb_t_states:
	lda @sst_disabled
	beq igb_s_row
	jmp igb_place                                ; slots off -> just a message, no cursor
igb_s_row:
	jsr igb_slot_row
	jmp igb_place

igb_t_saves:
	; the slot selector exists only when EnableSramSlots is on -- the status-only view has no
	; cursor at all (same test saves_enter uses to pick the view)
	sep #$20 : .as
	lda @CFG_ENABLE_SRAM_SLOTS
	rep #$30 : .al : .xl
	and #$00ff
	bne igb_v_row
	jmp igb_place
igb_v_row:
	jsr igb_slot_row
	jmp igb_place

igb_t_guides:
	; the guide LIST is on screen only when manual_enter took the mn_list path -- mn_list_live
	; is zeroed at manual_enter's entry and set right before guides_list_draw. Re-deriving the
	; mn_chk_present gate here would miss the ERROR screen (man_error is consumed when drawn)
	; and park the BAR over an empty row of it.
	rep #$30 : .al : .xl
	lda @mn_list_live
	bne igb_g_row
	jmp igb_place                                ; prompt/error/not-found -> keep the capsule
igb_g_row:
	lda @man_list_cursor
	clc : adc #GD_LIST_ROW0
	sta @ig_bar_row
	lda @ig_win_x : and #$00ff : inc : sta @ig_bar_xl     ; the frame's interior span --
	lda @ig_win_w : and #$00ff : dec : dec : sta @ig_bar_wl ; reads like a real selection row
	jmp igb_place

; ---- commit ig_bar_row/ig_bar_xl/ig_bar_wl to the ch5 table + the window regs. 8-bit A: every
;      value here is a byte (rows 0..25, columns 0..63), and ig_bar_tmp is used as a byte. ----
igb_place:
	sep #$20 : .as
	lda @ig_bar_row
	asl : asl : asl                              ; y_px = row * 8
	dec : dec : dec                              ; -3: one line of COLDATA G-reset before the
	                                             ;   border + the HDMA write only taking effect on
	                                             ;   the NEXT rendered line = the visible span is
	                                             ;   OFF+2..OFF+10. OFF = row*8-3 -> border on the
	                                             ;   last line of the row above, body on glyph
	                                             ;   lines 0-6, half-border on line 7 (hardware-
	                                             ;   calibrated: -2 still sat 1 line low)
	cmp #113
	bcs igb_lower
	sta @$7E0061                                 ; entry 0 count = lines before the bar
	lda #$01 : sta @$7E0064                      ; entry 1 count = the complementary line
	bra igb_horiz
igb_lower:
	sbc #111                                     ; carry set by the cmp -> A - 111 (<= 127)
	sta @$7E0064
	lda #112 : sta @$7E0061
igb_horiz:
	lda @ig_bar_xl
	asl : asl                                    ; xl * 4
	sec : sbc #$02                               ; - 2
	sta @$002126                                 ; WH0 = window 1 left
	sta @ig_bar_tmp
	lda @ig_bar_wl
	asl : asl                                    ; wl * 4
	inc                                          ; + 1
	clc : adc @ig_bar_tmp
	sta @$002127                                 ; WH1 = window 1 right
	plp
	rts

; ---- default target: the ACTIVE tab's capsule on the tab bar (also the fallback for every
;      tab/state with no content cursor). base col = TABBAR_COL0 + tab*TABBAR_SLOT, width =
;      one whole slot (cap + i18n field + cap), matching igmenu_draw_tabbar's recolour span. ----
igb_target_tab:
	php
	rep #$30 : .al : .xl
	lda #TABBAR_ROW : sta @ig_bar_row
	lda @active_tab : and #$00ff
	sta @ig_bar_tmp
	asl : asl : asl : asl                        ; *16
	sec : sbc @ig_bar_tmp                        ; *15 (= TABBAR_SLOT)
	clc : adc #TABBAR_COL0
	inc                                          ; +1: INSIDE the box (skip the left border cell)
	sta @ig_bar_xl
	lda #IGM_TAB_FIELD : sta @ig_bar_wl          ; the label field only -- never over the borders
	plp
	rts

; ---- shared States/Saves slot target: row = SST_SLOT_ROW0 + (sst_cursor-1)*SST_SLOT_STEP.
;      sst_cursor is 1..4; 0 would only appear if PSRAM were read before an enter ran, so it
;      is folded onto slot 1 rather than underflowing the row. ----
igb_slot_row:
	php
	rep #$30 : .al : .xl
	lda @sst_cursor : and #$00ff
	beq igb_sr_row                               ; defensive: 0 -> slot 1's row
	dec
igb_sr_row:
	asl                                          ; * SST_SLOT_STEP (2)
	clc : adc #SST_SLOT_ROW0
	sta @ig_bar_row
	lda @ig_win_x : and #$00ff : inc : sta @ig_bar_xl     ; the frame's interior span --
	lda @ig_win_w : and #$00ff : dec : dec : sta @ig_bar_wl ; reads like a real selection row
	plp
	rts

; ---- igt_grad_build: convert the staged [count, lo, hi]* backdrop blob into the ch2 HDMA table
;      in the borrowed WRAM. Each band becomes `count, $00, $00, lo, hi` (the mode-3 quartet:
;      $2121=0, $2121=0, $2122=lo, $2122=hi -> CGRAM entry 0 = the backdrop for those scanlines).
;      The count byte keeps bit7 clear = "repeat this data for N lines", exactly as in the menu's
;      hdma_pal_src. Two stops: the blob's own count==0 terminator, and -- defensively, against a
;      corrupt blob with no terminator -- the point where the next 5-byte entry would not fit the
;      92-byte region (a legitimate 55-byte blob is at most 18 bands = 91 output bytes, so this
;      never truncates real data). DBR=$F4 for the abs,Y blob reads (no long,Y exists); the WRAM
;      writes stay long,X. .as/.xl. ----
igt_grad_build:
	php
	phb
	sep #$20 : .as : rep #$10 : .xl
	lda #$f4 : pha : plb                         ; DBR=$F4 (IGM_THM_GRAD_A abs,Y)
	ldy #$0000                                   ; source byte offset within the blob
	ldx #$0000                                   ; destination byte offset within the table
igt_gb_loop:
	cpx #$0057                                   ; guard: entry must start at or below +$56 (with the
	bcs igt_gb_end                               ;   5-byte stride the last reachable start is +$55 ->
	                                             ;   entry $7E005A..$7E005E, terminator at $7E005F)
	lda IGM_THM_GRAD_A, y                        ; band scanline count ($00 = end of blob)
	and #$7f                                     ; strip bit7: a malformed theme count with bit7 set
	                                             ;   would flip the entry to per-line mode (N*4 bytes)
	                                             ;   and run the HDMA cursor past $7E0060 into the
	                                             ;   ch5 table + game WRAM
	beq igt_gb_end
	sta @$7E0005, x                              ; +0 line count (bit7 clear = one data set held N lines)
	lda #$00
	sta @$7E0006, x                              ; +1 $2121 = CGRAM address 0
	sta @$7E0007, x                              ; +2 $2121 again (mode 3 writes B twice)
	lda IGM_THM_GRAD_A+1, y : sta @$7E0008, x    ; +3 $2122 = colour low
	lda IGM_THM_GRAD_A+2, y : sta @$7E0009, x    ; +4 $2122 = colour high
	iny : iny : iny                              ; input stride 3
	inx : inx : inx : inx : inx                  ; output stride 5
	bra igt_gb_loop
igt_gb_end:
	lda #$00 : sta @$7E0005, x                   ; HDMA table terminator
	plb
	plp
	rts

; ---- igt_pal_apply: the themed CGRAM. The shell's palette slots mirror ig_init_palettes'
;      (pal0 text, pal1 grey/greyed, pal2 green, pal3 frame); a coloured cell spans BOTH
;      interleaved layers, so every sub-palette is written to its BG2 (2bpp, CGRAM N*4) AND
;      BG1 (4bpp, CGRAM N*16) block -- except pal0, whose two blocks overlap at CGRAM 0..3.
;      Forced blank. .as/.xl. ----
igt_pal_apply:
	php
	sep #$20 : .as : rep #$10 : .xl
	; CGRAM 0 = the FIRST gradient band's colour. Colour 0 of every BG palette is transparent,
	; so entry 0 is what shows through the text layers, and it is also the static backdrop for
	; the overscan lines the HDMA table does not cover.
	lda #$00 : sta @$002121
	lda @IGM_THM_GRAD+1 : sta @$002122
	lda @IGM_THM_GRAD+2 : sta @$002122
	lda #1  : ldx #$0002 : jsr igt_pal3          ; pal0 text  -> CGRAM 1..3  (BG1+BG2 pal0)
	lda #5  : ldx #$000a : jsr igt_pal3          ; pal6 grey  -> CGRAM 5..7  (BG2 pal1, greyed)
	lda #17 : ldx #$000a : jsr igt_pal3          ; pal6 grey  -> CGRAM 17..19 (BG1 pal1)
	lda #9  : ldx #$0012 : jsr igt_pal3          ; pal2 green -> CGRAM 9..11 (BG2 pal2)
	lda #33 : ldx #$0012 : jsr igt_pal3          ; pal2 green -> CGRAM 33..35 (BG1 pal2)
	lda #13 : ldx #$001a : jsr igt_pal3          ; pal3 frame -> CGRAM 13..15 (BG2 pal3)
	lda #49 : ldx #$001a : jsr igt_pal3          ; pal3 frame -> CGRAM 49..51 (BG1 pal3)
	plp
	rts
; ---- 3 colours (6 bytes) of a staged sub-palette -> CGRAM. A (8-bit) = first CGRAM entry,
;      X (16-bit) = byte offset within IGM_THM_PAL (+2 skips the sub-palette's transparent
;      colour 0). Clobbers A/X/Y. (.as/.xl; CGADD set here.) ----
igt_pal3:
	sta @$002121
	ldy #$0006
igt_p3_loop:
	lda @IGM_THM_PAL, x : sta @$002122
	inx
	dey
	bne igt_p3_loop
	rts

; ======================================================================
;  THEME teardown: hand the borrowed state back before the shell's rtl. The $C0 exit restores
;  VRAM/CGRAM/the whole $21xx+$43xx file from the game snapshot, so the only thing it CANNOT
;  undo is the game WRAM we wrote our HDMA tables into -- that is the mandatory half here; the
;  $43xx/$420C half keeps the shell self-contained (and correct even if the exit path changes).
; ======================================================================
; ---- brightness ramps for the tab switches: 3 vblank-paced steps each way instead of a hard
;      cut to black. fade_out ENDS in forced blank ($80) so the redraw runs blanked as before;
;      fade_in assumes the caller finished its VRAM writes. (.as inside; php/plp wrapped.) ----
ig_fade_out:
	php
	sep #$20 : .as
	lda #$0b : jsr igf_step
	lda #$07 : jsr igf_step
	lda #$03 : jsr igf_step
	lda #$80 : sta @$002100                      ; forced blank for the redraw
	plp
	rts
ig_fade_in:
	php
	sep #$20 : .as
	lda #$03 : jsr igf_step
	lda #$07 : jsr igf_step
	lda #$0b : jsr igf_step
	lda #$0f : sta @$002100
	plp
	rts
igf_step:                                        ; A = brightness; applied on a vblank edge
	pha
	- lda @$004212 : bmi -                       ; wait until active display...
	- lda @$004212 : bpl -                       ; ...then the vblank START edge
	pla
	sta @$002100
	rts

ig_theme_teardown:
	php
	sep #$20 : .as : rep #$10 : .xl
	; Land on a vblank BOUNDARY first: while the display is active those WRAM bytes and $43xx
	; regs ARE the live HDMA source, and rewriting them mid-frame feeds the PPU half-old,
	; half-new bands. Same active->vblank edge idiom the $C0 restore syncs on.
	- lda @$004212 : bmi -                       ; wait until active display (bit7 = 0)
	- lda @$004212 : bpl -                       ; ...then until vblank starts (bit7 = 1)
	lda #$02 : sta @$00420c                      ; back to the $C0 hook's ch1-only (BGMODE) HDMA
	ldx #$0000
igt_rrst:
	lda @ig_thm_ch2save, x : sta @$004320, x     ; ch2 $4320-$432B
	lda @ig_thm_ch3save, x : sta @$004330, x     ; ch3 $4330-$433B
	lda @ig_thm_ch5save, x : sta @$004350, x     ; ch5 $4350-$435B
	inx : cpx #$000c : bne igt_rrst
	ldx #$0000
igt_wrst:
	lda @ig_thm_wsave, x : sta @$7E0005, x
	inx : cpx #$0078 : bne igt_wrst              ; 120 B: $7E0005..$7E007C
	plp
	rts

; ---- ig_recolor: repaint cells [ig_rc_col, ig_rc_end) on row ig_rc_row into ig_rc_pal,
;      re-reading each glyph from OVL_RB (unchanged by the flush). Even col -> BG2, odd ->
;      BG1; tilemap entry index = row*32 + col>>1. DBR=$F4, $2115=$80, forced blank. .al/.xl. ----
ig_recolor:
	php
	rep #$30 : .al : .xl
	lda @ig_rc_col : sta @ig_rc_tmp
irc_loop:
	lda @ig_rc_tmp
	cmp @ig_rc_end
	bcs irc_done
	lda @ig_rc_tmp : lsr : sta @ig_rc_ei         ; col>>1 (tilemap entry index within a row)
	lda @ig_rc_row
	asl : asl : asl : asl : asl                  ; row*32
	clc : adc @ig_rc_ei
	sta @ig_rc_addr
	lda @ig_rc_tmp : and #$0001
	beq irc_bg2
	lda @ig_rc_addr : clc : adc #OVL_BG1_MAP : sta @$002116   ; odd col -> BG1
	bra irc_wr
irc_bg2:
	lda @ig_rc_addr : clc : adc #OVL_BG2_MAP : sta @$002116   ; even col -> BG2
irc_wr:
	lda @ig_rc_tmp : tax
	sep #$20 : .as
	lda OVL_RB, x                                ; glyph (OVL_RB still holds the flushed row)
	rep #$30 : .al : .xl
	and #$00ff
	asl                                          ; glyph<<1
	ora @ig_rc_pal                                ; | new palette
	sta @$002118
	lda @ig_rc_tmp : inc : sta @ig_rc_tmp
	bra irc_loop
irc_done:
	plp
	rts

; ======================================================================
;  Body window frame (Slice 1). A beveled RPG-style window around the tab body: reuses the
;  menu's window glyphs 20-29 (NW/NE/SW/SE corners, NH/SH/WV/EV edges, TL/TR title caps),
;  all resident in-game (genfonts makes every glyph). The 3-tone glyphs render as a chrome
;  bevel through palette 0 (CGRAM 0-3 = blue/white/dark-grey/light-grey), so NO CGRAM change.
;  Frame occupies cols 1..62, rows 3..24; interior cols 2..61, rows 4..23 (matches the
;  content columns and IGM_WIDTH_MAX=60). The active tab's i18n label is notched into the
;  top border. Top/bottom rows are built in OVL_RB and flushed whole; the two side columns
;  are single-cell VRAM writes done AFTER the content, so the content's full-row flushes do
;  not erase them. Forced blank. DBR set locally. Uses the transient tab-bar scratch
;  (igm_tab_*), which is dead once the destination tab's enter has run.
;  Cheats (tab 0) is skipped -- its list scrolls via DMA over rows 4..23.
; ======================================================================
ig_draw_window:
	php
	phb
	sep #$20 : .as
	lda #$f4 : pha : plb                        ; DBR=$F4 (OVL_RB abs writes)
	rep #$30 : .al : .xl
	lda #$2c00 : sta @ovl_pal                    ; frame flushes in palette 3 (amber/gold bevel)
	; Sized to the tab's content via ig_win_x/y/w/h (ig_frame_if_static loads them). The old
	; full-body frame + the title notch are gone: the active tab is already named+highlighted
	; on the tab bar, and the notch would need a per-frame position.
	; --- TOP border (row y): NW(20) @x, NH(24) @x+1..x+w-2, NE(21) @x+w-1 ---
	jsr ovl_row_clear
	lda @ig_win_w : and #$00ff : dec : dec : tay  ; Y = w-2 edge cells
	lda @ig_win_x : and #$00ff : tax              ; X = x (16-bit A -> clean tax)
	sep #$20 : .as
	lda #20 : sta OVL_RB, x                       ; NW corner
	lda #24                                       ; NH edge
igw_top_l:
	inx
	sta OVL_RB, x
	dey
	bne igw_top_l
	inx
	lda #21 : sta OVL_RB, x                       ; NE corner @ x+w-1
	rep #$30 : .al : .xl
	lda @ig_win_y : and #$00ff : tax
	jsr ovl_flush_abs                             ; flush TOP at row y (all amber)
	; --- BOTTOM border (row y+h-1): SW(22) / SH(25) / SE(23), same span ---
	jsr ovl_row_clear
	lda @ig_win_w : and #$00ff : dec : dec : tay
	lda @ig_win_x : and #$00ff : tax
	sep #$20 : .as
	lda #22 : sta OVL_RB, x                       ; SW corner
	lda #25                                       ; SH edge
igw_bot_l:
	inx
	sta OVL_RB, x
	dey
	bne igw_bot_l
	inx
	lda #23 : sta OVL_RB, x                       ; SE corner
	rep #$30 : .al : .xl
	lda @ig_win_y : and #$00ff
	clc : adc @ig_win_h : and #$00ff
	dec : tax                                     ; row y+h-1 (h is a byte: and cleans the carry-in
	                                              ;   read; y+h <= 25 so no 8-bit overflow)
	jsr ovl_flush_abs
	; --- SIDE columns: rows y+1..y+h-2, col x (ODD -> BG1) = WV(26), col x+w-1 (EVEN -> BG2)
	;     = EV(27). Single-cell VRAM writes (@long, DBR-agnostic); entry = (glyph<<1)|$2C00. ---
	lda @ig_win_x : and #$00ff : sta @ovl_idx     ; scratch: x
	lda @ig_win_w : and #$00ff
	clc : adc @ovl_idx : dec
	lsr : sta @ovl_idx                            ; (x+w-1)>>1 = right border BG2 entry column
	lda @ig_win_y : and #$00ff : inc : sta @igm_tab_src   ; row = y+1
	lda @ig_win_h : and #$00ff : dec : dec
	clc : adc @igm_tab_src : sta @igm_tab_len     ; stop row = y+h-1 (exclusive)
igw_side_l:
	lda @igm_tab_src
	asl : asl : asl : asl : asl                  ; row*32 (tilemap entries per row)
	sta @ovl_cur                                 ; row*32 (temp)
	lda @ig_win_x : and #$00ff : lsr             ; x>>1 (x odd -> BG1 entry column)
	clc : adc @ovl_cur
	clc : adc #OVL_BG1_MAP
	sta @$002116
	lda #$2c34 : sta @$002118                      ; WV = (26<<1)|$2C00 (amber)
	lda @ovl_cur
	clc : adc @ovl_idx
	clc : adc #OVL_BG2_MAP
	sta @$002116
	lda #$2c36 : sta @$002118                      ; EV = (27<<1)|$2C00 (amber)
	lda @igm_tab_src : inc : sta @igm_tab_src
	cmp @igm_tab_len
	bcc igw_side_l
	lda #$2000 : sta @ovl_pal                      ; restore palette 0 for later draws
	plb
	plp
	rts

; ---- RETIRED: title notch for the old full-body frame (TL cap + i18n label + TR cap on the
;      top border). Unreferenced since the frames became content-sized -- the active tab is
;      already named+highlighted on the tab bar. Kept (like the HELP tab) for a future reuse;
;      it assumes OVL_RB holds a top-border row, DBR=$F4, .al/.xl, and a col-3 notch. ----
ig_win_title:
	php
	rep #$30 : .al : .xl
	sep #$20 : .as
	lda #28 : sta OVL_RB+3                         ; TL cap (left of the title)
	lda @CFG_LANGUAGE                              ; clamp language 0..IGM_LANG_COUNT-1
	cmp #IGM_LANG_COUNT
	bcc iwt_lang_ok
	lda #$00
iwt_lang_ok:
	rep #$30 : .al : .xl
	and #$00ff
	sta @igm_tab_lang
	lda @active_tab
	and #$00ff
	asl : asl : asl                               ; tab*8 (IGM_LANG_STRIDE, see he_copy)
	clc : adc @igm_tab_lang                         ; + lang column
	asl                                           ; *2 (word index)
	tax
	lda @igm_tab_tbl, x                             ; string offset within bank $C2
	tax                                           ; X = source byte offset
	ldy #$0004                                    ; dest col 4 (after the TL cap at col 3)
	sep #$20 : .as
iwt_copy:
	lda @$c20000, x                                ; long,X source byte (bank $C2)
	beq iwt_done
	sta OVL_RB, y                                 ; abs,Y (DBR=$F4)
	inx
	iny
	cpy #(4+IGM_TAB_FIELD)                        ; cap at col 14 (label <=10 -> cols 4..13)
	bne iwt_copy
iwt_done:
	lda #29 : sta OVL_RB, y                         ; TR cap (right of the title)
	rep #$30 : .al : .xl
	tya : sta @ig_notch_end                          ; Slice 2: TR column -> amber recolor span
	plp
	rts

; ---- draw the body frame only for the static tabs (Cheats scrolls its list via DMA over
;      rows 4..23, so it gets no frame in Slice 1). ----
ig_frame_if_static:
	php
	rep #$30 : .al : .xl
	lda @active_tab
	and #$00ff
	beq ifs_skip                                  ; tab 0 (Cheats) -> no frame
	dec
	asl : asl                                     ; (tab-1)*4 -> geometry record
	tax
	sep #$20 : .as
	lda @ig_frame_geom+0, x : sta @ig_win_x       ; long,X reads of our own $C2 table
	lda @ig_frame_geom+1, x : sta @ig_win_y
	lda @ig_frame_geom+2, x : sta @ig_win_w
	lda @ig_frame_geom+3, x : sta @ig_win_h
	jsr ig_draw_window
ifs_skip:
	plp
	rts

; ======================================================================
;  Sprites (the "com sprites" ask): a tab icon above each tab label. 5 icons (8x8, 1bpp ->
;  4bpp OBJ tiles 0..4 @ VRAM word $6000), one per tab. They sit on tile-row 0 (Y=0), ABOVE the
;  tab labels on row 1, so their per-scanline sprite fetch lands on EMPTY scanlines and never
;  starves the body text's BG1 4bpp fetch -- the mode-5 garble the OAM-clear guards against needs
;  sprites on the TEXT lines. Free budget: VRAM $6000-$7FFF, OBJ palettes CGRAM 128-255, 128 OAM
;  slots (the $C0 hook already cleared the game's sprites). The $C0 restore repaints the game's
;  PPU (incl. TM) on exit, so enabling OBJ here never leaks. DBR-agnostic (@long everywhere).
; ======================================================================
ig_obj_load:                                     ; upload icon tiles + OBJ palettes + enable OBJ. Once.
	php
	sep #$20 : .as
	lda #$80 : sta @$002115                       ; VMAIN word step after high byte
	rep #$30 : .al : .xl
	lda #$6000 : sta @$002116                     ; OBJ VRAM base word $6000
	ldx #$0000                                    ; icon-font byte index
	ldy #$0000                                    ; icon counter
iol_icon:
	phy
	ldy #$0008                                    ; 8 rows -> 8 words (bp0 = bitmap, bp1 = 0)
iol_row:
	sep #$20 : .as
	lda @ig_icon_font, x
	rep #$20 : .al
	and #$00ff                                    ; bp0 = bitmap, bp1 = 0 (ink = colour 1, else clear)
	sta @$002118
	inx
	dey
	bne iol_row
	ldy #$0008                                    ; bp2 = bp3 = 0 (8 words)
iol_zero:
	lda #$0000 : sta @$002118
	dey
	bne iol_zero
	ply
	iny
	cpy #$0005
	bne iol_icon
	sep #$20 : .as
	lda #129 : sta @$002121                        ; OBJ pal0 entry 1 (CGRAM 129) = active icon
	lda #$b1 : sta @$002122 : lda #$7f : sta @$002122   ; $7FB1 light cyan (matches the frame)
	lda #145 : sta @$002121                        ; OBJ pal1 entry 1 (CGRAM 145) = inactive icon
	lda #$10 : sta @$002122 : lda #$42 : sta @$002122   ; $4210 grey (dim)
	lda #$03 : sta @$002101                        ; OBSEL: OBJ name base word $6000, 8x8 sprites
	lda #$03 : sta @$00212c                         ; OBJ OFF: 8x8 icons are too small/crude in-menu (the
	                                                ;   camera/gear read as garbled stripes). TM = BG1+BG2.
	                                                ;   A good icon needs 16x16 custom art (future work).
	plp
	rts

; ---- build the tab-icon OAM: 5 icons on row 0, active tab bright (pal0), others dim (pal1).
;      Called on init + every tab switch (forced blank). Parks the other 123 sprites off-screen. ----
ig_obj_tabbar:
	php
	sep #$20 : .as
	rep #$10 : .xl
	lda #$00 : sta @$002102 : sta @$002103         ; OAM word addr 0 (main table)
	ldx #$0080                                     ; park all 128
iot_park:
	lda #$00 : sta @$002104                        ; X
	lda #$f0 : sta @$002104                        ; Y = 240 (off-screen)
	lda #$00 : sta @$002104                        ; tile
	sta @$002104                                   ; attr
	dex
	bne iot_park
	lda #$00 : sta @$002102 : lda #$01 : sta @$002103   ; high table (word $0100)
	ldx #$0020
iot_hi:
	lda #$00 : sta @$002104                        ; X bit8 = 0, size = small (8x8)
	dex
	bne iot_hi
	; --- the ACTIVE tab's icon: ONE 8x8 sprite in the body top-left (fully visible, below the
	;     notch). Cheats (tab 0) gets none. Much cleaner than 5 tiny icons clipped at the screen top. ---
	rep #$20 : .al
	lda @active_tab
	and #$00ff
	sep #$20 : .as
	beq iot_done                                   ; tab 0 (Cheats) -> no icon
	lda #$00 : sta @$002102 : sta @$002103         ; sprite 0 (main table)
	lda #8  : sta @$002104                          ; X = 8  (just inside the frame's left border)
	lda #32 : sta @$002104                          ; Y = 32 (tile row 4, below the notch -- fully on-screen)
	rep #$20 : .al
	lda @active_tab : and #$00ff
	sep #$20 : .as
	sta @$002104                                   ; tile = active tab index -> that tab's icon
	lda #$30 : sta @$002104                         ; attr: pal0 (bright cyan), priority 3
iot_done:
	plp
	rts

; ======================================================================
;  Data (bank $C2; never executed).
; ======================================================================
tab_enter_tbl:
	.word cheats_enter                       ; 0 CHEATS
	.word states_enter                       ; 1 SAVESTATES (savestate slot selector)
	.word saves_enter                        ; 2 SAVES  (battery save status)
	.word manual_enter                       ; 3 GUIDES (image viewer prompt)
	.word help_enter                         ; 4 HELP   (static i18n reference)
tab_input_tbl:
	.word cheats_input                       ; 0 CHEATS
	.word states_input                       ; 1 SAVESTATES
	.word saves_input                        ; 2 SAVES: SRAM slot nav (noop when slots off)
	.word manual_input                       ; 3 GUIDES: list nav / A -> enter the viewer
	.word ig_noop                            ; 4 HELP  (static page, no input)
tab_tick_tbl:
	.word cheats_tick                        ; 0 CHEATS
	.word ig_noop                            ; 1 SAVESTATES
	.word ig_noop                            ; 2 SAVES
	.word ig_noop                            ; 3 GUIDES
	.word ig_noop                            ; 4 HELP
tab_leave_tbl:
	.word cheats_leave                       ; 0 CHEATS
	.word ig_noop                            ; 1 SAVESTATES
	.word ig_noop                            ; 2 SAVES
	.word ig_noop                            ; 3 GUIDES
	.word ig_noop                            ; 4 HELP

; ---- two-level focus: A at the tab bar drills into a tab's content. Tab 0 (Cheats) un-greys +
;      shows the cursor; tabs 1-4 just take content focus (their input becomes live). ----
tab_focus_tbl:
	.word cheats_focus                       ; 0 CHEATS (un-grey + cursor)
	.word ig_focus_setbit1                   ; 1 SAVESTATES
	.word ig_focus_setbit1                   ; 2 SAVES
	.word ig_focus_setbit1                   ; 3 GUIDES (manual_input then A -> viewer)
	.word ig_focus_setbit1                   ; 4 HELP

ig_footer_str:
	.byt "<>:TAB L/R:ENDS A:OPEN B:CLOSE"                    ; IG_FT_TAB_LEN = 30 (tab-bar level)
	.byt "<>:PAGE L/R:TOP/END A:ON/OFF X:CHEATS B:BACK"      ; IG_FT_CHT_LEN = 44 (Cheats content)
	.byt "A:SELECT B:BACK"                                   ; IG_FT_GEN_LEN = 15 (generic content)

; Master cheat switch status line, two fixed-width (IG_MASTER_LEN) variants: ON first,
; OFF second -- ig_master_draw indexes with 0 / IG_MASTER_LEN.
ig_master_str:
	.byt "CHEATS: ON "
	.byt "CHEATS: OFF"

; Tab icons: 5 x 8x8 1bpp (bit set = ink). Order = tab order (Cheats/Savestates/Saves/Guides/Help).
; Uploaded to OBJ tiles 0..4 by ig_obj_load; ig_obj_tabbar draws ONE sprite (tile = active_tab)
; at a fixed X/Y -- and ig_obj_load leaves OBJ off the main screen, so nothing renders today
; (8x8 icons read as garbled stripes; a good icon needs 16x16 custom art).
ig_icon_font:
	.byt $3c,$7e,$e7,$c3,$c3,$e7,$7e,$3c   ; 0 CHEATS     (gear/cog ring)
	.byt $00,$7e,$ff,$db,$db,$ff,$7e,$00   ; 1 SAVESTATES (camera)
	.byt $18,$7e,$42,$5a,$5a,$5a,$7e,$00   ; 2 SAVES      (battery)
	.byt $00,$66,$ff,$db,$db,$db,$ff,$00   ; 3 GUIDES     (book)
	.byt $3c,$66,$06,$0c,$18,$00,$18,$00   ; 4 HELP       (question mark)

; HELP tab layout: absolute tile row + start column per line. Language-independent;
; lockstep with HELP_LABELS order in gen_igmenu_lang.py (IGM_HELP_NLINES=13 entries).
igm_help_rows:
	.byt 4,  6, 7, 8, 9, 10,  13,  15, 16, 17, 18, 19,  22
igm_help_cols:
	.byt 12, 16,16,16,16,16,  12,  16,16,16,16,16,  10

; Baked fallback for the selection BAR's colour-math HDMA table (ch5, transfer mode 1 =
; $2131 CGADSUB + $2132 COLDATA), used when IGM_THM_MAGIC is not $A5. Byte-for-byte the
; menu's hdma_math_src (const.a65) with the DEFAULT normal bar colour already stamped into
; the slots set_bar_color owns (+2/+5/+8/+11 = hdma_bar_color_src[0..3] = $2a,$40,$9f,$00),
; so the fallback bar looks exactly like the untheme'd menu's. 19 bytes = 6 entries + the
; $00 terminator -- the same length ig_theme_init copies from IGM_THM_MATH.
; Per-tab frame geometry (x, y, w, h in tile cells), record = (active_tab-1)*4. Sized to each
; tab's content instead of the old full-body frame. INVARIANT: x ODD and x+w-1 EVEN (left
; border cell lands on BG1, right on BG2 -- ig_draw_window's side writes assume it).
ig_frame_geom:
	.byt 13, 4, 38, 18     ; 1 SAVESTATES: title r6, slots r9-15, hint r19 -> rows 4..21, cols 13..50
	.byt 13, 4, 38, 18     ; 2 SAVES: the slot selector (EnableSramSlots is retired/always-on;
	                       ;   the wide status-only view is dead code) -- same box as SAVESTATES
	.byt 13, 4, 40, 18     ; 3 GUIDES: list r5-14 / prompt r6..19 (keys r18/19) -> cols 13..52
	.byt  1, 3, 62, 22     ; 4 HELP (kept for the future options screen; the old full body)

ig_thm_math_def:
	.byt $01, $00, $2a                       ; 1 line : $2131 = $00, $2132 = $2a  (bar colour)
	.byt $01, $00, $40                       ; 1 line : $2131 = $00, $2132 = $40
	.byt $01, $23, $9f                       ; 1 line : BG1+BG2+backdrop math on, $2132 = $9f
	.byt $07, $23, $00                       ; 7 lines: math on, no added colour
	.byt $01, $63, $00                       ; 1 line : subtract, $2132 = $00
	.byt $01, $00, $e0                       ; 1 line : math off, $2132 = $e0
	.byt $00                                 ; terminator

; END MARKER -- MUST stay the LAST object emitted by this file. utils/pack_igmenu.py strips
; trailing $00/$FF bytes from the packed binary (linker padding), and it does not know where
; our data ends: with ig_thm_math_def last, the strip ATE that table's $00 terminator and the
; HDMA table ran off its end. $5A is neither $00 nor $FF, so the strip stops here and every
; $00/$FF-terminated table above is safe. Lockstep with the strip loop in pack_igmenu.py --
; if a new object is ever appended, it goes BEFORE this label.
ig_end_marker:
	.byt $5a

; PCM player screen -- plays a .pcm (an MSU-1 audio track) picked in the browser.
;
; WHAT MAKES THIS DIFFERENT FROM THE SPC PLAYER.  An .spc has to be uploaded into the
; S-SMP, so spcplay.a65 can only run with the APU at IPL and can only STOP by resetting
; the console.  A .pcm plays on the CARTRIDGE DAC instead (src/pcmplay.c over the
; menu_music_* engine in src/msu1.c), which the MCU drives on its own: starting, pausing
; and stopping are ordinary commands, and the menu keeps running underneath.
;
; THE ONE THING THE APU STILL DECIDES.  The console gates the cart's DAC while the S-DSP
; sits in its IPL reset/mute state, so the DSP has to be out of reset for us to be heard
; -- the same fact sfx_dsp_unmute exists for.  And if the menu music IS playing, the SPC
; and this track would play on top of each other, so that case warm-resets first (the
; only way to stop a running S-SMP) and hands the DSP the silent stub instead.  Which of
; those applies is what pcm_prepare_audio reads out of BGM_STATE.
;
; PROGRESS COMES FROM A BLOCK, NOT FROM COMMANDS.  This screen redraws off PCMPLAY_BLK,
; which the firmware republishes on its own once per menu-loop pass.  We never poll it by
; command: the MCU_CMD handshake runs at ~20 ms, and a per-frame command would both miss
; frames and eat the time budget the DAC pump needs.  Position and length arrive in
; SECONDS and as a 0..255 fraction because this CPU has no divide.
;
; WHY $C1: same as memtest.a65 -- $C0 is down to its last hundred-odd bytes, so only the
; `jsr X : rtl` trampolines live there (ui_call_* in ui.a65, gi_call_hiprint in
; gameinfo.a65).  The line-composition engine (mt_blank / mt_emit / mt_put_str /
; mt_put_num and the mt_linebuf / mt_col / mt_row vars) is SHARED with the memory-test
; screen: same 40-column geometry, and the two can never be open at once.  Only the flush
; is our own, because this window is not the memtest one.
;
; THE FOLDER IS THE PLAYLIST.  A track plays once (the firmware stops at EOF and reports
; PCM_ST_ENDED, PCMPLAY_VERSION 2+); the next .pcm of the directory table -- the browser's
; own order, which puts the .pcm files last and in natural order (sort.c) -- starts on its
; own, and L/R step back and forth.  After the last one the screen stays on "End"; A then
; starts over from the first.  With Repeat on (X, media_rep_toggle) the module loops the
; track instead and it never ends.  The track being played is pcm_cur, a byte offset into the
; directory table, and closing the screen leaves the browser's cursor on it.
;
; SEEK.  Left/Right move -/+5 s, more per step the longer they are held (pcm_seek_key);
; a left click on the bar seeks to that cell (mouse_playermode / mouse_pseek).  The firmware
; refills the whole DAC buffer at the target, keeps a pause, and republishes the block at
; once, so the bar and the clock move right away.  Version-1 firmware takes an unknown
; control code as STOP, so every seek is gated on pcm_ver.
;
; ENTRY POINT (jsl, self-contained -- forces DP=0 and DB=$00):
;   select_pcm  - the browser's A action on a TYPE_PCM entry (filesel.a65 sel_is_pcm)
; Shared with the SPC player (spcview.a65, same bank): pcm_flush / pcm_row_blank /
; pcm_row_str / pcm_put_time / pcm_wait_mcu / pcm_wait_frame / media_name_row /
; media_sel_offset / media_find / media_place_cursor.
.link page $c1
#include "memmap.i65"
// memmap.i65 re-asserts '.link page $c0' on include; re-declare $c1 AFTER it (last
// '.link page' wins and they emit no bytes).  Same pattern as memtest.a65.
.link page $c1

#define PCM_COLS        40
// Row r prints at win_y + 2 + r.  The layout is the CALL ORDER in pcm_draw (mt_row starts
// at 0 and pcm_flush advances it), so it is spelled out there and not duplicated here as
// defines nothing reads.
// The bar is 32 cells, not 40, and that is the whole reason there is no multiply here:
// filled = PCM_PROGRESS >> 3 exactly.  4 blank columns each side centre it in the 40.
#define PCM_BAR_CELLS   32
#define PCM_BAR_X       4
#define PCM_GLYPH_TRACK 18
#define PCM_GLYPH_FILL  19
// Bound on the wait for an MCU answer.  The play command opens the file and primes the
// whole 2 KB DAC buffer, so it is the slow one; everything else is immediate.  A timeout
// closes the screen instead of hanging the menu (same contract as the manual viewer).
#define PCM_TIMEOUT_HI  $0020
// Seek keys: a repeat comes every 3 frames once the d-pad has been held 16 (pad.a65).  Every
// other one seeks (a seek is a file seek + a 2 KB read on the MCU), with a step that grows:
// 5 s, then 10 s from the 6th repeat, then 30 s from the 16th (about a second in).
#define PCM_REP_DELAY   $0d      // pad1delay as read_pad leaves it on an auto-repeat (pad.a65)
#define PCM_STEP_MID    6
#define PCM_STEP_FAST   16


; ======================================================================
;  select_pcm -- browser entry.  A on a .pcm.
; ======================================================================
select_pcm:
  php
  phb
  phd
  rep #$30 : .al : .xl
  pea $0000
  pld                         ; DP = 0 (every direct-page access below needs it)
  sep #$20 : .as
  rep #$10 : .xl
  lda #$00
  pha
  plb                         ; DB = $00, the bank the browser itself runs in.  NOT $7E
                              ; like memtest.a65: the trampolines below reach code that
                              ; pokes hardware registers ABSOLUTELY -- bgm_silence_reset
                              ; alone does `stz $2100` -- and under DB=$7E every one of
                              ; those would land in WRAM instead, failing silently.  The
                              ; line-composition vars are all below $2000, i.e. inside the
                              ; $00:0000-$1FFF mirror of bank $7E, so they read the same
                              ; memory either way.
  ; The browser's .pcm arm also takes .nsf (one compare in $C0): the NSF player
  ; (nsfplay.a65) is this screen with a 2A03 behind it.
  rep #$20 : .al
  jsr media_sel_offset
  tay
  iny
  iny
  iny                         ; +3: the entry's type
  sep #$20 : .as
  lda [dirstart_addr], y
  cmp #TYPE_TEXT
  bne select_pcm_ntext
  jsl @fm_view_sel            ; a text file: the file manager's viewer (fmres.a65)
  bra select_pcm_done
select_pcm_ntext:
  .as : .xl
  cmp #TYPE_NSF
  bne select_pcm_pcm
  jsr nsf_screen
  bra select_pcm_done
select_pcm_pcm:
  .as : .xl
  jsr pcm_screen
select_pcm_done:
  .as : .xl
  pld
  plb
  plp
  .as : .xl
  rtl


; ======================================================================
;  pcm_screen -- prepare the audio path, start the track, run the window.
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ======================================================================
pcm_screen:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ; mt_put_str borrows longptr, the menu's general-purpose direct-page long pointer, and
  ; so does the filename lookup here.  Save the browser's value and put it back: this
  ; screen has to be a black box for the listing it pops up over.
  lda longptr+2
  pha
  rep #$20 : .al
  lda longptr
  pha
  sep #$20 : .as

  ; Drain an in-flight cover request BEFORE anything talks to the MCU.  This has to be
  ; here and not just in pcm_start, because on the music-playing path the FIRST command
  ; out is the warm reset's CMD_RESET -- and that one spins UNBOUNDED.  A .pcm entry fires
  ; a cover like any other (the same hazard select_spc guards against), and if the MCU is
  ; still inside that cover command, finishing it re-enters menu_main_loop, whose first
  ; statement zeroes MCU_CMD -- erasing our CMD_RESET before it is ever dispatched, and
  ; hanging the console for good.
  stz media_dark              ; (WRAM is $55 at boot: a gate has to be cleared before use)
  stz media_keys              ; no key legend until the loop has read the pad
  jsr media_rep_begin
  jsl @ui_call_coversync
  jsr pcm_init_cur            ; the track = the browser's selection (WRAM: survives the reset)
  jsr pcm_prepare_audio       ; may warm-reset; repaints the list itself if it does
  jsr pcm_start               ; sets pcm_nosup when this firmware has no handler

  ; Park the selection bar off-screen.  It is a hardware colour window driven by the NMI
  ; (bar_xl/yl/wl), not part of the pushed tilemap, so it would otherwise keep sweeping
  ; across this window.  Saved and restored: the caller is the LIVE browser.
  lda bar_xl
  pha
  lda bar_yl
  pha
  lda bar_wl
  pha
  lda #$ff
  sta bar_xl
  sta bar_yl
  sta bar_wl

  jsr media_dim               ; the browser behind goes grey, like under any modal
  lda #^text_pcm_title
  sta window_tbank
  ldx #!text_pcm_title
  stx window_taddr
  lda @spcstart_win_x
  sta window_x
  stz print_x+1
  lda @spcstart_win_y
  sta window_y
  stz print_y+1
  lda @spcstart_win_w
  sta window_w
  lda @spcstart_win_h
  sta window_h                ; also what pop_window counts rows with, so nothing
                              ; between here and the close may touch it
  jsl @ui_call_wopen
  stz print_pal

  lda #$ff
  sta pcm_seen                ; no state rendered yet -> force the first draw
  sta pcm_seen_pos
  sta mouse_pseek
  stz pcm_rep
  jsr pcm_bar_geom
  jsr pcm_draw
  jsr media_light             ; after a warm reset: fade in over the finished screen
pcm_loop:
  jsl @bgx_loop_gate  ; fork: the scrolling background composes while the loop waits
  lda isr_done
  beq pcm_loop
  stz isr_done
  jsr pcm_draw                ; self-gating: recomposes only when something changed
  jsr pcm_check_end           ; a track that played out -> the next one
  jsl @mouse_playermode
  jsl @ui_call_pad
  lda media_keys
  bne pcm_k_legend
  inc media_keys              ; the first read: the mouse is known now (a warm reset forgot
  lda #$ff                    ; it), so the legend comes up once, with the right buttons
  sta pcm_seen
pcm_k_legend:
  .as : .xl
  lda pad_b
  bne pcm_scr_out
  lda pcm_nosup
  bne pcm_loop                ; nothing is playing: no other key has anything to act on
  lda pad_x
  beq pcm_k_notx
  jsr media_rep_toggle        ; Repeat: the module reads the byte on its own
  bra pcm_loop
pcm_k_notx:
  lda pad_a
  beq pcm_k_nota
  jsr pcm_key_a
  bra pcm_loop
pcm_k_nota:
  lda pad_l
  beq pcm_k_notl
  lda #$01
  jsr pcm_track_key
  bra pcm_loop
pcm_k_notl:
  lda pad_r
  beq pcm_k_notr
  lda #$00
  jsr pcm_track_key
  bra pcm_loop
pcm_k_notr:
  lda pad_left
  beq pcm_k_notleft
  lda #$01
  jsr pcm_seek_key
  bra pcm_loop
pcm_k_notleft:
  lda pad_right
  beq pcm_k_notright
  lda #$00
  jsr pcm_seek_key
  bra pcm_loop
pcm_k_notright:
  lda mouse_pseek
  cmp #$ff
  beq pcm_loop
  jsr pcm_seek_click
  bra pcm_loop

pcm_scr_out:
  jsr pcm_stop
  jsl @ui_call_wclose
  jsr media_undim
  pla
  sta bar_wl
  pla
  sta bar_yl
  pla
  sta bar_xl
  lda #$ff
  sta mouse_pbrow             ; no bar on screen any more
  jsr pcm_restore_audio
  jsr media_rep_save
  rep #$20 : .al
  lda pcm_cur
  jsr media_place_cursor      ; the browser comes back on the track that was playing
  sep #$20 : .as
  rep #$20 : .al
  pla
  sta longptr
  sep #$20 : .as
  pla
  sta longptr+2
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_prepare_audio -- get the APU into a state where the cart DAC is audible.
;
;  BGM_STATE (see bgm_update in filesel.a65):
;    0 not attempted / 2 tried-no-spc  -> S-SMP idle at IPL, DSP still in reset/mute:
;                                         the DAC would be silent, so upload the stub.
;    1 playing                         -> the SPC would play OVER the track, and the only
;                                         way to stop a running S-SMP is a reset.  Warm-
;                                         reset (which also returns it to IPL), repaint
;                                         the list the reset's VRAM clear wiped, then the
;                                         stub as above.
;    3 / 4 stub already running        -> exactly the state we want; nothing to do.
;
;  In practice bgm_update has already moved the browser to 1 or 3 long before the user
;  can press A, but the 0/2 arm costs a compare and removes a silent-player failure mode.
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
pcm_prepare_audio:
  php
  sep #$20 : .as
  rep #$10 : .xl
  lda @BGM_STATE
  cmp #$03
  bcs pcm_pa_done             ; 3/4: stub up, DAC audible
  cmp #$01
  bne pcm_pa_stub             ; 0/2: at IPL already
  ; --- music playing: silence it the only way there is ---
  jsr media_reset_dark        ; the warm reset, behind a fade to black (pcm_screen lights it)
  lda #$01
  sta filesel_dirty           ; the browser owes itself a repaint when we hand it back
  jsl @ui_call_listrepaint    ; ...but the window opens NOW, so paint the list first
  jsl @bgx_flush_gate         ; and let the NMI send it, or the window overlays a blank screen
                              ;   (composed layer: all of it published, not one frame's share)
pcm_pa_stub:
  ; NOT bounded: spc_begin_upload waits for the IPL hello forever, deliberately (sfx.a65
  ; explains why a bounded wait there silently skipped the stub instead).  Same exposure
  ; bgm_update already carries on every browser frame, so this adds no new failure mode.
  jsl @ui_call_dsp_unmute
  lda #$03
  sta @BGM_STATE              ; mark it even on timeout: no retry storm
pcm_pa_done:
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_restore_audio -- hand the APU back to the browser.
;
;  State 3 -- "music off, DSP-unmute stub running" -- because that is exactly what the
;  S-SMP is doing when we leave, and bgm_update takes it from there on its own: with music
;  ON its state-3 arm (bgm_upd_unstub) warm-resets back to IPL and the pass after that does
;  the fresh menu_bgm_load; with music OFF, 3 IS the resting state and nothing happens.
;
;  It must NOT be 0.  State 0 means "S-SMP untouched, sitting at IPL", which would be a
;  LIE here -- the stub is running.  bgm_update would then go straight to menu_bgm_load,
;  whose spc700_load waits for an IPL hello that never comes: the menu freezes solid with
;  the MCU still alive (seen in hardware -- close the player, open it again, dead).
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
pcm_restore_audio:
  php
  sep #$20 : .as
  lda #$03
  sta @BGM_STATE
  lda #$01
  sta filesel_dirty           ; bgm_update may warm-reset (clearing VRAM) on its way back
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_start -- CMD_PLAY_PCM for the selected entry.  The window opens either way; a
;  firmware with no handler (or a timeout) just sets pcm_nosup, which is what the screen
;  reports.  No carry contract -- there is only one exit.
;
;  MCU_PARAM is laid out exactly like a ROM launch: pointer to FILESEL_CWD, then the
;  selected direntry, which is what lets the firmware reuse get_selected_name.  It is
;  built HERE and not before pcm_prepare_audio on purpose -- a warm reset clears
;  MCU_PARAM+0..+3 (the lesson bgm_clear_aram_for_launch documents).
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
pcm_start:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ldy pcm_cur                 ; Y = byte offset of the track's direntry
  iny
  iny
  rep #$20 : .al
  lda [dirstart_addr], y      ; +2: bank byte (high half is the type, masked off)
  and #$00ff
  sta @MCU_PARAM+6
  dey
  dey
  lda [dirstart_addr], y      ; +0: address
  sta @MCU_PARAM+4
  lda #!FILESEL_CWD
  sta @MCU_PARAM
  sep #$20 : .as
  lda #^FILESEL_CWD
  sta @MCU_PARAM+2
  lda #$00
  sta @MCU_PARAM+3

  ; CAPABILITY SENTINEL: an older dispatcher ACKs an unknown command, so the ACK alone
  ; proves nothing.  Zero the magic; the firmware writes it back on every publish, so a
  ; zero surviving the ACK means this firmware has no PCM player.
  lda #$00
  sta @PCMPLAY_BLK+PCM_MAGIC0
  lda #CMD_PLAY_PCM
  sta @MCU_CMD
  jsr pcm_wait_mcu
  bcs pcm_st_nosup            ; timed out -> treat it like "not supported"
  jsr pcm_magic_ok
  bcs pcm_st_nosup
  lda @PCMPLAY_BLK+PCM_VERSION
  sta pcm_ver
  stz pcm_paused
  stz pcm_nosup
  stz pcm_last
  plp
  .as : .xl
  rts
pcm_st_nosup:
  ; No handler (or a wedged MCU): nothing was opened and nothing is playing.  The screen
  ; still opens -- it is the only surface there is to say so on, and a modal would cost
  ; another $C0 trampoline for show_modal_msg.  The player is a card module
  ; (pcmplay.bin), so "no block" can also be a current firmware without that file:
  ; MODULE_STATUS tells the two apart (2 = the module is missing, 1 = old firmware).
  lda @MODULE_STATUS
  cmp #MODULE_ST_MISSING
  beq pcm_st_nomod
  lda #$01
  bra pcm_st_ns_set
pcm_st_nomod:
  lda #$02
pcm_st_ns_set:
  sta pcm_nosup
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_stop / pcm_toggle -- transport.  MCU_PARAM low byte carries PCM_CTL_*.
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
pcm_stop:
  lda pcm_nosup
  bne pcm_stop_none           ; never started -> nothing to tell the firmware
  lda #PCM_CTL_STOP
  bra pcm_ctl
pcm_stop_none:
  rts

pcm_toggle:
  lda pcm_paused
  bne pcm_tg_resume
  lda #PCM_CTL_PAUSE
  ldx #$0001
  bra pcm_tg_send
pcm_tg_resume:
  lda #PCM_CTL_RESUME
  ldx #$0000
pcm_tg_send:
  ; Remember what WE asked for rather than waiting for PCM_STATE to catch up: the block
  ; is republished on the firmware's own ~20 ms cadence, so a second press inside that
  ; window would otherwise repeat the first command.
  phx
  jsr pcm_ctl
  plx
  txa
  sta pcm_paused
  rts

pcm_ctl:
  php
  sep #$20 : .as
  rep #$10 : .xl
  sta @MCU_PARAM
  lda #CMD_PCM_CTL
  sta @MCU_CMD
  jsr pcm_wait_mcu            ; carry on timeout is ignored: nothing left to undo
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_wait_mcu -- bounded wait for MCU_CMD to clear.  Carry SET = timed out.
;  Bounded and not a bare spin so a wedged MCU closes the screen instead of taking the
;  menu down with it (the manual viewer's contract).
;  Entry .as/.xl; exit .as/.xl.
; ----------------------------------------------------------------------
pcm_wait_mcu:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ldx #PCM_TIMEOUT_HI
pcm_wm_outer:
  ldy #$0000
pcm_wm_inner:
  lda @MCU_CMD
  beq pcm_wm_ok
  dey
  bne pcm_wm_inner
  dex
  bne pcm_wm_outer
  plp
  .as : .xl
  sec
  rts
pcm_wm_ok:
  plp
  .as : .xl
  clc
  rts


; ----------------------------------------------------------------------
;  pcm_magic_ok -- carry CLEAR when PCMPLAY_BLK is really ours.  Re-checked before any
;  field is read: this is persistent PSRAM an older firmware never writes.
;  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
pcm_magic_ok:
  lda @PCMPLAY_BLK+PCM_MAGIC0
  cmp #$50                    ; 'P'
  bne pcm_mo_no
  lda @PCMPLAY_BLK+PCM_MAGIC1
  cmp #$43                    ; 'C'
  bne pcm_mo_no
  lda @PCMPLAY_BLK+PCM_VERSION
  cmp #$01
  bcc pcm_mo_no
  clc
  rts
pcm_mo_no:
  sec
  rts


; ----------------------------------------------------------------------
;  pcm_init_cur -- pcm_cur = the selected entry's byte offset in the directory table
;  (from its start, dirstart_addr: the page is dirptr_addr, the row filesel_sel).  Kept in
;  WRAM, not a register: the warm reset in pcm_prepare_audio destroys registers, not WRAM.
;  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
pcm_init_cur:
  rep #$20 : .al
  jsr media_sel_offset
  sta pcm_cur
  sep #$20 : .as
  rts

; media_sel_offset: A (16-bit) = the browser selection's offset from dirstart_addr.
media_sel_offset:
  .al : .xl
  lda filesel_sel
  and #$00ff
  asl
  asl
  clc
  adc dirptr_addr
  sec
  sbc dirstart_addr
  rts


; ----------------------------------------------------------------------
;  pcm_wait_frame -- one full NMI, so whatever was just composed is uploaded.
; ----------------------------------------------------------------------
pcm_wait_frame:
  php
  sep #$20 : .as
  stz isr_done
pcm_wf_loop:
  jsl @bgx_loop_gate  ; fork: the scrolling background composes while the loop waits
  lda isr_done
  beq pcm_wf_loop
  stz isr_done
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_bar_geom -- tell the mouse where the bar is (row 2 of the layout, PCM_BAR_X cells in),
;  or that there is none to click: no handler, or a firmware that cannot seek.
;  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
pcm_bar_geom:
  lda pcm_nosup
  bne pcm_bg_none
  lda pcm_ver
  cmp #PCM_VER_SEEK
  bcc pcm_bg_none
  lda @spcstart_win_y
  clc
  adc #$04                    ; + 2 (the window's first text row) + 2 (layout row of the bar)
  sta mouse_pbrow
  lda @spcstart_win_x
  clc
  adc #2+PCM_BAR_X
  sta mouse_pbcol
  rts
pcm_bg_none:
  lda #$ff
  sta mouse_pbrow
  rts


; ----------------------------------------------------------------------
;  pcm_check_end -- once a track reports PCM_ST_ENDED, start the folder's next one; after the
;  last, stay (pcm_last) and let the screen say "End".  Once per frame, before the keys.
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
pcm_check_end:
  lda pcm_nosup
  bne pcm_ce_out
  lda pcm_last
  bne pcm_ce_out
  jsr pcm_magic_ok
  bcs pcm_ce_out
  lda @PCMPLAY_BLK+PCM_STATE
  cmp #PCM_ST_ENDED
  bne pcm_ce_out
  rep #$20 : .al
  lda pcm_cur
  ldx #TYPE_PCM
  ldy #$0000                  ; forward
  jsr media_find
  bcc pcm_ce_last
  jmp pcm_switch              ; A (16-bit) = the next track
pcm_ce_last:
  .al : .xl
  sep #$20 : .as
  lda #$01
  sta pcm_last
  lda #$ff
  sta pcm_seen                ; redraw: "End"
pcm_ce_out:
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_key_a -- play/pause; on "End" after the last track, the folder again from the top.
; ----------------------------------------------------------------------
pcm_key_a:
  lda pcm_last
  bne pcm_ka_top
  jmp pcm_toggle
pcm_ka_top:
  .as : .xl
  rep #$20 : .al
  lda #$fffc                  ; "before the first entry": media_find starts at +4 = 0
  ldx #TYPE_PCM
  ldy #$0000
  jsr media_find
  bcc pcm_ka_out
  jmp pcm_switch
pcm_ka_out:
  .al : .xl
  sep #$20 : .as
  rts


; ----------------------------------------------------------------------
;  pcm_track_key -- A = 0 next / 1 previous .pcm of the folder (L/R).  At either end of the
;  list nothing happens.  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
pcm_track_key:
  rep #$20 : .al
  and #$00ff
  tay
  lda pcm_cur
  ldx #TYPE_PCM
  jsr media_find
  bcc pcm_tk_out
  jmp pcm_switch
pcm_tk_out:
  .al : .xl
  sep #$20 : .as
  rts


; ----------------------------------------------------------------------
;  pcm_switch -- A (16-bit) = a track's entry offset: play it in place of the current one.
;  CMD_PLAY_PCM stops and closes the old track on the firmware side (menu_music_play), so
;  there is nothing to stop first.  Exit .as/.xl.
; ----------------------------------------------------------------------
pcm_switch:
  .al : .xl
  sta pcm_cur
  sep #$20 : .as
  jsr pcm_start               ; clears pcm_paused / pcm_last
  lda #$ff
  sta pcm_seen                ; new name, new clock: redraw it all
  jsr pcm_bar_geom
  rts


; ----------------------------------------------------------------------
;  pcm_seek_key -- A = 0 forward / 1 back: Left/Right, held or not.
;  read_pad's own counter tells a press from its auto-repeat: a repeat leaves pad1delay at
;  PCM_REP_DELAY, a fresh press well below it.  A press seeks 5 s; of the repeats only every
;  other one seeks, with the step growing with pcm_rep.  (Counting loop passes between edges
;  instead broke as soon as a redraw took a frame longer: a quick second press read as a
;  repeat and was dropped.)  The target is the published position +/- the step; the
;  firmware clamps the far end, the near one is clamped here.  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
pcm_seek_key:
  pha
  lda pad1delay
  cmp #PCM_REP_DELAY
  bcc pcm_sk_new
  lda pcm_rep
  inc
  beq pcm_sk_sat
  sta pcm_rep
pcm_sk_sat:
  .as : .xl
  lda pcm_rep
  lsr
  bcc pcm_sk_go               ; even repeats seek, odd ones only count
  pla
  rts
pcm_sk_new:
  .as : .xl
  stz pcm_rep
pcm_sk_go:
  .as : .xl
  jsr pcm_can_seek
  bcs pcm_sk_drop
  ldx #5
  lda pcm_rep
  cmp #PCM_STEP_MID
  bcc pcm_sk_step
  ldx #10
  cmp #PCM_STEP_FAST
  bcc pcm_sk_step
  ldx #30
pcm_sk_step:
  .as : .xl
  stx pcm_tmp
  pla
  rep #$20 : .al
  and #$00ff
  bne pcm_sk_back
  lda @PCMPLAY_BLK+PCM_POS
  clc
  adc pcm_tmp
  bcc pcm_sk_send
  lda #$ffff                  ; the firmware clamps it to the track
  bra pcm_sk_send
pcm_sk_back:
  .al : .xl
  lda @PCMPLAY_BLK+PCM_POS
  sec
  sbc pcm_tmp
  bcs pcm_sk_send
  lda #$0000
pcm_sk_send:
  .al : .xl
  sta @MCU_PARAM+1
  sep #$20 : .as
  lda #PCM_CTL_SEEK
  jmp pcm_seek_send
pcm_sk_drop:
  .as : .xl
  pla
  rts

; pcm_seek_click: the mouse clicked bar cell mouse_pseek (0..31): seek to the middle of it.
pcm_seek_click:
  lda mouse_pseek
  pha
  lda #$ff
  sta mouse_pseek
  jsr pcm_can_seek
  pla
  bcs pcm_sc_out
  asl
  asl
  asl
  ora #$04
  sta @MCU_PARAM+1
  lda #PCM_CTL_SEEKFRAC
  jmp pcm_seek_send
pcm_sc_out:
  .as : .xl
  rts

; pcm_can_seek: carry CLEAR when a seek may go out -- a v2 firmware, and a track that is
; playing, paused or played out (never an error state, where nothing is open).
pcm_can_seek:
  lda pcm_ver
  cmp #PCM_VER_SEEK
  bcc pcm_cs_no
  jsr pcm_magic_ok
  bcs pcm_cs_no
  lda @PCMPLAY_BLK+PCM_STATE
  cmp #PCM_ST_ENDED
  beq pcm_cs_yes
  cmp #PCM_ST_PLAYING
  beq pcm_cs_yes
  cmp #PCM_ST_PAUSED
  beq pcm_cs_yes
pcm_cs_no:
  .as : .xl
  sec
  rts
pcm_cs_yes:
  .as : .xl
  clc
  rts

; pcm_seek_send: A = PCM_CTL_SEEK / SEEKFRAC, its target already at MCU_PARAM+1.  A seek on
; "End" plays that track again, so the playlist is live again too.
pcm_seek_send:
  .as : .xl
  jsr pcm_ctl
  stz pcm_last
  lda #$ff
  sta pcm_seen                ; the new second may share its low byte with the old one
  rts


; ----------------------------------------------------------------------
;  media_keys2 -- the players' second key row: with a mouse in, its held buttons (previous /
;  next track) and no seek keys, which a mouse cannot press (it seeks with a click on the
;  bar); else the .pcm row (seek + L/R) or, media_keys2_spc, the SPC row (L/R).  The
;  redraw on a mouse plugged in or out (pcm_seen_mouse) picks the other one.
;  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
media_keys2:
  lda @mouse_lseen
  beq mk2_pad
  lda #^text_media_mouse2
  ldx #!text_media_mouse2
  bra mk2_put
mk2_pad:
  .as : .xl
  lda #^text_pcm_prompt2
  ldx #!text_pcm_prompt2
mk2_put:
  .as : .xl
  jsr pcm_row_str
  jsl @hint_keys
  rts

media_keys2_spc:
  lda @mouse_lseen
  beq mk2s_pad
  lda #^text_media_mouse2
  ldx #!text_media_mouse2
  bra mk2_put
mk2s_pad:
  .as : .xl
  lda #^text_spc_prompt2
  ldx #!text_spc_prompt2
  bra mk2_put

; ----------------------------------------------------------------------
;  Repeat (CFG_PLAYER_REPEAT), shared by the three players.  X flips it: off, a track that
;  ends gives way to the next one (the folder's next .pcm / .spc, the next song of an NSF);
;  on, the same track again, for as long as the screen stays open.  The .pcm and .nsf card
;  modules read the byte themselves (the .pcm then loops at its header's loop point, the way
;  the game plays it); the SPC player reloads the track (spc_tick).
;  The byte is written straight into the menu's CFG and saved only when the player closes
;  (media_rep_save): a config.yml write while a track streams would hold up the DAC.
;  media_rep_row: layout row 7, "X: Repeat  On/Off" -- in green the key, as every legend
;  (with a mouse, the both-buttons glyph: a two-button click is X, mouse_b_word).
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
media_rep_begin:
  .as : .xl
  lda @CFG_PLAYER_REPEAT
  sta @media_rep0
  rts

media_rep_toggle:
  .as : .xl
  lda @CFG_PLAYER_REPEAT
  beq mrt_on
  lda #$00
  bra mrt_set
mrt_on:
  .as : .xl
  lda #$01
mrt_set:
  .as : .xl
  sta @CFG_PLAYER_REPEAT
  jsr pcm_wait_frame          ; at the start of a frame: the row and its green key are done
                              ; before the next NMI uploads them (pcm_draw has the story)
media_rep_row:
  .as : .xl
  lda #$07
  sta mt_row
  jsr mt_blank
  lda #^text_media_repeat
  ldx #!text_media_repeat
  jsr mt_put_str
  lda #$20
  jsr mt_emit
  jsr mt_emit
  lda @CFG_PLAYER_REPEAT
  beq mrr_off
  lda #^text_on
  ldx #!text_on
  bra mrr_put
mrr_off:
  .as : .xl
  lda #^text_off
  ldx #!text_off
mrr_put:
  .as : .xl
  jsr mt_put_str
  jsr pcm_flush
  jsl @hint_keys
  rts

; media_rep_save: SAVE_CFG when Repeat changed since the player opened.  Sent once and
; waited for the way onbg_save_cfg does (SNES_CMD back to $55: the menu loop acks before it
; runs the command), but bounded: a wedged MCU leaves the byte unsaved, not the menu hung.
media_rep_save:
  .as : .xl
  lda @CFG_PLAYER_REPEAT
  cmp @media_rep0
  beq mrs_out
  lda #$00
  sta @SNES_CMD
  lda #CMD_SAVE_CFG
  sta @MCU_CMD
  ldx #PCM_TIMEOUT_HI
mrs_outer:
  .as : .xl
  ldy #$0000
mrs_inner:
  .as : .xl
  lda @SNES_CMD
  cmp #CMD_MCU_RDY
  beq mrs_done
  dey
  bne mrs_inner
  dex
  bne mrs_outer
mrs_done:
  .as : .xl
  lda #$00
  sta @MCU_CMD
mrs_out:
  .as : .xl
  rts

; ----------------------------------------------------------------------
;  media_dim / media_undim / media_regrey -- the browser behind a player is dimmed the way
;  every modal over it is (mainmenu, the context menus): its rectangle pushed and greyed,
;  and popped back bright at the end.  media_regrey greys it again after a warm reset has
;  repainted the list (the SPC player's track changes); the push from before still holds.
;  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
media_dim:
  jsr media_dim_geom
  jsl @ui_call_wpush
  jsl @ui_call_greyout
  rts

media_undim:
  jsr media_dim_geom
  jsl @ui_call_wclose
  rts

media_regrey:
  jsr media_dim_geom
  jsl @ui_call_greyout
  rts

; ----------------------------------------------------------------------
;  media_reset_dark / media_light -- the warm reset that stops the S-SMP, hidden.  The
;  reset clears the tile buffers and the boot relights the screen at once, so what showed
;  was a flash of an empty screen and then the list and the window being redrawn.  Now:
;  a ramp to black first (mt_fade_out: it pins all three brightness variables, which keeps
;  the NMI's screensaver from pulling the level back up while a key is held), the reset,
;  forced blank while everything is repainted, and media_light fades back in once the
;  screen is whole -- waiting for the ramp, because the next thing may be an SPC upload,
;  which stops the NMI that drives it.  Entry/exit .as/.xl.
; ----------------------------------------------------------------------
media_reset_dark:
  jsr mt_fade_out             ; level saved in mt_bright_bak (WRAM: survives the reset)
  lda #$00
  sta @BGM_STATE              ; S-SMP at IPL after the reset
  jsl @ui_call_bgm_silence    ; returns after the warm boot, which lit the screen again
  sep #$20 : .as
  rep #$10 : .xl
  lda #$80
  sta @$002100                ; black again, before anything shows
  lda #$00
  sta @cur_bright
  sta @tgt_bright
  lda #$01
  sta media_dark
  rts

media_light:
  .as : .xl
  lda media_dark
  beq mli_out
  stz media_dark
  lda #$00
  sta @fade_count
  lda #$01
  sta @fade_speed             ; the NMI ramp, one step every other frame
  jmp mt_fade_in              ; unblank at 0, target = the saved level; the NMI does the rest

; media_light_wait: the same, and wait for the ramp to finish -- before an SPC upload, which
; stops the NMI that drives it.  Not elsewhere: the keys are not read while it waits.
media_light_wait:
  .as : .xl
  lda media_dark
  beq mli_out
  jsr media_light
  ldx #$0040                  ; bounded: 16 steps take ~32 frames
mli_wait:
  .as : .xl
  lda @cur_bright
  cmp @tgt_bright
  beq mli_out
  jsr pcm_wait_frame
  dex
  bne mli_wait
mli_out:
  .as : .xl
  rts

media_dim_geom:
  lda #$02
  sta window_x
  lda #$09
  sta window_y
  lda #60
  sta window_w
  lda #18
  sta window_h
  rts


; ----------------------------------------------------------------------
;  media_find -- the next entry of type X (TYPE_PCM / TYPE_SPC) after the one at offset A,
;  in the directory table's order (= the browser's): forward with Y = 0, back with Y = 1.
;  A = $fffc with Y = 0 finds the first one.  Carry SET = found, A = its offset; CLEAR = none
;  that way.  Bounded by the table: the end is dirend_addr (entries * 4) or an entry whose
;  bank byte is 0 (the terminator scan_dir writes), the start is offset 0.
;  Entry .al/.xl, DP=0; exit .al/.xl.  Uses pcm_tmp.
; ----------------------------------------------------------------------
media_find:
  .al : .xl
  stx pcm_tmp
  cpy #$0000
  bne mf_back
mf_fwd:
  .al : .xl
  clc
  adc #$0004
  cmp dirend_addr
  bcs mf_none
  tay
  iny
  iny
  lda [dirstart_addr], y      ; low byte +2 (bank), high byte +3 (type)
  and #$00ff
  beq mf_none                 ; bank 0: the terminator
  lda [dirstart_addr], y
  dey
  dey
  xba
  and #$00ff
  cmp pcm_tmp
  beq mf_hit
  tya
  bra mf_fwd
mf_back:
  .al : .xl
  cmp #$0004
  bcc mf_none
  sec
  sbc #$0004
  tay
  iny
  iny
  lda [dirstart_addr], y
  dey
  dey
  xba
  and #$00ff
  cmp pcm_tmp
  beq mf_hit
  tya
  bra mf_back
mf_hit:
  .al : .xl
  tya
  sec
  rts
mf_none:
  .al : .xl
  clc
  rts


; ----------------------------------------------------------------------
;  media_place_cursor -- A (16-bit) = an entry's offset from dirstart_addr: put the
;  browser's cursor on it.  On the page already shown it just moves the row; otherwise the
;  page scrolls so the entry is its LAST row (fnl_place_cursor's rule, filesel.a65), or
;  starts at the top when the entry is within the first page.  The caller has the browser
;  repaint (filesel_dirty).  Entry .al/.xl; exit .al/.xl.
; ----------------------------------------------------------------------
media_place_cursor:
  .al : .xl
  pha
  clc
  adc dirstart_addr
  sec
  sbc dirptr_addr
  bcc mpc_scroll              ; above the page
  lsr
  lsr
  cmp listdisp
  bcs mpc_scroll              ; below it
  sta filesel_sel
  pla
  rts
mpc_scroll:
  .al : .xl
  pla
  lsr
  lsr                         ; the entry's index
  cmp listdisp
  bcs mpc_last
  sta filesel_sel
  lda dirstart_addr
  sta dirptr_addr
  rts
mpc_last:
  .al : .xl
  sec
  sbc listdisp
  inc
  asl
  asl
  clc
  adc dirstart_addr
  sta dirptr_addr
  lda listdisp
  dec
  sta filesel_sel
  rts


; ======================================================================
;  pcm_draw -- the whole screen from PCMPLAY_BLK.
;
;  Self-gating: PCMPLAY_BLK is republished at the firmware's pace, so recomposing all six
;  rows every frame would burn vblank redrawing identical text.  Redraw when the STATE or
;  the elapsed SECOND changed -- the bar is derived from the same position, so it can
;  never lag behind the clock.
;  Fixed rows, so a branch never shifts the lines below it.
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ======================================================================
pcm_draw:
  php
  sep #$20 : .as
  rep #$10 : .xl
  lda pcm_nosup
  bne pcm_dr_nosup
  jsr pcm_magic_ok
  bcs pcm_dr_done             ; block went away under us -> leave the last frame up
  lda @PCMPLAY_BLK+PCM_STATE
  cmp pcm_seen
  bne pcm_dr_go
  lda @mouse_lseen            ; a mouse plugged in or out: the legend changes its keys
  cmp pcm_seen_mouse
  bne pcm_dr_go
  lda @PCMPLAY_BLK+PCM_POS
  cmp pcm_seen_pos
  beq pcm_dr_done
  ; Only the second ticked: the bar and the clock, nothing else.  Recomposing the key
  ; legend every second showed it raw for a frame now and then: it is printed first and
  ; its keys turned into green / mouse glyphs after (hint_keys), and an NMI in between
  ; uploads the half-done row.
  sta pcm_seen_pos
  lda @PCMPLAY_BLK+PCM_STATE
  cmp #PCM_ST_ENDED
  beq pcm_dr_tick
  cmp #PCM_ST_ERR_OPEN
  bcs pcm_dr_done             ; an error shows no clock
pcm_dr_tick:
  .as : .xl
  lda #$02
  sta mt_row
  jsr pcm_row_bar             ; row 2
  jsr pcm_row_time            ; row 3
  bra pcm_dr_done
pcm_dr_go:
  .as : .xl
  lda @PCMPLAY_BLK+PCM_STATE
  sta pcm_seen
  lda @PCMPLAY_BLK+PCM_POS
  sta pcm_seen_pos
  lda @mouse_lseen
  sta pcm_seen_mouse

  stz mt_row                  ; layout: 0 name, 1 blank, 2 bar, 3 clock, 4 blank, 5-6 keys.
                              ;   pcm_flush advances the row, so the call order below IS
                              ;   the layout -- keep the blanks, they hold the positions.
  rep #$20 : .al
  lda pcm_cur
  jsr media_name_row          ; row 0
  sep #$20 : .as
  jsr pcm_row_blank           ; row 1
  lda @PCMPLAY_BLK+PCM_STATE
  cmp #PCM_ST_ENDED
  beq pcm_dr_ok               ; played out: still a bar and a clock (at the end)
  cmp #PCM_ST_ERR_OPEN
  bcs pcm_dr_err
pcm_dr_ok:
  .as : .xl
  jsr pcm_row_bar             ; row 2
  jsr pcm_row_time            ; row 3
  bra pcm_dr_tail
pcm_dr_err:
  .as : .xl
  jsr pcm_row_blank           ; row 2
  jsr pcm_row_errmsg          ; row 3
pcm_dr_tail:
  .as : .xl
  jsr pcm_row_blank           ; row 4
  lda media_keys
  beq pcm_dr_nokeys           ; the pad not read yet: no legend (see media_keys)
  jsr pcm_wait_frame          ; at the start of a frame: both rows printed and their keys
                              ; turned into glyphs before the next NMI uploads them
  lda #^text_pcm_prompt
  ldx #!text_pcm_prompt
  jsr pcm_row_str             ; row 5
  jsl @hint_keys              ; keys in green (pcm_flush is a hiprint; manhost.a65)
  jsr media_keys2             ; row 6
  jsr media_rep_row           ; row 7
  bra pcm_dr_done
pcm_dr_nokeys:
  .as : .xl
  jsr pcm_row_blank           ; row 5
  jsr pcm_row_blank           ; row 6
  jsr pcm_row_blank           ; row 7
pcm_dr_done:
  plp
  .as : .xl
  rts

; Static screen: composed once (pcm_seen starts at $ff) and then left alone.
pcm_dr_nosup:
  lda pcm_seen
  beq pcm_dr_done
  stz pcm_seen
  stz mt_row
  rep #$20 : .al
  lda pcm_cur
  jsr media_name_row          ; row 0
  sep #$20 : .as
  jsr pcm_row_blank           ; row 1
  jsr pcm_row_blank           ; row 2
  lda pcm_nosup
  cmp #$02
  beq pcm_dr_nomod
  lda #^text_pcm_nosup
  ldx #!text_pcm_nosup
  bra pcm_dr_nsmsg
pcm_dr_nomod:
  lda #^text_pcm_nomod
  ldx #!text_pcm_nomod
pcm_dr_nsmsg:
  jsr pcm_row_str             ; row 3
  jsr pcm_row_blank           ; row 4
  lda #^text_pcm_promptb      ; only B does anything here
  ldx #!text_pcm_promptb
  jsr pcm_row_str             ; row 5
  jsl @hint_keys
  jsr pcm_row_blank           ; row 6
  bra pcm_dr_done


; -- row 0: a directory entry's file name, straight out of the dir buffer -------------
; Its own copy loop rather than mt_put_str, for one reason: with "Hide extensions" on,
; scan_dir overwrites the DOT with code 1 instead of truncating (fileops.c), and 1 is a
; string terminator to hiprint but not to mt_put_str.  Feeding it through that helper
; would park a live 1 in the middle of mt_linebuf, and hiprint would then stop there --
; leaving the rest of the row unpainted, i.e. showing whatever the previous frame drew.
; Stopping at anything below 2 is also what makes resolve_str irrelevant here: this is
; raw text out of the dir buffer, never a language-table pointer.
; media_name_row: A (16-bit) = the entry's byte offset from dirstart_addr (the track, not
; the browser's selection: the players walk the folder).  Entry .al/.xl; P is kept.
media_name_row:
  .al : .xl
  php
  pha
  sep #$20 : .as
  jsr mt_blank                ; clobbers A and X
  rep #$20 : .al
  ply
  lda [dirstart_addr], y      ; +0: entry address
  clc
  adc #$0006                  ; the name starts 6 bytes into the entry
  sta longptr
  iny
  iny
  sep #$20 : .as
  lda [dirstart_addr], y      ; +2: bank, relative to $C0 like every dir pointer
  clc
  adc #$c0
  sta longptr+2
  ldy #$0000
pcm_rn_loop:
  .as : .xl
  lda [longptr], y
  cmp #$02
  bcc pcm_rn_done             ; 0 = end of name, 1 = the hidden extension marker
  iny
  phy
  jsr mt_emit
  ply
  cpy #PCM_COLS               ; mt_emit drops the overflow anyway; stop walking for it
  bcc pcm_rn_loop
pcm_rn_done:
  .as : .xl
  jsr pcm_flush
  plp
  rts

pcm_row_blank:
  jsr mt_blank
  jsr pcm_flush
  rts

; -- one whole row from one string.  A = bank, X = address (mt_put_str's own contract).
;    mt_blank CLOBBERS BOTH (it walks the buffer with X and fills with A), so the pointer
;    has to be stacked across it -- writing the two jsr's in the obvious order printed one
;    stray glyph instead of the line.  A is 8-bit and X 16-bit here, hence the pull order.
pcm_row_str:
  phx
  pha
  jsr mt_blank
  pla
  plx
  jsr mt_put_str
  jsr pcm_flush
  rts

pcm_row_errmsg:
  lda @PCMPLAY_BLK+PCM_STATE
  cmp #PCM_ST_ERR_MAGIC
  beq pcm_re_magic
  lda #^text_pcm_erropen
  ldx #!text_pcm_erropen
  bra pcm_row_str
pcm_re_magic:
  lda #^text_pcm_errmagic
  ldx #!text_pcm_errmagic
  bra pcm_row_str


; -- row 2: the bar.  32 cells, filled = PCM_PROGRESS >> 3 -- an exact shift, which is
;    the entire reason the cell count is 32 and not the full 40 columns.
pcm_row_bar:
  php
  sep #$20 : .as
  rep #$10 : .xl
  jsr mt_blank
  rep #$20 : .al
  lda #PCM_BAR_X
  sta mt_col                  ; leave the first columns blank -> the bar sits centred
  sep #$20 : .as
  lda @PCMPLAY_BLK+PCM_PROGRESS
  cmp #$ff
  beq pcm_bar_full            ; 255>>3 is 31, so the last cell would never light up
  lsr
  lsr
  lsr
  bra pcm_bar_count
pcm_bar_full:
  lda #PCM_BAR_CELLS
pcm_bar_count:
  rep #$20 : .al
  and #$00ff                  ; the shifts leave the high half of A untouched
  sta pcm_tmp
  sep #$20 : .as
  ldx #$0000
pcm_bar_loop:
  cpx pcm_tmp
  bcs pcm_bar_track
  lda #PCM_GLYPH_FILL
  bra pcm_bar_put
pcm_bar_track:
  lda #PCM_GLYPH_TRACK
pcm_bar_put:
  jsr mt_emit                 ; preserves X
  inx
  cpx #PCM_BAR_CELLS
  bne pcm_bar_loop
  jsr pcm_flush
  plp
  .as : .xl
  rts


; -- row 3: "m:ss / m:ss", plus "Paused" when the DAC is frozen -----------------
pcm_row_time:
  php
  sep #$20 : .as
  rep #$10 : .xl
  jsr mt_blank
  rep #$20 : .al
  lda #PCM_BAR_X
  sta mt_col                  ; line the clock up with the left end of the bar
  lda @PCMPLAY_BLK+PCM_POS
  sta pcm_tmp
  sep #$20 : .as
  jsr pcm_put_time
  lda #$20
  jsr mt_emit
  lda #$2f                    ; '/'
  jsr mt_emit
  lda #$20
  jsr mt_emit
  rep #$20 : .al
  lda @PCMPLAY_BLK+PCM_TOTAL
  sta pcm_tmp
  sep #$20 : .as
  jsr pcm_put_time
  lda @PCMPLAY_BLK+PCM_STATE
  cmp #PCM_ST_PAUSED
  beq pcm_rt_paused
  cmp #PCM_ST_ENDED
  bne pcm_rt_flush
  lda #^text_pcm_ended
  ldx #!text_pcm_ended
  bra pcm_rt_label
pcm_rt_paused:
  .as : .xl
  lda #^text_pcm_paused
  ldx #!text_pcm_paused
pcm_rt_label:
  .as : .xl
  pha
  lda #$20
  jsr mt_emit
  jsr mt_emit
  pla
  jsr mt_put_str
pcm_rt_flush:
  .as : .xl
  jsr pcm_flush
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_put_time -- emit pcm_tmp (seconds, 16-bit) as m:ss.
;  Minutes go through mt_put_num (no leading zero, two digits -- a track past 99 minutes
;  is not a thing); the seconds always get both digits, which mt_put_num will not do.
;  Divide by repeated subtraction: no hardware divide, and at most a few dozen passes.
;  Entry/exit .as/.xl, DB=$00.
; ----------------------------------------------------------------------
pcm_put_time:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ldx #$0000                  ; minutes
pcm_pt_div:
  rep #$20 : .al
  lda pcm_tmp
  cmp #60
  bcc pcm_pt_done
  sec
  sbc #60
  sta pcm_tmp
  sep #$20 : .as
  inx
  bra pcm_pt_div
pcm_pt_done:
  sep #$20 : .as
  txa                         ; X is 16-bit but minutes never leave the low byte
  jsr mt_put_num
  lda #$3a                    ; ':'
  jsr mt_emit
  lda pcm_tmp                 ; remainder, 0..59
  jsr pcm_put_2d
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_put_2d -- emit A (0..99) as exactly two digits, leading zero included.
;  Entry/exit .as/.xl, DB=$00.
; ----------------------------------------------------------------------
pcm_put_2d:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ldy #$0000
pcm_2d_tens:
  cmp #10
  bcc pcm_2d_emit
  sec
  sbc #10
  iny
  bra pcm_2d_tens
pcm_2d_emit:
  pha
  tya
  clc
  adc #$30
  jsr mt_emit
  pla
  clc
  adc #$30
  jsr mt_emit
  plp
  .as : .xl
  rts


; ----------------------------------------------------------------------
;  pcm_flush -- print mt_linebuf at layout row mt_row, then advance the row.
;  Rows land at (spcstart_win_x+2, spcstart_win_y+2+mt_row).  Own copy rather than
;  mt_flush: everything else in the composition engine is geometry-free, but that one
;  hard-codes the memory test's window.
;  Entry/exit .as/.xl, DB=$00, DP=0.
; ----------------------------------------------------------------------
pcm_flush:
  php
  sep #$20 : .as
  rep #$10 : .xl
  lda #$7e
  sta print_bank              ; the BUFFER's bank, unrelated to DB
  ldx #!mt_linebuf
  stx print_src
  stz print_pal
  lda #PCM_COLS
  sta print_count
  lda @spcstart_win_x
  clc
  adc #$02
  sta print_x
  lda @spcstart_win_y
  clc
  adc #$02
  clc
  adc mt_row
  sta print_y
  jsl @gi_call_hiprint
  inc mt_row
  plp
  .as : .xl
  rts

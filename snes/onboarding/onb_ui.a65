; onboarding: text rendering for the standalone onboarding ROM.
;
; onb_hiprint is a trimmed clone of snes/ui.a65's hiprint -- prints a string in
; mode-5 pseudo-8x8 tiles across the two BG layers (BG1/BG2 tile buffers). It uses
; the onboarding's OWN print_* WRAM vars (onb_print_*) and font tile buffers, so
; it does not depend on the menu's ui.a65 symbols.
;
; onb_resolve_str is the i18n resolver: a string pointer inside the localized
; dispatch table range [onb_strtab_lo, onb_strtab_hi) is swapped for the active
; language's column (indexed by onb_cur_lang); any other pointer passes through.
; The strings are split by language over two pools (utils/gen_onb_lang.py): the
; tables and pool A in $C1, pool B in $C0; onb_strpool_bank gives a column's bank.
;
; .as/.xl GOTCHA: every routine with `lda #imm`/`ldx #imm` declares its widths on
; entry (directives leak in SOURCE order).

.link page $c0
#include "onboarding/onb_memmap.i65"

; ---------------------------------------------------------------------------
; onb_resolve_str -- language-resolve onb_print_src/onb_print_bank in place.
; Preserves A/X/Y/P/D/B. (Condensed from ui.a65 resolve_str.)
; ---------------------------------------------------------------------------
onb_resolve_str:
  php
  rep #$30 : .al : .xl
  pha
  phx
  phy
  phd
  phb
  pea $0000
  pld
  sep #$20 : .as
  lda #$7e
  pha
  plb
  lda @onb_print_bank
  cmp #^onb_strtab_lo
  bne onb_rs_out
  rep #$20 : .al
  lda @onb_print_src
  cmp #!onb_strtab_lo
  bcc onb_rs_out
  cmp #!onb_strtab_hi
  bcs onb_rs_out
  sep #$20 : .as
  lda @onb_cur_lang
  cmp @onb_strtab_nlang     ; languages present (8, gen_onb_lang.py LANGS)
  bcc +
  lda #$00                  ; past the last present column -> English
+ pha
  asl
  rep #$20 : .al
  and #$00ff
  clc
  adc @onb_print_src
  sta @onb_resolve_ptr
  sep #$20 : .as
  lda #^onb_strtab_lo
  sta @onb_resolve_ptr+2
  rep #$20 : .al
  lda [onb_resolve_ptr]
  sta @onb_print_src
  ; the string itself lives in its language's pool: the pool is split by language
  ; across two banks (gen_onb_lang.py POOL_B_LANGS), the table entry is 16 bits
  sep #$20 : .as
  pla                       ; the column pushed above (one byte: A was 8 bits there)
  rep #$20 : .al
  and #$00ff
  tax
  sep #$20 : .as
  lda @onb_strpool_bank, x
  sta @onb_print_bank
onb_rs_out:
  plb
  pld
  rep #$30 : .al : .xl
  ply
  plx
  pla
  plp
  rts

; ---------------------------------------------------------------------------
; onb_hiprint -- print onb_print_count chars from onb_print_src/_bank at
; (onb_print_x, onb_print_y) in onb_print_pal, into BG1_TILE_BUF/BG2_TILE_BUF.
; Characters 0 and 1 are end-of-string. Direct port of ui.a65 hiprint with the
; print_* vars renamed onb_print_*. (See ui.a65 for the full annotation.)
; ---------------------------------------------------------------------------
onb_hiprint:
  php
  phd
  sep #$20 : .as
  rep #$10 : .xl
  pea $0000
  pld
  phb
  lda #$7e
  pha
  plb
  jsr onb_resolve_str
  ldx onb_print_src
  stx onb_print_ptr
  lda @onb_print_bank
  sta @onb_print_ptr+2
  rep #$30 : .al : .xl
  lda @onb_print_pal
  and #$00ff
  xba
  asl
  asl
  ora #$2000
  sta @onb_print_temp
  lda @onb_print_count
  and #$00ff
  beq onb_hp_end
  tay
  lda @onb_print_x
  and #$00ff
  sta @onb_print_x
  lda @onb_print_y
  and #$00ff
  xba
  lsr
  lsr
  clc
  adc @onb_print_x
  and #$fffe
  tax
  lda @onb_print_x
  lsr
  bcs onb_hp_bg1
onb_hp_bg2:
  .al : .xl
  lda [onb_print_ptr]
  and #$00ff
  cmp #$0002                  ; BTN_TOGGLE (gen_onb_lang.py): green on/off, no cell
  bne +
  jsr onb_hp_toggle
  bra onb_hp_bg2
+ cmp #ONB_CJK_MARK           ; a CJK string's marker: at an even column it takes none
  bne +
  inc onb_print_ptr
  bra onb_hp_bg2
+ cmp #ONB_CJK_LEAD0          ; a CJK glyph: one BG2 cell over this column and the next
  bcc +
  jmp onb_hp2_cjk
+ lda [onb_print_ptr]
  ror
  and #$007f
  beq onb_hp_end
  rol
  asl
  inc onb_print_ptr
  ora @onb_print_temp
  sta !BG2_TILE_BUF, x
  dey
  beq onb_hp_end
onb_hp_bg1:
  .al : .xl
  lda [onb_print_ptr]
  and #$00ff
  cmp #$0002
  bne +
  jsr onb_hp_toggle
  bra onb_hp_bg1
+ cmp #ONB_CJK_MARK           ; the marker at an odd column: a blank, so the glyphs that
  bne +                       ; follow start on BG2's even columns -- or, for a label made
  jsr onb_hp1_pairs           ; only of glyphs, pair cells that start them right here
  bcs onb_hp1_mark
  jmp onb_hp_end
onb_hp1_mark:
  .al : .xl
  inc onb_print_ptr
  bra onb_hp1_blank
+ cmp #ONB_CJK_LEAD0          ; a glyph at an odd column (not aligned): a blank first
  bcs onb_hp1_blank
  lda [onb_print_ptr]
  ror
  and #$007f
  beq onb_hp_end
  rol
  asl
  inc onb_print_ptr
  ora @onb_print_temp
  sta !BG1_TILE_BUF, x
  inx
  inx
  dey
  beq onb_hp_end
  bra onb_hp_bg2
onb_hp_end:
  .al : .xl
  sep #$20 : .as
  lda [onb_print_ptr]
  and #$fe
  sta @onb_print_over
  tya
  sec
  sbc @onb_print_count
  eor #$ff
  inc
  sta @onb_print_done
  plb
  pld
  plp
  rts

; onb_hp1_blank: a blank BG1 cell at this odd column, then on to the next (even) one.
onb_hp1_blank:
  .al : .xl
  lda #$0040                  ; ' ' (char 32 = tile 64)
  ora @onb_print_temp
  sta !BG1_TILE_BUF, x
  inx
  inx
  dey
  beq +
  jmp onb_hp_bg2
+ jmp onb_hp_end

; onb_hp1_pairs: [onb_print_ptr] = a CJK marker at an ODD column. When the caller allows it
;   (OCJ_SHIFT, onb_puts_shift) and the rest of the string is glyphs only, draw them from
;   this column: glyph k covers this column + 2k and the next, so BG2's cells (even columns)
;   each show the right half of one glyph and the left half of the next (onb_cjk_pair), from
;   the column before the string to its last one; BG1's columns under them go blank. Out:
;   C clear = drawn (pointer at the end, X/Y moved on), C set = not (nothing changed).
;   .al/.xl in and out.
onb_hp1_pairs:
  .al : .xl
  lda @OCJ_SHIFT
  and #$00ff
  beq ohp_no
  phy                         ; the columns left
  ldy #$0001
ohp_scan:
  .al : .xl
  lda [onb_print_ptr], y
  and #$00ff
  cmp #$0002
  bcc ohp_end
  cmp #ONB_CJK_LEAD0
  bcc ohp_no_y                ; something else than a glyph
  iny
  iny
  bra ohp_scan
ohp_end:
  .al : .xl
  dey                         ; = 2 * glyphs = the columns they take
  beq ohp_no_y
  tya
  cmp $01, s
  beq +
  bcs ohp_no_y                ; more than the count
+ ply
  inc onb_print_ptr           ; past the marker
  lda #$0000
  sta @OCJ_PA
ohp_cell:
  .al : .xl
  lda [onb_print_ptr]
  and #$00ff
  cmp #ONB_CJK_LEAD0
  bcc ohp_last
  sec
  sbc #ONB_CJK_LEAD0
  xba                         ; * 256
  lsr                         ; * 128
  sta @onb_cjk_g
  inc onb_print_ptr
  lda [onb_print_ptr]
  and #$007f
  ora @onb_cjk_g
  inc onb_print_ptr
  inc                         ; glyph + 1
  sta @OCJ_PB
  jsl @onb_cjk_pair           ; A = the cell (X, Y kept)
  ora @onb_print_temp
  sta !BG2_TILE_BUF, x
  lda #$0040
  ora @onb_print_temp
  sta !BG1_TILE_BUF, x
  inx
  inx
  dey
  dey
  lda @OCJ_PB
  sta @OCJ_PA
  bra ohp_cell
ohp_last:
  .al : .xl
  lda #$0000                  ; the last glyph's right half, a blank after it
  sta @OCJ_PB
  jsl @onb_cjk_pair
  ora @onb_print_temp
  sta !BG2_TILE_BUF, x
  clc
  rts
ohp_no_y:
  .al : .xl
  ply
ohp_no:
  .al : .xl
  sec
  rts

; onb_hp2_cjk: the pair {lead, trail} at an even column -> glyph (lead - $FA) * 128 +
;   (trail & $7f); its cell (onb_cjk.a65) on BG2, a blank on BG1's column over its right
;   half. Needs both columns of the count.
onb_hp2_cjk:
  .al : .xl
  cpy #$0002
  bcs +
  jmp onb_hp_end
+ lda [onb_print_ptr]
  and #$00ff
  sec
  sbc #ONB_CJK_LEAD0
  xba                         ; * 256
  lsr                         ; * 128
  sta @onb_cjk_g
  inc onb_print_ptr
  lda [onb_print_ptr]
  and #$007f
  ora @onb_cjk_g
  inc onb_print_ptr
  jsl @onb_cjk_cell           ; A = its tile (X, Y kept)
  ora @onb_print_temp
  sta !BG2_TILE_BUF, x
  lda #$0040
  ora @onb_print_temp
  sta !BG1_TILE_BUF, x
  inx
  inx
  dey
  dey
  beq +
  jmp onb_hp_bg2
+ jmp onb_hp_end

; onb_hp_toggle: step over a BTN_TOGGLE byte and flip the cell palette between the
;   line's (white, 0) and the green of the key hints (ONB_PAL_DIM, 2): bit 11 of the
;   tilemap word. .al/.xl in and out, X/Y untouched.
onb_hp_toggle:
  .al : .xl
  inc onb_print_ptr
  lda @onb_print_temp
  eor #$0800
  sta @onb_print_temp
  rts

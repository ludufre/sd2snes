.link page $c0
#define APUIO0                      $2140
#define APUIO1                      $2141
#define APUIO2                      $2142
#define APUIO3                      $2143

#define BG1_TILE_BASE               $5800
#define BG2_TILE_BASE               $5000

#define OAM_TILE_BASE               $6000

/* ---- cover preview (16x16 OBJ sprites floating over the file list) ----
   The cover is drawn with OBJ sprites (independent of the BG mode), so the file
   list keeps its full Mode-5 hi-res 18 rows. It is a w_spr x h_spr grid of 16x16
   sprites, 4bpp, up to 8 OBJ palettes (CGRAM 128..255), one palette per 16x16
   block (the BLOCKMAP). The 4bpp tiles live in the FREED BG-cover VRAM region:
   OBJ name base $2000 (256 tiles). The cover floats OPAQUE (OBJ priority 3) over
   the top of the list. The MCU stages the cover into bank C9 (CMD_LOAD_COVER,
   see src/cover.c, .cov v4). The whole upload is done synchronously in forced
   blank (no VBlank overrun, no NMI work). The list/band/logo are untouched. */
#define COVER_OBJ_VRAM_BASE         $2000      /* OBJ name-table base (VRAM words) */
#define COVER_OBJ_CLEAR_LEN         $2000      /* bytes cleared at init (256 4bpp tiles) */
#define COVER_OBSEL                 $01        /* $2101: size tbl0 (8/16), name sel 0, base $2000 */
/* The header logo is now FULL-WIDTH (cols 0..31), so there is no blank cover area
   to fill: the old COVER_BLANK_VRAM/COVER_BLANK_CHAR tile is gone. */
#define COVER_OBJ_X_RIGHT           256        /* right edge of the cover = screen edge; the
                                                  256 wrap is handled in cover_build_oam (lda #0). */
#define COVER_OBJ_Y0                0          /* TEMP: top-right (Y=0) to preview overlap vs header */
#define COVER_OBJ_MAX_W             8          /* 16-wide name grid -> <= 8 sprites wide */
#define COVER_OBJ_MAX_H             8          /* 256-tile page -> <= 8 sprites tall */
#define COVER_OBJ_ATTR              $30        /* OAM attr base: OBJ priority 3 (bits5-4), no flip */
#define COVER_OAM_FIRST             0          /* first OAM slot used by the cover */
#define COVER_OAM_LO_BYTES          256        /* 64 sprites * 4 bytes (whole cover OAM low table) */
#define COVER_OAM_HI_BYTES          16         /* 64 sprites / 4 (whole cover OAM high table) */
#define COVER_DEBOUNCE              6          /* frames to settle before requesting (must stay
                                                  > the 3-frame d-pad auto-repeat so held scrolling
                                                  never fires a cover; 6 = faster load, still safe) */
#define COVER_TIMEOUT               180        /* frames before giving up on the MCU */
/* ---- header logo (8bpp BG1, FULL-WIDTH 256x56; baked tiles in logo.a65) ----
   The logo lives permanently in BG1_TILE_BUF cols 0..31 (written once at init);
   the OBJ cover floats below it (COVER_OBJ_Y0), so the logo is never overwritten. */
#define COVER_LOGO_VRAM            $6000      /* VRAM word dest for logo tile 0 (= char $300) */
#define COVER_LOGO_CHAR            $0300      /* BG1 char number of logo tile 0 */
#define COVER_LOGO_CGB             $40        /* CGRAM 64: logo palette base (pal 4+5, free) */
#define COVER_LOGO_COLS            32         /* logo width in 8px tiles (256px, full-width cols 0..31) */
#define COVER_LOGO_TILEBYTES       $3800      /* 32*7*64 = 14336 bytes */
#define COVER_LOGO_PALBYTES        $0040      /* 32 colours * 2 = 64 bytes */
/* bank-C9 staging layout (must match src/cover.h COVER_OFF_*) */
#define SRAM_COVER_ADDR             $C90000
#define COVER_C9_TILES              $C90000    /* 4bpp tiles (name-grid order) */
#define COVER_C9_PAL                $C92000    /* up to 8 OBJ palettes, 16 BGR555 each */
#define COVER_C9_BLOCKMAP           $C92100    /* per-16x16-block palette index (0..7) */
#define COVER_C9_STATUS             $C93A00    /* meta: status,w_spr,h_spr,npal,rsvd,flags */
#define COVER_C9_META_W             $C93A01    /* w_spr */
#define COVER_C9_META_H             $C93A02    /* h_spr */
#define COVER_C9_META_NPAL          $C93A03    /* n_palettes */
#define COVER_STATUS_OK             $01

/* ---- pre-boot game info screen (snes/gameinfo.a65) ----
   One composited DirectColor (CG-Direct-Select) BG1 image (cover + screenshot,
   utils/gen_dcimage.py) is staged by the MCU (CMD_GAME_INFO): 8bpp tiles -> bank
   $CA, 16-bit tilemap -> bank $CB. The parsed metadata struct lands at GAMEINFO
   ($FF7400, just after the favorites mirror); the menu reads it by fixed offset (mirror src/gameinfo.h). */
#define GI_TILES                    $CA0000    /* 8bpp DirectColor tiles (.gd) / FMV frame tiles (.fmv) */
#define GI_FMV_PAL                  $CA1B00    /* FMV frame palette (176B, 88 colours) right after the 6912B frame at GI_TILES; -> CGRAM 168 */
#define GI_TMAP                     $CB0000    /* 16-bit BG tilemap (.gd) / .gcv cover palette (240B, 120 colours) -> CGRAM 48 */
/* paletted band cover region (left): 16x16 tiles (128x128px) at col 1. Cover tiles DMA to window-0
   ($2000 = char #256); 256 tiles span #256..511 ($2000..$3FFF) -- MUST stay <= 256 tiles or it spills
   into $4000 (the body's BG2 font), corrupting the background (the bottom cover row overwrote BG2
   font #0..31). 17 wide (272 tiles, -> $41FF) did exactly that. Cell (r,c) -> char GI_COVER_CHAR0 + r*GI_COVER_W + c. */
#define GI_COVER_CHAR0              $0100      /* window-0 first tile char (#256) */
#define GI_COVER_COL0              1          /* cover left column in the 32-wide band (px 8) */
#define GI_COVER_ROW0              0
#define GI_COVER_W                 16         /* cover width  in tiles (128 px) */
#define GI_COVER_H                 16         /* cover height in tiles (128 px) -- 16x16 = 256 = window-0 cap */

/* gameinfo_meta_t. MUST sit AFTER the favorites mirror ($FF6000..$FF73FF) -- overlapping it
   clobbers the favorites list when a favorite's info panel opens. Lockstep with src/memory.h. */
#define GAMEINFO                    $FF7400    /* gameinfo_meta_t (src/gameinfo.h) */
#define GI_STATUS                   $FF7402    /* 0 NONE, 1 OK, 2 ERROR */
#define GI_FLAGS                    $FF7403    /* bit0 = image.gd staged */
#define GI_IMG_W                    $FF7404    /* image width in 8x8 tiles */
#define GI_IMG_H                    $FF7405    /* image height in tiles */
#define GI_IMG_NTILES               $FF7406    /* unique tiles (uint16) */
#define GI_TITLE                    $FF7408    /* char[40] font-encoded */
#define GI_DEVELOPER                $FF7430    /* char[40] */
#define GI_YEAR                     $FF7458    /* char[6]  e.g. "1994" */
#define GI_PLAYERS                  $FF745E    /* char[4]  e.g. "2" */
#define GI_GENRE                    $FF7462    /* char[32] */
#define GI_CHIP                     $FF7482    /* char[24] */
#define GI_DESCRIPTION              $FF749A    /* char[256] one line; menu word-wraps */
#define GI_FMV_FPS                  $FF759A    /* FMV playback fps (when GI_FLAG_FMV) */
#define GI_FMV_FRAMES               $FF759B    /* FMV total frames (uint16; info/debug) */
#define GI_DESC_EXT                 $FF7600    /* full description char[2048] NUL-term staged by CMD_GI_DESC_FULL;
                                                  first byte 0 = invalid -> menu falls back to GI_DESCRIPTION;
                                                  lockstep with SRAM_GAMEINFO_DESCEXT_ADDR in src/memory.h */
#define GI_STATUS_OK                $01
#define GI_FLAG_IMAGE               $01        /* legacy DirectColor .gd (RETIRED; band is paletted) */
#define GI_FLAG_FMV                 $02        /* cover-LESS <rom>.fmv v4 screenshot/animation staged at
                                                  GI_TILES ($CA0000); 1 frame = static, N = animated;
                                                  pumped by CMD_FMV_NEXT (see snes/gameinfo.a65) */
#define GI_FLAG_COVER               $04        /* <rom>.gcv paletted 120c cover staged (CGRAM 48..167);
                                                  without it the cover region shows the gradient */
#define GI_FLAG_COVER_OBJ           $08        /* FALLBACK (no .gcv): the <rom>.cov staged in C9 -> float it
                                                  as OBJ box-art CENTERED in the .gcv 128x128 cover box.
                                                  Mutually exclusive with GI_FLAG_COVER (.gcv wins). */
/* ---- small (half-size) cover: WRAM scratch + downscale LUT ----
   When ShowCovers == 2 the menu resamples the staged 16x16-block tiles down to
   one 8x8 tile per block (nearest-neighbour, even pixels) into COVER_SMALL_TILEBUF,
   then draws the cover as 8x8 OBJ sprites (COVER_OBSEL already selects the 8/16
   size pair). COVER_PACKTBL is a 256-byte LUT that gathers a byte's 4 even bits
   into the low nibble; it is built once at boot. Both live in free WRAM after the
   cover OAM shadow ($7EC000+256) and below WRAM_ROUTINE ($7EF000). */
#define COVER_SMALL_TILEBUF         $7EC100    /* resampled 8x8 tiles (dense, <= w*h*32 = 2048 B) */
#define COVER_PACKTBL               $7ED100    /* 256-byte even-bit-pack LUT (built at init) */
#define COVER_PACKTBL_W             $D100      /* low 16 of COVER_PACKTBL for abs,Y reads (DB=$7E) */
#define COVER_SMALL_OBJ_STEP        8          /* small sprite pitch in px (8x8 OBJ) */

#define MCU_CMD                     $002A00
#define SNES_CMD                    $002A02
#define MCU_PARAM                   $002A04
#define BRAM_ROUTINE                $002A10
#define WARM_SIGNATURE              $002AFD
#define WARM_COMPLEMENT             $002AF9
#define SAVED_SP                    $002AFB

#define BGM_STATE                   $002AF7 /* fork: menu-music runtime state. Lives in the $2A
                                              FPGA region, which is NOT cleared by clear_wram and
                                              survives a reset, so coldboot explicitly zeroes it
                                              (main.a65) -- every non-warm reset lands in coldboot.
                                              0=not loaded (reload), 1=playing, 2=tried-no-spc,
                                              3=music off + DSP-unmute stub running (keeps the
                                              cart MSU-1 DAC audible for the menu sound effects),
                                              4=tried-no-spc + DSP-unmute stub running. */

#define BRAM_PAYLOAD                $002A10
#define BRAM_RETURN_VECTOR          $002A6C
#define BRAM_RESET_HOOK             $002A7D
#define NMI_WRAM_CHEATS             $002AD8
#define NMI_PAD                     $002BF0
#define NMI_CMD                     $002BF2
#define BRAM_UNLOCK                 $002BF4
#define MIRROR_4200                 $002BFA
#define PAD_LATCH                   $002BFB
#define NMI_BUTTONS_ENABLE          $002BFC
#define NMI_VECT_DISABLE            $002BFD
#define NMI_WRAM_PATCH_DISABLE      $002BFE
#define NMI_WRAM_PATCH_COUNT        $002BFF
#define NMI_EXEC                    $002C00
#define WINDOW_STACK_BASE           $7E2000

/* iris_out $420c HDMA-enable selector byte. Lives in the iris WRAM scratch block
   ($7E8000..$7E9FFF; free byte after IRIS_TMP8 $8402, see iris.a65). game_handshake
   (main.a65) writes it right before `jsl iris_out`: $59 = menu set (keep ch0/3/4 scroll
   + mode-switch, add ch6 window) or $48 = game-info ficha set (keep only ch3 = the ficha's
   mode3->mode5 split + ch6 window). iris.a65 reads it at the $420c swap. The value is
   discriminated by screen_dma_disable (=1 <=> the ficha is still on the PPU => $48). */
#define IRIS_HDMA_EN                $7E8408

/* game_handshake save slot for screen_dma_disable's original value. During an MCU load the
   browser list DMA is frozen (screen_dma_disable=1) so its per-frame tile-buffer DMA can't
   glitch a frame (the 1-frame black flash on GI-off loads); the original is restored before
   the iris set is picked and in the NACK error path. Free byte in the iris scratch block. */
#define GH_SDD_SAVE                 $7E8409

/* (the iris-frame sampler that used to live here is gone -- see LOAD_NACK) */

#define BG2_TILE_BUF                $7EA000
#define BG1_TILE_BUF                $7EB000
#define COVER_OAM_LO                $7EC000    /* cover OAM low-table shadow (64 sprites*4) */

#define WRAM_ROUTINE                $7EF000
#define WRAM_STORE_BLOCKRAM_ROUTINE $7EF080
#define WRAM_FADELOOP               $7EF100
#define WRAM_WAIT_MCU               $7EF200
#define WRAM_LOAD_ULTRA16_CFG       $7EF210

#define ROOT_DIR                    $C20000

#define NUM_CHEATS                  $FF0700
#define SS_SCENE_GATE               $FF0702 /* overlay scene-gate arm flag, written by the firmware on EVERY game load (savestate.c) = "this game needs the probe gated on scene liveness" (core+checksum keyed; today Super Mario RPG (US) on SA-1 only). 1 => the probe must also see bit0 of $F90720 (the FPGA scene_fresh bit from cheat.v: pad written to SA-1 IRAM $3010/$3011 or $4218/$4219 polled within ~49-73ms) before opening the overlay, because the NMI hook also fires on scene transitions where the frame loop is parked mid-RPC and opening there hangs the game on resume. Free $FF0702..$FF070F gap ($FF0703..$FF0707 still free). Lockstep with SS_SCENE_GATE_ADDR in src/memory.h. */
#define SS_SCENE_FRESH              $F90720 /* FPGA-served scene-liveness bit (bit0; the rest reads 0). Decoded by verilog/sd2snes_sa1/main.v inside the IS_PATCH identity window, so it is only readable while the hook holds the snescmd unlock -- exactly when the probe runs. Read only when SS_SCENE_GATE is 1; on cores that do not decode it the address reads back PSRAM. */
#define CHEAT_WIN_BASE              $FF0708 /* absolute base index of the 64-name window RESIDENT in CHEAT_NAMES ($FF8000). MCU-owned (published = 0 at game load and on each CMD_CHEAT_NAMES_WINDOW). The overlay maps an absolute cheat index to its window slot: (idx - CHEAT_WIN_BASE)*CHEAT_NAME_LEN. Free $FF0702..$FF070F gap. Lockstep with SRAM_CHEAT_WIN_BASE_ADDR in src/memory.h. */
#define CHEAT_OVL_GATE              $FF0710 /* in-game cheat overlay arm flag, set by firmware at game load (= CFG.enable_cheat_overlay && !special_chip). The savestate-handler probe reads it; 0 => don't open. Free $FF0701..$FF07FF gap. */
#define PPU_CLEAR_GATE             $FF0711 /* pre-boot PPU-clear arm flag, set by firmware in load_rom (= CFG.clear_ppu_on_boot && a patch was applied this load). game_handshake reads it; 1 => jsr clear_ppu_on_boot. Lockstep with SRAM_PPU_CLEAR_GATE_ADDR in src/memory.h; same free gap. */
#define SS_DSP_GATE                 $FF0712 /* DSP1-4 savestate present flag (firmware-armed = fpga_conf==FPGA_DSP && !ST0010). Handler reads it to decide whether to capture/restore the DSP. Same $FF0701..$FF07FF gap. Lockstep with SS_DSP_GATE_ADDR in src/memory.h. */
#define SS_DSP_WINDOW               $E80000 /* DSP1-4 data-RAM + scan register-file window (banks $E8-$EF, off $0000-$07FF). $07FF = halt control (write bit0=halt, read bit0=halted). Live only while the handler holds map/snescmd unlock. */
#define SS_DSP_SCRATCH              $F47000 /* PSRAM scratch for the DSP snapshot (0x700 B), inside the persisted F0..F4 region. NOT bank F3: copier op2 (F8F3, ARAM) rewrites all of F3 while it drains during the VRAM readback, so a snapshot there is silently overwritten with ARAM. $F47000 is the coprocessor scratch slot shared with SA-1 IRAM / GSU cache (a game never has two chips); the overlay scratch starts at $F48100 and op2 stops at $F404FF, so nothing else touches this range during a DSP save/load. */
#define SS_SA1_GATE                 $FF0713 /* SA-1 savestate present flag (firmware-armed = Mk.III && fpga_conf==FPGA_SA1; 0 on Mk.II). Handler reads it to decide whether to capture/restore the SA-1. Same $FF0701..$FF07FF gap. Lockstep with SS_SA1_GATE_ADDR in src/memory.h. */
#define SS_SA1_WINDOW               $E80000 /* SA-1 savestate scan window (bank $E8, off $0000-$00FF = 256-byte state block; off $07FF = halt control: write bit0=1 request halt/0=release, read bit0=frozen, bit1=frozen-at-WAI. Off $F0 = resume-shape/normalize byte, off $FF = magic $5A. Reads of $0100-$07FE return $00). Live only while the handler holds snescmd_unlock (the sa1 core has no map_unlock). */
#define SS_SA1_IRAM_SCRATCH         $F47000 /* PSRAM scratch for the SA-1 IRAM snapshot (2 KB). Free range inside the F4 bank of the F0..F4 region persisted to the .state file. */
#define SS_SA1_REGS_SCRATCH         $F47800 /* PSRAM scratch for the SA-1 window state block (256 B). Inside the persisted F4 bank. */
#define SS_SA1_BWRAM_SCRATCH        $F48000 /* PSRAM scratch for the SA-1 BW-RAM snapshot (32 KB). Inside the persisted F4 bank. */
#define SS_GSU_GATE                 $FF0714 /* GSU savestate present flag (firmware-armed = fpga_conf==FPGA_GSU, on Mk.II and Mk.III -- the GSU window is un-gated from ifdef MK3, unlike SA-1). Lockstep with SS_GSU_GATE_ADDR in src/memory.h. */
#define SS_GSU_WINDOW               $E80000 /* GSU savestate scan window (bank $E8, off $00-$FF; $00-$3F mirrors native MMIO semantics with read gates opened while frozen, $40+ = COLR/POR/SREG/DREG/cache-valid/pixbuf, $F0 = normalize, $FE = halt ctl (write bit0=1 halt request -> run-to-stop, read bit0=frozen), $FF = magic $5B). Live only under snescmd_unlock. */
#define SS_GSU_CACHE_SCRATCH        $F47000 /* PSRAM scratch for the GSU 512B instruction cache image (shares the SA-1 IRAM scratch slot; a game is never both). */
#define SS_GSU_REGS_SCRATCH         $F47800 /* PSRAM scratch for the GSU window state block (256 B; shares the SA-1 regs slot). */
#define SS_GSU_RAM_SCRATCH          $F48000 /* PSRAM scratch for the GSU cart-RAM snapshot (32 KB @ $70:0000; shares the SA-1 BW-RAM slot). */
#define IGMENU_GATE                 $FF0715 /* in-game TAB menu: igmenu.bin staged+verified flag, armed by firmware igmenu_stage at game load. The $C0 overlay hook reads it; 0 => single-tab fail-safe (proven cheat overlay). Free $FF0701..$FF07FF gap, after SS_GSU_GATE. Lockstep with SRAM_IGMENU_GATE_ADDR in src/memory.h. */
#define SS_SLOT_STATUS              $FF0716 /* savestate slot occupancy bitmask, bit N-1 = slot N (1..4) has a .state file. Staged by firmware at game load; read by the STATES tab. Lockstep with SRAM_SS_SLOT_STATUS_ADDR in src/memory.h. */
#define SRM_SLOT_STATUS             $FF0717 /* battery-SRAM slot occupancy bitmask. EnableSramSlots ON: bit i = slot i (0..3: <stem>.srm, <stem>.02/03/04.srm) exists; OFF: bit0 = legacy <stem>.srm exists. Staged by saveinfo_stage at game load, refreshed after autosave; read by the SAVES tab. The selected/next slot is published separately at SAVEINFO+42. Lockstep with SRAM_SRM_SLOT_STATUS_ADDR in src/memory.h. */
#define SAVEINFO                    $FF0730 /* SAVES tab staging block (48B, clear of the BPS breadcrumbs $FF0720-2E): +0 flags (bit0 game-has-sram, bit1 srm-exists, bit2 autosave-on), +1 size str (16B ASCII NUL), +17 datetime str (24B ASCII NUL), +42 selected/next SRAM slot (0..3; 0 when EnableSramSlots OFF). Slot occupancy bitmask is separate at SRM_SLOT_STATUS $FF0717. Lockstep with SRAM_SAVEINFO_ADDR in src/memory.h. */
#define MANUAL_META                 $FF0760 /* guides viewer meta (16B, staged at game load): +0 flags (bit0 = >=1 valid guide present, bit1 = transient read-error latch, bit2 = a zoom page is staged and ready in $C5/$C6), +1 npages of guide 0, +2 meta_abi (=MANUAL_META_ABI; shell degrades to "no guides" if != this), +3 staged 1x page, +4 block-in-page, +5 content_rows, +6 zoom nrows, +7..8 zoom pix_h u16 LE, +9 staged zoom page, +10 staged zoom guide. Per-guide metadata lives in MANUAL_GUIDES. Lockstep with SRAM_MANUAL_META_ADDR in src/memory.h. */
#define MANUAL_META_ABI             $03     /* MANUAL_META+2 sanity value; firmware<->igmenu.bin data-contract. Lockstep with MAN_META_ABI in src/manual.c. (3: title[0] may be a document-type slug) */
#define MAN_META_F_PRESENT          $01     /* MANUAL_META+0 bit0 */
#define MAN_META_F_ERROR            $02     /* MANUAL_META+0 bit1: transient read-error latch */
#define MAN_META_F_ZREADY           $04     /* MANUAL_META+0 bit2: zoom page staged in $C5/$C6 */
#define MAN_META_ZNROWS             $FF0766 /* u8 tile rows in the staged zoom page (1..MAN_Z_MAX_ROWS) */
#define MAN_META_ZPIXH              $FF0767 /* u16 LE 2x pixel height; vertical scroll clamps to pix_h-224 so padding never shows */
#define MAN_META_ZPAGE              $FF0769 /* u8 staged zoom page */
#define MAN_META_ZGUIDE             $FF076A /* u8 staged zoom guide */
#define MAN_META_ZENTRYY            $FF076B /* u16 LE: where to start panning when entering zoom from a 1x block (2x pixels into the page) */
#define MAN_META_ZFIRSTBLK          $FF076D /* u16 LE: first 1x block covering the staged zoom page (after page turns it is not the one we entered from) */
#define MAN_META_ZNBLK              $FF076F /* u8: how many 1x blocks cover it, so leaving zoom returns to the BAND being read rather than always the first */
#define MANUAL_S1META               $FF0770 /* scale-1 (1x) page meta, 16B after MANUAL_META: +0 flags (bit0 = staged and ready), +1 nrows, +2..3 pix_h u16 LE, +4 staged page, +5 staged guide, +6..7 page count u16 LE. Lockstep with SRAM_MANUAL_S1META_ADDR in src/memory.h. */
#define MAN_S1_F_READY              $01
#define MAN_S1META_NROWS            $FF0771
#define MAN_S1META_PIXH             $FF0772 /* u16 LE */
#define MAN_S1META_PAGE             $FF0774
#define MAN_S1META_NPAGES           $FF0776 /* u16 LE */
#define CMD_MANUAL_S1PAGE           $46     /* SNES_CMD_MANUAL_S1PAGE: stage one scale-1 (1x) scrollable page into MANUAL_S1TILES/S1TMAP/S1PAL. MCU_PARAM[0] = guide, [1..2] = page u16 LE. Lockstep with src/snes.h. */
#define CMD_CHEAT_NAMES_WINDOW      $47     /* SNES_CMD_CHEAT_NAMES_WINDOW: stage the sliding 64-name window at MCU_PARAM low16 = absolute base index (from the $D00000 records) into CHEAT_NAMES + publish CHEAT_WIN_BASE. Lets the overlay list ALL cheats. ACK = MCU_CMD cleared. Lockstep with src/snes.h. */
#define MANUAL_GUIDES               $FF9000 /* guides list (260B, $FF9000..$FF9103, staged at game load; free above CHEAT_NAMES $FF8FFF, below scratchpad $FFFF00): +0 count (0..8), +1 selected (active guide; SNES writes it; default 0), +2..3 rsvd, record[8] of MAN_GD_REC_STRIDE bytes at +MAN_GD_REC0. Lockstep with SRAM_MANUAL_GUIDES_ADDR in src/memory.h. */
#define MAN_GD_COUNT                $FF9000 /* u8 guide count (0..8) */
#define MAN_GD_SELECTED             $FF9001 /* u8 active guide the tab writes; default 0 */
#define MAN_GD_REC0                 $FF9004 /* first record; record k = MAN_GD_REC0 + k*MAN_GD_REC_STRIDE */
#define MAN_GD_REC_STRIDE           32
#define MAN_GD_R_PRESENT            0       /* u8: 1 = valid (list compacted -> 0..count-1 present) */
#define MAN_GD_R_NN                 1       /* u8: physical suffix, 0=".man", 2..8=".0N.man" */
#define MAN_GD_R_FLAGS              2       /* u8: raw .man header flags -- bit0 = LEGACY quadrant zoom (IGNORE, never produced any more), bit1 = scrollable zoom section present */
#define MAN_GD_R_NPAGES             3       /* u8 */
#define MAN_GD_R_NBLOCKS            4       /* u16 LE: 1x blocks */
#define MAN_GD_R_ZPAGES             6       /* u16 LE: number of scrollable zoom pages (0 = none). A zoom page is a whole PDF page at 2x, so this is normally npages -- NOT nblocks. */
#define MAN_GD_F_ZOOM2              $02     /* MAN_GD_R_FLAGS bit1 */
#define MAN_GD_R_TITLE              8       /* title[24] font-encoded NUL-term */
#define MANUAL_SHELLSAVE            $C40000 /* viewer's save of the shell mode-5 state: VRAM $0000-$5FFF (24KB, $2139 readback) + CGRAM 512B at +$6000. Lockstep with SRAM_MANUAL_SHELLSAVE_ADDR in src/memory.h. */
/* --- scrollable 2x zoom page, staged whole into PSRAM by CMD_MANUAL_ZPAGE. Panning costs NO MCU
   traffic: the viewer just DMAs from here. 512px does not fit one BG layer (10-bit character field
   = 1024 tiles max), so each tile row is split cols 0-31 -> BG1, cols 32-63 -> BG2, joined by a
   window at 256-X. Lockstep with the SRAM_MANUAL_Z* defines in src/memory.h. */
/* --- scale-1 (1x) scrollable page: same machinery as the 2x at 256px wide. 32 tiles/row means a
   29-row ring is 928 tiles -> ONE layer, no split and no window. Lives in bank C3 (the retired
   8bpp block's space) so 1x and 2x are both resident and toggling is instant. --- */
#define MANUAL_S1TILES              $C30000 /* scale-1 tile row r at +r*1024 */
#define MANUAL_S1TMAP               $C4B000 /* prebuilt tilemap, row r at +r*64 */
#define MANUAL_S1PAL                $C4C000 /* 8 palettes x 16 BGR555 -> CGRAM 0..127 */
#define MAN_S1_MAX_ROWS             64      /* 512px at 1x; a page is ~47 rows (A4 46, Legal 53) */
#define MAN_S1_TILES_W              32      /* tiles across a 256px page */
#define MAN_S1_ROW_BYTES            1024
#define MAN_S1_TMAP_STRIDE          64      /* 32 entries x 2B */
#define MANUAL_ZTILES_A             $C50000 /* BG1 half (cols 0-31) of tile row r at +r*1024; 96 rows -> $C50000-$C67FFF */
#define MANUAL_ZTILES_B             $C68000 /* BG2 half (cols 32-63) of tile row r at +r*1024; 96 rows -> $C68000-$C7FFFF */
#define MANUAL_ZTMAP                $C47000 /* prebuilt tilemap entries, row r at +r*128 = 32 words BG1 then 32 words BG2 */
#define MANUAL_ZPAL                 $C4A000 /* 8 palettes x 16 BGR555 = 256B -> CGRAM 0..127 */
#define MAN_Z_RING_ROWS             29      /* VRAM ring depth in tile rows: 28 on screen + 1 partial for sub-tile scroll. The MCU bakes slot = r % this into the tilemap words, so it is a LOCKSTEP constant (MAN_Z_RING_ROWS in src/manual.c), not a viewer-local choice. */
#define MAN_Z_MAX_ROWS              96      /* tile rows in a zoom page (768px of 2x). A zoom page is a WHOLE PDF PAGE, not a 1x band -- panning must be continuous over the entire page. */
#define MAN_Z_TILE0                 16      /* first image tile index; tiles 0..15 are the OBJ HUD glyphs (OBJ char base is only 16KB-alignable, so both pools start 512B in) */
#define MAN_Z_TMAP_STRIDE           128     /* bytes per prebuilt tilemap row (64 entries) */
#define MAN_Z_HALF_BYTES            1024    /* bytes per BG half of one tile row (32 tiles x 32B) */
#define CMD_MANUAL_ZPAGE            $45     /* SNES_CMD_MANUAL_ZPAGE: stage one whole 2x zoom page into MANUAL_ZTILES_A/B + ZTMAP + ZPAL. MCU_PARAM[0] = compacted guide (0..7), [1..2] = index u16 LE, [3] = mode: 0 = index is a 1x BLOCK (resolved via the block map; entry Y published in MAN_META_ZENTRYY), 1 = index is a ZOOM PAGE directly (page turns). Re-staging an already-resident page is skipped. Publishes MAN_META_F_ZREADY + ZNROWS/ZPIXH/ZPAGE/ZENTRYY/ZFIRSTBLK. Lockstep with src/snes.h. */
#define CMD_SET_SRM_SLOT           $44     /* SNES_CMD_SET_SRM_SLOT: persist the selected SRAM slot (MCU_PARAM low byte 0..3) to the <stem>.slot sidecar; refreshes SAVEINFO+42 / SRM_SLOT_STATUS. Applies on next game load (never changes the live slot). Lockstep with src/snes.h. */
#define CFG_ENABLE_GAME_MANUAL      CFG_ADDR+$0145 /* EnableGameManual toggle (default ON); next free after CFG_BUS_COMPAT $0144. Lockstep with src/cfg.h. */
#define IGMENU_ABI_VERSION          $03     /* igmenu.bin ABI version. Checked by BOTH the MCU (igmenu_stage: magic+version+crc) AND the overlay ($C20004 vs this). Bump on ANY layout/ABI change so a mismatched bin degrades to the fail-safe. v3 requires the theme block the overlay stages at IGM_THM_* before dispatching the shell. Lockstep with IGMENU_ABI_VERSION in src/memory.h. */
#define IGM_POS_MAGIC               $5A34   /* in-game menu session-persist magic (bumped on any change to what active_tab indexes / the persisted layout). Written by igmenu_main to IGM_POS_MAGIC_ADDR; tested by BOTH the shell (manual position + tab) and the $C0 overlay init (cheat-list top/selrow keep). MCU clears the ADDR on every game load. */
#define IGM_POS_MAGIC_ADDR          $F4819E /* = man_pos_magic (igmenu.a65) = IGMENU_PERSIST_MAGIC_ADDR (src/memory.h). Lockstep. */
#define IGMENU_ENTRY                $C20008 /* igmenu.bin entry (jml igmenu_main); the $C0 hook does jsl here after the gate+version guard. Header: $C20000 "IGMN" magic, $C20004 version, $C20006 crc16(body), $C20008 jml. Loaded to PSRAM SRAM_DIR_ADDR ($C20000, menu dir buffer, dormant in-game) -- reachable in-game only under IS_PATCH (snescmd_unlock). */
/* ---- in-game TAB menu theme hand-off (staged block in PSRAM $F4) ----
   igmenu.bin is a SEPARATE link and sees none of the m3nu symbols, but the cheat
   overlay object ($C1, part of the m3nu link) does -- and in-game those symbols
   address the menu image RESIDENT in PSRAM, which theme_apply already overwrote
   with the active theme (the same mechanism that lets the overlay call genfonts).
   So the overlay copies the themed bytes into this block right before the
   jsl $c20008, and the shell reads only from here. Written by snes/cheatoverlay.a65
   (ovl_stage_theme), read by snes/igmenu.a65. Lives in the once-free $F48252..$F48FFF
   gap -- above the igmenu Slice-2 scratch ($F48240..$F4824F), clear of OVL_RB
   ($F48200..$F4823F) and OVL_TMBUF ($F49000..$F499FF) -- now occupied up to $F48397:
   IGM_THM_* $F48260-$F482D2, ovl_sb_* $F482DE-$F482E7 (cheatlist.i65), OVL_CUR_OFF
   $F482E8, ig_hdma_mask + BAR scratch $F482F0-$F482FF and theme WRAM/DMA-reg saves
   $F48300-$F483A3 (igmenu.a65); free again from $F483AE (ig_win_x..h $F483A4-A7, tint $F483A8, pos_focus $F483AA, pos_slot $F483AC). */
#define IGM_THM_MAGIC               $F48260 /* 1B: $A5 = staged block valid, written LAST by the overlay before the jsl $c20008; 0 = invalid (aborted/never staged) and the shell must fall back to its baked colours. */
#define IGM_THM_GRAD                $F48261 /* 55B: backdrop gradient blob ([count,lo,hi]* terminated by a 0 count), copied from the THEMED hdma_pal_src. Same 55-byte region size main.a65 DMAs into the hdma_pal WRAM buffer. */
#define IGM_THM_GRAD_A              $8261   /* 16-bit abs alias of IGM_THM_GRAD for abs,Y reads under DBR=$F4 (igt_grad_build walks two cursors and the 65816 has long,X but NO long,Y). KEEP IN LOCKSTEP with IGM_THM_GRAD above -- same convention as OVL_RB/OVL_TMBUF in cheatlist.i65. */
#define IGM_THM_MATH                $F48298 /* 19B: colour-math table of the selection BAR, copied RAW from hdma_math_src -- so it already carries the NORMAL bar colour in its COLDATA bytes. */
#define IGM_THM_BARCOL              $F482AB /* 8B: BAR colours from hdma_bar_color_src -- 4B normal then 4B highlight (active editing). The shell applies a group the way set_bar_color (ui.a65) does: byte i overwrites table offset 2+3*i (2, 5, 8, 11) of its WRAM copy of IGM_THM_MATH. The staged table is RAW, so only the highlight group ever NEEDS patching in. */
#define IGM_THM_PAL                 $F482B3 /* 32B: four 8-byte (4 colours x BGR555) sub-palettes lifted out of the menu's raw 512B `palette` block: +0 pal0 (text, CGRAM 0-3), +8 pal6 (grey, CGRAM 24-27), +16 pal2 (green, CGRAM 8-11), +24 pal3 (frame, CGRAM 12-15). */
#define OVL_CUR_OFF                 $F482E8 /* 1B: 0 = the cheat list draws its own '>' cursor (the $C0 fail-safe path); 1 = the $C2 shell suppresses it because the BAR marks the selection. Zeroed by the overlay on EVERY open, BEFORE the first list paint (ss_ovl_draw_full_row is the reader) -- PSRAM $F4 is not auto-cleared and survives reopens. The reader does a 16-bit lda + and #$00ff, so $F482E9 is fetched and discarded: keep it unallocated. */
#define SS_OBC1_GATE                $FF0718 /* OBC1 savestate present flag (firmware-armed = fpga_conf==FPGA_OBC1, on Mk.II and Mk.III -- the OBC1 is purely reactive, no chip halt needed). Handler reads it to decide whether to capture/restore the OBC1 window. Free $FF0701..$FF07FF gap, after SRM_SLOT_STATUS (below the BPS breadcrumbs $FF0720-2E). Lockstep with SS_OBC1_GATE_ADDR in src/memory.h. */
#define SS_OBC1_SCRATCH             $F47000 /* PSRAM scratch for the OBC1 window image (2 KB = the SNES-visible $7800-$7FFF window: obc_lower + obc_upper mirror image + the 8 regs). Shares the coprocessor scratch slot (SA-1 IRAM / GSU cache / DSP snapshot); a game is never two chips. Captures/restores the state VISIBLE to the SNES, not the chip's internal BRAM (on Mk.II the unreachable obc_lower[512:1023] never enters the window). */
#define SS_SDD1_GATE                $FF0719 /* S-DD1 savestate present flag (firmware-armed = fpga_conf==FPGA_SDD1, on Mk.II and Mk.III -- the S-DD1 decompressor FSM is never mid-transfer at an NMI boundary, so no chip halt needed). Handler reads it to decide whether to capture/restore the S-DD1 config block. Free $FF0701..$FF07FF gap, after SS_OBC1_GATE. Lockstep with SS_SDD1_GATE_ADDR in src/memory.h. */
#define SS_SDD1_SCRATCH             $F47000 /* PSRAM scratch for the S-DD1 config snapshot (6 bytes = the bus-visible config regs $4800/$4801/$4804-$4807). Shares the coprocessor scratch slot (SA-1 IRAM / GSU cache / DSP snapshot / OBC1 window); a game is never two chips. */
#define SS_CX4_GATE                 $FF071F /* CX4 savestate present flag (firmware-armed = fpga_conf==FPGA_CX4, on Mk.II AND Mk.III). Free $FF0701..$FF07FF gap, after EXPORT_RESULT (last byte before the BPS breadcrumbs at $FF0720). Lockstep with SS_CX4_GATE_ADDR in src/memory.h. */
#define SS_CX4_WINDOW               $E80000 /* CX4 savestate scan window (bank $E8, off $00-$27 = state block; $E0-$E2 stage cpu_idb, $E3 commit, $E4 readback index, $F0 normalize, $FE halt ctl (write bit0=1 halt request -> run-to-stop, read bit0=frozen), $FF magic $5C). Live only under snescmd_unlock. */
#define SS_CX4_DATRAM_SCRATCH       $F47000 /* PSRAM scratch for the CX4 data RAM (3072 B, $00:6000-$6BFF). Shares the coprocessor scratch slot (DSP/SA-1/GSU/OBC1/S-DD1); a game is never two chips. */
#define SS_CX4_NAT_SCRATCH          $F47C00 /* base indexed by the LOW byte of $00:7Fxx, so MMIO + status + vectors + GPR are one loop; uses +$40..+$AF (112 B). */
#define SS_CX4_WIN_SCRATCH          $F47CC0 /* 64 B mirror of $E8:0000-$003F (only $04-$27 carries data). */
#define SS_CX4_CORE_SCRATCH         $F47D00 /* 16 B: the five 24-bit registers read through the $E4 readback mux, in the order cpu_a, romdata, ramdata, busaddr, ramaddr. Top at $F47D0F -- well below IGM_POS_MAGIC_ADDR $F4819E and the overlay scratch ($F48100+). */
#define SS_STAGED_SLOT              $FF071B /* savestate slot whose image is currently RESIDENT in PSRAM $F00000 (1..4; 0 = none/unknown). Published by the firmware whenever it stages one (load_backup_state) or writes one out (save_backup_state -- after a save the resident image IS that slot). load_state (snes/savestate.a65) compares it against CS_SLOT and asks the MCU for a CMD_LOADSTATE when they differ, which is what makes selecting a slot in the STATES tab affect the LOAD and not only the save. Free $FF0701..$FF07FF gap, after CHEAT_MASTER. Lockstep with SRAM_SS_STAGED_SLOT_ADDR in src/memory.h. */
#define CHEAT_MASTER                $FF071A /* master cheat switch mirror (1 = cheats globally enabled). Published by the firmware in cheat_program (= CFG.enable_cheats) and kept in sync when the L+R+Start+A/B combos are served (main.c). The in-game CHEATS tab reads it to draw the status line and writes it when X toggles the master. The ACTUAL switch is the FPGA's cheat_enable register: writing $82/$83 to MCU_CMD ($002A00) under snescmd_unlock is decoded by cheat.v -- this byte is only the mirror the UI reads back. Free $FF0701..$FF07FF gap, after SS_SDD1_GATE. Lockstep with SRAM_CHEAT_MASTER_ADDR in src/memory.h. */
#define CHEAT_ADDR                  $D00000
#define CHEAT_CODE_STRINGS          $D40000 /* per-code display strings, 12 bytes each. cheat_idx*512 + code_idx*12. Spans banks D4..D7 to leave D0..D3 free for up to 512 cheat records (512 bytes each). */
#define CHEAT_TITLE                 $D80000 /* 256 bytes "Cheats for <game>" null-terminated, in cheat region past any plausible cheat count */
#define CHEAT_FLAGS                 $FF0500 /* 512 bytes BSRAM mirror of cheat flag byte 0 (cheats 0..511). SNES reads/writes here for instant visual toggle, MCU also keeps it in sync. */
#define CHEAT_NAMES                 $FF8000 /* in-game cheat overlay: first CHEAT_OVL_MAX names, CHEAT_NAME_LEN bytes each, staged by firmware at game load ($D00000 records are game ROM in-game). 64*64=4KB fills $FF8000..$FF8FFF. Lockstep with SRAM_CHEAT_NAMES_ADDR in src/memory.h. */
#define CHEAT_OVL_MAX               64      /* size of the RESIDENT in-game name window: CHEAT_NAMES holds 64 names for [CHEAT_WIN_BASE, +64). The list slides the window (CMD_CHEAT_NAMES_WINDOW) to cover all cheats up to CHEAT_LIST_MAX. */
#define CHEAT_LIST_MAX              512     /* hard cap on listed cheats (= CHEAT_RECORD_MAX in src/cheat.h); the TRUE count comes from NUM_CHEATS. */
#define CHEAT_NAME_LEN              64      /* bytes per staged in-game name (power of 2 -> (idx-base)*LEN is a shift) */

#define SPC_DATA                    $FD0000
#define SPC_HEADER                  $FE0000
#define SPC_DSP_REGS                $FE0100

#define FILESEL_CWD                 $FF0000
#define CFG_ADDR                    $FF0100
#define MCU_ERR_CODE                $FF1000 /* MCU snes_menu_errmsg: error code (1 byte). 0=OK,2=SUPPLFILE(missing chip BIOS),3=NOIMPL(unsupported chip). game_handshake_error reads this. */
#define MCU_ERR_MSG                 $FF1001 /* MCU error string (basename/chip name, NUL-term), $FF1001..$FF1040. NB overlaps SRAM_PARAM_ADDR($FF1004) on the MCU side -- benign, PARAM already consumed in this flow. */
/* error codes -- must match MENU_ERR_* in src/snes.h */
#define MENU_ERR_SUPPLFILE          $02
#define MENU_ERR_NOIMPL             $03
#define ST_MCU_ADDR                 $FF1100
#define ST_SNES_ADDR                $FF1110
#define SYSINFO_BLK                 $FF1200
#define LAST_GAME                   $FF1420
#define LAST_GAME_DIR               $FF1F00
#define WRAM_BAK                    $FF2000
#define FAVORITE_GAMES              $FF6000 /* 20*256 = $1400 -> $FF6000..$FF73FF. Moved off $FF4000 (only fit 10) into the free gap past IPS_LIST so favorites could grow to 20. Lockstep with SRAM_FAVORITEGAMES_ADDR (src/memory.h). Old $FF4000..$FF49FF now unused. */
#define LAST_GAME_FILE              $FF4A00 /* base ROM basename for reset_to_menu==3 pre-select (now-fully-free gap before IPS_LIST $FF5000; favorites moved off $FF4000 to $FF6000). NOT LAST_GAME[0]: that is the recents display name, which for a patch-aware entry is the patch name and never matches a TYPE_ROM directory entry. */
#define BROWSER_DIR                 $FF4B00 /* folder to reopen after a theme/BGM menu reload (browser_pos_save); read by filesel_nav_restore when ST_RESTORE_BROWSER is set. Lockstep with SRAM_BROWSER_DIR_ADDR (src/memory.h). */
#define BROWSER_FILE                $FF4C00 /* basename to put the cursor on after that reload ("" = reopen the folder only). Lockstep with SRAM_BROWSER_FILE_ADDR. */

#define CMD_LOADROM                 $01 /* shortcut - load ROM with default settings */
#define CMD_SETRTC                  $02
#define CMD_SYSINFO                 $03
#define CMD_LOADLAST                $04
#define CMD_LOADSPC                 $05
#define CMD_LOADFAVORITE            $06
#define CMD_SET_ALLOW_PAIR          $07
#define CMD_SET_VIDMODE_GAME        $08
#define CMD_SET_VIDMODE_MENU        $09
#define CMD_READDIR                 $0A
#define CMD_FPGA_RECONF             $0B
#define CMD_LOAD_CHT                $0C
#define CMD_SAVE_CHT                $0D
#define CMD_SAVE_CFG                $0E
#define CMD_SET_CFG                 $0F
#define CMD_SELECTROM               $10 /* TODO WIP */
#define CMD_RUNROM                  $11 /* TODO WIP - ROM must first be selected by SELECTROM */
#define CMD_LED_BRIGHTNESS          $12
#define CMD_ADD_FAVORITE_ROM        $13
#define CMD_ADD_FAVORITE_RECENT     $14
#define CMD_REMOVE_FAVORITE_ROM     $15
#define CMD_REMOVE_RECENT_ROM       $16
#define CMD_SET_AUTOBOOT_ROM        $17 /* set autoboot from file browser */
#define CMD_SET_AUTOBOOT_FAV        $18 /* set autoboot from favorites (index in MCU_PARAM) */
#define CMD_SET_AUTOBOOT_RECENT     $19
#define CMD_CLR_AUTOBOOT_ROM        $1a /* clear autoboot ROM setting */
#define CMD_LOAD_AUTOBOOT           $1b /* trigger autoboot at cold boot */
#define CMD_LOAD_COVER              $1c /* stage sibling .cov for highlighted ROM into bank C9 */
#define CMD_QUERY_IPS_PATCHES       $1d /* find IPS patches for selected ROM */
#define CMD_LOAD_MENU_SPC           $1e /* stage /sd2snes/menu.spc for background menu music */
#define CMD_LOAD_COVER_RECENT       $1f /* stage downscaled .cov for recent game (index in MCU_PARAM) */
#define CMD_LOAD_COVER_FAVORITE     $20 /* stage downscaled .cov for favorite game (index in MCU_PARAM) */
#define CMD_DELETE_FILE             $21 /* delete selected file */
#define CMD_DELETE_SRM              $22 /* delete SRM save file for selected ROM */
#define CMD_TOGGLE_CHT              $23 /* MCU_PARAM low byte: cheat index. MCU XORs the flag bit in PSRAM record. */
#define CMD_LOAD_CHT_FAV            $24 /* MCU_PARAM low byte: favorite index. Resolves path via cfg_get_listed_game(FAVORITES_FILE, ...) then cheat_yaml_load. */
#define CMD_SAVE_CHT_FAV            $25 /* MCU_PARAM low byte: favorite index. Resolves path via cfg_get_listed_game(FAVORITES_FILE, ...) then cheat_yaml_save. */
#define CMD_DELETE_FILE_FAV         $26 /* MCU_PARAM low byte: favorite index. Delete the ROM, then drop the favorites list entry. */
#define CMD_DELETE_SRM_FAV          $27 /* MCU_PARAM low byte: favorite index. Delete only the .srm (ROM stays in favorites). */
#define CMD_DELETE_FILE_RECENT      $28 /* MCU_PARAM low byte: recent index. Delete the ROM, then drop the recents list entry. */
#define CMD_DELETE_SRM_RECENT       $29 /* MCU_PARAM low byte: recent index. Delete only the .srm (ROM stays in recents). */
#define CMD_LOAD_CHT_RECENT         $2a /* MCU_PARAM low byte: recent index. Resolves path via LAST_FILE then cheat_yaml_load. */
#define CMD_SAVE_CHT_RECENT         $2b /* MCU_PARAM low byte: recent index. Resolves path via LAST_FILE then cheat_yaml_save. */
#define CMD_SET_THEME               $2c /* selected .thm in a visible folder (MCU_PARAM set like LOADROM): store full path, reload menu */
#define CMD_CLR_THEME               $2d /* clear menu theme to baked default, reload menu */
#define CMD_SET_MENU_SPC            $2e /* selected .spc (MCU_PARAM set like LOADROM): store full path in CFG.bgm_name, enable music */
#define CMD_CLR_MENU_SPC            $2f /* clear CFG.bgm_name -> menu BGM falls back to /sd2snes/menu.spc */
#define CMD_PATCH_META_SAVE         $3b /* patch selector: persist the header modes the menu edited (IPS_FLAGS) into /sd2snes/patches/<BB>/<stem>.yml. MCU_PARAM set like LOADROM. ($39 went to CMD_RESTORE_CLASSIC, developed in parallel.) */
#define CMD_EXPORT_PATCHED_ROM      $3a /* patch selector: write a .sfc next to the ROM with the patch at MCU_PARAM+7 already applied, named after the PATCH FILE ("Foo - [BR].ips" -> "Foo - [BR].sfc"), then reload the menu. Slow (tens of seconds). */
#define CMD_EXPORT_CHECK            $3c /* pre-flight for CMD_EXPORT_PATCHED_ROM (same MCU_PARAM, +7 = patch index): answers "would the .sfc collide?" in EXPORT_RESULT (0 free / 4 exists) and ACKs $55. Non-booting -- lets patch_create_rom refuse IN PLACE, before the screen teardown. Lockstep with src/snes.h. */
/* WiFi-in-menu commands RESERVED for the Companion port (lockstep with src/snes.h):
   WiFi owns $30-$33, so game-info lives at $34-$37. No menu/MCU handler in this
   branch -- reserved so adding WiFi later needs zero command renumbering. */
#define CMD_WIFI_SCAN               $30 /* RESERVED (Companion): queue an AP scan on the ESP */
#define CMD_WIFI_GET                $31 /* RESERVED (Companion): write current status + scan list to WIFI_BLK */
#define CMD_WIFI_CONNECT            $32 /* RESERVED (Companion): connect using ssid/pass written to WIFI_BLK */
#define CMD_WIFI_FORGET             $33 /* RESERVED (Companion): forget the saved network */
#define CMD_GAME_INFO               $34 /* parse /sd2snes/info/<rom>.yml + stage cover/screenshot (non-booting, like LOAD_COVER) */
#define CMD_GAME_INFO_RECENT        $35 /* GAME_INFO for the recent game at MCU_PARAM index (LAST_FILE) */
#define CMD_GAME_INFO_FAVORITE      $36 /* GAME_INFO for the favorite game at MCU_PARAM index (FAVORITES_FILE) */
#define CMD_FMV_NEXT                $37 /* info-screen FMV pump: stream next <rom>.fmv frame into GI_TILES ($CA0000) for the menu to re-DMA (gameinfo_fmv_next); non-booting */
#define CMD_GI_DESC_FULL            $38 /* stage the full (untruncated) description into GI_DESC_EXT ($FF7600) NUL-term; non-booting */
#define CMD_RESTORE_CLASSIC         $39 /* apply /sd2snes/classic.thm (the pre-2.16 baked look), reload menu; NACK ($aa) if the file is missing */
#define SFX_MAILBOX                 $002BE0 /* fork: menu sound effects mailbox (sfx.a65 <-> MCU menu loop). Value = effect+1 (1-4: cursor/confirm/back/error), 0 = consumed. DEDICATED byte: sharing MCU_CMD raced the real commands. NOT $2A08: MCU_PARAM is a 12-BYTE region ($2A04-$2A0F, settime writes +11) - parking there corrupted cover requests and saved garbled favorites. $2BE0 sits in the unreferenced $2BB4-$2BEF gap. Newest-wins, fire-and-forget. */

/* WiFi status/scan block + connect params, RESERVED for the Companion port.
   Own dedicated 437-byte block ($FF4000..$FF41B5) in the free gap left by the old
   favorites slot ($FF4000..$FF49FF, vacated when favorites moved to $FF6000) -- no
   longer aliases SYSINFO_BLK, so the WiFi and sysinfo screens can coexist. Layout
   MUST match src/snes.h WIFI_OFF_* (lockstep with SRAM_WIFI_ADDR in src/memory.h). */
#define WIFI_BLK                    $FF4000
#define WIFI_OFF_CONNECTED          0    /* u8 */
#define WIFI_OFF_RSSI               1    /* i8 */
#define WIFI_OFF_SSID               2    /* char[33] */
#define WIFI_OFF_IP                 35   /* char[16] */
#define WIFI_OFF_SCAN_CNT           51   /* u8 */
#define WIFI_OFF_SCAN_SEQ           52   /* u8 */
#define WIFI_OFF_APS                53   /* scan_cnt * {i8 rssi, u8 enc, char ssid[33]} */
#define WIFI_AP_STRIDE              35
#define WIFI_OFF_REQ_SSID           340  /* char[33] - menu writes (CONNECT) */
#define WIFI_OFF_REQ_PASS           373  /* char[64] - menu writes (CONNECT) */

/* IPS/BPS patch list staged by the MCU (ips_find_patches).  Layout, region
   $FF5000..$FF5F1F, below FAVORITE_GAMES $FF6000:
     +0                                u8  num_patches
     +IPS_NAME_BASE + N*IPS_NAME_LEN   48B display slot: name (NUL-term) at +0,
                                           "IPS"/"BPS" badge at +IPS_NAME_BADGE
     +IPS_FLAGS_BASE + N               u8  flags: bits0-1 type (0 IPS, 1 BPS),
                                           bits2-3 header mode (0 auto, 1 headered,
                                           2 headerless)
     +800 (MCU only)                       full SD paths, 16*192
   The display name arrives already resolved (yml Name: override or the cleaned
   suffix after the ROM stem) so the menu only renders.  The flags byte is the
   one field the menu also WRITES -- left/right on the patch screen cycles the
   header mode, and patchsel_persist_meta hands it back via CMD_PATCH_META_SAVE.
   Lockstep with src/patch.h (offsets) and src/memory.h (region comment). */
#define IPS_LIST                    $FF5000  /* IPS patch list written by MCU */
#define IPS_NAME_BASE               16       /* offset of the first display slot */
#define IPS_NAME_LEN                48       /* bytes per display slot */
#define IPS_NAME_BADGE              42       /* badge offset inside a display slot */
#define IPS_FLAGS_BASE              784      /* offset of the per-patch flag bytes */
#define IPS_MAX_PATCHES             16       /* maximum patches per ROM */
#define IPS_NAMES                   $FF5010  /* = IPS_LIST + IPS_NAME_BASE, spelled out because snescom will not size-infer an immediate like #(!IPS_LIST + IPS_NAME_BASE) */
#define IPS_FLAGS                   $FF5310  /* = IPS_LIST + IPS_FLAGS_BASE, spelled out so it can be indexed (lda @IPS_FLAGS,x) */
#define LOAD_NACK                   $FF071D /* 1 = the MCU refused this game load (missing chip BIOS / unimplemented chip). The $aa it also writes to SNES_CMD is TRANSIENT -- the menu loop re-arms MCU_CMD_RDY ($55, which doubles as the ACK) microseconds later -- so it cannot be observed by a poll that starts after the iris animation. This byte is written BEFORE that $aa and never re-armed, so game_handshake can test it at its leisure. Cleared by the SNES right before it sends the load command. Lockstep with SRAM_LOAD_NACK_ADDR in src/memory.h. */
#define EXPORT_RESULT               $FF071E /* "create patched ROM" outcome, shown after the menu reload: 0 none, 1 written, 2 failed, 3 written but a sidecar that existed did not copy, 4 refused because the .sfc already exists (checked before anything ran; delete the old file first to regenerate). Values are the PATCH_EXPORT_* constants in src/patch.h. The export holds the SNES in reset the whole time, so this is the only way to tell the user anything. Read+cleared by export_result_check (snes/patch.a65) once the browser has repainted. Lockstep with SRAM_EXPORT_RESULT_ADDR in src/memory.h. */
#define PATCH_HDR_SEL               $FF071C  /* scratch byte the patch context menu edits as a plain 0/1/2 header mode (MTYPE_VALUE + kv_patch_hdrmode); patchsel_contextmenu seeds it from the patch's flags byte and folds the result back. Free $FF0701..$FF07FF gap, after SS_STAGED_SLOT. Lockstep with SRAM_PATCH_HDR_SEL_ADDR in src/memory.h. */
#define PATCH_FLAG_TYPE_MASK        $03
#define PATCH_TYPE_BPS              $01
#define PATCH_FLAG_HDR_MASK         $0c
#define PATCH_FLAG_HDR_CLR          $f3      /* ~PATCH_FLAG_HDR_MASK */
#define PATCH_HDR_AUTO              $00
#define PATCH_HDR_HEADERED          $04      /* mode 1 << 2, pre-shifted */
#define PATCH_HDR_HEADERLESS        $08      /* mode 2 << 2, pre-shifted */
#define CMD_SAVESTATE               $40
#define CMD_LOADSTATE               $41
#define CMD_CHEAT_REPROGRAM         $42 /* in-game cheat overlay: reconcile BSRAM flag mirror ($FF0500) into canonical records + re-deploy cheats live */
#define CMD_MCU_RDY                 $55
#define CMD_RESET                   $80
#define CMD_RESET_TO_MENU           $81
#define CMD_ENABLE_CHEATS           $82
#define CMD_DISABLE_CHEATS          $83
#define CMD_KILL_NMIHOOK            $84
#define CMD_TEMP_KILL_NMIHOOK       $85
#define CMD_RESET_LOOP_FAIL         $88
#define CMD_RESET_LOOP_PASS         $89
#define CMD_RESET_LOOP_TIMEOUT      $8A
#define CMD_COMBO_TRANSITION        $90


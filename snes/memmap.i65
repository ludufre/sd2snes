#define CFG_BUS_COMPAT                  CFG_ADDR+$0144 /* bus-timing compat: narrow databus window (v1.11.0) for timing-sensitive 1-CHIP consoles; drives featurebits[13]; lockstep with src/cfg.h */
#define CFG_ENABLE_SRAM_SLOTS           CFG_ADDR+$0146 /* multi-slot battery SRAM -- ALWAYS ON since 2.15 (the EnableSramSlots YAML flag + menu toggle were retired; cfg.c forces the byte to 1, kept at $0146 for offset stability). The SAVES tab is the 4-slot selector. Lockstep with src/cfg.h. */

#define MENU_ENTRY_SIZE             23
#define PATCHSEL_VISMAX             15 /* max patch-selector rows shown at once (incl. the "[No patch]" row). NOT IPS_MAX_PATCHES+1: window_h = vis+4, and the window cannot start above row 9 -- rows 0..8 are the baked logo, which the per-frame DMA never re-uploads for BG1 (do_screen_dma, snes/reset.a65). 9 + (15+4) = 28 exactly, so 15 is the tallest that still ends inside the 28-row screen. With 16 patches the list therefore scrolls and listsel_scrollbar finally draws. */
#define FAV_VISMAX                  13/* max favorites rows shown at once (window at last_win_y=12 -> rows 12..26, status bar 27); the rest scroll */
#define MENU_VISMAX                 12 /* settings menu (show_menu): max entry rows shown before the viewport scrolls. Deepest scrolling submenu opens at window_y=13 (mm 11 -> cfg 12 -> submenu 13); window_h=(vis-1)*step+3 so bottom=window_y+vis+1 -> vis=12 is the max that keeps the bottom border at row 26 (status bar = 27); the description box then shows ABOVE (rows 9..12). Must be >= the largest CURRENTLY-fitting menu's entry count (cfg=10) so those never start scrolling. Do NOT raise above 12, and keep scrolling menus at window_y<=13. */


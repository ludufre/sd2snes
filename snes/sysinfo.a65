.link page $c0
#include "memmap.i65"

; sysinfo.a65: display sysinfo text block
.byt "===SHOW_SYSINFO==="
show_sysinfo:
  php
  sep #$20 : .as
  rep #$10 : .xl
  stz bar_wl
  dec bar_wl
  stz bar_xl
  dec bar_xl
  stz bar_yl
  dec bar_yl
  lda #^mtext_mm_sysinfo
  sta window_tbank
  ldx #!mtext_mm_sysinfo
  stx window_taddr
  lda @sysinfo_win_x
  sta window_x
  stz print_x+1
  lda @sysinfo_win_y
  sta window_y
  stz print_y+1
  lda @sysinfo_win_w
  sta window_w
  lda @sysinfo_win_h
  sta window_h
  jsr push_window
  jsr draw_window
  stz print_pal

  ldx #38
copy_snes_system_text:
  lda @text_system,x
  sta @snes_system_config,x
  dex
  bpl copy_snes_system_text

  ; The screen is composed by si_render_all (snes/sysinfo_render.a65, bank $C1) out of
  ; the BINARY block the MCU publishes in SYSINFO_BLK plus localized templates. This
  ; clears the grace counter it uses to decide when a firmware is too old to publish
  ; that block at all.
  jsl @si_render_reset

sysinfo_printloop:
  sep #$20 : .as
  rep #$10 : .xl
  lda #CMD_SYSINFO
  sta @MCU_CMD
- lda @SNES_CMD
  cmp #CMD_SYSINFO
  bne -
  jsl @si_render_all

  ldx #17
  lda $213e
  and #$0f
  clc
  adc #$30
  sta @snes_system_config,x

  ldx #19
  lda $213f
  and #$0f
  clc
  adc #$30
  sta @snes_system_config,x

  ldx #15
  lda $4210
  and #$0f
  clc
  adc #$30
  sta @snes_system_config,x

  ldx #35
  lda $213f
  eor #$10
  and #$10
  adc #$f0
  lda #$35
  adc #$00
  sta @snes_system_config, x

  lda #^snes_system_config ; System text
  ldx #!snes_system_config
  sta print_bank
  stx print_src
  stz print_pal
  lda #39
  sta print_count
  lda #23
  sta print_y
  lda #12
  sta print_x
  jsr hiprint
  ; (the hardware model line below this one is drawn by si_render_all)

- lda isr_done
  lsr
  bcc -
  jsr printtime
  jsr read_pad
  lda pad_b
  ora pad_a
  bne +
  jmp sysinfo_printloop
+ plp
  jsr snd_fx_back       ; leaving the System Information screen
  lda #CMD_MCU_RDY
  sta @MCU_CMD
- cmp @SNES_CMD
  bne -
  jsr pop_window
  rtl

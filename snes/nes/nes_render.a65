; nes_render.a65 -- nucleo COMPARTILHADO de decode/conversao/apply do renderer
; NES->SNES (Fase 1b). Roda IDENTICO no device real e no harness bsnes-plus;
; a UNICA coisa que difere entre os dois e' o "transporte" (quem preenche
; nes_parse_ptr/nes_parse_bank/nes_parse_len antes de chamar
; nes_process_frame -- ver nes_transport_device.a65 no device e
; nes_transport_harness.a65 no harness).
;
; INVARIANTE DE ORCAMENTO (NES-BRIDGE-SPEC SS1.4, NAO regredir): tudo neste
; arquivo (parse TLV + conversao NES->SNES) roda no DISPLAY ATIVO. O DMA de
; verdade p/ VRAM/OAM/CGRAM (nes_apply_vblank) roda SEPARADO, chamado so
; durante o V-Blank (pela NMI do topo -- nes_snes.a65/harness_main.a65).
; Nunca junte os dois: decode no vblank colapsa o orcamento de ~6KiB p/ ~3KiB.
;
; FAIL-SAFE (bounded, nunca trava): o parser TLV e' limitado por
; nes_parse_len (nunca le alem do frame declarado); opcode desconhecido =
; aborta o frame (para de consumir, mantem o que ja foi aplicado -- sem
; rollback, decisao de projeto documentada); CMD_NT_RUN nunca escreve fora
; de @nes_nametable_shadow (clampado em offset 0x400, banco B descartado).
;
; LIMITACAO DE V1 (documentada, nao e' bug): so o banco FISICO A da CIRAM
; (nt_off 0x000-0x3FF) e' renderizado -- BG1 e' um UNICO screen SNES 32x32
; (REG_BG1SC_VAL=$00). O endereco logico NES $2000 SEMPRE resolve pro banco
; fisico A (CIRAM_A10=0 tanto em mirror horizontal quanto vertical, e' fixo
; pelo proprio PPU) -- entao qualquer jogo que nunca troque de nametable via
; PPUCTRL (nt_select sempre 0, ex. Donkey Kong) renderiza CORRETO com essa
; simplificacao. Jogos com scroll multi-banco (Excitebike/Ice Climber/SMB1)
; mostrariam so o banco A parado -- correto ate a Fase 1c implementar
; 64x32/32x64 + um bit de mirroring que a spec AINDA NAO carrega no control
; block (pendencia registrada no relatorio final).

.link page $00
#include "nes_equates.i65"
#include "nes_palette.i65"

; ============================================================
; nes_process_frame -- consome o frame TLV apontado por
; nes_parse_ptr/nes_parse_bank, comprimento nes_parse_len (todos setados
; pelo transporte ANTES de chamar). Preenche @nes_nametable_shadow/
; @nes_tilemap_shadow/@nes_oam_shadow/nes_cgram_*_shadow/nes_regs_*
; incrementalmente. Seta @nes_nt_dirty/@nes_pal_dirty/@nes_frame_valid. Roda
; 100% no display ativo (chamador garante isso). NAO mexe em VRAM/OAM/CGRAM
; de verdade (isso e' nes_apply_vblank, chamado separado no vblank).
;
; Chamada: jsl nes_process_frame (sem parametros em registrador).
; ============================================================
nes_process_frame:
        php
        rep #$30 : .al : .xl
        lda #$0000
        sta nes_parse_consumed
        sep #$20 : .as
        ; "stz @long" nao existe no 65816 (STZ so' tem dp/abs/abs,x) --
        ; usa LDA#0 + STA long em cada um.
        lda #$00
        sta @nes_nt_dirty
        sta @nes_pal_dirty
        sta @nes_frame_valid
        rep #$20 : .al
        sta @nes_nt_facc         ; v2.12: bytes de CMD_NT_RUN neste frame
        sta @nes_nt_fcells       ; v2.13 F-8: ORCAMENTO de conversao do frame
        jsr nes_nt_frame_budget  ; v2.14: ... e o TETO dele, medido no RASTER
        lda #$0000               ; a rotina DEVOLVE o teto em A e os dois STA
                                 ; abaixo consomem o zero da cadeia de init --
                                 ; sem isto split_pend/cspl_pend nascem com
                                 ; (teto & $FF) != 0 e a NMI arma o HDMA ch2/
                                 ; ch3 com tabela STALE em frame sem split
        sep #$20 : .as
        sta @nes_split_pend      ; v1.3: splits sao POR FRAME (transientes)
        sta @nes_cspl_pend       ; v2.3: idem p/ o raster-split de CHR (frame
                                  ; sem CMD_CHR_SPLITS = tabela de tile-base
                                  ; ausente => canal 3 fica OFF nesse frame)
        rep #$10 : .xl

npf_loop:
        rep #$20 : .al
        lda nes_parse_consumed
        cmp nes_parse_len
        sep #$20 : .as
        bcc npf_have_more       ; consumed < len -> continua
        lda #$01
        sta @nes_frame_valid     ; consumiu o frame inteiro sem abortar
        bra npf_finish

npf_have_more:
        ldy #$0000
        lda [nes_parse_ptr],y   ; opcode
        cmp #CMD_NOP
        beq npf_op_nop
        cmp #CMD_FRAME_HDR
        beq npf_op_hdr
        cmp #CMD_REGS
        beq npf_op_regs
        cmp #CMD_SPLITS
        beq npf_op_splits
        cmp #CMD_CHR_STATE
        beq npf_op_chrstate
        cmp #CMD_CHR_SPLITS
        beq npf_op_chrsplits
        cmp #CMD_CHR_STATE8
        beq npf_op_chrstate8
        cmp #CMD_CHR_SPLITS8
        beq npf_op_chrsplits8
        cmp #CMD_PALETTE
        beq npf_op_pal
        cmp #CMD_PALETTE_FULL
        beq npf_op_palfull
        cmp #CMD_NT_RUN
        beq npf_op_ntrun
        cmp #CMD_CHR_BANK
        beq npf_op_chrbank
        cmp #CMD_CHR_RUN
        beq npf_op_chrrun
        cmp #CMD_OAM
        beq npf_op_oam
        cmp #CMD_FRAME_DONE
        beq npf_op_done
        ; opcode desconhecido -- fail-safe: aborta o frame (@nes_frame_valid
        ; fica 0), mantem tudo que ja foi aplicado (sem rollback).
        ; v2.11 INSTRUMENTO: o aborto tambem era silencioso. Um
        ; byte corrompido no dreno da mailbox aparece PRIMEIRO aqui (o
        ; parser perde o alinhamento) -- contar separa transporte de logica.
        rep #$20 : .al
        lda @nes_dbg_badop
        inc
        sta @nes_dbg_badop
        sep #$20 : .as
        bra npf_finish

npf_op_nop:
        ldx #$0001
        bra npf_advance
npf_op_hdr:
        jsr nes_handle_hdr        ; v1.1: deriva o NT arrangement (flags[5:4])
        ldx #$0006
        bra npf_advance
npf_op_regs:
        jsr nes_handle_regs
        ldx #$0008
        bra npf_advance
npf_op_splits:
        jsr nes_handle_splits    ; v1.3: devolve o tamanho (2+4*cnt) em X
        bra npf_advance
npf_op_pal:
        jsr nes_handle_palette   ; devolve o tamanho total do comando em X
        bra npf_advance
npf_op_palfull:
        jsr nes_handle_palette_full
        ldx #$0021
        bra npf_advance
npf_op_ntrun:
        jsr nes_handle_nt_run    ; devolve o tamanho total do comando em X
        bra npf_advance
npf_op_chrbank:
        ldx #$0003               ; v2.2: ADVISORY (o estado vem do CHR_STATE)
        bra npf_advance
npf_op_chrstate:
        jsr nes_chr_handle_state ; v2.2: reconciliador idempotente
        ldx #$0004
        bra npf_advance
npf_op_chrsplits:
        jsr nes_chr_handle_splits ; v2.3: devolve o tamanho (2+2*cnt) em X
        bra npf_advance
npf_op_chrstate8:
        jsr nes_chrw_handle_state ; v2.3w: vetor de 8 janelas de 1KB (mapper 4)
        ldx #$000a
        bra npf_advance
npf_op_chrsplits8:
        jsr nes_chrw_handle_splits ; v2.3w: devolve o tamanho (2+9*cnt) em X
        bra npf_advance
npf_op_chrrun:
        jsr nes_chr_handle_run    ; v2.2-lite (CHR-RAM): estagia o payload;
        bra npf_advance           ; devolve o tamanho (4+len) em X
npf_op_oam:
        jsr nes_handle_oam
        ldx #$0101                ; 257
        bra npf_advance
npf_op_done:
        ldx #$0002
        bra npf_advance

npf_advance:
        ; X = tamanho do comando que acabou de ser processado. Avanca o
        ; ponteiro (nes_parse_ptr) e o contador (nes_parse_consumed) pelo
        ; mesmo valor -- X sobrevive aos jsr acima (nenhum handler o usa
        ; como scratch; todos usam Y p/ indexar campos).
        rep #$20 : .al
        txa
        clc
        adc nes_parse_ptr
        sta nes_parse_ptr
        txa
        clc
        adc nes_parse_consumed
        sta nes_parse_consumed
        sep #$20 : .as
        bra npf_loop

npf_finish:
        ; v1.5.1: o commit da tabela HDMA (v1.3, nes_hdma_commit) virou parte
        ; do COMMIT DO FRAME BUFFER: nes_fb_commit snapshota OAM/CGRAM/regs +
        ; grava nes_split_pend em fb_regs[t]+12 e publica nes_fb_pending (1
        ; byte = atomico). A NMI le TUDO do buffer commitado.
        ; --- v2.8: a conversao da tilemap tambem sai do caminho critico
        ;     durante um despejo de CHR-RAM com a tela do NES apagada.
        ;     MEDIDO (tb_oneshot, trace real do Mega Man): so' o fix do CHR
        ;     deixa 1802 B / 133 tiles perdidos, porque a entrega da CIRAM
        ;     INTEIRA (2048 B) custa ~1920 celulas x ~360 master = ~2 FRAMES
        ;     de CPU e e' ela que segura o ACK enquanto o ring da bridge
        ;     enche. Com os dois adiamentos: 0 B, 0 tiles, 0 celulas.
        ;     nes_nt_dirty NAO serve de pendencia -- ele e' ZERADO no topo do
        ;     nes_process_frame (flag POR FRAME); a divida fica no
        ;     nes_chrfd_ntdef, que sobrevive ao frame.
        lda @nes_nt_dirty
        beq npf_nt_owed
        jsr nes_chrfd_ntdefer_frame
        bcc npf_nt_go
        lda #$01
        sta @nes_chrfd_ntdef       ; fica devendo a conversao GLOBAL
        bra npf_no_nt
npf_nt_owed:
        lda @nes_chrfd_ntdef
        beq npf_no_nt
        jsr nes_chrfd_ntdefer_frame
        bcs npf_no_nt              ; ainda em despejo: continua devendo
npf_nt_go:
        ; v2.13 F-8: o pass e' FATIADO -- carry SET = COMPLETO (limpa a
        ; divida e conta o breadcrumb), carry CLEAR = fatia PARCIAL (a divida
        ; sobrevive ao frame e o proprio ramo npf_nt_owed re-entra aqui no
        ; frame seguinte). sep/rep e rts nao mexem no carry; o bcc abaixo e' o
        ; PRIMEIRO consumidor da flag.
        jsr nes_convert_nametable
        bcc npf_nt_owe
        rep #$20 : .al             ; v2.12 instrumento: cada pass global
        lda @nes_dbg_ntglob        ; custa ~1920 celulas (agora fatiadas)
        inc
        beq npf_ntg_sat
        sta @nes_dbg_ntglob
npf_ntg_sat:
        sep #$20 : .as
        lda #$00
        sta @nes_chrfd_ntdef
        bra npf_no_nt
npf_nt_owe:
        sep #$20 : .as
        lda #$01
        sta @nes_chrfd_ntdef       ; fatia parcial: continua devendo
npf_no_nt:
        jsr nes_fb_commit
        jsr nes_chrq_publish       ; v2.2-lite: publica a fila de CHR-RAM p/ a
                                    ; NMI. Fica FORA do fb_commit de proposito
                                    ; -- o commit e' PULADO quando ja' existe
                                    ; frame pendente (nfc_skip) e a fila nao
                                    ; pode ser descartada junto (os bytes de
                                    ; CHR-RAM nao sao cumulativos como os
                                    ; masters de NT/OAM/CGRAM: o bitmap de
                                    ; sujeira do RTL ja' foi limpo, run
                                    ; perdido = tile errado PARA SEMPRE).
        plp
        rtl

; ============================================================
; nes_handle_hdr -- CMD_FRAME_HDR (v1.1): le flags (Y=5) e deriva o NT
; ARRANGEMENT (bits 5:4 -- lockstep com bridge_sim/mailbox.py NTARR_* e
; nes_bridge.v): 0=H (banco0=topo/screen0, banco1=base/screen1; BG1SC
; 32x64), 1=V (banco0=esq, banco1=dir; 64x32), 2=single-lower (so banco0,
; 32x32), 3=single-upper (so banco1 -> screen0, 32x32). Roda TODO frame
; (barato); mudanca em runtime (mappers dinamicos: MMC1/AOROM) rederiva
; dstoff/bankmask/bg1sc e forca reconversao GLOBAL (nt_dirty) -- raro.
; Nao mexe em X (o dispatcher poe o tamanho DEPOIS do jsr).
; ============================================================
nes_handle_hdr:
        sep #$20 : .as
        rep #$10 : .xl
        ldy #$0005
        lda [nes_parse_ptr],y    ; flags
        pha                       ; v2.0a: guarda flags p/ o bit0 (forced-blank)
        and #FLAG_FORCED_BLANK    ; b0=forced-blank recomendado (payload>orcamento).
        sta @nes_chr_frame_fb     ; lido pelo CMD_CHR_BANK p/ escolher full x slice
        pla
        lsr : lsr : lsr : lsr
        and #$03                 ; arrangement (0-3)
        cmp @nes_ntarr
        bne nhh_changed
        rts                      ; inalterado (caso quente): nada a fazer
nhh_changed:
        sta @nes_ntarr
        pha                      ; guarda o arrangement (8-bit push/pull casados)
        lda #$01
        sta @nes_nt_dirty        ; re-deriva a tilemap inteira no fim do frame
        ; v2.13 F-8 (item D): o ARRANJO muda nes_cr_dstoff e nes_cr_bankmask,
        ; que o pass FOTOGRAFA POR FATIA. Com um pass em voo, a metade ja'
        ; convertida ficaria no screen errado PARA SEMPRE (o cursor nunca
        ; volta). Reinicia o pass e limpa a marca d'agua.
        jsr nes_nt_gcur_reset
        ; defaults (H/V/single-lower): dstoff=0, ambos os bancos
        rep #$20 : .al
        lda #$0000
        sta nes_cr_dstoff
        sep #$20 : .as
        lda #$03
        sta nes_cr_bankmask
        pla
        cmp #NTARR_V
        beq nhh_v
        cmp #NTARR_1L
        beq nhh_1l
        cmp #NTARR_1H
        beq nhh_1h
        ; H (0): 2 screens empilhados -> BG1SC size 2 (32x64)
        lda #$02
        sta @nes_regs_bg1sc
        rts
nhh_v:
        lda #$01                 ; 64x32 (lado a lado)
        sta @nes_regs_bg1sc
        rts
nhh_1l:
        lda #$00                 ; 32x32, so banco0 -> screen0
        sta @nes_regs_bg1sc
        lda #$01
        sta nes_cr_bankmask
        rts
nhh_1h:
        lda #$00                 ; 32x32, so banco1 -> screen0 (dst -2048)
        sta @nes_regs_bg1sc
        lda #$02
        sta nes_cr_bankmask
        rep #$20 : .al
        lda #$f800               ; -2048: 2*phys(1024..) - 2048 = 0..2046
        sta nes_cr_dstoff
        sep #$20 : .as
        rts

; ============================================================
; nes_handle_regs -- CMD_REGS (Y=0 opcode; campos em Y=1..7). Copia direto
; p/ nes_regs_* (staged; so vira BG1HOFS/VOFS de verdade no vblank, ver
; nes_apply_vblank). Chamada com A=8bit,X/Y=16bit (invariante do loop TLV).
; ============================================================
nes_handle_regs:
        rep #$20 : .al
        ldy #$0001
        lda [nes_parse_ptr],y
        sta @nes_regs_scrollx
        ldy #$0003
        lda [nes_parse_ptr],y
        sta @nes_regs_scrolly
        sep #$20 : .as
        ldy #$0005
        lda [nes_parse_ptr],y
        ; BUG DE SEMANTICA PEGO EM HARDWARE (iteracao 5, DK Redux: sprites
        ; certos + BG todo errado): o PPUCTRL bit4 (BG pattern table select)
        ; era IGNORADO -- todo tile de BG saia da metade $0000 da CHR mesmo
        ; com o jogo usando a metade $1000 (DK Redux seta bit4=1 em TODO
        ; frame). O harness NAO pegou porque o verify_model tinha o MESMO
        ; mal-entendido (validacao circular) -- so' o hardware/ground-truth
        ; do Mesen revelou. Fix em nes_convert_nametable (soma bg_patt*256
        ; ao indice, a CHR inteira de 512 tiles ja' esta' na VRAM); aqui,
        ; uma MUDANCA do bit4 em runtime forca reconversao da nametable
        ; inteira (nt_dirty=1) -- sem isso a tilemap ficaria stale se o
        ; jogo trocar de pattern table sem reescrever a nametable.
        pha
        eor @nes_regs_ppuctrl
        and #$10
        beq nhr_bgsel_same
        lda #$01
        sta @nes_nt_dirty
        ; v2.13 F-8 (item D): o bit4 do PPUCTRL muda nes_cr_bgbase, que o pass
        ; FOTOGRAFA POR FATIA -- meia tela ficaria na pattern table ERRADA,
        ; permanente. Reinicia o pass e limpa a marca d'agua.
        jsr nes_nt_gcur_reset
nhr_bgsel_same:
        pla
        sta @nes_regs_ppuctrl
        ldy #$0006
        lda [nes_parse_ptr],y
        sta @nes_regs_ppumask
        ldy #$0007
        lda [nes_parse_ptr],y
        sta @nes_regs_ntselect
        rts

; ============================================================
; nes_handle_splits -- CMD_SPLITS (v1.3 multi-scroll): hdr em Y=1 (bit7=
; overflow -- informativo, contrato diz que o frame ja veio coalescido;
; [3:0]=cnt 2..4), entradas de 4B [sl sx sy ntsel] a partir de Y=2. Cada
; entrada vale de sl ate' a proxima; entrada 0 = inicio do display.
;
; Monta (NO DISPLAY ATIVO) a tabela HDMA de BG1HOFS: mode 2 non-repeat,
; [count(1..127), lo, hi]* + $00 -- $210D e' write-twice, o mode 2 escreve
; os 2 bytes no mesmo reg = exatamente o latch duplo. Conversao pro
; viewport: NES sl -> SNES sl-8 (crop; faixa que morre acima do corte e'
; ABSORVIDA -- count 0 nao emite e o valor da ultima entrada com sl<=8
; vale como faixa inicial); faixa >127 linhas vira 2 linhas de tabela.
; HOFS por faixa = sx + (arranjo V && ntsel.b0 ? 256 : 0) -- a MESMA
; formula do HOFS unico v1.2, agora por faixa.
;
; VOFS: continua UNICO por frame, tomado da faixa DOMINANTE (maior
; line-count no viewport) -- sobrescreve nes_regs_scrolly/ntselect (o
; SPLITS vem DEPOIS do REGS na ordem canonica, entao e' um refinamento
; do snapshot mid-display; VOFS por faixa exigiria um 2o canal em $210E
; + interacao gap/crop por faixa -- adiado, documentado no relatorio).
;
; Escreve no buffer INATIVO (double-buffer, ver nes_hdma_tab0/1 em
; nes_data.a65) e seta nes_split_pend = id do buffer; o COMMIT pra NMI
; acontece so' no fecho do frame (npf_finish). Devolve tamanho em X.
; ============================================================
nes_handle_splits:
        sep #$20 : .as
        rep #$10 : .xl
        ldy #$0001
        lda [nes_parse_ptr],y
        and #$0f
        sta nes_sp_cnt
        cmp #$02
        bcs nhs_go
        rep #$20 : .al            ; v1.5: cnt<2 = sem splits -> zera prev_cnt
        lda #$0000                ; (deadband comeca fresh no proximo frame
        sta @nes_sp_prev_cnt      ; que tiver splits). @ OBRIGATORIO: banco
                                   ; $7F (o sta ABSOLUTO da v1.5.0 escrevia
                                   ; $00:3Bxx/open bus em silencio -- o
                                   ; sneslink linka sem erro; foi o bug que
                                   ; desarmou a histerese inteira no device)
        sep #$20 : .as
        brl nhs_size              ; cnt<2 (defensivo): frame sem splits
nhs_go:
        cmp #$05
        bcc nhs_cnt_ok
        lda #$04                  ; clamp K<=4 (contrato)
        sta nes_sp_cnt
nhs_cnt_ok:
        ; v1.5.1: a tabela HDMA segue o FRAME BUFFER alvo (target 1 -> tab0,
        ; 2 -> tab1). O display NUNCA le tab0/tab1 diretamente -- ele le a
        ; nes_hdma_live (copiada pelo NMI ao aplicar) => zero hazard de
        ; overwrite mid-display, e o alvo (≠ pending, por nes_fb_select) so'
        ; pode ser um buffer ja consumido/morto.
        rep #$10 : .xl
        ldx #!nes_hdma_tab0
        stx nes_sp_tab
        lda @nes_fb_target
        cmp #$02
        bne nhs_buf_ok            ; target 1 (ou boot) -> tab0
        ldx #!nes_hdma_tab1
        stx nes_sp_tab
nhs_buf_ok:
        lda #^nes_hdma_tab0
        sta nes_sp_tabb
        rep #$20 : .al
        lda #$0000
        sta nes_sp_maxc
        sta nes_sp_off
        sta nes_sp_idx            ; v1.5: indice de entrada (byte-offset) = 0
        lda #$0002
        sta nes_sp_y              ; offset da 1a entrada no payload
        sep #$20 : .as
        ; --- v1.5.1 Sintoma B PRE-PASS (DEADBAND): snap da scanline de
        ;     fronteira de CADA entrada em nes_sp_snap[idx] ANTES de montar
        ;     as faixas. A fronteira entre a banda j e j+1 e' UMA so'
        ;     (aparece como S1 da banda j E S0 da banda j+1); a fronteira NA
        ;     TELA e' definida pelo COUNT da banda anterior (= S1_j), entao
        ;     snapar so' o S0 nao travaria nada. Snapando 1x aqui e lendo do
        ;     MESMO array nos dois papeis, a fronteira trava de verdade.
        ;     REGRA (validada no trace real inteiro -- ver nota longa em
        ;     nes_data.a65): |sl - emitida_anterior| <= 1 -> mantem a
        ;     anterior (para sempre); >= 2 -> adota (mudanca real). SEM
        ;     condicao de hofs (nunca engatava: o scroll da banda muda todo
        ;     frame). Guarda a EMITIDA (nao a crua), senao 57<->58 voltaria
        ;     a alternar. prev_*/snap em WRAM $7F -> TODO acesso LONG (@). ---
        lda nes_sp_cnt
        sta nes_sp_pcnt           ; contador do pre-pass (preserva nes_sp_cnt)
nhs_pre_loop:
        rep #$10 : .xl
        ldy nes_sp_y
        lda [nes_parse_ptr],y     ; sl raw da entrada
        rep #$20 : .al
        and #$00ff
        sta nes_sp_slraw
        lda nes_sp_idx
        cmp @nes_sp_prev_cnt      ; @ OBRIGATORIO (banco $7F -- ver nhs_go)
        bcs nhs_pre_store         ; idx >= prev_cnt: entrada nova -> adota raw
        tax                       ; X = byte-offset da entrada (0,2,4,6)
        lda nes_sp_slraw
        sec
        sbc @nes_sp_prev_sl,x     ; dsl = raw - emitida_anterior
        bcs nhs_pre_pos
        eor #$ffff
        inc                       ; abs (complemento de 2)
nhs_pre_pos:
        cmp #$0002
        bcs nhs_pre_store         ; |dsl| >= 2: layout real moveu -> adota raw
        lda @nes_sp_prev_sl,x     ; |dsl| <= 1: DEADBAND -> mantem a emitida
        sta nes_sp_slraw
nhs_pre_store:
        ldx nes_sp_idx
        lda nes_sp_slraw          ; = valor EMITIDO desta entrada
        sta @nes_sp_prev_sl,x     ; deadband do proximo frame ancora no EMITIDO
                                   ; CRU (sem o atraso) -- a histerese fica
                                   ; byte-identica a' v1.5.1
        cpx #$0000                ; entrada 0 = ESTADO no inicio do display,
        beq nhs_pre_snap          ; nao e' mudanca -> nao atrasa
        clc                        ; v2.13: o efeito de um $2005/$2000 so' vale
        adc #NES_SPLIT_EFF_DELAY  ; da PROXIMA scanline (copia horizontal de
                                   ; t->v no dot 257) -- ver o equate
nhs_pre_snap:
        sta @nes_sp_snap,x        ; build le daqui (S0 e S1, 2 papeis)
        lda nes_sp_idx            ; avanca entrada: idx+=2, y+=4
        clc
        adc #$0002
        sta nes_sp_idx
        lda nes_sp_y
        clc
        adc #$0004
        sta nes_sp_y
        sep #$20 : .as
        dec nes_sp_pcnt
        beq nhs_pre_done
        brl nhs_pre_loop
nhs_pre_done:
        rep #$20 : .al            ; prev_cnt = entradas*2 (=idx); reset idx/y
        lda nes_sp_idx
        sta @nes_sp_prev_cnt      ; @ OBRIGATORIO (banco $7F)
        lda #$0000
        sta nes_sp_idx
        lda #$0002
        sta nes_sp_y
        sep #$20 : .as

        ; --- BUILD: monta as faixas com as scanlines SNAPPED do pre-pass ---
nhs_loop:
        rep #$10 : .xl
        rep #$20 : .al
        ldx nes_sp_idx            ; S0 = max(0, snap[idx] - CROP)
        lda @nes_sp_snap,x
        sec
        sbc #VIEWPORT_CROP_Y
        bcs nhs_s0_ok
        lda #$0000                ; acima do corte: comeca na linha 0
nhs_s0_ok:
        sta nes_sp_s0
        sep #$20 : .as
        ldy nes_sp_y              ; re-le sx/sy/ntsel (hofs/VOFS da faixa)
        iny
        lda [nes_parse_ptr],y     ; sx
        sta nes_sp_hofs
        lda #$00
        sta nes_sp_hofs+1
        iny
        lda [nes_parse_ptr],y     ; sy
        sta nes_sp_sy
        iny
        lda [nes_parse_ptr],y     ; ntsel
        sta nes_sp_nt
        lda @nes_ntarr
        cmp #NTARR_V
        bne nhs_hofs_ok           ; so' V tem 2 telas no eixo X (== v1.2)
        lda nes_sp_nt
        and #$01
        beq nhs_hofs_ok
        lda #$01
        sta nes_sp_hofs+1         ; +256: tela logica da direita
nhs_hofs_ok:
        ; S1 = snap[idx+2] croppado (proxima entrada), ou 224 (ultima)
        lda nes_sp_cnt
        cmp #$02
        bcs nhs_have_next         ; cnt>=2 -> ha proxima entrada
        rep #$20 : .al
        lda #224
        sta nes_sp_s1
        bra nhs_count
nhs_have_next:
        rep #$20 : .al
        lda nes_sp_idx
        clc
        adc #$0002
        tax
        lda @nes_sp_snap,x
        sec
        sbc #VIEWPORT_CROP_Y
        bcs nhs_s1_ok
        lda #$0000
nhs_s1_ok:
        sta nes_sp_s1
nhs_count:
        ; count = S1 - S0; 0 (ou negativo, defensivo) = faixa absorvida
        lda nes_sp_s1
        sec
        sbc nes_sp_s0
        beq nhs_next
        bcc nhs_next
        sta nes_sp_c
        ; faixa DOMINANTE -> VOFS unico (sy/ntsel desta faixa)
        cmp nes_sp_maxc
        bcc nhs_not_dom
        sta nes_sp_maxc
        lda nes_sp_sy
        and #$00ff
        sta @nes_regs_scrolly
        sep #$20 : .as
        lda nes_sp_nt
        sta @nes_regs_ntselect
        rep #$20 : .al
nhs_not_dom:
        ; emite a faixa ([count<=127, lo, hi]; >127 divide em 2)
nhs_emit_loop:
        lda nes_sp_c
        cmp #$0080
        bcc nhs_emit_last
        sec
        sbc #$007f
        sta nes_sp_c
        sep #$20 : .as
        lda #$7f
        jsr nhs_emit3
        rep #$20 : .al
        bra nhs_emit_loop
nhs_emit_last:
        sep #$20 : .as
        lda nes_sp_c              ; 1..127 (byte baixo)
        jsr nhs_emit3
nhs_next:
        rep #$20 : .al            ; (textual + runtime: chega .al ou .as)
        lda nes_sp_y
        clc
        adc #$0004
        sta nes_sp_y
        lda nes_sp_idx            ; v1.5: proxima entrada (byte-offset +2) p/
        clc                        ; o build indexar nes_sp_snap corretamente
        adc #$0002
        sta nes_sp_idx
        sep #$20 : .as
        lda nes_sp_cnt
        dec
        sta nes_sp_cnt
        beq nhs_fin
        brl nhs_loop
nhs_fin:
        ; terminator + registra o buffer pro commit do fecho do frame
        phy
        rep #$10 : .xl
        ldy nes_sp_off
        lda #$00
        sta [nes_sp_tab],y
        ply
        lda #$01
        ldx nes_sp_tab
        cpx #!nes_hdma_tab0
        beq nhs_pend_ok
        lda #$02
nhs_pend_ok:
        sta @nes_split_pend
        sta @nes_hdma_sel
nhs_size:
        ; tamanho TLV = 2 + 4*cnt DO HEADER (nao o clampado!)
        rep #$10 : .xl
        ldy #$0001
        lda [nes_parse_ptr],y
        rep #$20 : .al
        and #$000f
        asl : asl                 ; *4
        clc
        adc #$0002
        tax
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nhs_emit3 -- escreve [A(count), hofs_lo, hofs_hi] na tabela corrente
; ([nes_sp_tab],y por nes_sp_off). Entra/sai .as; preserva Y do chamador.
; ------------------------------------------------------------
nhs_emit3:
        phy
        rep #$10 : .xl
        ldy nes_sp_off
        sta [nes_sp_tab],y
        iny
        lda nes_sp_hofs
        sta [nes_sp_tab],y
        iny
        lda nes_sp_hofs+1
        sta [nes_sp_tab],y
        iny
        sty nes_sp_off
        ply
        rts

; ============================================================
; nes_handle_palette -- CMD_PALETTE (count em Y=1; pares idx/col a partir
; de Y=2). Devolve o tamanho TOTAL do comando (2+2*count) em X (16-bit).
; ============================================================
nes_handle_palette:
        sep #$20 : .as             ; declaracao explicita (gotcha .as/.al)
        rep #$10 : .xl
        lda #$01
        sta @nes_pal_dirty
        ldy #$0001
        lda [nes_parse_ptr],y   ; count (0-255)
        sta @nes_hp_count
        lda #$00                ; "stz @long" nao existe -- LDA#0+STA long
        sta @nes_hp_idx
nhp_loop:
        lda @nes_hp_count
        beq nhp_end
        ; offset do par corrente = 2 + idx*2
        lda @nes_hp_idx
        asl
        clc
        adc #$02
        rep #$20 : .al
        and #$00ff
        tay
        sep #$20 : .as
        lda [nes_parse_ptr],y   ; idx (0-31)
        sta @nes_ape_idx_tmp     ; salva em WRAM (nao na pilha -- evita
                                 ; mismatch de largura push/pull)
        iny
        lda [nes_parse_ptr],y   ; nescol (0-63)
        and #$3f
        jsr nes_apply_palette_entry
        ; "inc/dec @long" nao existem -- LDA long + inc/dec(acumulador) + STA long
        lda @nes_hp_idx
        inc
        sta @nes_hp_idx
        lda @nes_hp_count
        dec
        sta @nes_hp_count
        bra nhp_loop
nhp_end:
        ; tamanho total = 2 + 2*count_original. count_original nao esta
        ; mais em @nes_hp_count (zerado pelo loop) -- recompute via @nes_hp_idx
        ; (que terminou == count_original, ja que incrementou 1x por par).
        rep #$20 : .al
        lda @nes_hp_idx
        and #$00ff
        asl
        clc
        adc #$0002
        tax
        sep #$20 : .as
        rts

; ============================================================
; nes_handle_palette_full -- CMD_PALETTE_FULL (32 cores cruas a partir de
; Y=1, idx implicito 0..31). Tamanho fixo (33), quem chama ja sabe.
; ============================================================
nes_handle_palette_full:
        sep #$20 : .as             ; declaracao explicita (gotcha .as/.al)
        rep #$10 : .xl
        lda #$01
        sta @nes_pal_dirty
        lda #$00                 ; "stz @long" nao existe -- LDA#0+STA long
        sta @nes_ape_idx_tmp
        ldy #$0001
nhpf_loop:
        lda [nes_parse_ptr],y
        and #$3f
        jsr nes_apply_palette_entry
        lda @nes_ape_idx_tmp      ; "inc @long" nao existe
        inc
        sta @nes_ape_idx_tmp
        iny
        cpy #$0021
        bne nhpf_loop
        rts

; ------------------------------------------------------------
; nes_apply_palette_entry -- A(8b)=nescol(0-63), @nes_ape_idx_tmp=idx
; NES(0-31). Aplica a LUT NES->BGR555 e escreve no shadow de CGRAM certo
; (BG idx0-15, OBJ idx16-31 -- cor de indice 0 dentro de um grupo OBJ e'
; sempre transparente no NES, escrita mesmo assim, nunca e' mostrada).
; So usa X (nunca Y) -- os chamadores (nes_handle_palette(_full)) usam Y
; como indice de loop, entao Y sobrevive ao jsr sem precisar de push/pull.
; Nescol e' salvo em WRAM (nao na pilha) antes de largar A p/ 16 bits --
; evita o erro classico de push 8-bit / pull 16-bit com larguras diferentes.
; ------------------------------------------------------------
nes_apply_palette_entry:
        sep #$20 : .as             ; declaracao explicita (gotcha .as/.al --
        rep #$10 : .xl              ; nunca confiar no estado herdado da
                                     ; ordem textual do arquivo)
        sta @nes_ape_nescol
        rep #$20 : .al
        lda @nes_ape_nescol
        and #$00ff
        asl                   ; nescol*2 = indice de word na LUT
        tax
        lda @nes_palette_lut,x
        sta @nes_ape_bgr
        sep #$20 : .as

        lda @nes_ape_idx_tmp
        cmp #16
        bcs nape_obj
        ; --- BG: offset = idx*2 dentro de @nes_cgram_bg_shadow ---
        ; BUG REAL PEGO AQUI (achado no gate offline: 13 de 14 pares de um
        ; CMD_PALETTE real ficavam com o shadow intocado, so' o par cujo
        ; BGR555 calhava de ter o byte alto $00 "funcionava"). A LUT lookup
        ; logo acima (linha ~280, "lda @nes_palette_lut,x") roda com A de
        ; 16 bits e deixa o byte alto ESCONDIDO da acumuladora = byte alto
        ; do BGR555 (nao-zero na maioria das cores) quando volta pra 8-bit
        ; (sep #$20:.as, linha ~282). TAX com X de 16 bits copia o
        ; ACUMULADOR INTEIRO (A visivel + o byte alto escondido) -- um AND
        ; de 8-bit (o antigo 'and #$00ff' aqui, com A ainda em .as) NUNCA
        ; toca esse byte escondido, entao X saia com LIXO no byte alto e a
        ; STA seguinte escrevia longe do shadow. Fix: largar A p/ 16-bit
        ; ANTES do and -- so' um AND de 16-bit de verdade zera o byte
        ; escondido.
        rep #$20 : .al
        lda @nes_ape_idx_tmp
        and #$00ff
        asl
        tax
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_ape_bgr
        sta @nes_cgram_bg_shadow,x
        sep #$20 : .as
        rts

nape_obj:
        ; --- OBJ: grupo=(idx-16)>>2, cor=(idx-16)&3;
        ;     offset = grupo*32 + cor*2 ---
        sec
        sbc #16
        sta @nes_ape_scratch      ; = idx-16 (0-15)
        and #$03
        asl                    ; cor*2 (0,2,4,6)
        sta @nes_ape_scratch2
        lda @nes_ape_scratch
        lsr
        lsr                    ; grupo (0-3)
        rep #$10 : .xl
        and #$00ff
        asl : asl : asl : asl : asl  ; grupo*32
        sep #$20 : .as
        clc
        adc @nes_ape_scratch2      ; ainda 8-bit: grupo*32 + cor*2 (0..102)
        ; MESMO BUG do path BG acima (ver nota la): tem que largar A p/
        ; 16-bit ANTES do and -- um and de 8-bit nao zera o byte alto
        ; escondido da acumuladora (que aqui carrega o byte alto do BGR555
        ; lido pela LUT no topo da rotina). 'rep #$10:.xl' sozinho (a
        ; versao antiga) so' afeta X, que ja' e' 16-bit -- nao ajuda em nada.
        rep #$20 : .al
        and #$00ff
        tax
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_ape_bgr
        sta @nes_cgram_obj_shadow,x
        sep #$20 : .as
        rts

; ============================================================
; nes_handle_nt_run -- CMD_NT_RUN (nt_off em Y=1..2, len em Y=3, dados a
; partir de Y=4). Copia p/ @nes_nametable_shadow SOMENTE a parte que cai no
; banco fisico A (offset <0x400) -- banco B e' descartado (v1, ver
; limitacao no cabecalho do arquivo). Devolve o tamanho TOTAL do comando
; (4+len) em X.
;
; MISSAO DE PERF (iteracao 7) -- dois fixes estruturais aqui:
;  1. COPIA via MVN (7 master/byte) no lugar do loop antigo com rep/sep
;     POR BYTE (~264 master/byte, ~37x mais lento). O MVN tem os bancos
;     FIXOS no opcode e a origem varia por transporte -> stub em WRAM
;     (nes_mvn_stub, ver nes_data.a65) com o src-bank patchado aqui.
;  2. CONVERSAO INCREMENTAL: em vez de marcar nes_nt_dirty (reconversao
;     GLOBAL de 960 celulas por QUALQUER run, ate de 3 bytes), converte
;     so o afetado: celulas do run direto + blocos 4x4 dos attr bytes do
;     run. Runs grandes (custo = celulas + 16*attrs > NHN_INCR_MAX_CELLS,
;     tipico de resync/full-redraw) ainda marcam nt_dirty -> UM pass
;     global no fim do frame (mais barato que incremental repetido).
;     Nucleo de conversao UNICO (nes_convert_range) pros dois caminhos --
;     incremental==global por construcao.
; ============================================================
nes_handle_nt_run:
        rep #$20 : .al
        ldy #$0001
        lda [nes_parse_ptr],y   ; nt_off (16-bit)
        sta @nes_hnr_ntoff
        sep #$20 : .as
        ldy #$0003
        lda [nes_parse_ptr],y   ; len (0-255)
        sta @nes_hnr_len

        rep #$20 : .al
        lda @nes_hnr_ntoff
        cmp #$0800                ; v1.1: CIRAM FISICA inteira (2 bancos)
        bcc nhn_in_range
        ; --- v2.11 INSTRUMENTO: este descarte era SILENCIOSO, e
        ;     e' exatamente a unica assinatura compativel com o residual
        ;     "(203,10)" (run de NT que some no device e que a bridge nao
        ;     emite). Contar aqui e' o que separa "a bridge nao emitiu" de
        ;     "o byte chegou corrompido no dreno". ---
        lda @nes_dbg_badrun
        inc
        sta @nes_dbg_badrun
        lda @nes_hnr_ntoff
        sta @nes_dbg_badoff
        brl nhn_copy_done         ; alem da CIRAM -- nada a copiar
nhn_in_range:
        lda #$0800
        sec
        sbc @nes_hnr_ntoff        ; espaco restante na CIRAM
        sta @nes_hnr_room
        sep #$20 : .as
        lda @nes_hnr_len
        rep #$20 : .al
        and #$00ff
        cmp @nes_hnr_room
        bcc nhn_use_len
        lda @nes_hnr_room
nhn_use_len:
        sta @nes_hnr_copylen
        bne nhn_do_copy
        brl nhn_copy_done
nhn_do_copy:
        clc
        adc @nes_hnr_ntoff
        sta @nes_hnr_ntend        ; fim (exclusive) do trecho copiado

        ; --- 1. copia via MVN (stub em WRAM; src-bank do transporte) ---
        sep #$20 : .as
        lda nes_parse_bank
        sta @nes_mvn_stub+2
        phb                       ; MVN deixa DB = banco destino ($7F)
        rep #$30 : .al : .xl
        lda nes_parse_ptr
        clc
        adc #$0004                ; dados do run comecam em +4
        tax                       ; X = offset de ORIGEM
        lda @nes_hnr_ntoff
        clc
        adc #!nes_nametable_shadow
        tay                       ; Y = offset de DESTINO
        lda @nes_hnr_copylen
        dec                       ; MVN move A+1 bytes
        jsl @nes_mvn_stub
        sep #$20 : .as
        plb

        ; --- 1.5 (v2.8) ADIAMENTO. Com um despejo de CHR-RAM em voo e a tela
        ;     do NES APAGADA, converter a tilemap agora nao mostra nada (o
        ;     renderer poe TM=0 = backdrop com rendering off) e custa o CPU
        ;     que mantem o ACK em dia -- 2048 B de CIRAM = ~2 frames de
        ;     conversao, que e' exatamente onde o ring da bridge enchia e ela
        ;     abandonava payload $41. O shadow ja' esta' escrito acima (fonte
        ;     de verdade); a divida vai para nes_chrfd_ntdef e UM pass global
        ;     em npf_finish paga tudo quando o despejo cala ou a tela abre.
        ;     v2.12: o gate virou o predicado COMPARTILHADO
        ;     nes_chrfd_ntdefer (anti-drift com o npf_finish). O acumulador
        ;     nes_nt_facc segue sendo mantido -- ele e' a metrica que o gate
        ;     de fatiamento le, e o teste de TAMANHO que ele habilitava ficou
        ;     FORA (provado INERTE em revisao: para runs > NHN_INCR_MAX_CELLS
        ;     o gate por-run nao decide nada, e o npf_finish desfazia o
        ;     adiamento no MESMO frame pelo ramo bacc == 0).
        rep #$20 : .al
        lda @nes_nt_facc
        clc
        adc @nes_hnr_copylen
        sta @nes_nt_facc
        sep #$20 : .as
        ; v2.13 F-8: o gate de ADIAMENTO desceu para DEPOIS do calculo de
        ; custo -- decidir "run pequeno" por BYTES
        ; (nes_hnr_copylen) contra um teto que e' CUSTO (celulas + 16*attrs)
        ; faz o predicado e o dispatch discordarem: 100 bytes de atributo
        ; custam 1600, nao 100.
nhn_convert:

        ; --- 2. dispatch incremental x global (v1.1: run pode straddlar
        ;     os 2 bancos fisicos -> particiona em ATE' 2 segmentos por
        ;     banco; custo total = soma; cada segmento se divide em
        ;     CELULAS (< banco+$3C0) e ATTRS) ---
        rep #$20 : .al
        lda @nes_hnr_ntoff
        sta nes_hnr_s0s
        lda @nes_hnr_ntend
        cmp #$0400
        bcc nhn_s0e_ok
        lda #$0400
nhn_s0e_ok:
        sta nes_hnr_s0e           ; seg banco0 = [ntoff, min(ntend,$400))
        lda @nes_hnr_ntoff
        cmp #$0400
        bcs nhn_s1s_ok
        lda #$0400
nhn_s1s_ok:
        sta nes_hnr_s1s           ; seg banco1 = [max(ntoff,$400), ntend)
        lda @nes_hnr_ntend
        sta nes_hnr_s1e

        lda #$0000
        sta nes_hnr_bankb
        lda nes_hnr_s0s
        sta nes_hnr_segs
        lda nes_hnr_s0e
        sta nes_hnr_sege
        jsr nhn_seg_cost          ; A = custo do seg0 (.al preservado)
        sta nes_cr_p0             ; scratch (p0 so' vive DENTRO do conversor)
        lda #$0400
        sta nes_hnr_bankb
        lda nes_hnr_s1s
        sta nes_hnr_segs
        lda nes_hnr_s1e
        sta nes_hnr_sege
        jsr nhn_seg_cost
        clc
        adc nes_cr_p0             ; + custo do seg0
        sta @nes_nt_cost          ; v2.13 F-8: o custo REAL deste run
        ; ============================================================
        ; v2.13 F-8 -- ORCAMENTO UNICO POR FRAME.
        ;
        ; No regime ADIAVEL (tela do NES apagada + despejo em voo) o custo do
        ; frame hoje e' ZERO: tudo e' adiado e a divida vira UM pass CAPADO em
        ; 1920 celulas. Converter os runs BARATOS na hora tira a divida do
        ; caminho, mas NHN_INCR_MAX_CELLS e' teto POR RUN: um frame com N runs
        ; pequenos pagaria N x 128 SEM TETO NENHUM. Medido no
        ; corpus: Mega Man 1 f656 = 580 celulas = 0,95 FRAME sozinho (1,37 com
        ; a fatia na mesma janela), metroid 491, ducktales2 400 -- e o MM1 e' a
        ; OUTRA vitima documentada desta classe. Por isso o teto e' do FRAME e
        ; e' COMPARTILHADO com a fatia global: incremental consome primeiro,
        ; fatia leva o resto, e o que nao couber volta a ser ADIADO (com marca
        ; d'agua). A invariante "pior frame <= NES_NT_SLICE" passa a valer POR
        ; CONSTRUCAO, em qualquer jogo -- nao por sorte do corpus.
        ; ============================================================
        sep #$20 : .as
        jsr nes_chrfd_ntdefer     ; carry SET = regime ADIAVEL (.as)
        rep #$20 : .al            ; rep/sep nao mexem em C
        bcc nhn_cost_dispatch
        lda @nes_nt_cost
        cmp #NHN_INCR_MAX_CELLS+1
        bcs nhn_defer             ; caro: adia (comportamento v2.8)
        jsr nes_nt_fits           ; carry SET = nao cabe no ORCAMENTO DO FRAME
        bcs nhn_defer
        bra nhn_incremental
nhn_cost_dispatch:
        ; v2.14 -- O FURO DO F-8, FECHADO. Ate' aqui este ramo (regime
        ; NAO-adiavel = tela LIGADA = gameplay) mandava todo run barato ao
        ; incremental SEM TESTAR O ORCAMENTO: so' o ramo adiavel acima
        ; testava. Resultado medido no corpus MMC3 (que o gate nao enxergava
        ; -- ver a errata do nes_equates): pior frame de 718 celulas no
        ; smb3_2ndrun, 2,8x o orcamento anunciado. O predicado agora e' UM SO'
        ; (nes_nt_fits) e vale nos DOIS regimes; o run que nao cabe vai pro
        ; pass GLOBAL, que e' FATIADO -- e' o mesmo destino do run caro, e o
        ; unico mecanismo de adiamento que existe com a tela ligada.
        lda @nes_nt_cost
        cmp #NHN_INCR_MAX_CELLS+1
        bcs nhn_global_path
        jsr nes_nt_fits           ; carry SET = nao cabe: vai pro pass GLOBAL
        bcc nhn_incremental
nhn_global_path:
        ; custo alto (resync/full-redraw) OU run que estourou o orcamento do
        ; frame: 1 pass global (fatiado) no fim do frame.
        ; v2.13 F-8: este ramo TAMBEM precisa da marca d'agua. Ele nao adia
        ; (a tela pode estar LIGADA), mas se um pass FATIADO estiver em voo as
        ; celulas deste run que caem ABAIXO do cursor ficariam stale e o
        ; cursor NUNCA voltaria a elas -- o mesmo furo do ramo nhn_defer, por
        ; um caminho que nao passa pelo adiamento. Achado ao ensinar o
        ; nt_stale.py a enxergar o cursor (item I).
        jsr nes_nt_wmark
        sep #$20 : .as
        lda #$01
        sta @nes_nt_dirty
        brl nhn_copy_done
nhn_defer:
        jsr nes_nt_wmark          ; MARCA D'AGUA (.al -> .al)
        sep #$20 : .as
        lda #$01
        sta @nes_nt_dirty
        sta @nes_chrfd_ntdef
        brl nhn_copy_done

nhn_incremental:
        ; rep redundante em runtime (chega .al do cmp acima) mas NECESSARIO
        ; textualmente: o ramo global logo acima termina .as e o snescom
        ; herda largura por ORDEM DE FONTE (gotcha snescom-as-al-leak).
        rep #$20 : .al
        lda @nes_nt_fcells        ; v2.13 F-8: contabiliza no orcamento do
        clc                       ; FRAME -- a fatia global le o que sobrar
        adc @nes_nt_cost
        sta @nes_nt_fcells
        jsr ncr_setup_bgbase      ; sai .al
        rep #$10 : .xl
        lda #$0000
        sta nes_hnr_bankb
        lda nes_hnr_s0s
        sta nes_hnr_segs
        lda nes_hnr_s0e
        sta nes_hnr_sege
        jsr nhn_incr_seg          ; banco 0
        lda #$0400
        sta nes_hnr_bankb
        lda nes_hnr_s1s
        sta nes_hnr_segs
        lda nes_hnr_s1e
        sta nes_hnr_sege
        jsr nhn_incr_seg          ; banco 1

nhn_copy_done:
        rep #$20 : .al
        lda @nes_hnr_len
        and #$00ff
        clc
        adc #$0004
        tax
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nhn_seg_cost -- custo (celulas + 16*attrs) do segmento [nes_hnr_segs,
; nes_hnr_sege) do banco nes_hnr_bankb. Entra/sai .al; devolve em A.
; Scratch: nes_cr_base/gmid (livres fora do conversor).
; ------------------------------------------------------------
nhn_seg_cost:
        rep #$20 : .al            ; redundante em runtime; obrigatorio
                                   ; TEXTUALMENTE (bloco anterior termina
                                   ; .as -- gotcha snescom-as-al-leak)
        lda nes_hnr_segs
        cmp nes_hnr_sege
        bcc nsc_nonempty
        lda #$0000
        rts
nsc_nonempty:
        lda nes_hnr_bankb
        clc
        adc #$03c0
        sta nes_cr_base           ; attr_base do banco
        ; celulas = max(0, min(sege, attr_base) - segs)
        lda nes_hnr_sege
        cmp nes_cr_base
        bcc nsc_ce_sege
        lda nes_cr_base
nsc_ce_sege:
        sec
        sbc nes_hnr_segs
        bcs nsc_cells_ok
        lda #$0000
nsc_cells_ok:
        sta nes_cr_gmid           ; celulas
        ; attrs = max(0, sege - max(segs, attr_base))
        lda nes_hnr_segs
        cmp nes_cr_base
        bcs nsc_a0_segs
        lda nes_cr_base
nsc_a0_segs:
        sta nes_cr_base           ; a0
        lda nes_hnr_sege
        sec
        sbc nes_cr_base
        bcs nsc_attrs_ok
        lda #$0000
nsc_attrs_ok:
        asl : asl : asl : asl     ; attrs * 16 (celulas por bloco 4x4)
        clc
        adc nes_cr_gmid
        rts

; ------------------------------------------------------------
; nhn_incr_seg -- conversao INCREMENTAL do segmento [nes_hnr_segs,
; nes_hnr_sege) do banco nes_hnr_bankb ($0000/$0400 fisico). Requer
; bgbase ja setado (ncr_setup_bgbase). Respeita nes_cr_bankmask (banco
; mascarado em single-mode = skip -- em single-upper, converter banco0
; com dstoff -2048 escreveria FORA do shadow). Entra/sai .al/.xl.
; ------------------------------------------------------------
nhn_incr_seg:
        rep #$20 : .al            ; idem: diretiva textual obrigatoria
        lda nes_hnr_segs
        cmp nes_hnr_sege
        bcc nis_nonempty
        rts
nis_nonempty:
        ; mask do banco: bankb=$0000 -> bit0; $0400 -> bit1
        lda nes_hnr_bankb
        beq nis_mask_b0
        sep #$20 : .as
        lda nes_cr_bankmask
        and #$02
        bra nis_mask_test
nis_mask_b0:
        sep #$20 : .as
        lda nes_cr_bankmask
        and #$01
nis_mask_test:
        rep #$20 : .al            ; rep nao mexe em Z -- o teste sobrevive
        bne nis_go
        rts                       ; banco mascarado (single-mode)
nis_go:
        ; celulas: [segs, min(sege, attr_base))
        lda nes_hnr_bankb
        clc
        adc #$03c0
        sta nes_cr_ce             ; attr_base (clamp abaixo)
        cmp nes_hnr_sege
        bcc nis_ce_ok
        lda nes_hnr_sege
        sta nes_cr_ce
nis_ce_ok:
        lda nes_hnr_segs
        sta nes_cr_cs
        cmp nes_cr_ce
        bcs nis_no_cells
        lda nes_cr_ce
        sta nes_cr_end
        ldy nes_cr_cs
        jsr nes_convert_range     ; sai .al/.xl
nis_no_cells:
        ; attrs: [max(segs, attr_base), sege) -- offsets FISICOS
        lda nes_hnr_bankb
        clc
        adc #$03c0
        sta nes_cr_tmp
        lda nes_hnr_segs
        cmp nes_cr_tmp
        bcs nis_a0_segs
        lda nes_cr_tmp
nis_a0_segs:
        sta nes_cr_a
        lda nes_hnr_sege
        sta nes_cr_aend
nab_loop:
        lda nes_cr_a
        cmp nes_cr_aend
        bcs nis_done
        ; n = a - (bankb+$3C0) (0..63); base FISICA do bloco 4x4 =
        ; bankb + (n&$38)<<4 + (n&7)<<2
        sec
        sbc nes_hnr_bankb
        sec
        sbc #$03c0
        sta nes_cr_tmp
        and #$0038
        asl : asl : asl : asl     ; (n&$38)<<4 == (n>>3)*128
        sta nes_cr_base
        lda nes_cr_tmp
        and #$0007
        asl : asl                 ; (n&7)*4
        clc
        adc nes_cr_base
        clc
        adc nes_hnr_bankb
        sta nes_cr_base
        jsr nab_range4            ; linha 0 do bloco (A = base)
        lda nes_cr_base
        clc
        adc #$0020
        jsr nab_range4            ; linha 1
        lda nes_cr_base
        clc
        adc #$0040
        jsr nab_range4            ; linha 2
        lda nes_cr_base
        clc
        adc #$0060
        jsr nab_range4            ; linha 3
        inc nes_cr_a
        bra nab_loop
nis_done:
        rts

; ------------------------------------------------------------
; nab_range4 -- converte as 4 celulas [A, A+4) se a celula cai na area de
; CELULAS do seu banco ((A & $3FF) < $3C0 -- linhas 30/31 do bloco de attr
; caem fora da tela NES: skip). A e' FISICO (v1.1). Entra/sai .al/.xl.
; Preserva nes_cr_a/aend/base e nes_hnr_* (nes_convert_range nao os toca).
; ------------------------------------------------------------
nab_range4:
        rep #$20 : .al            ; runtime ja chega .al (redundante); a
                                   ; DIRETIVA e' obrigatoria: textualmente
                                   ; o bloco anterior termina .as (gotcha
                                   ; snescom-as-al-leak)
        sta nes_cr_gmid           ; scratch (livre fora do conversor)
        and #$03ff
        cmp #$03c0                ; linha 30/31 dentro do banco? fora
        bcs nabr_skip
        lda nes_cr_gmid
        tay
        clc
        adc #$0004
        sta nes_cr_end
        jsr nes_convert_range     ; entra com Y=inicio; sai .al/.xl
nabr_skip:
        rts

; ============================================================
; nes_handle_oam -- CMD_OAM (256 bytes NES crus a partir de Y=1: Y,tile,
; attr,X por sprite x64). DOIS caminhos, escolhidos pelo PPUCTRL bit5:
;  - 8x8  (b5=0, abaixo): 1 slot SNES por sprite -> @nes_oam_shadow, so' as
;    primeiras 64 entradas (256B). A pagina alta do shadow NAO e' usada
;    neste modo -- o apply exibe @nes_oam_park (escrita 1x no boot, ver
;    nes_boot.a65), nunca o shadow;
;  - 8x16 (b5=1, ver nho_big): cada sprite vira DOIS slots -> o shadow e'
;    usado INTEIRO (512B = 128 slots) e a pagina alta vira dado VIVO do
;    frame (snapshot em fb_oam?b, ver nes_fb_commit/nes_apply_vblank).
;
; Conversao do caminho 8x8 (documentada no relatorio final):
;  - X: NES 0-255 -> SNES 9-bit direto (MSB sempre 0, cabe).
;  - Y: NES topo-1 -> SNES = nes_y - 7 (wrap 8-bit natural cobre sprites
;    parcialmente acima do viewport cortado).
;
;    A DERIVACAO (v2.10 -- o -8 anterior deixava TODO sprite 1 px ACIMA do
;    BG, que e' a "flutuacao sobre o chao" do SMB2):
;      o CROP de 8 descarta as linhas NES 0-7, entao a linha NES 8 e' a
;      SCANLINE 1 do SNES (a 0 nao e' exibida) => o mapa e'
;      snes_sl = nes_sl - 7.  E' o MESMO mapa que o BG usa: BG1VOFS =
;      scrolly + CROP - 1 (o 'dec' do nav_vofs_ok) faz a scanline i mostrar
;      a linha logica scrolly+i+7, i.e. a linha NES i+7.
;      Sprite NES em ny ocupa as scanlines NES ny+1..ny+8 (convencao
;      topo-1); mapeando: snes_sl ny-6..ny+1.  Um OBJ do SNES em OAM_Y
;      ocupa OAM_Y+1..OAM_Y+8 => OAM_Y = ny-7.
;    Os dois "+1" (NES e SNES) de fato se cancelam -- o que NAO cancela e'
;    a origem do frame: NES 8 -> SNES 1, nao SNES 0.  O -8 vinha da
;    iteracao 5, calibrado contra um BG que ainda estava 1 linha acima; a
;    iteracao 9 desceu o BG (o 'dec' do VOFS) e o OBJ nao acompanhou.
;    Ground truth (Mesen, SMB2 1-1, Peach parada): a ultima linha opaca do
;    sprite e' a NES 191 (= OAM Y 175 + 16, 8x16) e o topo da plataforma e'
;    a NES 192 -- CONTATO, gap 0.  Com -8 o renderer punha a ultima linha
;    do sprite na scanline SNES 183 e o topo da plataforma na 185 = 1 px de
;    fundo entre os dois; com -7, 184 e 185 = contato.
;  - tile: direto (tabela OBJ de 256 tiles, indice 8-bit == indice NES).
;  - attr: V/H-flip = mesmos bits (7,6) do NES; paleta = attr&3 (bits1-3
;    do resultado); prioridade = attr bit5 (0=na frente do BG -> priori-
;    dade SNES 3 (maxima); 1=atras do BG -> prioridade SNES 0 (minima)).
;    LIMITACAO CONHECIDA: em Mode 0 com BG1 SEMPRE nao-prioritario (nunca
;    setamos o bit de prioridade do BG1 no tilemap), OBJ prioridade 0
;    ainda fica ACIMA de BG1 nao-prioritario (ordem de hardware do Mode 0)
;    -- entao sprites NES "atras do fundo" nao ficam perfeitamente atras
;    de tiles opacos do BG1 aqui; e' um limite estrutural do Mode 0 sem
;    usar o bit de prioridade por-tile do BG, registrado como pendencia.
; ============================================================
; PERF (iteracao 7): loop reescrito com INDICES INCREMENTAIS (X=saida,
; Y=entrada -- ambos andam +4/sprite; o antigo recomputava os dois por
; sprite com rep/sep + mult) e scratch em DP (nes_ho_a/b/msb). ~100 cyc/
; sprite vs ~190 antes. O sprite-pattern-select (PPUCTRL b3) e' pre-
; computado 1x por comando (nes_ho_msb) em vez de por sprite.
nes_handle_oam:
        sep #$20 : .as             ; declaracao explicita (gotcha .as/.al)
        rep #$10 : .xl
        ; --- v2.7: PPUCTRL bit5 = sprites 8x16 -> caminho PROPRIO (o SNES
        ;     nao tem tamanho 8x16; cada entrada NES vira DUAS entradas de
        ;     OAM SNES). Antes disso o renderer tratava TODO jogo como 8x8:
        ;     desenhava so' 8 das 16 linhas e usava o byte de tile CRU como
        ;     indice -- em 8x16 o bit0 do tile e' o SELETOR DE PATTERN
        ;     TABLE, entao um indice IMPAR virava "metade de baixo do par,
        ;     na tabela ERRADA". E' a causa das metades faltando/flutuando
        ;     em SMB2/SMB3 (e de todo objeto de 8px de altura na tela, que
        ;     em 8x16 e' impossivel no NES real). ---
        lda @nes_regs_ppuctrl
        and #$20
        beq nho_small
        brl nho_big
nho_small:
        ; --- sprite pattern table select (PPUCTRL bit3) -> bit0 do attr
        ;     SNES (MSB do tile OBJ; CHR OBJ inteira de 512 tiles ja' na
        ;     VRAM linear = name_select 0). Mesma CLASSE do bug de BG da
        ;     iteracao 5 (nao mordeu no DK, bit3=0 la'). So' vale em 8x8:
        ;     em 8x16 o HW IGNORA o bit3. REGS vem antes de OAM no TLV. ---
        lda #$00
        sta nes_ho_msb
        lda @nes_regs_ppuctrl
        and #$08
        beq nho_msb_done
        lda #$01
        sta nes_ho_msb
nho_msb_done:
        ldx #$0000                ; offset de SAIDA no shadow (0,4,..,252)
        ldy #$0001                ; offset de ENTRADA no payload (1+i*4)
nho_loop:
        lda [nes_parse_ptr],y   ; NES OAM byte0 = Y (topo-1)
        sec
        sbc #7                  ; snes_y = nes_y-7 (v2.10). Ver a derivacao
                                ; completa no cabecalho: o CROP de 8 tira as
                                ; linhas NES 0-7, entao a linha NES 8 e' a
                                ; SCANLINE 1 do SNES -- o mapa e'
                                ; snes_sl = nes_sl - 7, nao -8. Sprite NES em
                                ; ny ocupa nes_sl ny+1..ny+8 -> snes_sl
                                ; ny-6..ny+1 -> OAM_Y = ny-7.
        sta @nes_oam_shadow+1,x
        iny
        lda [nes_parse_ptr],y   ; tile (indice 8-bit == indice NES)
        sta @nes_oam_shadow+2,x
        iny
        lda [nes_parse_ptr],y   ; attr NES
        sta nes_ho_a
        and #$c0                ; V/H flip -- mesma posicao de bit NES/SNES
        sta nes_ho_b
        lda nes_ho_a
        and #$20
        bne nho_prio_done       ; bit5==1 -> atras do BG: prioridade fica 0
        lda nes_ho_b
        ora #$30                ; bit5==0 -> na frente: prioridade SNES 3
        sta nes_ho_b
nho_prio_done:
        lda nes_ho_a
        and #$03                ; paleta NES sprite (0-3)
        asl                     ; -> bits1-3 do attr SNES
        ora nes_ho_b
        ora nes_ho_msb          ; + MSB do tile (pattern select, ver acima)
        sta @nes_oam_shadow+3,x
        iny
        lda [nes_parse_ptr],y   ; X NES (0-255 -> 9-bit SNES direto, MSB 0)
        sta @nes_oam_shadow,x
        iny
        inx
        inx
        inx
        inx
        cpx #$0100              ; 64 sprites * 4B
        bcc nho_loop
        rts

; ------------------------------------------------------------
; nho_big -- caminho 8x16 (v2.7). Cada sprite NES i ocupa DOIS slots SNES
; CONSECUTIVOS, 2i (metade de cima) e 2i+1 (metade de baixo) -- o
; INTERCALADO e' de proposito: a prioridade do OBJ no SNES e' a ordem de
; slot (rotacao desligada, $2103 b7=0), entao 2i/2i+1 preserva EXATAMENTE
; a ordem de indice do NES; empilhar "todas as de cima e depois todas as
; de baixo" poria a metade de baixo do sprite 0 atras da de cima do 63.
; O shadow inteiro (512B = 128 slots) fica vivo; a fonte da pagina alta no
; apply passa a ser fb_oam?b (ver nes_apply_vblank).
;
; Semantica do HW (PPU NES, 8x16):
;   tile = TTTTTTTB -> B (bit0) escolhe a pattern table; o par exibido e'
;   (T<<1) e (T<<1)|1 DENTRO dela. Na VRAM do renderer as duas tabelas
;   estao LINEARES (512 tiles), entao indice SNES = B*256 + (tile & $FE)
;   em cima e +1 embaixo -- B vai no bit0 do attr (MSB de 9 bits) e o
;   PPUCTRL bit3 e' IGNORADO (regra do HW).
;   V-FLIP troca as metades (o NES espelha o sprite de 16 linhas inteiro).
;   Y: cima = ny-8 (mesmo -8 do 8x8); baixo = cima+8 = ny.
;
; SPRITE ESCONDIDO (ny >= $EF) -- EARLY-OUT, e' o que paga o custo do modo:
;   ny >= $EF nunca aparece no NES (a 1a linha do sprite e' ny+1 = 240 =
;   pos-render), entao os DOIS slots so' precisam ficar INVISIVEIS: o laco
;   escreve $F0 nos dois bytes de Y e PULA tile/attr/X. $F0 = linhas
;   241..248, fora das 224 e SEM wrap de 8 bits (o mesmo valor/argumento do
;   park do nes_boot.a65); escrever o ny cru la' daria snes_y=$F8 no valor
;   com que o SMB2 esconde sprites -> linhas 249..256 -> WRAP -> lixo
;   VISIVEL em x=0 no topo da tela.
;   CONTRATO (o modelo do gate depende dele): os 3 bytes restantes de cada
;   slot escondido ficam com o CONTEUDO DO FRAME ANTERIOR -- dado morto por
;   construcao (Y=$F0 esconde o slot inteiro, e o refresh de 544B reescreve
;   Y todo frame). Custo (ciclos de CPU do 65816, contados instrucao a
;   instrucao): sprite escondido 56 cyc CONTRA 161 do visivel (187 com
;   V-flip) e 106 do laco 8x8 -- que nao tem early-out. Medido no trace
;   real: SMB2 esconde 53,5 dos 64 sprites por frame e SMB3, 58,3, entao
;   nesses jogos o caminho 8x16 sai MAIS BARATO que o 8x8 de hoje; o teto
;   e' o frame com os 64 visiveis (+11,9% do orcamento de CPU do frame,
;   somando o MVN do commit). Ver a conta completa no relatorio.
; ------------------------------------------------------------
nho_big:
        sep #$20 : .as
        rep #$10 : .xl
        ldx #$0000              ; saida: slot 2i em X, slot 2i+1 em X+4
        ldy #$0001              ; entrada: 1+i*4 no payload
nhob_loop:
        lda [nes_parse_ptr],y   ; NES OAM byte0 = Y (topo-1)
        cmp #$ef                ; escondido no NES -> early-out (ver acima)
        bcs nhob_hidden
        inc                     ; v2.10: metade de BAIXO = ny+1 (era ny)
        sta @nes_oam_shadow+5,x ; ny <= $EE -> $EF no maximo, nunca wrapa
        sec
        sbc #8
        sta @nes_oam_shadow+1,x ; metade de cima = (ny+1)-8 = ny-7 (era
                                ; ny-8; ver a derivacao no cabecalho -- as
                                ; duas metades desceram 1 JUNTAS, entao o
                                ; par continua colado)
        iny
        lda [nes_parse_ptr],y   ; tile: b0 = pattern table, b7-1 = par
        sta nes_ho_a
        and #$01
        sta nes_ho_msb          ; -> bit0 do attr SNES (MSB do indice)
        lda nes_ho_a
        and #$fe
        sta @nes_oam_shadow+2,x ; provisorio: cima = par, baixo = par+1
        inc
        sta @nes_oam_shadow+6,x ; (trocados abaixo se V-FLIP)
        iny
        lda [nes_parse_ptr],y   ; attr NES
        sta nes_ho_a
        and #$c0                ; V/H-flip -- mesma posicao de bit NES/SNES
        sta nes_ho_b
        lda nes_ho_a
        and #$20
        bne nhob_prio_done      ; bit5==1 -> atras do BG: prioridade fica 0
        lda nes_ho_b
        ora #$30                ; bit5==0 -> na frente: prioridade SNES 3
        sta nes_ho_b
nhob_prio_done:
        lda nes_ho_a
        and #$03                ; paleta NES sprite (0-3) -> bits1-3
        asl
        ora nes_ho_b
        ora nes_ho_msb          ; + MSB do tile (pattern table do bit0)
        sta @nes_oam_shadow+3,x
        sta @nes_oam_shadow+7,x
        lda nes_ho_a
        and #$80                ; V-FLIP: as metades trocam de lugar
        beq nhob_noflip
        lda @nes_oam_shadow+2,x
        pha
        lda @nes_oam_shadow+6,x
        sta @nes_oam_shadow+2,x
        pla
        sta @nes_oam_shadow+6,x
nhob_noflip:
        iny
        lda [nes_parse_ptr],y   ; X NES (as duas metades na MESMA coluna)
        sta @nes_oam_shadow,x
        sta @nes_oam_shadow+4,x
nhob_next:                      ; cauda COMUM aos dois caminhos: fecha o
        iny                     ; sprite no payload (4B) e no shadow (8B)
        inx
        inx
        inx
        inx
        inx
        inx
        inx
        inx
        cpx #$0200              ; 64 sprites * 8B (128 slots SNES)
        bcc nhob_loop
        rts

; --- early-out do sprite ESCONDIDO (ny >= $EF): so' os dois bytes de Y.
;     X (cursor de saida, +8) e Y (cursor de payload, +4) avancam pela
;     MESMA cauda do caminho completo -- 3 'iny' aqui + o 4o no nhob_next
;     (o caminho completo gasta os 3 lendo tile/attr/X). ---
nhob_hidden:
        lda #$f0
        sta @nes_oam_shadow+1,x
        sta @nes_oam_shadow+5,x
        iny
        iny
        iny
        bra nhob_next

; ============================================================
; nes_convert_nametable -- converte @nes_nametable_shadow (1024B: 960 tile-
; id NES row-major 32x30 + 64 bytes de atributo) inteiro p/
; @nes_tilemap_shadow (2048B, SNES 32x32 words, so as 32x30 primeiras
; linhas sao escritas -- as ultimas 2 linhas ficam com o lixo do boot,
; fora do viewport 224 linhas mesmo assim). Custo-modelo (SS7.2 da spec):
; ~13 cyc/tile-convertido; medido ~60 cyc/celula no nucleo novo (iteracao
; 7). So' roda quando nes_nt_dirty (resync/full-redraw ou flip do PPUCTRL
; bit4) -- runs pequenos convertem INCREMENTALMENTE no proprio
; nes_handle_nt_run, sem pass global (missao de perf).
; ============================================================
; PERF (iteracao 7): reescrito como wrapper do NUCLEO UNICO nes_convert_
; range (estado em DP, ~60 cyc/celula vs ~110 do loop antigo) -- o mesmo
; nucleo atende o caminho INCREMENTAL do nes_handle_nt_run, entao
; incremental==global por construcao (sem 2 implementacoes pra divergir).
nes_convert_nametable:
        ; ============================================================
        ; v2.13 F-8 -- UMA FATIA do pass GLOBAL. carry SET = pass COMPLETO.
        ;
        ; CONTEXTO: chamador UNICO = npf_finish, que roda
        ; no MAIN. Todo o estado (nes_nt_gcur/glo/g*) e' MAIN-only e NAO tem
        ; corrida -- o molde e' o nes_chrq_rb_t do rebuild fatiado da v2.6,
        ; mas aquele e' NMI-only e o argumento de seguranca e' o OPOSTO.
        ; INVARIANTE: nenhum caminho de NMI pode chamar este pass.
        ;
        ; ORCAMENTO: o que sobrou de NES_NT_SLICE depois do que o caminho
        ; INCREMENTAL ja' gastou neste frame (nes_nt_fcells). E' o mesmo
        ; orcamento dos dois caminhos -- ver o bloco F-8 do nes_equates.
        ;
        ; RE-ENTRANCIA: nes_convert_range deriva attridx/rowend/gend/gmid e o
        ; destino X INTEIRAMENTE de Y e de nes_cr_end, e preserva
        ; nes_cr_{a,aend,base,cs,ce,bgbase} -- cortar em qualquer celula e'
        ; correto (auditado em revisao).
        ;
        ; O QUE E' FOTOGRAFADO POR FATIA (item D): nes_cr_bgbase (PPUCTRL
        ; bit4, via ncr_setup_bgbase abaixo), nes_cr_dstoff e
        ; nes_cr_bankmask (arranjo). Se qualquer um mudar ENTRE fatias, a
        ; metade ja' convertida fica com os valores VELHOS e o cursor nunca
        ; volta -- meia tela na pattern table errada, PERMANENTE. Por isso os
        ; DOIS sitios que forcam nt_dirty (nhh_changed = arranjo, e o flip do
        ; bit4 no nes_handle_regs) tambem forcam nes_nt_gcur = 0 e limpam a
        ; marca d'agua.
        ; ============================================================
        rep #$30 : .al : .xl
        lda @nes_nt_fbud           ; v2.14: o MESMO metro do dispatch (o teto
        sec                        ; do frame ja' foi medido no raster, 1x)
        sbc @nes_nt_fcells         ; orcamento QUE SOBROU deste frame
        bcc ncn_nobud              ; ja' estourou
        beq ncn_nobud
        sta @nes_nt_gbud
        jsr ncr_setup_bgbase       ; sai .al -- fotografa o bgbase DESTA fatia
        rep #$30 : .al : .xl
ncn_loop:
        lda @nes_nt_gcur
        cmp #NES_NT_CELLS
        bcs ncn_finish             ; cursor no fim: pass COMPLETO
        cmp #NES_NT_B0_CELLS
        bcc ncn_bank0
        ; ---------------- banco 1 (logico 960..1919) ----------------
        sep #$20 : .as
        lda nes_cr_bankmask
        and #$02
        rep #$20 : .al             ; rep nao mexe em Z
        bne ncn_b1_ok
        lda #NES_NT_CELLS          ; banco mascarado: pula tudo
        sta @nes_nt_gcur
        bra ncn_loop
ncn_b1_ok:
        lda #NES_NT_CELLS
        sta @nes_nt_glim
        lda #NES_NT_B1_OFS
        sta @nes_nt_gofs
        bra ncn_run
ncn_bank0:
        ; ---------------- banco 0 (logico 0..959) ----------------
        sep #$20 : .as
        lda nes_cr_bankmask
        and #$01
        rep #$20 : .al
        bne ncn_b0_ok
        lda #NES_NT_B0_CELLS       ; banco mascarado: pula pro banco 1
        sta @nes_nt_gcur
        bra ncn_loop
ncn_b0_ok:
        lda #NES_NT_B0_CELLS
        sta @nes_nt_glim
        lda #$0000
        sta @nes_nt_gofs
ncn_run:
        lda @nes_nt_gcur           ; gend = min(gcur + gbud, glim)
        clc
        adc @nes_nt_gbud
        cmp @nes_nt_glim
        bcc ncn_end_ok
        lda @nes_nt_glim
ncn_end_ok:
        sta @nes_nt_gend
        sec
        sbc @nes_nt_gcur           ; n = celulas desta passada
        beq ncn_partial            ; orcamento zerou exatamente na fronteira
        sta @nes_nt_gn
        lda @nes_nt_gbud
        sec
        sbc @nes_nt_gn
        sta @nes_nt_gbud
        lda @nes_nt_fcells         ; a fatia tambem consome o orcamento do
        clc                        ; FRAME (e' o MESMO teto do incremental)
        adc @nes_nt_gn
        sta @nes_nt_fcells
        lda @nes_nt_gend           ; logico -> FISICO
        clc
        adc @nes_nt_gofs
        sta nes_cr_end
        lda @nes_nt_gcur
        clc
        adc @nes_nt_gofs
        tay
        jsr nes_convert_range      ; sai .al/.xl
        lda @nes_nt_gend
        sta @nes_nt_gcur
        lda @nes_nt_gbud
        bne ncn_loop               ; ainda cabe (ex.: virada de banco)
ncn_partial:
        sep #$20 : .as
        clc                        ; fatia PARCIAL: a divida sobrevive
        rts
ncn_nobud:
        sep #$20 : .as
        clc
        rts
ncn_finish:
        rep #$20 : .al             ; redundante em runtime; OBRIGATORIO
                                   ; textualmente (o ncn_nobud acima sai .as)
        ; --- RE-ARME por MARCA D'AGUA. Um CMD_NT_RUN adiado que chegou ENTRE
        ;     fatias deixou stale toda celula ja' convertida ABAIXO dele -- e'
        ;     o furo que o pass monolitico nao tem (ele converte a CIRAM
        ;     inteira do shadow CORRENTE). O nes_nt_wmark so' registra quando
        ;     ha' pass em voo E a celula esta' abaixo do cursor, entao o
        ;     re-arme e' raro por construcao. Termina porque o trafego para. ---
        lda @nes_nt_glo
        cmp #NES_NT_CELLS
        bcs ncn_done_clean         ; sentinela: nada stale
        sta @nes_nt_gcur           ; recomeca da marca
        lda #NES_NT_CELLS
        sta @nes_nt_glo
        lda @nes_nt_gbud
        bne ncn_loop               ; ainda ha' orcamento: segue AGORA
        sep #$20 : .as
        clc
        rts
ncn_done_clean:
        rep #$20 : .al             ; idem (o ramo parcial acima sai .as)
        lda #$0000
        sta @nes_nt_gcur           ; pronto para o proximo pass
        sep #$20 : .as
        sec                        ; pass COMPLETO
        rts

; ------------------------------------------------------------
; nes_nt_fits -- (MAIN, entra/sai .al) PREDICADO UNICO de orcamento: o run
; corrente (nes_nt_cost) ainda cabe no ORCAMENTO DESTE FRAME (nes_nt_fbud)
; junto com o que ja' foi gasto (nes_nt_fcells)?  carry CLEAR = cabe.
;
; Existe para que os DOIS regimes (adiavel e nao-adiavel) usem O MESMO metro.
; Ate' o v2.13 so' o adiavel testava, e contra a CONSTANTE NES_NT_SLICE --
; duas assimetrias que juntas furavam a invariante do F-8 com a tela ligada.
; Clobbera A (os dois chamadores recarregam o que precisam).
; ------------------------------------------------------------
nes_nt_fits:
        rep #$20 : .al
        lda @nes_nt_cost
        clc
        adc @nes_nt_fcells
        cmp @nes_nt_fbud
        beq nnf_yes                ; cabe EXATAMENTE
        bcc nnf_yes
        sec                        ; nao cabe
        rts
nnf_yes:
        clc
        rts

; ------------------------------------------------------------
; nes_nt_frame_budget -- (MAIN, entra .al/.xl, sai .al) ORCAMENTO DESTE FRAME
; em celulas, DIMENSIONADO PELO RASTER. Grava em nes_nt_fbud.
;
; Chamado EXATAMENTE 1x por frame, no topo do nes_process_frame, junto do
; zeramento de nes_nt_fcells -- e' o que faz "um orcamento por frame" ser
; literal em vez de retorico, e mantem o dispatch (que roda por RUN) livre de
; leitura de $213x.
;
; E' o mesmo principio do nes_chrw_slice_service do v2.11 -- "o passo nao e'
; uma constante, e' o que ainda cabe" -- com o metro certo: a conversao de
; tilemap e' CPU do laco principal, entao ela mede o FRAME que resta, nao o
; vblank. Derivacao completa (e a reserva, que e' DERIVADA da ancora do
; proprio F-8) no bloco correspondente do nes_equates.
;
; ⚠ V DE NOVE BITS, e LIDO DUAS VEZES ficando com a MENOR concessao: a
; sequencia $213F/$2137/$213D nao e' atomica contra a NMI, que tambem usa o
; latch H/V. Se a NMI cair no meio de uma leitura, a outra segura o valor --
; sem isso o MAIN poderia ler scale ~225 em pleno display e conceder o teto.
; ------------------------------------------------------------
nes_nt_frame_budget:
        jsr nnfb_read              ; A = scale da 1a leitura
        sta @nes_nt_vscale
        jsr nnfb_read              ; A = scale da 2a leitura
        cmp @nes_nt_vscale
        bcs nnfb_worst             ; fica com o MAIOR scale = MENOR orcamento
        lda @nes_nt_vscale
nnfb_worst:
        sta @nes_nt_vscale
        lda #NES_NT_RASTER_K
        sec
        sbc @nes_nt_vscale         ; linhas ate' o proximo vblank - reserva
        bcc nnfb_floor             ; ja' passou do ponto: PISO
        asl                        ; celulas = linhas * 2
        cmp #NES_NT_SLICE_MAX+1
        bcc nnfb_ceil_ok
        lda #NES_NT_SLICE_MAX
nnfb_ceil_ok:
        cmp #NES_NT_SLICE
        bcs nnfb_done
nnfb_floor:
        lda #NES_NT_SLICE          ; nunca abaixo do comportamento do F-8
nnfb_done:
        sta @nes_nt_fbud
        rts

; nnfb_read -- (entra .al, sai .al) UMA leitura de V de 9 bits, ja' na escala
; monotona (scale = V se V >= 225, senao V + 262). Devolve em A.
nnfb_read:
        sep #$20 : .as
        lda $213f                  ; reseta o flip-flop do latch de H/V
        lda $2137                  ; latcha H/V
        lda $213d                  ; V[7:0]
        rep #$20 : .al
        and #$00ff
        sta @nes_nt_gtmp           ; scratch do pass, livre fora dele
        sep #$20 : .as
        lda $213d                  ; 2a leitura do MESMO latch: bit0 = V[8]
        and #$01
        rep #$20 : .al
        and #$00ff
        xba                        ; A = V[8] << 8
        clc
        adc @nes_nt_gtmp           ; A = V de NOVE bits (0..261)
        cmp #225
        bcs nnfbr_done             ; V >= 225: ja' esta' na escala
        clc
        adc #262                   ; V < 225 (display ativo): +1 frame
nnfbr_done:
        rts

; ------------------------------------------------------------
; nes_nt_gcur_reset -- (MAIN, entra/sai .as) INVALIDA o pass fatiado.
; Chamado pelos DOIS sitios que mudam algo que o pass fotografa por fatia
; (item D): flip do PPUCTRL bit4 (nes_cr_bgbase) e mudanca de ARRANJO
; (nes_cr_dstoff / nes_cr_bankmask). Sem isto a metade ja' convertida fica
; com os valores VELHOS e o cursor NUNCA volta a ela: meia tela errada de
; forma PERMANENTE. Preserva A (os dois chamadores tem A viva).
; ------------------------------------------------------------
nes_nt_gcur_reset:
        sep #$20 : .as             ; entra .as (os dois chamadores tem A viva)
        pha
        rep #$20 : .al
        lda #$0000
        sta @nes_nt_gcur
        lda #NES_NT_CELLS
        sta @nes_nt_glo
        sep #$20 : .as
        pla
        rts

; ------------------------------------------------------------
; nes_nt_wmark -- (MAIN, entra/sai .al) MARCA D'AGUA do pass fatiado.
; Ancora a celula LOGICA mais baixa que o run adiado invalida:
;   celula        -> a propria celula (logica)
;   byte de ATTR  -> o inicio da LINHA DE QUADRANTE que ele governa
;                    (1 attr = quadrante 4x4; a linha de quadrante q cobre as
;                    celulas [128q, 128q+128) do banco). Ancorar no inicio do
;                    BANCO -- a versao conservadora -- foi o que produziu 16
;                    re-armes e hold=30 na variante (a) do projeto.
; So' registra com pass EM VOO (gcur != 0) e abaixo do cursor: acima dele a
; propria passada ja' vai cobrir.
; ------------------------------------------------------------
nes_nt_wmark:
        rep #$20 : .al             ; redundante em runtime; OBRIGATORIO
                                   ; textualmente (gotcha snescom-as-al-leak)
        lda @nes_nt_gcur
        beq nnw_out                ; sem pass em voo: a proxima passada cobre
        lda @nes_hnr_ntoff         ; (1) a ancora do INICIO do run
        jsr nnw_anchor
        sta @nes_nt_gtmp
        ; (2) ATRIBUTOS. Um byte de attr governa um quadrante 4x4 e a LINHA
        ;     de quadrante dele comeca MUITO abaixo do offset do byte -- um
        ;     run que COMECA em celula e ENTRA nos attrs invalida celulas
        ;     bem abaixo do seu proprio inicio. Foi exatamente isto que o
        ;     nt_stale.py pegou (megaman2 f64: run off=842 len=182 entra nos
        ;     attrs em 960 e suja as celulas 0..231, 232 celulas STALE).
        ;     Ancorar so' no inicio do run e' ERRADO.
        lda @nes_hnr_ntend         ; attrs do banco 0 tocados?
        cmp #$03c1
        bcc nnw_b1
        lda @nes_hnr_ntoff
        cmp #$0400
        bcs nnw_b1
        cmp #NES_NT_B0_CELLS
        bcs nnw_a0_ok
        lda #NES_NT_B0_CELLS       ; primeiro attr TOCADO do banco 0
nnw_a0_ok:
        jsr nnw_anchor
        cmp @nes_nt_gtmp
        bcs nnw_b1
        sta @nes_nt_gtmp
nnw_b1:
        lda @nes_hnr_ntend         ; attrs do banco 1 tocados?
        cmp #$07c1
        bcc nnw_min
        lda @nes_hnr_ntoff
        cmp #$07c0
        bcs nnw_a1_ok
        lda #$07c0
nnw_a1_ok:
        jsr nnw_anchor
        cmp @nes_nt_gtmp
        bcs nnw_min
        sta @nes_nt_gtmp
nnw_min:
        lda @nes_nt_gtmp
        cmp @nes_nt_gcur
        bcs nnw_out                ; acima do cursor: a propria passada cobre
        cmp @nes_nt_glo
        bcs nnw_out
        sta @nes_nt_glo
nnw_out:
        rts

; ------------------------------------------------------------
; nnw_anchor -- (MAIN, .al) A = offset na CIRAM -> A = celula LOGICA ancora.
;   celula -> a propria celula (logica: banco1 = fisica - 64)
;   attr   -> primeira celula da LINHA DE QUADRANTE que ele governa
;             (attr idx i cobre as celulas [128*(i>>3), +128) do banco)
; ------------------------------------------------------------
nnw_anchor:
        cmp #NES_NT_B0_CELLS
        bcc nna_out                ; celula do banco 0: logica == fisica
        cmp #$0400
        bcc nna_attr0
        cmp #$07c0
        bcc nna_cell1
        sec                        ; --- attr do banco 1 ---
        sbc #$07c0
        lsr : lsr : lsr            ; linha de quadrante (0..7)
        xba                        ; x256
        lsr                        ; x128 = primeira celula da linha
        clc
        adc #NES_NT_B0_CELLS
        rts
nna_cell1:                         ; --- celula do banco 1 ---
        sec
        sbc #NES_NT_B1_OFS
        rts
nna_attr0:                         ; --- attr do banco 0 ---
        sec
        sbc #NES_NT_B0_CELLS
        lsr : lsr : lsr
        xba
        lsr
nna_out:
        rts

; ------------------------------------------------------------
; ncr_setup_bgbase -- pre-computa nes_cr_bgbase ($0000/$0100) do PPUCTRL
; bit4 corrente (BG pattern table select -- fix da iteracao 5: a CHR
; inteira de 512 tiles ja' esta' na VRAM 2bpp; bit4=1 -> tiles 256..511;
; os 10 bits de tile da word comportam 512). Sai .al.
; ------------------------------------------------------------
ncr_setup_bgbase:
        rep #$20 : .al
        lda #$0000
        sta nes_cr_bgbase
        sep #$20 : .as
        lda @nes_regs_ppuctrl
        and #$10
        rep #$20 : .al             ; rep so' mexe no bit M -- Z sobrevive
        beq nsb_done
        lda #$0100
        sta nes_cr_bgbase
nsb_done:
        rts

; ============================================================
; nes_convert_range -- NUCLEO UNICO de conversao (iteracao 7): converte as
; celulas [Y, nes_cr_end) do @nes_nametable_shadow p/ words no
; @nes_tilemap_shadow. Chamado pelo caminho GLOBAL (nes_convert_nametable,
; range 0..960) e pelo INCREMENTAL (nes_handle_nt_run: trechos de run +
; blocos de attr) -- identidade dos dois caminhos por construcao.
;
; Requer: nes_cr_bgbase setado (ncr_setup_bgbase) e o ptr dp nes_nt_ptr/
; nes_nt_bank apontando pro shadow (nes_boot_init). Entra: Y = celula
; inicial (16b), qualquer largura (faz rep #$30). Sai .al/.xl. Clobbera
; A/X/Y e nes_cr_{p0,p1,end,rowend,attridx,gend,gmid,tmp} -- preserva
; nes_cr_{a,aend,base,cs,ce,bgbase} (o loop de attr do chamador depende).
;
; Estrutura: por LINHA (attridx/rowend) -> por GRUPO de 4 colunas (1 attr
; byte -> p0/p1 pre-OR'ados com bgbase) -> 2 mini-loops de celula SEM
; teste de paridade (split em gmid): ~35 cyc/celula + ~90/grupo de refresh
; ~= ~60 cyc/celula amortizado. Leituras via [nes_nt_ptr],y (o 65816 nao
; tem long,y -- e' o ponteiro dp que resolve isso sem round-trip por X).
; ============================================================
nes_convert_range:
        rep #$30 : .al : .xl
ncr_outer:
        cpy nes_cr_end
        bcc ncr_row_setup
        rts
ncr_row_setup:
        ; attridx = banco + $3C0 + ((cel>>7)<<3) + ((cel>>2)&7) -- v1.1:
        ; cel e' FISICA (0-2047); o termo de banco = cel & $0400; os
        ; termos de linha/coluna usam so' bits <10, imunes ao banco
        ;   (cel>>7)<<3 == (cel>>4)&$38 (bits 7-9 -> 3-5)
        tya
        lsr : lsr : lsr : lsr
        and #$0038
        sta nes_cr_attridx
        tya
        lsr : lsr
        and #$0007
        clc
        adc nes_cr_attridx
        clc
        adc #$03c0
        sta nes_cr_attridx
        tya
        and #$0400                 ; termo de banco fisico
        clc
        adc nes_cr_attridx
        sta nes_cr_attridx
        ; rowend = min(end, proximo multiplo de 32)
        tya
        ora #$001f
        inc
        cmp nes_cr_end
        bcc ncr_re_ok
        lda nes_cr_end
ncr_re_ok:
        sta nes_cr_rowend
        tya
        asl
        clc
        adc nes_cr_dstoff          ; v1.1: dst = 2*phys + dstoff (0 em H/V/
        tax                        ; 1L -- banco N cai exato no screen N;
                                   ; -2048 em 1H: banco1 -> screen0)
        ; --- v2.9b (R2): guarda o INICIO desta linha. A marcacao da faixa
        ;     [lo,hi) inteira acontece no ncr_rowdone, com os dois stores
        ;     ADJACENTES: com o minimo AQUI e o maximo la', a NMI podia
        ;     esvaziar a faixa NO MEIO (janela ~1.400 cyc = 1 scanline) e a
        ;     linha ficava stale ate' o jogo re-suja-la. Agora a janela e'
        ;     ~10 cyc -- e o scrub rotativo limita o estrago mesmo assim. ---
        sta @nes_tm_rs
ncr_group:
        ; --- refresh p0/p1 do grupo: attr byte >> rowshift ---
        phy
        ldy nes_cr_attridx
        lda [nes_nt_ptr],y         ; attr (16-bit; mask abaixo)
        ply
        and #$00ff
        sta nes_cr_tmp
        tya
        and #$0040                 ; bit6 da celula == row&2 -> rowshift 4
        beq ncr_rs_done
        lda nes_cr_tmp
        lsr : lsr : lsr : lsr
        sta nes_cr_tmp
ncr_rs_done:
        ; p0 = ((attr>>rs)&3)<<10 | bgbase: and #$0003 + XBA (<<8) + 2x asl
        lda nes_cr_tmp
        and #$0003
        xba
        asl : asl
        ora nes_cr_bgbase
        sta nes_cr_p0
        ; p1 = ((attr>>rs)>>2 & 3)<<10 == (attr&$0C)<<8 -> XBA direto
        lda nes_cr_tmp
        and #$000c
        xba
        ora nes_cr_bgbase
        sta nes_cr_p1
        ; gend = min(rowend, fim do grupo); gmid = min(gend, meio do grupo)
        tya
        and #$fffc
        clc
        adc #$0004
        cmp nes_cr_rowend
        bcc ncr_ge_ok
        lda nes_cr_rowend
ncr_ge_ok:
        sta nes_cr_gend
        tya
        and #$fffc
        clc
        adc #$0002
        cmp nes_cr_gend
        bcc ncr_gm_ok
        lda nes_cr_gend
ncr_gm_ok:
        sta nes_cr_gmid
ncr_cell_p0:                       ; colunas 0-1 do grupo (sem teste de paridade)
        cpy nes_cr_gmid
        bcs ncr_cell_p1
        lda [nes_nt_ptr],y
        and #$00ff
        ora nes_cr_p0
        sta @nes_tilemap_shadow,x
        inx
        inx
        iny
        bra ncr_cell_p0
ncr_cell_p1:                       ; colunas 2-3 do grupo
        cpy nes_cr_gend
        bcs ncr_gdone
        lda [nes_nt_ptr],y
        and #$00ff
        ora nes_cr_p1
        sta @nes_tilemap_shadow,x
        inx
        inx
        iny
        bra ncr_cell_p1
ncr_gdone:
        cpy nes_cr_rowend
        bcs ncr_rowdone
        inc nes_cr_attridx         ; proximo grupo da MESMA linha
        brl ncr_group
ncr_rowdone:
        ; --- v2.9b: marca a faixa suja [nes_tm_rs, X) -- os dois stores
        ;     ADJACENTES (R2). X = offset EXCLUSIVE logo depois da ultima
        ;     word escrita nesta linha; A esta' morta aqui (o ncr_outer so'
        ;     faz cpy/rts ou cai no 'tya' do row_setup). ---
        txa
        cmp @nes_tm_hi
        bcc ncr_hi_ok
        sta @nes_tm_hi
ncr_hi_ok:
        lda @nes_tm_rs
        cmp @nes_tm_lo
        bcs ncr_lo_ok
        sta @nes_tm_lo
ncr_lo_ok:
        brl ncr_outer

; ============================================================
; nes_fb_select -- v1.5.1: escolhe o FRAME BUFFER alvo do decode = o buffer
; que NAO e' pending (unica restricao: a NMI pode ler o pending a qualquer
; momento). SEM STALL (carry sempre clear; os chamadores mantem o bcs por
; robustez): apos o apply, o buffer consumido esta' MORTO (OAM/CGRAM/regs
; ja desceram no NMI; a tabela HDMA foi copiada pra nes_hdma_live) -> pode
; ser reusado imediatamente. Race-safe: so' a NMI ZERA pending (nunca
; seta); ler um pending stale => escolhe o outro buffer (ja consumido =
; morto) -- seguro nos dois sentidos. Chamar ANTES de drenar/consumir o
; frame do transporte. Contexto MAIN.
; ============================================================
nes_fb_select:
        sep #$20 : .as
        lda @nes_fb_pending
        cmp #$01
        beq nfs_t2                ; pending=buf0 -> alvo buf1
        lda #$01                  ; pending=0 ou buf1 -> alvo buf0
        bra nfs_set
nfs_t2:
        lda #$02
nfs_set:
        sta @nes_fb_target
        clc
        rts

; ============================================================
; nes_fb_commit -- v1.5.1: snapshot dos masters pos-frame -> fb[target] +
; COMMIT (nes_fb_pending = target; 1 byte = atomico). Chamado no fecho do
; frame (npf_finish). Custo ~428B de MVN (~3K cyc, display ativo). Usa o
; stub MVN em WRAM (nes_mvn_stub) com src-bank patchado p/ $7F -- mesmo
; contexto MAIN do NT_RUN (que o re-patcha por chamada), sem race; a NMI
; nao usa o stub. Uma NMI NO MEIO destes MVNs e' inofensiva: ela aplica o
; pending ANTIGO (outro buffer) e o MVN retoma (A/X/Y/DBR restaurados).
; ============================================================
; GOTCHA DURAVEL (custou o 0/14 do 1o build v1.5.1): o snescom monta acesso
; a simbolo de pagina-0 (nes_data_zp) como ABSOLUTO ($AD/$AE/$AC nnnn), que
; e' RELATIVO AO DBR -- e o MVN DEIXA DBR = banco destino ($7F). Um "ldy
; nes_fb_dcg" ENTRE dois MVNs lia $7F:0067 (garbage do mailbox buf) e o 2o/
; 3o MVN copiava pra destino-lixo (fb_cg/fb_regs ficavam com o power-on ->
; CGRAM de lixo na tela). Por isso a REGRA, enunciada com precisao (v2.7):
; entre o phb e o plb, NENHUM acesso que dependa do DBR -- ou seja, nada de
; absoluto/dp (que o snescom monta DBR-relativo). Os destinos dos MVNs sao
; IMEDIATOS (DBR-independentes), um ramo por target, e o nes_handle_nt_run
; segue a mesma regra (nada entre o MVN e o plb).
; O gate de 8x16 do v2.7 le @nes_regs_ppuctrl entre os MVNs: e' acesso LONG
; ('@' = 24 bits, banco no proprio opcode), imune ao DBR=$7F -- e' o UNICO
; tipo de acesso permitido ai. Copiar esse padrao SEM o '@' le o banco
; errado e o sneslink NAO reclama (gotcha da casa).
nes_fb_commit:
        sep #$20 : .as
        rep #$10 : .xl
        ; --- v1.5.2 (fix do drop-race do device: Mario embaralhado no SMB,
        ;     pedaco de sprite PRESO no canto pos-morte -- janelas de frames
        ;     pesados): NUNCA snapshota/commita com um frame commitado-nao-
        ;     aplicado. A v1.5.1 sobrescrevia o PONTEIRO pending (drop
        ;     newest-wins) -- na teoria os buffers eram distintos, mas a
        ;     evidencia de silicio aponta pra esta classe; o SKIP elimina a
        ;     janela INTEIRA por construcao: o buffer pendente e' IMUTAVEL
        ;     ate' o apply, e fb[target] abandonado nunca vira pending.
        ;     Semantica preservada (newest-wins): os masters sao cumulativos
        ;     e o PROXIMO commit carrega o full-state; so' o gate de paleta
        ;     acumula (nes_fb_pd_acc) pra nao perder um CMD_PALETTE de frame
        ;     cujo commit foi pulado. Vazao intacta: o decode nunca stalla
        ;     (so' o snapshot de ~428B e' pulado; <=1 commit por vblank e'
        ;     tudo que o display consome). ---
        lda @nes_fb_pending
        beq nfc_do
        lda @nes_pal_dirty        ; frame de commit PULADO tinha paleta?
        beq nfc_skip
        lda #$01
        sta @nes_fb_pd_acc        ; acumula pro proximo commit real
nfc_skip:
        rts
nfc_do:
        lda #$7f
        sta @nes_mvn_stub+2       ; src bank = $7F (masters)
        lda @nes_fb_target
        cmp #$02
        beq nfc_t2
        phb                       ; MVN deixa DBR = banco destino ($7F)
        rep #$30 : .al : .xl
        ldx #!nes_oam_shadow      ; OAM master -> fb_oam0 (256B)
        ldy #!nes_fb_oam0
        lda #255                  ; MVN move A+1 bytes
        jsl @nes_mvn_stub
        ; v2.7: em 8x16 a METADE ALTA do shadow (slots SNES 64-127) e' dado
        ; VIVO do frame -> entra no snapshot. Em 8x8 nada a copiar (a
        ; pagina alta do apply vem do @nes_oam_park estatico). O teste usa
        ; acesso LONG ('@'), imune ao DBR=$7F que o MVN deixou.
        lda @nes_regs_ppuctrl     ; (16 bits: ctrl|mask<<8; b5 = 8x16)
        and #$0020
        beq nfc_t1_nobig
        ldx #!nes_oam_shadow+256
        ldy #!nes_fb_oam0b
        lda #255
        jsl @nes_mvn_stub
nfc_t1_nobig:
        ldx #!nes_cgram_bg_shadow ; CGRAM masters bg+obj -> fb_cg0 (160B,
        ldy #!nes_fb_cg0          ; contiguos: $7F3A00-$7F3A9F)
        lda #159
        jsl @nes_mvn_stub
        ldx #!nes_regs_scrollx    ; bloco de regs -> fb_regs0 (12B: sx sy
        ldy #!nes_fb_regs0        ; ctrl mask ntsel pad ntarr bg1sc nt_dirty
        lda #11                   ; pal_dirty -- ordem de nes_data.a65)
        jsl @nes_mvn_stub
        sep #$20 : .as
        plb                       ; DBR de volta a $00 ANTES de qualquer
                                   ; acesso absoluto/dp
        rep #$10 : .xl
        ldx #!nes_fb_regs0
        bra nfc_fin
nfc_t2:
        phb
        rep #$30 : .al : .xl
        ldx #!nes_oam_shadow
        ldy #!nes_fb_oam1
        lda #255
        jsl @nes_mvn_stub
        lda @nes_regs_ppuctrl     ; v2.7 (ver o gate identico no ramo t1)
        and #$0020
        beq nfc_t2_nobig
        ldx #!nes_oam_shadow+256
        ldy #!nes_fb_oam1b
        lda #255
        jsl @nes_mvn_stub
nfc_t2_nobig:
        ldx #!nes_cgram_bg_shadow
        ldy #!nes_fb_cg1
        lda #159
        jsl @nes_mvn_stub
        ldx #!nes_regs_scrollx
        ldy #!nes_fb_regs1
        lda #11
        jsl @nes_mvn_stub
        sep #$20 : .as
        plb
        rep #$10 : .xl
        ldx #!nes_fb_regs1
nfc_fin:
        lda @nes_split_pend       ; hdma do frame -> fb_regs[t]+12 (base
        sta @$7f000c,x            ; $7F0000 + X=!fb_regs + $0C)
        lda @nes_cspl_pend        ; v2.3: hdma de TILE-BASE do frame -> +13
        sta @$7f000d,x            ; (X intacto: acesso long sem indice)
        lda #$00
        sta @nes_cspl_pend        ; consumido; o inicio do proximo decode
                                   ; tambem zera (defesa em profundidade --
                                   ; nenhum commit pode republicar tabela velha)
        ; --- pal_dirty acumulado de frames com commit PULADO (v1.5.2):
        ;     um CMD_PALETTE num frame cujo commit foi pulado nao pode se
        ;     perder -- o snapshot atual TEM os bytes certos (masters
        ;     cumulativos), so' o gate precisava sobreviver. ---
        lda @nes_fb_pd_acc
        beq nfc_commit
        lda #$01
        sta @$7f000b,x            ; fb_regs[t]+11 |= acumulado (X intacto)
        lda #$00
        sta @nes_fb_pd_acc
nfc_commit:
        lda @nes_fb_target        ; COMMIT: 1 byte, atomico p/ a NMI
        sta @nes_fb_pending
        rts

; ============================================================
; ==== CHR: RECONCILIADOR IDEMPOTENTE (v2.2) ====
; DESIGN (pos 3 falhas de device da familia dirigida-a-evento -- first-valid
; engolido, runaway de re-anuncio de resync, inferencia de modo): o RTL agora
; publica o ESTADO ABSOLUTO por frame -- CMD_CHR_STATE ($12, 4B: s0_bank,
; s1_bank, s1_present -- o bit 8K/4K que nunca viajava), INCONDICIONAL, logo
; apos o CMD_REGS. O renderer RECONCILIA todo frame: (desejado != residente)
; -> agenda carga. Frame perdido/duplicado NUNCA deixa estado errado
; permanente (o proximo CHR_STATE reconverge -- auto-cura por construcao).
; O CMD_CHR_BANK ($40) virou ADVISORY (parse-only skip).
;
; GEOMETRIA UNIFICADA (par-residencia em ids 4K):
;   want = s1_present ? (s0, s1) : (2*s0, 2*s0+1)   [8K bank B = par (2B,2B+1)]
;   2 REGIOES de VRAM (os antigos slots), cada uma com um PAR-alvo:
;     regiao 0: BG $1000/OBJ $4000; regiao 1: BG $2000/OBJ $6000
;     metade PT1 = +$800 BG / +$1000 OBJ (bg_patt/spr_msb ja somam +256 tiles)
;   Reconcilio: want==par(cur) -> nada; want==par(other) -> SWAP de tile-base
;   (zero DMA -- cobre CNROM/ciclos); UMA metade difere em cur -> carga
;   IN-PLACE dessa metade; senao victim=other, carrega as metades que diferem
;   do conteudo do victim, cur=victim. Toda carga = LOADER POR METADE
;   (4KB BG + 8KB OBJ), full (forced-blank/rendering-off) ou slice; escalada
;   bounded (cooldown) quando retargeta um slice em voo.
; Fonte: CHR-SNES pre-convertida na PSRAM ($50 BG 2bpp / $60 OBJ 4bpp),
; offset = id4k * $1000 (BG) / * $2000 (OBJ).
; ============================================================

; ------------------------------------------------------------
; nes_chr_handle_state -- CMD_CHR_STATE (parse, contexto MAIN). Deriva o
; par desejado e reconcilia. Nao mexe em X (dispatcher poe o tamanho depois).
; ------------------------------------------------------------
nes_chr_handle_state:
        sep #$20 : .as
        rep #$10 : .xl
        ; --- v2.3w: o $12 e' IGNORADO quando o frame trouxe o $14 (mapper 4).
        ;     Em mapper 4 a visao da PPU e' o VETOR DE 8 JANELAS do $14; o $12
        ;     continua no offset FIXO 14 apenas pra nao quebrar o parser (o
        ;     tamanho 4 e a posicao sao contrato duro dos 20 goldens), com
        ;     conteudo que NAO descreve o estado real -- processa-lo armaria
        ;     carga de par 4K por cima da residencia de janelas.
        ;     COMO SABEMOS, se o $12 vem ANTES do $14: por PEEK de 1 byte. A
        ;     ordem canonica (design SS3.4) e' CONTRATO DURO -- o $14 vem
        ;     IMEDIATAMENTE apos o $12 -- entao o opcode em +4 (o $12 tem
        ;     tamanho fixo 4) decide. A leitura nunca sai do frame: depois do
        ;     $12 sempre existe pelo menos o CMD_FRAME_DONE (2B).
        ;     Um FLAG setado pelo $14 NAO serviria (ele e' parseado DEPOIS);
        ;     o flag sticky nes_chrw_active fica como defesa em profundidade
        ;     pro caso de um frame anomalo sem o $14 no lugar canonico. ---
        ldy #$0004
        lda [nes_parse_ptr],y
        cmp #CMD_CHR_STATE8
        beq nhs_ignored
        lda @nes_chrw_active
        bne nhs_ignored
        lda #$01
        sta @nes_chr_active
        bra nhs_st_go
nhs_ignored:
        rts                          ; v2.3w: frame de mapper 4 -- o $14 manda
nhs_st_go:
        sep #$20 : .as
        ; --- v2.2b (i) UPGRADE OPORTUNISTA: frame ESCURO (fb=1 OU rendering
        ;     OFF) com slice em voo -> promove a full NESTE vblank (o full
        ;     service continua do cursor = so' o restante; janela ja' escura
        ;     = zero flicker novo). pick_mode devolve 1 exatamente nesses
        ;     frames. Roda ANTES do reconcilio (vale mesmo em frame no-op). ---
        jsr nes_chr_pick_mode
        cmp #$01
        bne nhs_noupg
        lda @nes_chr_d0_mode
        cmp #$02
        bne nhs_upg_d1
        lda #$01
        sta @nes_chr_d0_mode
nhs_upg_d1:
        lda @nes_chr_d1_mode
        cmp #$02
        bne nhs_noupg
        lda #$01
        sta @nes_chr_d1_mode
nhs_noupg:
        ldy #$0003
        lda [nes_parse_ptr],y        ; flags: bit0 = s1_present (contrato
        and #$01                     ; pinado; bits 1-7 reservados)
        sta @nes_cspl_s1p            ; v2.3: o CMD_CHR_SPLITS ($13) vem logo
                                      ; DEPOIS deste comando e precisa do MODO
                                      ; (4K/8K) p/ derivar o par de cada faixa.
                                      ; STA nao mexe em flags -> o Z do AND
                                      ; acima sobrevive p/ o bne abaixo.
        bne nhs_4k
        ; 8K: want = (2*s0, 2*s0+1)
        ldy #$0001
        rep #$20 : .al
        lda [nes_parse_ptr],y
        and #$00ff
        asl
        sta @nes_chr_want0
        inc
        sta @nes_chr_want1
        sep #$20 : .as
        bra nhs_recon
nhs_4k:
        ldy #$0001
        rep #$20 : .al
        lda [nes_parse_ptr],y
        and #$00ff
        sta @nes_chr_want0
        sep #$20 : .as
        ldy #$0002
        rep #$20 : .al
        lda [nes_parse_ptr],y
        and #$00ff
        sta @nes_chr_want1
        sta @nes_cspl_s1             ; v2.3: metade PT1 do frame (so' faz
                                      ; sentido no modo 4K -- no 8K o par de
                                      ; cada faixa e' (2b, 2b+1) e o $13 nem le)
        sep #$20 : .as
nhs_recon:
        lda @nes_chr_cur_slot
        bne nhs_cur1
        ; ---------- cur = regiao 0 ----------
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r0_p0
        bne nhs0_notcur
        lda @nes_chr_want1
        cmp @nes_chr_r0_p1
        bne nhs0_notcur
        sep #$20 : .as
        rts                          ; regra 1: match total (caso quente)
nhs0_notcur:
        rep #$20 : .al               ; (redeclara: alvo de branch)
        lda @nes_chr_want0
        cmp @nes_chr_r1_p0
        bne nhs0_noswap
        lda @nes_chr_want1
        cmp @nes_chr_r1_p1
        bne nhs0_noswap
        sep #$20 : .as
        ; --- v2.3 (fix A2): a regra 2 (SWAP zero-DMA) exige a regiao destino
        ;     INTEIRA -- ela passa a valer pra TELA TODA (BG estatico do
        ;     apply_tilebase E o OBSEL/sprites). Ate' a v2.2 nenhuma carga
        ;     podia estar em voo na regiao NAO-corrente (so' a corrente era
        ;     alvo de loader), entao o teste nunca fez falta; a residencia
        ;     SECUNDARIA do $13 (v2.3) fatia justamente a nao-corrente por
        ;     ~32 frames, e basta o banco do frame coincidir com o par sendo
        ;     fatiado pro swap jogar a tela inteira numa VRAM ~30% carregada.
        ;     Em voo => PULA o reconcilio deste frame INTEIRO: nao cascateia
        ;     p/ a regra 3 (seria o retarget cross-regiao do fix A1 por outro
        ;     caminho) nem p/ a regra 4 (frame preto a toa). O CHR_STATE
        ;     republica todo frame -> o swap acontece sozinho quando a carga
        ;     completar (auto-cura, custo = manter a corrente mais 1 frame). ---
        lda #$01
        jsr nes_chr_reg_busy
        bcs nhs0_skip
        lda #$01
        sta @nes_chr_cur_slot        ; regra 2: SWAP p/ regiao 1 (zero DMA)
nhs0_skip:
        rts
nhs0_noswap:
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r0_p0
        bne nhs0_h0diff
        ; h0 igual, h1 difere -> in-place h1 na regiao 0 (regra 3)
        sep #$20 : .as
        lda #$00
        jmp nes_chr_load_h1
nhs0_h0diff:
        rep #$20 : .al
        lda @nes_chr_want1
        cmp @nes_chr_r0_p1
        bne nhs0_miss
        sep #$20 : .as
        lda #$00
        jmp nes_chr_load_h0          ; regra 3: in-place h0
nhs0_miss:
        sep #$20 : .as
        lda #$01
        jmp nes_chr_load_pair        ; regra 4: victim = regiao 1
nhs_cur1:
        ; ---------- cur = regiao 1 (espelho) ----------
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r1_p0
        bne nhs1_notcur
        lda @nes_chr_want1
        cmp @nes_chr_r1_p1
        bne nhs1_notcur
        sep #$20 : .as
        rts
nhs1_notcur:
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r0_p0
        bne nhs1_noswap
        lda @nes_chr_want1
        cmp @nes_chr_r0_p1
        bne nhs1_noswap
        sep #$20 : .as
        lda #$00                     ; v2.3 (fix A2): idem, espelho -- ver a
        jsr nes_chr_reg_busy         ; nota longa no nhs0_notcur
        bcs nhs1_skip
        lda #$00
        sta @nes_chr_cur_slot        ; swap p/ regiao 0
nhs1_skip:
        rts
nhs1_noswap:
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r1_p0
        bne nhs1_h0diff
        sep #$20 : .as
        lda #$01
        jmp nes_chr_load_h1
nhs1_h0diff:
        rep #$20 : .al
        lda @nes_chr_want1
        cmp @nes_chr_r1_p1
        bne nhs1_miss
        sep #$20 : .as
        lda #$01
        jmp nes_chr_load_h0
nhs1_miss:
        sep #$20 : .as
        lda #$00
        jmp nes_chr_load_pair        ; victim = regiao 0

; ------------------------------------------------------------
; nes_chr_load_h0/_h1 -- carga IN-PLACE de UMA metade na regiao A(.as)=0/1:
; atualiza o par-alvo da regiao e arma o loader da metade (want ja em
; nes_chr_want0/1). pick0/pick1 = full/slice + escalada bounded.
; nes_chr_load_pair -- regra 4: victim=A; carrega as metades que diferem do
; conteudo ATUAL do victim (skip por metade), par(victim)=want, cur=A.
; Contexto MAIN. Idempotencia garantida pelo chamador (so chega aqui com
; mudanca real; frames duplicados batem na regra 1 e nunca re-armam).
; ------------------------------------------------------------
; --- v2.3 (fix A1) -- INVALIDACAO DE RETARGET CROSS-REGIAO. r{reg}_p{half}
;     e' registro de ALVO (escrito aqui no ARM, ANTES do DMA), NAO de
;     residencia. Ate' a v2.2 todo retarget de loader era MESMA-REGIAO
;     (regra 3 in-place na corrente / regra 4 no victim que vira corrente),
;     entao a distincao nunca importou. A residencia SECUNDARIA do $13
;     (v2.3) carrega a regiao NAO-corrente por SLICE (~32 frames): nessa
;     janela um CHR_STATE seguinte pode retargetar o MESMO loader pra OUTRA
;     regiao -- a regiao abandonada fica com a VRAM MEIO carregada enquanto
;     r{X}_p{half} continua afirmando que o par esta' la'. O reg_busy nao
;     pega (o loader ja aponta pro novo destino) => nes_cspl_resolve casaria
;     essa regiao e a faixa ficaria embaralhada PARA SEMPRE (o reconciliador
;     nunca recarrega porque acredita no r*_p*). FIX: no retarget
;     cross-regiao, marcar a metade da regiao ABANDONADA como VAZIA
;     (NES_CHR_BANK_EMPTY, a mesma sentinela do boot/regiao 1 vazia) -- o
;     resolve para de casar (fallback correto) e o reconciliador/secondary
;     recarrega depois. Auto-cura preservada, zero DMA extra.
nes_chr_load_h0:
        sta nes_cl0_reg              ; regiao NOVA (scratch DEDICADO desta
                                      ; rotina -- nada compartilhado)
        ; --- v2.2-lite: com CHR-RAM a residencia por BANCO nao existe (o
        ;     mapper 2/7 tem 8KB fixos) e a fonte pre-convertida da PSRAM
        ;     ($50/$60) e' ZERADA pelo loader -- um DMA dali APAGARIA os
        ;     tiles que o CMD_CHR_RUN acabou de escrever. Este e' o UNICO
        ;     ponto (com o _h1) que arma DMA de banco, entao gatear aqui torna
        ;     TODO o caminho v2.2/v2.3 inerte (o load_pair e o
        ;     nes_cspl_secondary so' chegam ao DMA por estas duas rotinas).
        ;     Na pratica o reconciliador nem chega aqui em mapper 2 (o $12
        ;     publica s0=0/s1p=0 -> want=(0,1) = o par residente do boot ->
        ;     regra 1), mas isso e' COINCIDENCIA do RTL; o gate faz da
        ;     inercia uma construcao.
        ;     O gate e' AMNESICO de proposito (achado do A10): ele sai ANTES
        ;     de escrever nes_cl0_reg em @nes_chr_d0_reg e antes de atualizar
        ;     r{reg}_p0. Isso e' correto porque em CHR-RAM NENHUM estado de
        ;     residencia deve avancar -- o loader d0 fica ocioso, r0 continua
        ;     valendo o par (0,1) do boot e r1 continua EMPTY, que e'
        ;     exatamente o que mantem a regra 1 (match total) ganhando todo
        ;     frame e a regra 2 (swap) sem nunca casar. O 'sta nes_cl0_reg'
        ;     acima vira dead store nesse caminho, e e' so' isso. ---
        lda @nes_chr_ram_mode
        beq nlh0_go
        rts
nlh0_go:
        lda @nes_chr_d0_mode
        beq nlh0_noinv               ; loader ocioso: nada a invalidar
        lda @nes_chr_d0_reg          ; regiao ANTIGA
        cmp nes_cl0_reg
        beq nlh0_noinv               ; mesmo destino: retarget seguro (v2.2)
        cmp #$01                     ; A = regiao ABANDONADA
        beq nlh0_inv1
        rep #$20 : .al
        lda #NES_CHR_BANK_EMPTY
        sta @nes_chr_r0_p0
        sep #$20 : .as
        bra nlh0_noinv
nlh0_inv1:
        rep #$20 : .al
        lda #NES_CHR_BANK_EMPTY
        sta @nes_chr_r1_p0
        sep #$20 : .as
nlh0_noinv:
        lda nes_cl0_reg
        sta @nes_chr_d0_reg
        cmp #$01
        beq nlh0_r1
        rep #$20 : .al
        lda @nes_chr_want0
        sta @nes_chr_r0_p0
        bra nlh0_arm
nlh0_r1:
        rep #$20 : .al
        lda @nes_chr_want0
        sta @nes_chr_r1_p0
nlh0_arm:
        sep #$20 : .as
        jsr nes_chr_pick0            ; A(.as) = modo (escalada-aware)
        pha
        rep #$20 : .al
        lda @nes_chr_want0
        sta @nes_chr_d0_bank
        lda #$0000
        sta @nes_chr_d0_cursor
        sep #$20 : .as
        pla
        sta @nes_chr_d0_mode
        rts

nes_chr_load_h1:
        ; v2.3 (fix A1): espelho exato do nes_chr_load_h0 -- ver a nota longa
        ; la' em cima (metade PT1 / loader d1 / r*_p1).
        sta nes_cl1_reg              ; regiao NOVA (scratch DEDICADO)
        lda @nes_chr_ram_mode        ; v2.2-lite: gate CHR-RAM (ver _h0)
        beq nlh1_go
        rts
nlh1_go:
        lda @nes_chr_d1_mode
        beq nlh1_noinv
        lda @nes_chr_d1_reg          ; regiao ANTIGA
        cmp nes_cl1_reg
        beq nlh1_noinv               ; mesmo destino: retarget seguro (v2.2)
        cmp #$01                     ; A = regiao ABANDONADA
        beq nlh1_inv1
        rep #$20 : .al
        lda #NES_CHR_BANK_EMPTY
        sta @nes_chr_r0_p1
        sep #$20 : .as
        bra nlh1_noinv
nlh1_inv1:
        rep #$20 : .al
        lda #NES_CHR_BANK_EMPTY
        sta @nes_chr_r1_p1
        sep #$20 : .as
nlh1_noinv:
        lda nes_cl1_reg
        sta @nes_chr_d1_reg
        cmp #$01
        beq nlh1_r1
        rep #$20 : .al
        lda @nes_chr_want1
        sta @nes_chr_r0_p1
        bra nlh1_arm
nlh1_r1:
        rep #$20 : .al
        lda @nes_chr_want1
        sta @nes_chr_r1_p1
nlh1_arm:
        sep #$20 : .as
        jsr nes_chr_pick1
        pha
        rep #$20 : .al
        lda @nes_chr_want1
        sta @nes_chr_d1_bank
        lda #$0000
        sta @nes_chr_d1_cursor
        sep #$20 : .as
        pla
        sta @nes_chr_d1_mode
        rts

nes_chr_load_pair:
        pha                          ; victim (0/1), push/pull 8-bit casados
        ; --- v2.2b (ii) regra-4 = FULL mesmo com rendering ON: troca de PAR
        ;     completo e' transicao de tela por natureza -- 1 frame preto
        ;     limpo (release em vblank ja validado) em vez de ~16 frames de
        ;     tiles mistos. Trocas de UMA metade (regra 3, in-game) continuam
        ;     slice (sem frame preto no meio do jogo). ---
        lda #$01
        sta @nes_chr_force_full
        pla
        pha
        cmp #$01
        beq nlp_r1
        ; victim = regiao 0: skip por metade se o conteudo ja bate
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r0_p0
        beq nlp0_h1
        sep #$20 : .as
        lda #$00
        jsr nes_chr_load_h0
nlp0_h1:
        rep #$20 : .al               ; (redeclara: alvo de branch)
        lda @nes_chr_want1
        cmp @nes_chr_r0_p1
        beq nlp_done
        sep #$20 : .as
        lda #$00
        jsr nes_chr_load_h1
        bra nlp_done
nlp_r1:
        rep #$20 : .al
        lda @nes_chr_want0
        cmp @nes_chr_r1_p0
        beq nlp1_h1
        sep #$20 : .as
        lda #$01
        jsr nes_chr_load_h0
nlp1_h1:
        rep #$20 : .al
        lda @nes_chr_want1
        cmp @nes_chr_r1_p1
        beq nlp_done
        sep #$20 : .as
        lda #$01
        jsr nes_chr_load_h1
nlp_done:
        sep #$20 : .as
        lda #$00
        sta @nes_chr_force_full      ; regra-4 encerrada
        pla
        sta @nes_chr_cur_slot        ; exibe o victim (tile-base no vblank)
        rts

; ------------------------------------------------------------
; nes_chr_pick_mode -- modo de um loader novo: A(.as) = 1 (full forced-
; blank: FLAG_FORCED_BLANK do frame OU rendering OFF) / 2 (slice).
; nes_chr_pick0/pick1 -- + escalada bounded: retarget de um slice em voo
; fora de cooldown => full (1 frame escuro; max 1/NES_CHR_ESC_COOLDOWN).
; ------------------------------------------------------------
nes_chr_pick_mode:
        sep #$20 : .as
        lda @nes_chr_frame_fb
        bne ncpm_full
        lda @nes_regs_ppumask
        and #$18
        beq ncpm_full
        lda #$02
        rts
ncpm_full:
        lda #$01
        rts
nes_chr_pick0:
        sep #$20 : .as
        lda @nes_chr_force_full      ; v2.2b regra-4 (load_pair)
        beq np0_chk_esc
        lda #$01
        rts
np0_chk_esc:
        lda @nes_chr_d0_mode
        cmp #$02
        bne np0_normal
        lda @nes_chr_esc_cool
        bne np0_normal
        lda #NES_CHR_ESC_COOLDOWN
        sta @nes_chr_esc_cool
        lda #$01
        rts
np0_normal:
        jmp nes_chr_pick_mode
nes_chr_pick1:
        sep #$20 : .as
        lda @nes_chr_force_full
        beq np1_chk_esc
        lda #$01
        rts
np1_chk_esc:
        lda @nes_chr_d1_mode
        cmp #$02
        bne np1_normal
        lda @nes_chr_esc_cool
        bne np1_normal
        lda #NES_CHR_ESC_COOLDOWN
        sta @nes_chr_esc_cool
        lda #$01
        rts
np1_normal:
        jmp nes_chr_pick_mode

; ------------------------------------------------------------
; nes_chr_cool_tick -- (NMI) decrementa o cooldown da escalada (1x/apply).
; ------------------------------------------------------------
nes_chr_cool_tick:
        sep #$20 : .as
        lda @nes_chr_esc_cool
        beq nct_done
        dec
        sta @nes_chr_esc_cool
nct_done:
        rts

; ============================================================
; ==== CHR: RASTER-SPLIT via HDMA de BG12NBA (v2.3) ====
; PROBLEMA (medido no RoboCop 2, MMC1 4K): o jogo troca o banco s0 (BG)
; MID-FRAME em TODO frame -- HUD nas scanlines 0-31 com um banco e playfield
; do 32 em diante com outro (no titulo a fronteira vai ate' ~119). O
; CMD_CHR_STATE ($12) so' carrega UM estado por frame, entao a faixa que nao
; casa renderiza com os tiles do banco errado (topo embaralhado permanente).
;
; SOLUCAO: as DUAS regioes de VRAM ja existem e ja ficam residentes (o
; reconciliador v2.2 mantem uma; a residencia secundaria abaixo mantem a
; outra) -- basta trocar o CHAR-BASE da BG1 por faixa de scanline. Isso e'
; UM byte por linha em $210B (BG12NBA) => HDMA canal 3, mode 0 (1 reg, 1
; byte), tabela non-repeat [line_count, byte]* + $00. ZERO DMA por faixa,
; zero custo no display. Sprites NAO precisam (a medicao mostra que chr1
; nunca troca mid-frame) -> OBSEL continua estatico.
;
; DIVISAO DE TRABALHO com o reconciliador ($12, roda ANTES neste mesmo
; frame): o $12 continua dono de QUEM esta' residente em cada regiao e de
; qual regiao e' a CORRENTE (nes_chr_cur_slot -- a que o
; nes_chr_apply_tilebase escreve estaticamente e a que os sprites usam). O
; $13 NAO muda residencia da corrente e NAO troca a corrente: ele so'
; (a) resolve, por faixa, QUAL regiao ja tem o par certo e monta a tabela, e
; (b) quando uma faixa nao acha o par em regiao nenhuma, pede a residencia
; SECUNDARIA (carga do par alternativo na regiao NAO-corrente) -- so' com os
; dois loaders ociosos, sem force_full e no maximo 1 par por frame.
; Idempotente/auto-curavel: o $13 re-publica tudo TODO frame, entao um frame
; perdido ou um loader ocupado nunca deixa estado errado permanente.
; ------------------------------------------------------------
; nes_chr_handle_splits -- CMD_CHR_SPLITS (contexto MAIN, display ativo):
; hdr em Y=1 (bit7=overflow informativo; [3:0]=cnt 2..4), entradas de 2B
; [scanline(1) s0_bank(1)] a partir de Y=2. Escreve no buffer do FRAME EM
; DECODE (chdma_tab0/1 conforme nes_fb_target, igual ao split de scroll) e
; seta nes_cspl_pend; o COMMIT pra NMI acontece no fecho do frame
; (nes_fb_commit -> fb_regs+13). Devolve o tamanho TLV em X.
; ------------------------------------------------------------
nes_chr_handle_splits:
        sep #$20 : .as
        rep #$10 : .xl
        ldy #$0001
        lda [nes_parse_ptr],y
        and #$0f
        sta nes_cs_cnt
        cmp #$02
        bcs nchs_go
        rep #$20 : .al            ; cnt<2 (defensivo): frame sem raster-split
        lda #$0000                ; -> deadband recomeca fresh no proximo
        sta @nes_cspl_prev_cnt    ; frame que tiver splits. @ OBRIGATORIO
        sep #$20 : .as            ; (banco $7F -- sem ele o snescom monta
        lda #$00                  ; ABSOLUTO contra o DBR e linka SEM erro)
        sta @nes_cspl_cnt
        brl nchs_size
nchs_go:
        cmp #$05
        bcc nchs_cnt_ok
        lda #$04                  ; clamp K<=4 (contrato)
        sta nes_cs_cnt
nchs_cnt_ok:
        sta @nes_cspl_cnt         ; espelho do cnt clampado (debug/gate)
        ; a tabela segue o FRAME BUFFER alvo (target 1 -> tab0, 2 -> tab1);
        ; o display nunca le tab0/tab1, so' a nes_chdma_live copiada no NMI
        rep #$10 : .xl
        ldx #!nes_chdma_tab0
        stx nes_cs_tab
        lda @nes_fb_target
        cmp #$02
        bne nchs_buf_ok
        ldx #!nes_chdma_tab1
        stx nes_cs_tab
nchs_buf_ok:
        lda #^nes_chdma_tab0
        sta nes_cs_tabb
        rep #$20 : .al
        lda #$0000
        sta nes_cs_off
        sta nes_cs_idx
        lda #$0002
        sta nes_cs_y              ; offset da 1a entrada no payload
        sep #$20 : .as
        lda #$00
        sta nes_cs_armed

        ; --- PRE-PASS: (1) DEADBAND da fronteira de faixa -- ESPELHO EXATO
        ;     do pre-passe do split de scroll (nes_handle_splits): entrada j
        ;     que ja existia (idx < prev_cnt) com |sl_nova - sl_EMITIDA
        ;     anterior| <= 1 mantem a anterior PARA SEMPRE; |dsl| >= 2 =
        ;     mudanca real de layout -> adota na hora. Guarda a EMITIDA (nao
        ;     a crua), senao o jitter de +-1 volta a alternar. prev_cnt =
        ;     entradas*2 (0 = frame anterior sem splits -> 1o frame nunca
        ;     snapa). (2) resolve o byte de BG12NBA de cada entrada (a
        ;     residencia so' muda dentro deste pre-pass, entao o build ja' le
        ;     um mapa estavel).
        ;     LIMITACAO COSMETICA DOCUMENTADA: este deadband e' INDEPENDENTE
        ;     do deadband do split de SCROLL (nes_sp_prev_*). Quando o $11 e
        ;     o $13 reportam a MESMA fronteira, os dois podem travar em
        ;     valores que diferem de 1 linha -- e travam PARA SEMPRE (e' o
        ;     proprio ponto do deadband). Resultado: a fronteira de scroll e
        ;     a de tile-base podem ficar 1px deslocadas entre si. Unificar os
        ;     dois estados seria errado (as fronteiras sao independentes por
        ;     natureza: um jogo pode trocar scroll numa linha e banco em
        ;     outra), e a ALTERNANCIA -- que era o bug -- continua morta nos
        ;     dois. ---
        lda nes_cs_cnt
        sta nes_cs_pcnt
nchs_pre_loop:
        rep #$10 : .xl
        ldy nes_cs_y
        lda [nes_parse_ptr],y     ; sl crua da entrada
        rep #$20 : .al
        and #$00ff
        sta nes_cs_slraw
        lda nes_cs_idx
        cmp @nes_cspl_prev_cnt
        bcs nchs_pre_store        ; idx >= prev_cnt: entrada nova -> adota raw
        tax                       ; X = byte-offset da entrada (0,2,4,6)
        lda nes_cs_slraw
        sec
        sbc @nes_cspl_prev_sl,x   ; dsl = raw - emitida anterior
        bcs nchs_pre_pos
        eor #$ffff
        inc                       ; abs (complemento de 2)
nchs_pre_pos:
        cmp #$0002
        bcs nchs_pre_store        ; |dsl| >= 2: layout real moveu -> adota raw
        lda @nes_cspl_prev_sl,x   ; |dsl| <= 1: DEADBAND -> mantem a emitida
        sta nes_cs_slraw
nchs_pre_store:
        ldx nes_cs_idx
        lda nes_cs_slraw          ; = valor EMITIDO desta entrada
        sta @nes_cspl_sl,x        ; o build le daqui (S0 e S1, 2 papeis)
        sta @nes_cspl_prev_sl,x   ; e o deadband do proximo frame ancora nele
        sep #$20 : .as
        ; --- banco cru da entrada -> par 4K -> byte de BG12NBA ---
        rep #$10 : .xl
        ldy nes_cs_y
        iny
        lda [nes_parse_ptr],y     ; s0_bank da entrada
        rep #$20 : .al
        and #$00ff
        sta nes_cs_bnk
        ldx nes_cs_idx
        sta @nes_cspl_bank,x      ; espelho cru (debug/gate)
        sep #$20 : .as
        jsr nes_cspl_pair         ; -> nes_cs_pair0/nes_cs_pair1
        jsr nes_cspl_resolve      ; A(.as) = byte de BG12NBA da faixa
        ldx nes_cs_idx
        sta @nes_cspl_nba,x
        rep #$20 : .al            ; avanca entrada: idx+=2, y+=2
        lda nes_cs_idx
        clc
        adc #$0002
        sta nes_cs_idx
        lda nes_cs_y
        clc
        adc #$0002
        sta nes_cs_y
        sep #$20 : .as
        dec nes_cs_pcnt
        beq nchs_pre_done
        brl nchs_pre_loop
nchs_pre_done:
        rep #$20 : .al            ; prev_cnt = entradas*2 (=idx); reset do idx
        lda nes_cs_idx            ; (nes_cs_y nao precisa de reset: e' EXCLUSIVO
        sta @nes_cspl_prev_cnt    ;  do pre-pass, o build nao le o payload)
        lda #$0000
        sta nes_cs_idx
        sep #$20 : .as
        jsr nes_cspl_build
        brl nchs_size             ; (BRL: o corpo do build fica entre este
                                   ;  ponto e o nchs_size, fora do alcance
                                   ;  de +-127 de um BRA)

; ------------------------------------------------------------
; nes_cspl_build -- ESTAGIO DE BUILD da tabela HDMA de tile-base,
; COMPARTILHADO pelo $13 (par 4K, v2.3) e pelo $15 (vetor de 8 janelas,
; v2.3w). Le SO' estado ja resolvido -- nes_cs_cnt (entradas), @nes_cspl_sl
; (scanline EMITIDA por entrada, pos-deadband) e @nes_cspl_nba (byte de
; $210B por entrada) -- e nunca o payload; por isso os dois produtores
; podem ser completamente diferentes. Chamador prepara: nes_cs_cnt,
; nes_cs_idx=0, nes_cs_off=0, nes_cs_tab/nes_cs_tabb. Entra/sai .as; deixa
; @nes_cspl_pend = id do buffer (1=tab0 / 2=tab1).
; ------------------------------------------------------------
nes_cspl_build:
        sep #$20 : .as
        rep #$10 : .xl

        ; --- BUILD: faixas com as scanlines SNAPPED do pre-pass. Conversao
        ;     pro viewport identica a do split de scroll: NES sl -> SNES
        ;     sl-VIEWPORT_CROP_Y; faixa que morre acima do corte e' ABSORVIDA
        ;     (count 0 nao emite, e a faixa seguinte comeca na linha 0 --
        ;     as entradas HDMA sao SEQUENCIAIS, nao carregam linha absoluta,
        ;     e S1_j == S0_j+1 por construcao); faixa > 127 linhas vira 2
        ;     pares (NUNCA setar bit7 = seria repeat mode = 1 byte POR
        ;     LINHA, que exigiria uma tabela de 224B). ---
nchs_loop:
        rep #$10 : .xl
        rep #$20 : .al
        ldx nes_cs_idx            ; S0 = max(0, sl[idx] - CROP)
        lda @nes_cspl_sl,x
        sec
        sbc #VIEWPORT_CROP_Y
        bcs nchs_s0_ok
        lda #$0000                ; acima do corte: comeca na linha 0
nchs_s0_ok:
        sta nes_cs_s0
        sep #$20 : .as
        ldx nes_cs_idx
        lda @nes_cspl_nba,x       ; byte de $210B desta faixa (byte baixo)
        sta nes_cs_nba
        ; S1 = sl[idx+2] croppada (proxima entrada), ou 224 (ultima)
        lda nes_cs_cnt
        cmp #$02
        bcs nchs_have_next
        rep #$20 : .al
        lda #224
        sta nes_cs_s1
        bra nchs_count
nchs_have_next:
        rep #$20 : .al
        lda nes_cs_idx
        clc
        adc #$0002
        tax
        lda @nes_cspl_sl,x
        sec
        sbc #VIEWPORT_CROP_Y
        bcs nchs_s1_ok
        lda #$0000
nchs_s1_ok:
        sta nes_cs_s1
nchs_count:
        ; count = S1 - S0; 0 (ou negativo, defensivo) = faixa absorvida
        lda nes_cs_s1
        sec
        sbc nes_cs_s0
        beq nchs_next
        bcc nchs_next
        sta nes_cs_c
nchs_emit_loop:
        lda nes_cs_c
        cmp #$0080
        bcc nchs_emit_last
        sec
        sbc #$007f
        sta nes_cs_c
        sep #$20 : .as
        lda #$7f
        jsr nchs_emit2
        rep #$20 : .al
        bra nchs_emit_loop
nchs_emit_last:
        sep #$20 : .as
        lda nes_cs_c              ; 1..127 (byte baixo)
        jsr nchs_emit2
nchs_next:
        rep #$20 : .al            ; (textual + runtime: chega .al ou .as)
        ; (o build NAO avanca nes_cs_y: diferente do split de scroll, ele nao
        ;  re-le o payload -- a sl ja veio snapada em @nes_cspl_sl e o byte de
        ;  BG12NBA ja veio resolvido em @nes_cspl_nba, ambos pelo pre-pass)
        lda nes_cs_idx
        clc
        adc #$0002
        sta nes_cs_idx
        sep #$20 : .as
        lda nes_cs_cnt
        dec
        sta nes_cs_cnt
        beq nchs_fin
        brl nchs_loop
nchs_fin:
        ; terminador + registra o buffer pro commit do fecho do frame
        phy
        rep #$10 : .xl
        ldy nes_cs_off
        lda #$00
        sta [nes_cs_tab],y
        ply
        lda #$01
        ldx nes_cs_tab
        cpx #!nes_chdma_tab0
        beq nchs_pend_ok
        lda #$02
nchs_pend_ok:
        sta @nes_cspl_pend
        rts                       ; fim de nes_cspl_build

nchs_size:
        ; tamanho TLV = 2 + 2*cnt DO HEADER (nao o clampado!)
        rep #$10 : .xl
        ldy #$0001
        lda [nes_parse_ptr],y
        rep #$20 : .al
        and #$000f
        asl                       ; *2
        clc
        adc #$0002
        tax
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nchs_emit2 -- escreve [A(count), nes_cs_nba] na tabela corrente
; ([nes_cs_tab],y por nes_cs_off). Entra/sai .as; preserva Y do chamador.
; GUARD de 14: par(2B) + terminador(1B) sempre cabem nos 16B da tabela --
; o pior caso real e' 11B, o guard e' seguro contra encoding inesperado
; (uma faixa a mais nunca pode virar escrita fora da tabela).
; ------------------------------------------------------------
nchs_emit2:
        phy
        rep #$10 : .xl
        ldy nes_cs_off
        cpy #14
        bcs nche2_full
        sta [nes_cs_tab],y
        iny
        lda nes_cs_nba
        sta [nes_cs_tab],y
        iny
        sty nes_cs_off
nche2_full:
        ply
        rts

; ------------------------------------------------------------
; nes_cspl_pair -- par 4K da entrada corrente a partir de nes_cs_bnk (banco
; cru) e do MODO do CMD_CHR_STATE deste frame: 4K -> (bank, s1_bank);
; 8K -> (2*bank, 2*bank+1). MESMA formula do reconciliador (want0/want1),
; e' o que faz a comparacao com o par residente ser byte-exata. Entra/sai .as.
; ------------------------------------------------------------
nes_cspl_pair:
        sep #$20 : .as
        lda @nes_cspl_s1p
        beq ncpr_8k
        rep #$20 : .al
        lda nes_cs_bnk
        sta nes_cs_pair0
        lda @nes_cspl_s1
        sta nes_cs_pair1
        sep #$20 : .as
        rts
ncpr_8k:
        rep #$20 : .al
        lda nes_cs_bnk
        asl
        sta nes_cs_pair0
        inc
        sta nes_cs_pair1
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_cspl_resolve -- devolve em A(.as) o byte de BG12NBA da faixa cujo par
; esta' em nes_cs_pair0/1. Politica (3 casos):
;   par == par(regiao CORRENTE)                    -> NBA da corrente
;   par == par(regiao OTHER) e sem loader em voo la' -> NBA da other
;   senao -> FALLBACK = NBA da CORRENTE (nunca pior que o comportamento
;            v2.2, que usava a corrente pro frame inteiro) + pedido de
;            residencia SECUNDARIA na other (nes_cspl_secondary).
; O teste de loader em voo e' obrigatorio: durante um slice a regiao tem
; conteudo MISTO, e apontar a BG pra ela mostraria tiles pela metade.
; Entra/sai .as (X/Y intactos -- o pre-pass depende disso).
; ------------------------------------------------------------
nes_cspl_resolve:
        sep #$20 : .as
        lda @nes_chr_cur_slot
        bne ncrs_cur1
        ; ---------- regiao corrente = 0 ----------
        rep #$20 : .al
        lda nes_cs_pair0
        cmp @nes_chr_r0_p0
        bne ncrs0_notcur
        lda nes_cs_pair1
        cmp @nes_chr_r0_p1
        bne ncrs0_notcur
        sep #$20 : .as
        lda #NES_CHR_BG12NBA_SLOT0
        rts
ncrs0_notcur:
        rep #$20 : .al            ; (redeclara: alvo de branch)
        lda nes_cs_pair0
        cmp @nes_chr_r1_p0
        bne ncrs0_miss
        lda nes_cs_pair1
        cmp @nes_chr_r1_p1
        bne ncrs0_miss
        sep #$20 : .as
        lda #$01                  ; par vive na regiao 1
        jsr nes_chr_reg_busy
        bcs ncrs0_fallback        ; carga em voo la' -> conteudo misto
        lda #NES_CHR_BG12NBA_SLOT1
        rts
ncrs0_miss:
        sep #$20 : .as
        lda #$01                  ; other = regiao 1
        jsr nes_cspl_secondary
ncrs0_fallback:
        lda #NES_CHR_BG12NBA_SLOT0
        rts
ncrs_cur1:
        ; ---------- regiao corrente = 1 (espelho) ----------
        rep #$20 : .al
        lda nes_cs_pair0
        cmp @nes_chr_r1_p0
        bne ncrs1_notcur
        lda nes_cs_pair1
        cmp @nes_chr_r1_p1
        bne ncrs1_notcur
        sep #$20 : .as
        lda #NES_CHR_BG12NBA_SLOT1
        rts
ncrs1_notcur:
        rep #$20 : .al
        lda nes_cs_pair0
        cmp @nes_chr_r0_p0
        bne ncrs1_miss
        lda nes_cs_pair1
        cmp @nes_chr_r0_p1
        bne ncrs1_miss
        sep #$20 : .as
        lda #$00                  ; par vive na regiao 0
        jsr nes_chr_reg_busy
        bcs ncrs1_fallback
        lda #NES_CHR_BG12NBA_SLOT0
        rts
ncrs1_miss:
        sep #$20 : .as
        lda #$00                  ; other = regiao 0
        jsr nes_cspl_secondary
ncrs1_fallback:
        lda #NES_CHR_BG12NBA_SLOT1
        rts

; ------------------------------------------------------------
; nes_chr_reg_busy -- A(.as) = regiao (0/1); carry SET = algum loader por
; metade (d0/d1) esta' ARMADO pra essa regiao => a VRAM dela esta' MEIO
; carregada e ninguem pode exibi-la. O reg de destino (d*_reg) so' vale com
; mode != 0 (ele nao e' limpo no fim da carga) -- por isso o mode e' testado
; PRIMEIRO. COMPARTILHADO por dois chamadores: o reconciliador do $12
; (regra 2, fix A2) e o nes_cspl_resolve do $13. Scratch PROPRIO
; (nes_crb_rq), nunca o de outra rotina. Entra/sai .as; X/Y intactos.
; ------------------------------------------------------------
nes_chr_reg_busy:
        sep #$20 : .as
        sta nes_crb_rq
        lda @nes_chr_d0_mode
        beq ncif_d1
        lda @nes_chr_d0_reg
        cmp nes_crb_rq
        beq ncif_busy
ncif_d1:
        lda @nes_chr_d1_mode
        beq ncif_free
        lda @nes_chr_d1_reg
        cmp nes_crb_rq
        beq ncif_busy
ncif_free:
        clc
        rts
ncif_busy:
        sec
        rts

; ------------------------------------------------------------
; nes_cspl_secondary -- A(.as) = regiao ALVO (a NAO-corrente): programa a
; carga do par da faixa (nes_cs_pair0/1) nessa regiao, so' as metades que
; DIFEREM do conteudo atual dela. CONDICOES (todas obrigatorias):
;   - os DOIS loaders (d0/d1) ociosos: sao um par unico compartilhado com o
;     reconciliador, que ja rodou neste frame -- se ele armou algo, o $13
;     nao pode pisotear (o $12 e' o dono da regiao CORRENTE);
;   - no maximo UM par alternativo por frame (nes_cs_armed).
; NAO toca nes_chr_cur_slot (a regiao exibida/OBSEL continua a mesma) e NAO
; liga nes_chr_force_full (uma faixa nao justifica frame preto -- slice
; normal; pick0/pick1 ainda escolhem full sozinhos num frame ja escuro).
; Sem loader livre = NO-OP: o $13 re-publica tudo todo frame, entao a
; residencia converge sozinha no frame seguinte (auto-cura, mesma
; disciplina do reconciliador). Entra/sai .as.
; NOTA: escreve nes_chr_want0/1 (os loaders leem de la'). E' seguro: o $12
; deste frame ja reconciliou e nao le mais os wants, e o $12 do proximo
; frame os reescreve do zero antes de qualquer uso.
; ------------------------------------------------------------
nes_cspl_secondary:
        sep #$20 : .as
        sta nes_cs_rq
        lda nes_cs_armed
        bne ncsec_done
        lda @nes_chr_d0_mode
        bne ncsec_done
        lda @nes_chr_d1_mode
        bne ncsec_done
        lda #$01
        sta nes_cs_armed
        rep #$20 : .al
        lda nes_cs_pair0
        sta @nes_chr_want0
        lda nes_cs_pair1
        sta @nes_chr_want1
        sep #$20 : .as
        lda nes_cs_rq
        bne ncsec_r1
        ; ---- alvo = regiao 0 ----
        rep #$20 : .al
        lda nes_cs_pair0
        cmp @nes_chr_r0_p0
        beq ncsec_r0_h1
        sep #$20 : .as
        lda #$00
        jsr nes_chr_load_h0
ncsec_r0_h1:
        rep #$20 : .al            ; (redeclara: alvo de branch)
        lda nes_cs_pair1
        cmp @nes_chr_r0_p1
        beq ncsec_fin
        sep #$20 : .as
        lda #$00
        jsr nes_chr_load_h1
        bra ncsec_fin
ncsec_r1:
        ; ---- alvo = regiao 1 ----
        rep #$20 : .al
        lda nes_cs_pair0
        cmp @nes_chr_r1_p0
        beq ncsec_r1_h1
        sep #$20 : .as
        lda #$01
        jsr nes_chr_load_h0
ncsec_r1_h1:
        rep #$20 : .al
        lda nes_cs_pair1
        cmp @nes_chr_r1_p1
        beq ncsec_fin
        sep #$20 : .as
        lda #$01
        jsr nes_chr_load_h1
ncsec_fin:
        sep #$20 : .as
ncsec_done:
        rts

; ============================================================
; ==== CHR: RECONCILIADOR DE JANELAS DE 1KB (v2.3w -- mapper 4 / MMC3) ====
;
; O MMC3 troca a visao de 8KB da PPU em OITO janelas de 1KB independentes.
; O protocolo publica isso como ESTADO ABSOLUTO (CMD_CHR_STATE8 $14 = vetor
; win[0..7], ja normalizado no RTL) e, quando ha troca mid-frame, como
; SNAPSHOT ABSOLUTO POR FAIXA (CMD_CHR_SPLITS8 $15). Tudo o mais e' o que o
; v2.2/v2.3 ja fazia: 2 REGIOES de VRAM, HDMA de $210B (canal 3) por faixa,
; carga full (forced-blank) x slice, fallback pra regiao corrente. O par de
; 4KB do $12 e' o CASO PARTICULAR deste vetor (win[k] = 2*s0+k / etc.) --
; por isso o caminho v2.2/v2.3 continua INTACTO para os mappers 0-3/7 e o
; modo janela so' liga quando o $14 aparece.
;
; DIVISAO DE TRABALHO POR FRAME:
;   $14 sem $15  -> composicao UNICA: reconcilia na hora.
;   $14 com $15  -> o $14 so' guarda o vetor (breadcrumb); quem reconcilia e'
;                   o $15, porque a POLITICA DE RESIDENCIA e' por COBERTURA
;                   DE SCANLINES (design SS4.4) e so' ele conhece as faixas.
;
; POLITICA DE RESIDENCIA (OBRIGATORIA, nao e' refinamento): com 2 regioes so'
; DUAS composicoes ficam residentes, e uma janela presente nas DUAS custa
; 2x (tem de ser escrita nas duas). Escolher "por ordem de chegada" deixaria
; um write de restauracao que cobre 1 LINHA expulsar uma composicao de 200.
; Entao: soma-se a cobertura (em linhas SNES pos-crop) de cada composicao
; DISTINTA das faixas e ficam residentes as DUAS de maior cobertura --
; primaria na regiao CORRENTE (a que o apply_tilebase/OBSEL exibe) e
; secundaria na regiao NAO-corrente. Faixas 3-4 (K=4 e' o teto do protocolo)
; caem no FALLBACK = NBA da corrente, "nunca pior que o v2.2".
;
; CORTE DE PLANO (design SS4.5): PPUCTRL bit4 escolhe a pattern table do BG e
; o bit3 a dos sprites. Quando diferem, 4 janelas sao SO-BG (1024 B em vez de
; 3072) e 4 so-OBJ; quando o jogo nao usa uma metade em camada nenhuma, ela
; nem e' carregada. CONDICAO: com sprites 8x16 (bit5) o bit0 do indice do
; tile escolhe a tabela e o bit3 e' IGNORADO -> todas as janelas viram
; OBJ-relevantes e o corte NAO vale. A materializacao do que faltava quando
; bg_patt/spr_patt mudam e' um MISS NORMAL do reconciliador (o diff compara
; id E planos), nao um caso especial.
;
; DUPLICATAS (R2=R3=R4=R5 do MMC3, design SS5.5): a residencia e' indexada
; por k, nunca por id -- duas janelas com o mesmo id sao carregadas DUAS
; vezes, uma em cada k. Nao existe lookup inverso.
;
; CHR-RAM x MMC3 (design SS5.1): com chr_mask=0 as 8 janelas apontam pros
; MESMOS 8KB e o vetor vira a IDENTIDADE -- que e' exatamente o estado que o
; boot instala (r0[k]=k). O reconciliador nasce em HIT total e nunca arma
; nada; e o servico de DMA e' gateado por nes_chr_ram_mode do mesmo jeito que
; o loader v2.2 (a fonte PSRAM $50/$60 e' ZERADA em CHR-RAM -- um DMA dali
; apagaria os tiles que o $41 acabou de escrever). Banking NAO-identidade em
; CHR-RAM (Kirby) e' a 2.2-full: fica como limitacao documentada (a janela
; nao carrega, a tela mostra a identidade), NUNCA como corrupcao.
;
; INDICE: todo array deste bloco e' ESPACADO EM WORD e percorrido por
; X = k*2 (0,2,..,14) -- residencia, planos e composicao usam o MESMO X. O
; 65816 nao tem LONG,Y, entao comparar duas matrizes em $7F exige isso; a
; composicao sob exame e' sempre copiada pro buffer unico nes_chrw_cmp.
;
; CORRIDAS MAIN x NMI -- as duas conhecidas, ambas BENIGNAS por construcao
; (documentadas por exigencia do A13; nao tentar "consertar" sem medir):
;  1. dclear (NMI) caindo entre o `pl[k]=0` e o set do bit de pendencia do arm
;     (MAIN): a regiao afirma residencia por ~1 carga com a VRAM ainda velha.
;     Auto-cura no proximo apply (o bit fica setado e a janela carrega).
;  2. RMW do pend0/1: MAIN faz `lda/ora/sta` pra LIGAR bit e a NMI faz
;     `lda/and/sta` pra DESLIGAR. Um clear perdido custa uma RECARGA
;     IDEMPOTENTE da mesma janela (<=4 vblanks de slice, dados identicos);
;     um SET perdido nao mente porque o arm zera pl[k] ANTES (ver
;     nes_chrw_wr). Nenhum dos dois pode produzir residencia falsa.
; GAP DE 1 FRAME (F5): janela PENDENTE com o id certo nao e' re-armada (senao
; o cursor do slice reinicia todo frame = livelock). Se o `need` CRESCER
; nesse meio tempo (troca de pattern table do PPUCTRL), o job termina com os
; planos ANTIGOS, o diff so' a acusa no frame SEGUINTE e a recarga e' da
; janela INTEIRA (nao so' do plano que faltava). Custo: 1 frame com o plano
; novo stale + 1 recarga cheia. Aceito -- e' raro (exige troca de pattern
; table exatamente durante uma carga) e a alternativa (cursor por plano)
; dobraria o estado do job.
; ============================================================

; ------------------------------------------------------------
; Acessores de residencia. MAIN usa @nes_chrw_reg, NMI usa @nes_chrw_dreg
; (contextos SEPARADOS de proposito -- a regra da casa de nao compartilhar
; scratch entre NMI e main loop). X = k*2 em todos; X e' preservado.
; ------------------------------------------------------------
nes_chrw_rd:                     ; -> A(.al) = id residente da janela X/2
        sep #$20 : .as
        lda @nes_chrw_reg
        bne ncwrd_r1
        rep #$20 : .al
        lda @nes_chrw_r0,x
        rts
ncwrd_r1:
        rep #$20 : .al
        lda @nes_chrw_r1,x
        rts

nes_chrw_rdpl:                   ; -> A(.al) = planos carregados (byte baixo)
        sep #$20 : .as
        lda @nes_chrw_reg
        bne ncwrp_r1
        rep #$20 : .al
        lda @nes_chrw_pl0,x
        rts
ncwrp_r1:
        rep #$20 : .al
        lda @nes_chrw_pl1,x
        rts

nes_chrw_wr:                     ; r[k] = @nes_chrw_tmp ; pl[k] = 0
        ; ORDEM IMPORTA: zerar os planos ANTES de ligar o bit de pendencia e'
        ; o que torna o arm AUTO-CURAVEL -- se o set do bit se perder numa
        ; corrida com a NMI, a janela continua "divergente" (planos 0 <
        ; exigidos) e o proximo frame re-arma. Afirmar residencia que a VRAM
        ; nao tem seria tela errada PERMANENTE.
        sep #$20 : .as
        lda @nes_chrw_reg
        bne ncwwr_r1
        rep #$20 : .al
        lda @nes_chrw_tmp
        sta @nes_chrw_r0,x
        lda #$0000
        sta @nes_chrw_pl0,x
        sep #$20 : .as
        rts
ncwwr_r1:
        rep #$20 : .al
        lda @nes_chrw_tmp
        sta @nes_chrw_r1,x
        lda #$0000
        sta @nes_chrw_pl1,x
        sep #$20 : .as
        rts

nes_chrw_drd:                    ; (NMI) -> A(.al) = id residente, reg=dreg
        sep #$20 : .as
        lda @nes_chrw_dreg
        bne ncwdr_r1
        rep #$20 : .al
        lda @nes_chrw_r0,x
        rts
ncwdr_r1:
        rep #$20 : .al
        lda @nes_chrw_r1,x
        rts

nes_chrw_dsetpl:                 ; (NMI) pl[k] = A(.as), reg = dreg
        xba                       ; guarda os planos em B (sem tocar memoria)
        lda @nes_chrw_dreg
        bne ncwsp_r1
        xba
        rep #$20 : .al
        and #$00ff
        sta @nes_chrw_pl0,x
        sep #$20 : .as
        rts
ncwsp_r1:
        xba
        rep #$20 : .al
        and #$00ff
        sta @nes_chrw_pl1,x
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrw_bitof -- A(.as) = 1 << (X/2). Preserva X.
; ------------------------------------------------------------
nes_chrw_bitof:
        sep #$20 : .as
        phx
        lda #$01
ncwbo_loop:
        cpx #$0000
        beq ncwbo_done
        asl
        dex
        dex
        bra ncwbo_loop
ncwbo_done:
        plx
        rts

; ------------------------------------------------------------
; nes_chrw_needof -- A(.as) = planos EXIGIDOS da janela X/2 (metade 0-3 x
; 4-7; o corte da SS4.5 e' uniforme por metade). Preserva X.
; ------------------------------------------------------------
nes_chrw_needof:
        sep #$20 : .as
        cpx #$0008
        bcc ncwno_lo
        lda @nes_chrw_need1
        rts
ncwno_lo:
        lda @nes_chrw_need0
        rts

; ------------------------------------------------------------
; nes_chrw_needs -- deriva need0/need1 do PPUCTRL do frame (bits 3/4/5).
; ------------------------------------------------------------
nes_chrw_needs:
        sep #$20 : .as
        lda #$00
        sta @nes_chrw_need0
        sta @nes_chrw_need1
        lda @nes_regs_ppuctrl
        and #NES_CHRW_CTRL_BG
        bne ncwn_bg1
        lda #NES_CHRW_PLANE_BG
        sta @nes_chrw_need0       ; BG le a metade BAIXA (janelas 0-3)
        bra ncwn_obj
ncwn_bg1:
        lda #NES_CHRW_PLANE_BG
        sta @nes_chrw_need1
ncwn_obj:
        lda @nes_regs_ppuctrl
        and #NES_CHRW_CTRL_8X16
        beq ncwn_8x8
        ; sprites 8x16: o bit0 do indice do tile escolhe a pattern table e o
        ; PPUCTRL b3 e' ignorado -> as DUAS metades sao OBJ-relevantes (o
        ; corte SS4.5 nao vale; condicao registrada no design SS11.2)
        lda @nes_chrw_need0
        ora #NES_CHRW_PLANE_OBJ
        sta @nes_chrw_need0
        lda @nes_chrw_need1
        ora #NES_CHRW_PLANE_OBJ
        sta @nes_chrw_need1
        rts
ncwn_8x8:
        lda @nes_regs_ppuctrl
        and #NES_CHRW_CTRL_SPR
        bne ncwn_spr1
        lda @nes_chrw_need0
        ora #NES_CHRW_PLANE_OBJ
        sta @nes_chrw_need0
        rts
ncwn_spr1:
        lda @nes_chrw_need1
        ora #NES_CHRW_PLANE_OBJ
        sta @nes_chrw_need1
        rts

; ------------------------------------------------------------
; nes_chrw_busy -- carry SET = a regiao @nes_chrw_reg tem janela PENDENTE
; (VRAM meio carregada; ninguem pode exibi-la). Equivalente do
; nes_chr_reg_busy do v2.2/v2.3.
; ------------------------------------------------------------
nes_chrw_busy:
        sep #$20 : .as
        jsr nes_chrw_mpend
        beq ncwb_free
        sec
        rts
ncwb_free:
        clc
        rts

; ------------------------------------------------------------
; nes_chrw_mpend -- A(.as) = bitmask de pendencia da regiao @nes_chrw_reg
; (lado MAIN; o lado NMI tem o nes_chrw_dpend, com o seletor dele).
; ------------------------------------------------------------
nes_chrw_mpend:
        sep #$20 : .as
        lda @nes_chrw_reg
        bne ncwmp_r1
        lda @nes_chrw_pend0
        rts
ncwmp_r1:
        lda @nes_chrw_pend1
        rts

; ------------------------------------------------------------
; nes_chrw_nba -- A(.as) = byte de BG12NBA da regiao @nes_chrw_reg.
; ------------------------------------------------------------
nes_chrw_nba:
        sep #$20 : .as
        lda @nes_chrw_reg
        bne ncwnb_r1
        lda #NES_CHR_BG12NBA_SLOT0
        rts
ncwnb_r1:
        lda #NES_CHR_BG12NBA_SLOT1
        rts

; ------------------------------------------------------------
; nes_chrw_ldcmp_want -- cmp <- composicao do $14.
; nes_chrw_ldcmp_band -- cmp <- composicao do payload em @nes_chrw_ya
;   (offset Y do win[0] daquela faixa). Le 16 bits e mascara: o byte alto e'
;   a janela seguinte (ou o flags/opcode no k=7), sempre dentro do frame.
; ------------------------------------------------------------
nes_chrw_ldcmp_want:
        rep #$30 : .al : .xl
        ldx #$0000
ncwlw_loop:
        lda @nes_chrw_want,x
        sta @nes_chrw_cmp,x
        inx
        inx
        cpx #$0010
        bcc ncwlw_loop
        sep #$20 : .as
        rts

nes_chrw_ldcmp_band:
        rep #$30 : .al : .xl
        lda @nes_chrw_ya
        tay
        ldx #$0000
ncwlb_loop:
        lda [nes_parse_ptr],y
        and #$00ff
        sta @nes_chrw_cmp,x
        iny
        inx
        inx
        cpx #$0010
        bcc ncwlb_loop
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrw_diff -- compara nes_chrw_cmp com a residencia da regiao
; @nes_chrw_reg. Uma janela DIVERGE quando o id difere OU quando os planos
; carregados nao cobrem os EXIGIDOS deste frame (e' assim que uma troca de
; pattern table do PPUCTRL materializa o que faltava, sem caso especial).
; Saida: @nes_chrw_dmask (bitmask) + @nes_chrw_dcnt (popcount).
; ------------------------------------------------------------
nes_chrw_diff:
        sep #$20 : .as
        rep #$10 : .xl
        lda #$00
        sta @nes_chrw_dmask
        sta @nes_chrw_dcnt
        ldx #$0000
ncwd_loop:
        jsr nes_chrw_rd
        rep #$20 : .al
        cmp @nes_chrw_cmp,x
        sep #$20 : .as
        bne ncwd_diff
        ; --- id JA e' o desejado. Se a janela esta' PENDENTE, a carga certa
        ;     ja' esta' na fila: NAO reportar divergencia. Sem esta clausula o
        ;     reconciliador re-arma a mesma janela TODO frame (os planos ficam
        ;     0 enquanto ela nao carrega) e, como o arm invalida o job em voo
        ;     pra nao misturar fonte velha e nova, o cursor do slice voltava a
        ;     0 a cada frame => LIVELOCK: a janela nunca terminava de carregar
        ;     (bug real, pego pelo caso C do run_chrwin_gate: 24 arms, 0
        ;     loads). O planos-faltando so' vale pra janela ASSENTADA. ---
        jsr nes_chrw_bitof
        pha
        jsr nes_chrw_mpend
        sta @nes_chrw_tmp2
        pla
        and @nes_chrw_tmp2
        bne ncwd_next
        jsr nes_chrw_needof
        sta @nes_chrw_tmp2
        jsr nes_chrw_rdpl
        sep #$20 : .as
        and @nes_chrw_tmp2
        cmp @nes_chrw_tmp2
        beq ncwd_next
ncwd_diff:
        sep #$20 : .as
        jsr nes_chrw_bitof
        ora @nes_chrw_dmask
        sta @nes_chrw_dmask
        lda @nes_chrw_dcnt
        inc
        sta @nes_chrw_dcnt
ncwd_next:
        inx
        inx
        cpx #$0010
        bcc ncwd_loop
        rts

; ------------------------------------------------------------
; nes_chrw_arm -- arma na regiao @nes_chrw_reg as janelas de @nes_chrw_dmask
; (id novo + planos zerados + bit de pendencia). Janela EXIGIDA POR NENHUMA
; camada (need == 0, corte SS4.5) registra o id novo e NAO entra na fila:
; carregar 3072 B que ninguem le e' desperdicio, e o diff a recupera assim
; que o PPUCTRL exigir.
; ------------------------------------------------------------
nes_chrw_arm:
        sep #$20 : .as
        rep #$10 : .xl
        ldx #$0000
ncwa_loop:
        jsr nes_chrw_bitof
        and @nes_chrw_dmask
        beq ncwa_next
        rep #$20 : .al
        lda @nes_chrw_cmp,x
        sta @nes_chrw_tmp
        sep #$20 : .as
        jsr nes_chrw_wr
        ; --- se a janela armada e' JUSTAMENTE a que a NMI esta' fatiando,
        ;     INVALIDA o job (escrita de 1 byte = atomica): o cursor dela
        ;     aponta pro id ANTIGO e continuar dali misturaria fonte velha e
        ;     nova DENTRO da MESMA janela (o equivalente do reset de cursor
        ;     que o nes_chr_load_h0 faz no retarget do v2.2, so' que sem
        ;     escrever o cursor de 16 bits do outro contexto). O bit de
        ;     pendencia continua ligado -> o pick re-escolhe do zero. ---
        txa
        lsr
        cmp @nes_chrw_jk
        bne ncwa_nojob
        lda @nes_chrw_jreg
        cmp @nes_chrw_reg
        bne ncwa_nojob
        lda #$ff
        sta @nes_chrw_jk
ncwa_nojob:
        jsr nes_chrw_needof
        beq ncwa_next
        jsr nes_chrw_bitof
        pha
        lda @nes_chrw_reg
        bne ncwa_p1
        pla
        ora @nes_chrw_pend0
        sta @nes_chrw_pend0
        bra ncwa_count
ncwa_p1:
        pla
        ora @nes_chrw_pend1
        sta @nes_chrw_pend1
ncwa_count:
        phx
        rep #$20 : .al
        lda @nes_chrw_arms
        inc
        sta @nes_chrw_arms
        sep #$20 : .as
        plx
ncwa_next:
        inx
        inx
        cpx #$0010
        bcc ncwa_loop
        rts

; ------------------------------------------------------------
; nes_chrw_reconcile -- regras 1-4 com a composicao PRIMARIA em nes_chrw_cmp.
;   1. HIT total na CORRENTE                     -> nada
;   2. HIT total na OUTRA e ela ociosa           -> SWAP de tile-base (0 DMA)
;      (ocupada => PULA o frame inteiro, auto-cura -- fix A2 do v2.3)
;   3. poucas janelas divergem (<= INPLACE_MAX), OU a corrente ja esta
;      carregando                                -> carga IN-PLACE na corrente
;      (slice, sem frame preto -- e' o caso da ANIMACAO de tiles do MMC3)
;   4. senao TRANSICAO DE TELA: victim = outra regiao, forced-blank, cur =
;      victim (1 frame escuro limpo > N frames de tiles mistos; a mesma
;      politica da regra 4 do v2.2b, agora com granularidade de 1KB).
; ------------------------------------------------------------
nes_chrw_reconcile:
        sep #$20 : .as
        ; --- CHR-RAM: o caminho $41/shadow e' o DONO da VRAM de CHR. Sair
        ;     aqui (e nao so' no servico de DMA) e' o que mata as DUAS falhas
        ;     do F2: (a) nenhum arm chega a apontar pra fonte PSRAM zerada;
        ;     (b) o estado nao fica ENVENENADO -- sem arm nao ha pend eterno,
        ;     entao regra 2/regra 4/secundaria continuam vivas e o contador de
        ;     arms nao cresce sem teto. Banking NAO-identidade em CHR-RAM
        ;     (Kirby) e' a 2.2-full: a tela mostra a identidade, que e' o
        ;     conteudo que o $41 mantem -- degradacao, nunca corrupcao. ---
        lda @nes_chr_ram_mode
        beq ncwrc_go
        rts
ncwrc_go:
        jsr nes_chrw_needs
        lda @nes_chr_cur_slot
        sta @nes_chrw_reg
        jsr nes_chrw_diff
        lda @nes_chrw_dmask
        bne ncwrc_notcur
        rts                          ; regra 1 (caso quente)
ncwrc_notcur:
        sta @nes_chrw_mcur           ; guarda o diff da CORRENTE
        lda @nes_chrw_dcnt
        sta @nes_chrw_ccur
        jsr nes_chrw_busy            ; (reg ainda = corrente)
        lda #$00
        bcc ncwrc_cbz
        lda #$01
ncwrc_cbz:
        sta @nes_chrw_cbusy
        lda @nes_chr_cur_slot
        eor #$01
        sta @nes_chrw_reg
        jsr nes_chrw_diff
        lda @nes_chrw_dmask
        bne ncwrc_miss
        ; ---- regra 2: a outra regiao JA tem a composicao ----
        jsr nes_chrw_busy
        bcs ncwrc_skip
        lda @nes_chrw_reg
        sta @nes_chr_cur_slot
        rts
ncwrc_skip:
        rep #$20 : .al
        lda @nes_chrw_skips
        inc
        sta @nes_chrw_skips
        sep #$20 : .as
        rts
ncwrc_miss:
        lda @nes_chrw_cbusy
        bne ncwrc_inplace            ; corrente ocupada: completa in-place
        lda @nes_chrw_ccur           ; (nunca empilha 2 frames pretos)
        cmp #NES_CHRW_INPLACE_MAX+1
        bcc ncwrc_inplace
        ; ---- regra 4: transicao (reg ja = outra, dmask ja e' o dela) ----
        jsr nes_chrw_busy
        bcs ncwrc_skip
        jsr nes_chrw_arm
        lda #$01
        sta @nes_chrw_full
        rep #$20 : .al
        lda @nes_chrw_fulls
        inc
        sta @nes_chrw_fulls
        sep #$20 : .as
        lda @nes_chrw_reg
        sta @nes_chr_cur_slot
        rts
ncwrc_inplace:
        ; ---- regra 3: in-place na CORRENTE (restaura o diff dela) ----
        lda @nes_chr_cur_slot
        sta @nes_chrw_reg
        lda @nes_chrw_mcur
        sta @nes_chrw_dmask
        lda @nes_chrw_ccur
        sta @nes_chrw_dcnt
        jmp nes_chrw_arm             ; rts la'

; ------------------------------------------------------------
; nes_chrw_secondary -- residencia da 2a composicao (a de 2a maior cobertura)
; na regiao NAO-corrente. CONDICOES (todas obrigatorias, espelham o
; nes_cspl_secondary do v2.3): nenhuma carga em voo (as duas regioes
; ociosas), no maximo 1 composicao alternativa por frame, e NUNCA no frame
; que ja pediu forced-blank (a transicao ja gasta o vblank inteiro).
; NAO toca nes_chr_cur_slot. Sem condicao satisfeita = NO-OP: o $15
; re-publica tudo todo frame, entao a residencia converge sozinha.
; ------------------------------------------------------------
nes_chrw_secondary:
        sep #$20 : .as
        lda @nes_chr_ram_mode        ; CHR-RAM: idem reconcile (F2)
        bne ncwsec_done
        lda @nes_chrw_secarm
        bne ncwsec_done
        lda @nes_chrw_full
        bne ncwsec_done
        lda @nes_chr_cur_slot
        eor #$01
        sta @nes_chrw_reg
        ; --- CONDICAO DE OCUPACAO: so' a regiao DESTINO importa (correcao F6
        ;     do A13). A versao anterior recusava com QUALQUER pendencia
        ;     (`pend0|pend1`), herdada do v2.3 onde os dois loaders eram um
        ;     par unico compartilhado; aqui a fila e' POR REGIAO. Sob animacao
        ;     continua na regiao corrente aquilo virava FOME: a secundaria
        ;     nunca assentava, toda faixa nao-primaria ficava em fallback e
        ;     cada cruzamento de composicao pagava forced-blank. Carga em voo
        ;     na CORRENTE nao impede armar na OUTRA -- o pick prioriza a
        ;     corrente, entao a secundaria so' pega a vez quando sobra. ---
        jsr nes_chrw_busy
        bcs ncwsec_done
        jsr nes_chrw_diff
        lda @nes_chrw_dmask
        beq ncwsec_done
        lda #$01
        sta @nes_chrw_secarm
        lda @nes_chrw_dcnt
        rep #$20 : .al
        and #$00ff                   ; zera o byte alto ESCONDIDO de A antes
        clc                           ; de somar (gotcha da casa)
        adc @nes_chrw_secs
        sta @nes_chrw_secs
        sep #$20 : .as
        jmp nes_chrw_arm             ; rts la'
ncwsec_done:
        rts

; ------------------------------------------------------------
; nes_chrw_resolve -- A(.as) = byte de BG12NBA da faixa cuja composicao esta'
; em nes_chrw_cmp. Politica identica a' do $13: casa a corrente -> NBA dela;
; casa a outra e ela ociosa -> NBA da outra; senao FALLBACK = NBA da
; corrente (nunca pior que o v2.2). Uma regiao meio carregada nunca casa (as
; janelas pendentes tem planos 0), entao o teste de conteudo misto e' o
; PROPRIO diff -- o busy so' precisa ser testado na outra regiao, que pode
; ter uma janela pendente com id ja registrado.
; ------------------------------------------------------------
nes_chrw_resolve:
        sep #$20 : .as
        lda @nes_chr_cur_slot
        sta @nes_chrw_reg
        jsr nes_chrw_diff
        lda @nes_chrw_dmask
        bne ncwrs_notcur
        jmp nes_chrw_nba
ncwrs_notcur:
        lda @nes_chr_cur_slot
        eor #$01
        sta @nes_chrw_reg
        jsr nes_chrw_diff
        lda @nes_chrw_dmask
        bne ncwrs_fallback
        jsr nes_chrw_busy
        bcs ncwrs_fallback
        jmp nes_chrw_nba
ncwrs_fallback:
        rep #$20 : .al
        lda @nes_chrw_fallb
        inc
        sta @nes_chrw_fallb
        sep #$20 : .as
        lda @nes_chr_cur_slot
        sta @nes_chrw_reg
        jmp nes_chrw_nba

; ------------------------------------------------------------
; nes_chrw_handle_state -- CMD_CHR_STATE8 $14 (parse, contexto MAIN).
; Guarda o vetor e, quando o frame NAO tem $15 (peek do proximo opcode --
; contrato duro da SS3.4), reconcilia na hora com ele. Nao mexe em X (o
; dispatcher poe o tamanho 10 depois do jsr).
; ------------------------------------------------------------
nes_chrw_handle_state:
        sep #$20 : .as
        rep #$10 : .xl
        lda #$01
        sta @nes_chrw_active         ; modo janela ligado (sticky)
        sta @nes_chr_active          ; tile-base sai dos defaults de boot
        ldx #$0000
        ldy #$0001
ncws_cp:
        rep #$20 : .al
        lda [nes_parse_ptr],y
        and #$00ff
        sta @nes_chrw_want,x
        sep #$20 : .as
        inx
        inx
        iny
        cpx #$0010
        bcc ncws_cp
        ; --- flags (Y=9): bit0 = CHR-RAM (BRIDGE-SPEC SS4.3). Os demais bits
        ;     sao reservados e o renderer NAO os le (as janelas ja chegam
        ;     normalizadas do RTL -- derivar o invert aqui seria fazer a mesma
        ;     conta duas vezes, a licao "nao inferir no renderer").
        ;     POR QUE LER O bit0 (achado F2 do A13): antes disto o
        ;     nes_chr_ram_mode so' nascia no PRIMEIRO CMD_CHR_RUN ($41), o que
        ;     deixava uma JANELA no inicio do jogo em que um $14 nao-identidade
        ;     -- perfeitamente legal com chr_mask=0, ex. R0/R1 de 2KB apontando
        ;     (2,3) -- armava DMA da fonte PSRAM $50/$60, que em CHR-RAM esta'
        ;     ZERADA, POR CIMA da VRAM que o $41 vai escrever. O bit do $14 e'
        ;     deterministico e chega no frame 1, antes de qualquer $41. So'
        ;     SETA (nunca limpa): a semantica e' sticky, igual a' do $41. ---
        ldy #$0009
        lda [nes_parse_ptr],y
        and #$01
        beq ncws_notram
        lda #$01
        sta @nes_chr_ram_mode
ncws_notram:
        ldy #$000a
        lda [nes_parse_ptr],y        ; PEEK do proximo opcode
        cmp #CMD_CHR_SPLITS8
        beq ncws_defer
        lda #$00
        sta @nes_chrw_cnt            ; frame de composicao UNICA
        sta @nes_chrw_secarm
        jsr nes_chrw_ldcmp_want
        jsr nes_chrw_reconcile
ncws_defer:
        rts

; ------------------------------------------------------------
; nes_chrw_offi / nes_chrw_offj -- A(.al) = offset da entrada i/j no payload
; do $15 (= 2 + 9*idx). Duas rotinas (uma por iterador) de proposito: nenhum
; temp compartilhado entre lacos aninhados.
; ------------------------------------------------------------
nes_chrw_offi:
        rep #$20 : .al
        lda @nes_chrw_i
        asl
        asl
        asl
        clc
        adc @nes_chrw_i
        clc
        adc #$0002
        rts
nes_chrw_offj:
        rep #$20 : .al
        lda @nes_chrw_j
        asl
        asl
        asl
        clc
        adc @nes_chrw_j
        clc
        adc #$0002
        rts

; ------------------------------------------------------------
; nes_chrw_bandeq -- compara as composicoes das faixas @nes_chrw_i e
; @nes_chrw_j LENDO O PAYLOAD (nada de matriz intermediaria: sao 8 bytes por
; faixa, e o payload esta' vivo durante todo o handler). Saida:
; @nes_chrw_eq = 0 (iguais) / 1 (diferentes).
; ------------------------------------------------------------
nes_chrw_bandeq:
        rep #$30 : .al : .xl
        lda @nes_chrw_i
        cmp @nes_chrw_j
        bne ncwbe_go
        sep #$20 : .as               ; i == j: iguais por construcao
        lda #$00
        sta @nes_chrw_eq
        rts
ncwbe_go:
        rep #$20 : .al
        jsr nes_chrw_offi
        clc
        adc #$0001
        sta @nes_chrw_ea             ; trio PROPRIO (ea/eb/et): o ya e' do
        jsr nes_chrw_offj            ; ldcmp_band e o tmp2 do laco de
        clc                           ; cobertura -- compartilhar foi o bug
        adc #$0001                    ; da tabela HDMA de lixo (F9/A13)
        sta @nes_chrw_eb
        ldx #$0000
ncwbe_loop:
        rep #$20 : .al
        txa
        clc
        adc @nes_chrw_ea
        tay
        lda [nes_parse_ptr],y
        and #$00ff
        sta @nes_chrw_et
        txa
        clc
        adc @nes_chrw_eb
        tay
        lda [nes_parse_ptr],y
        and #$00ff
        cmp @nes_chrw_et
        bne ncwbe_diff
        inx
        cpx #$0008
        bcc ncwbe_loop
        sep #$20 : .as
        lda #$00
        sta @nes_chrw_eq
        rts
ncwbe_diff:
        sep #$20 : .as
        lda #$01
        sta @nes_chrw_eq
        rts

; ------------------------------------------------------------
; nes_chrw_handle_splits -- CMD_CHR_SPLITS8 $15 (contexto MAIN, display
; ativo). hdr em Y=1 (b7=ovf informativo; [3:0]=cnt 2..4), entradas de 9 B
; [scanline(1) win[0..7](8)] a partir de Y=2. Faz, nesta ordem:
;   (1) PRE-PASS com deadband PROPRIO (o do $13 fica intocado -- os dois
;       nunca coexistem, mas estado compartilhado entre protocolos e' a
;       receita de "congelou na fronteira errada");
;   (2) cobertura por faixa e cobertura TOTAL por composicao DISTINTA;
;   (3) escolha primaria/secundaria por cobertura (SS4.4) + reconcilio;
;   (4) resolucao do byte de $210B por faixa (com cache por CLASSE: faixas
;       de composicao repetida copiam o resultado da primeira);
;   (5) BUILD da tabela HDMA -- a MESMA rotina do $13 (nes_cspl_build).
; Devolve o tamanho TLV (2 + 9*cnt DO HEADER) em X.
; ------------------------------------------------------------
nes_chrw_handle_splits:
        sep #$20 : .as
        rep #$10 : .xl
        lda #$00
        sta @nes_chrw_secarm
        ldy #$0001
        lda [nes_parse_ptr],y
        and #$0f
        sta @nes_chrw_cnt
        cmp #$02
        bcs ncwhs_go
        ; cnt<2 (defensivo): frame sem raster-split -> deadband recomeca
        ; fresh no proximo frame COM faixas, e a composicao unica do $14
        ; reconcilia agora (o $14 deferiu pra ca' por causa do peek).
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_prev_cnt
        sep #$20 : .as
        lda #$00
        sta @nes_chrw_cnt
        jsr nes_chrw_ldcmp_want
        jsr nes_chrw_reconcile
        brl ncwhs_size
ncwhs_go:
        cmp #$05
        bcc ncwhs_cnt_ok
        lda #$04                     ; clamp K<=4 (contrato)
        sta @nes_chrw_cnt
ncwhs_cnt_ok:
        lda @nes_chrw_cnt
        rep #$20 : .al
        and #$00ff
        sta @nes_chrw_cnt2w          ; espelho 16-bit p/ os lacos de faixa
        sep #$20 : .as
        ; ---------- (1) PRE-PASS: deadband da fronteira ----------
        ; Espelho exato do pre-passe do $11/$13: entrada j que ja existia
        ; (idx < prev_cnt) com |sl_nova - sl_EMITIDA anterior| <= 1 mantem a
        ; anterior PARA SEMPRE; |dsl| >= 2 = mudanca real de layout -> adota
        ; na hora. Guarda a EMITIDA (nao a crua), senao o jitter de +-1 volta
        ; a alternar. A scanline emitida vai pro @nes_cspl_sl, que e' de onde
        ; o build compartilhado le.
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_j
        sep #$20 : .as
ncwhs_pre:
        rep #$30 : .al : .xl
        jsr nes_chrw_offj
        tay
        lda [nes_parse_ptr],y
        and #$00ff
        sta @nes_chrw_tmp            ; scanline crua
        lda @nes_chrw_j
        asl
        tax                           ; X = idx = j*2
        txa
        cmp @nes_chrw_prev_cnt
        bcs ncwhs_pre_store
        lda @nes_chrw_tmp
        sec
        sbc @nes_chrw_prev_sl,x
        bcs ncwhs_pre_pos
        eor #$ffff
        inc
ncwhs_pre_pos:
        cmp #$0002
        bcs ncwhs_pre_store
        lda @nes_chrw_prev_sl,x
        sta @nes_chrw_tmp
ncwhs_pre_store:
        rep #$20 : .al
        lda @nes_chrw_tmp
        sta @nes_cspl_sl,x           ; o build compartilhado le daqui
        sta @nes_chrw_prev_sl,x
        lda @nes_chrw_j
        inc
        sta @nes_chrw_j
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_pre_done
        brl ncwhs_pre                ; (BRL: o corpo do laco passa dos 127 B
                                      ;  de alcance de um branch curto)
ncwhs_pre_done:
        rep #$20 : .al
        lda @nes_chrw_j
        asl
        sta @nes_chrw_prev_cnt       ; entradas*2 (ancora do proximo frame)
        sep #$20 : .as

        ; ---------- (2) COBERTURA por faixa (linhas SNES pos-crop) ----------
        ; cov[j] = S1 - S0, com S = max(0, sl - VIEWPORT_CROP_Y) e S1 da
        ; ULTIMA faixa = 224 -- a MESMA aritmetica que o build usa pra emitir
        ; os line-counts, senao a politica ordenaria por um numero que nao e'
        ; o que aparece na tela.
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_j
        sep #$20 : .as
ncwhs_cov:
        rep #$30 : .al : .xl
        lda @nes_chrw_j
        asl
        tax
        lda @nes_cspl_sl,x
        and #$00ff
        sec
        sbc #VIEWPORT_CROP_Y
        bcs ncwhs_cov_s0
        lda #$0000
ncwhs_cov_s0:
        sta @nes_chrw_tmp            ; S0
        lda @nes_chrw_j
        inc
        cmp @nes_chrw_cnt2w          ; ultima faixa?
        bcc ncwhs_cov_next
        lda #224
        sta @nes_chrw_tmp2
        bra ncwhs_cov_calc
ncwhs_cov_next:
        asl
        tax
        lda @nes_cspl_sl,x
        and #$00ff
        sec
        sbc #VIEWPORT_CROP_Y
        bcs ncwhs_cov_s1
        lda #$0000
ncwhs_cov_s1:
        sta @nes_chrw_tmp2           ; S1
ncwhs_cov_calc:
        lda @nes_chrw_tmp2
        sec
        sbc @nes_chrw_tmp
        bcs ncwhs_cov_ok
        lda #$0000                   ; faixa absorvida pelo crop
ncwhs_cov_ok:
        sta @nes_chrw_tmp2
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_tmp2
        sta @nes_chrw_cov,x
        lda @nes_chrw_j
        inc
        sta @nes_chrw_j
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_cov_done
        brl ncwhs_cov
ncwhs_cov_done:

        ; ---------- (3) cobertura TOTAL por composicao + classes ----------
        ; tot[j] = soma de cov[i] de TODAS as faixas i com a MESMA
        ; composicao de j; cls[j] = menor i equivalente a j (cache do passo
        ; 4). E' este somatorio que implementa a SS4.4: uma composicao que
        ; aparece em 2 faixas curtas pode ganhar de uma faixa unica media, e
        ; um write de restauracao de 1 linha nunca ganha de um playfield.
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_j
        sep #$20 : .as
ncwhs_tot_j:
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_acc            ; acumulador (var PROPRIA: o bandeq usa
        sta @nes_chrw_i              ;  o tmp2 como scratch dele)
        lda #$ffff
        sta @nes_chrw_cl             ; classe (menor i equivalente)
        sep #$20 : .as
ncwhs_tot_i:
        jsr nes_chrw_bandeq
        lda @nes_chrw_eq
        bne ncwhs_tot_i_next
        rep #$30 : .al : .xl
        lda @nes_chrw_i
        asl
        tax
        lda @nes_chrw_cov,x
        clc
        adc @nes_chrw_acc
        sta @nes_chrw_acc
        lda @nes_chrw_cl
        cmp #$ffff
        bne ncwhs_tot_i_cls
        lda @nes_chrw_i
        sta @nes_chrw_cl             ; 1a faixa equivalente = a classe
ncwhs_tot_i_cls:
        sep #$20 : .as
ncwhs_tot_i_next:
        rep #$20 : .al
        lda @nes_chrw_i
        inc
        sta @nes_chrw_i
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_tot_i_done
        brl ncwhs_tot_i
ncwhs_tot_i_done:
        rep #$30 : .al : .xl
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_acc
        sta @nes_chrw_tot,x
        lda @nes_chrw_cl
        sta @nes_chrw_cls,x
        lda @nes_chrw_j
        inc
        sta @nes_chrw_j
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_tot_done
        brl ncwhs_tot_j
ncwhs_tot_done:

        ; ---------- (4) primaria e secundaria ----------
        ; primaria = maior cobertura TOTAL (empate mantem o indice MENOR =
        ; ordem estavel entre frames, o que evita alternancia de residencia);
        ; secundaria = maior cobertura entre as faixas de composicao
        ; DIFERENTE da primaria.
        rep #$30 : .al : .xl
        lda #$0000
        sta @nes_chrw_bestp
        sta @nes_chrw_j
        lda #$ffff
        sta @nes_chrw_bests
        sep #$20 : .as
ncwhs_bp:
        rep #$30 : .al : .xl
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_tot,x
        sta @nes_chrw_tmp
        lda @nes_chrw_bestp
        asl
        tax
        lda @nes_chrw_tot,x
        cmp @nes_chrw_tmp
        bcs ncwhs_bp_next            ; melhor atual >= candidato: mantem
        lda @nes_chrw_j
        sta @nes_chrw_bestp
ncwhs_bp_next:
        lda @nes_chrw_j
        inc
        sta @nes_chrw_j
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_bp_done
        brl ncwhs_bp
ncwhs_bp_done:
        ; secundaria
        rep #$20 : .al
        lda @nes_chrw_bestp
        sta @nes_chrw_j              ; bandeq compara i (candidato) x j (prim)
        lda #$0000
        sta @nes_chrw_i
        sep #$20 : .as
ncwhs_bs:
        jsr nes_chrw_bandeq
        lda @nes_chrw_eq
        beq ncwhs_bs_next            ; mesma composicao da primaria: pula
        rep #$30 : .al : .xl
        lda @nes_chrw_bests
        cmp #$ffff
        beq ncwhs_bs_take
        asl
        tax
        lda @nes_chrw_tot,x
        sta @nes_chrw_tmp
        lda @nes_chrw_i
        asl
        tax
        lda @nes_chrw_tot,x
        cmp @nes_chrw_tmp
        bcc ncwhs_bs_keep
        beq ncwhs_bs_keep
ncwhs_bs_take:
        lda @nes_chrw_i
        sta @nes_chrw_bests
ncwhs_bs_keep:
        sep #$20 : .as
ncwhs_bs_next:
        rep #$20 : .al
        lda @nes_chrw_i
        inc
        sta @nes_chrw_i
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_bs_done
        brl ncwhs_bs
ncwhs_bs_done:

        ; ---------- reconcilio da PRIMARIA ----------
        rep #$20 : .al
        lda @nes_chrw_bestp
        sta @nes_chrw_j
        jsr nes_chrw_offj
        clc
        adc #$0001
        sta @nes_chrw_ya
        sep #$20 : .as
        jsr nes_chrw_ldcmp_band
        jsr nes_chrw_reconcile
        ; ---------- residencia SECUNDARIA ----------
        rep #$20 : .al
        lda @nes_chrw_bests
        cmp #$ffff
        sep #$20 : .as
        beq ncwhs_resolve
        rep #$20 : .al
        lda @nes_chrw_bests
        sta @nes_chrw_j
        jsr nes_chrw_offj
        clc
        adc #$0001
        sta @nes_chrw_ya
        sep #$20 : .as
        jsr nes_chrw_ldcmp_band
        jsr nes_chrw_secondary

        ; ---------- (5) resolucao por faixa + BUILD ----------
ncwhs_resolve:
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_j
        sep #$20 : .as
ncwhs_res_loop:
        rep #$30 : .al : .xl
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_cls,x
        cmp @nes_chrw_j
        sep #$20 : .as
        beq ncwhs_res_calc
        ; faixa de composicao REPETIDA: copia o NBA da classe (a primeira
        ; faixa equivalente ja foi resolvida -- cls[j] < j sempre)
        rep #$30 : .al : .xl
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_cls,x
        asl
        tax
        lda @nes_cspl_nba,x
        and #$00ff
        sta @nes_chrw_tmp
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_tmp
        sta @nes_cspl_nba,x
        sep #$20 : .as
        bra ncwhs_res_next
ncwhs_res_calc:
        rep #$20 : .al
        jsr nes_chrw_offj
        clc
        adc #$0001
        sta @nes_chrw_ya
        sep #$20 : .as
        jsr nes_chrw_ldcmp_band
        jsr nes_chrw_resolve         ; A(.as) = byte de $210B da faixa
        rep #$20 : .al
        and #$00ff
        sta @nes_chrw_tmp
        lda @nes_chrw_j
        asl
        tax
        lda @nes_chrw_tmp
        sta @nes_cspl_nba,x
        sep #$20 : .as
ncwhs_res_next:
        rep #$20 : .al
        lda @nes_chrw_j
        inc
        sta @nes_chrw_j
        cmp @nes_chrw_cnt2w
        sep #$20 : .as
        bcs ncwhs_res_done
        brl ncwhs_res_loop
ncwhs_res_done:
        ; ---- BUILD (rotina COMPARTILHADA com o $13) ----
        lda @nes_chrw_cnt
        sta nes_cs_cnt
        rep #$10 : .xl
        ldx #!nes_chdma_tab0
        stx nes_cs_tab
        lda @nes_fb_target
        cmp #$02
        bne ncwhs_buf_ok
        ldx #!nes_chdma_tab1
        stx nes_cs_tab
ncwhs_buf_ok:
        lda #^nes_chdma_tab0
        sta nes_cs_tabb
        rep #$20 : .al
        lda #$0000
        sta nes_cs_off
        sta nes_cs_idx
        sep #$20 : .as
        lda @nes_chrw_cnt
        sta @nes_cspl_cnt            ; espelho (debug/gate), como no $13
        jsr nes_cspl_build
ncwhs_size:
        ; tamanho TLV = 2 + 9*cnt DO HEADER (nao o clampado!)
        rep #$10 : .xl
        ldy #$0001
        lda [nes_parse_ptr],y
        rep #$20 : .al
        and #$000f
        sta @nes_chrw_tmp
        asl
        asl
        asl
        clc
        adc @nes_chrw_tmp            ; 9*cnt
        clc
        adc #$0002
        tax
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrw_dma_bg / nes_chrw_dma_obj -- (NMI) UM transfer do staging
; (@nes_chrw_dreg/_dk/_dwin/_dcur/_dlen). dlen e' em BYTES DE BG; o OBJ do
; mesmo transfer e' 2x (a identidade linear do CHR-SNES: 1 tile = 16 B em
; 2bpp e 32 B em 4bpp). Como fonte E destino sao lineares em k, um transfer
; com dlen = n*1024 COALESCE n janelas consecutivas cujos ids tambem sao
; consecutivos -- e' o que faz uma composicao inteira caber em 2 DMAs em vez
; de 16 no caminho de forced-blank.
; ------------------------------------------------------------
nes_chrw_dma_bg:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda @nes_chrw_dwin
        sta nes_cd_src
        sep #$20 : .as
        ldy #NES_CHRW_SHIFT_BG
        jsr nes_chr_shift            ; src24 = win * 1024
        rep #$20 : .al
        lda nes_cd_src
        clc
        adc @nes_chrw_dcur
        sta nes_cd_src
        sep #$20 : .as
        bcc ncwdb_c1
        inc nes_cd_srcbank
ncwdb_c1:
        rep #$20 : .al
        lda nes_cd_src
        clc
        adc @nes_chr_bg_base_addr
        sta nes_cd_src
        sep #$20 : .as
        bcc ncwdb_c2
        inc nes_cd_srcbank
ncwdb_c2:
        lda nes_cd_srcbank
        clc
        adc @nes_chr_bg_base_bank
        sta nes_cd_srcbank
        rep #$20 : .al
        lda #NES_CHR_SLOT0_BG_WORD
        sta nes_cd_dst
        sep #$20 : .as
        lda @nes_chrw_dreg
        beq ncwdb_r0
        rep #$20 : .al
        lda #NES_CHR_SLOT1_BG_WORD
        sta nes_cd_dst
        sep #$20 : .as
ncwdb_r0:
        rep #$20 : .al
        lda @nes_chrw_dk             ; dst += k * 512 words (1024 B de BG)
        xba                           ; *256 (dk <= 7: byte alto era 0)
        asl
        clc
        adc nes_cd_dst
        sta nes_cd_dst
        lda @nes_chrw_dcur           ; dst += cursor/2 (words)
        lsr
        clc
        adc nes_cd_dst
        sta nes_cd_dst
        lda @nes_chrw_dlen
        sta nes_cd_len
        sep #$20 : .as
        jmp nes_chr_dma_one          ; rts la'

nes_chrw_dma_obj:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda @nes_chrw_dwin
        sta nes_cd_src
        sep #$20 : .as
        ldy #NES_CHRW_SHIFT_OBJ
        jsr nes_chr_shift            ; src24 = win * 2048
        rep #$20 : .al
        lda @nes_chrw_dcur           ; offset OBJ = cursor * 2
        asl
        sta nes_cd_tmp
        lda nes_cd_src
        clc
        adc nes_cd_tmp
        sta nes_cd_src
        sep #$20 : .as
        bcc ncwdo_c1
        inc nes_cd_srcbank
ncwdo_c1:
        rep #$20 : .al
        lda nes_cd_src
        clc
        adc @nes_chr_obj_base_addr
        sta nes_cd_src
        sep #$20 : .as
        bcc ncwdo_c2
        inc nes_cd_srcbank
ncwdo_c2:
        lda nes_cd_srcbank
        clc
        adc @nes_chr_obj_base_bank
        sta nes_cd_srcbank
        rep #$20 : .al
        lda #NES_CHR_SLOT0_OBJ_WORD
        sta nes_cd_dst
        sep #$20 : .as
        lda @nes_chrw_dreg
        beq ncwdo_r0
        rep #$20 : .al
        lda #NES_CHR_SLOT1_OBJ_WORD
        sta nes_cd_dst
        sep #$20 : .as
ncwdo_r0:
        rep #$20 : .al
        lda @nes_chrw_dk             ; dst += k * 1024 words (2048 B de OBJ)
        xba
        asl
        asl
        clc
        adc nes_cd_dst
        sta nes_cd_dst
        lda @nes_chrw_dcur           ; dst += cursor (words == cursor*2 / 2)
        clc
        adc nes_cd_dst
        sta nes_cd_dst
        lda @nes_chrw_dlen           ; len = 2 * dlen
        asl
        sta nes_cd_len
        sep #$20 : .as
        jmp nes_chr_dma_one          ; rts la'

; ------------------------------------------------------------
; nes_chrw_dma_step -- (NMI) executa o transfer corrente nos planos pedidos.
; ------------------------------------------------------------
nes_chrw_dma_step:
        sep #$20 : .as
        lda @nes_chrw_dpl
        and #NES_CHRW_PLANE_BG
        beq ncwds_obj
        jsr nes_chrw_dma_bg
ncwds_obj:
        sep #$20 : .as
        lda @nes_chrw_dpl
        and #NES_CHRW_PLANE_OBJ
        beq ncwds_done
        jsr nes_chrw_dma_obj
ncwds_done:
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrw_dclear -- (NMI) conclui a janela X/2 da regiao @nes_chrw_dreg:
; grava os planos carregados, apaga o bit de pendencia e conta. X preservado.
; ------------------------------------------------------------
nes_chrw_dclear:
        sep #$20 : .as
        lda @nes_chrw_dpl
        jsr nes_chrw_dsetpl
        jsr nes_chrw_bitof
        eor #$ff
        pha
        lda @nes_chrw_dreg
        bne ncwdc_r1
        pla
        and @nes_chrw_pend0
        sta @nes_chrw_pend0
        bra ncwdc_cnt
ncwdc_r1:
        pla
        and @nes_chrw_pend1
        sta @nes_chrw_pend1
ncwdc_cnt:
        phx
        rep #$20 : .al
        lda @nes_chrw_loads
        inc
        sta @nes_chrw_loads
        sep #$20 : .as
        lda @nes_chrw_dpl
        cmp #NES_CHRW_PLANE_BG+NES_CHRW_PLANE_OBJ
        beq ncwdc_out
        rep #$20 : .al
        lda @nes_chrw_1pl            ; breadcrumb do corte SS4.5
        inc
        sta @nes_chrw_1pl
        sep #$20 : .as
ncwdc_out:
        plx
        rts

; ------------------------------------------------------------
; nes_chrw_dpend -- (NMI) A(.as) = bitmask de pendencia da regiao dreg.
; ------------------------------------------------------------
nes_chrw_dpend:
        sep #$20 : .as
        lda @nes_chrw_dreg
        bne ncwdp_r1
        lda @nes_chrw_pend0
        rts
ncwdp_r1:
        lda @nes_chrw_pend1
        rts

; ------------------------------------------------------------
; nes_chrw_drain -- (NMI, SO em forced-blank) carrega TODAS as janelas
; pendentes da regiao @nes_chrw_dreg, coalescendo runs de janelas
; consecutivas com ids consecutivos e os MESMOS planos. Custo do pior caso
; (8 janelas, 24576 B, 2-16 DMAs) = 156 linhas: cabe no FRAME INTEIRO que o
; forced-blank libera (262 linhas), nao no vblank -- exatamente como o par
; de 24KB do v2.2, ja validado em hardware.
; ------------------------------------------------------------
nes_chrw_drain:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_dk
        sep #$20 : .as
ncwdr_loop:
        rep #$30 : .al : .xl
        lda @nes_chrw_dk
        asl
        tax                           ; X = k*2
        sep #$20 : .as
        jsr nes_chrw_bitof
        sta @nes_chrw_dtmp
        jsr nes_chrw_dpend
        and @nes_chrw_dtmp
        beq ncwdr_next
        jsr nes_chrw_needof
        sta @nes_chrw_dpl
        bne ncwdr_run
        jsr nes_chrw_dclear          ; need==0: nada a carregar, so' conclui
        bra ncwdr_next
ncwdr_run:
        ; --- corre o run coalescivel a partir de k ---
        rep #$20 : .al
        lda #$0001
        sta @nes_chrw_dn
        jsr nes_chrw_drd             ; id da janela inicial
        sta @nes_chrw_dwin
        sep #$20 : .as
ncwdr_grow:
        rep #$30 : .al : .xl
        lda @nes_chrw_dk
        clc
        adc @nes_chrw_dn
        cmp #$0008
        bcs ncwdr_go                 ; acabou o vetor
        sta @nes_chrw_di             ; proxima janela candidata
        asl
        tax
        sep #$20 : .as
        jsr nes_chrw_bitof
        sta @nes_chrw_dtmp
        jsr nes_chrw_dpend
        and @nes_chrw_dtmp
        beq ncwdr_go                 ; candidata nao pendente
        jsr nes_chrw_needof
        cmp @nes_chrw_dpl
        bne ncwdr_go                 ; planos diferentes (fronteira de metade)
        jsr nes_chrw_drd
        rep #$20 : .al
        sec
        sbc @nes_chrw_dwin
        cmp @nes_chrw_dn
        sep #$20 : .as
        bne ncwdr_go                 ; ids nao consecutivos
        rep #$20 : .al
        lda @nes_chrw_dn
        inc
        sta @nes_chrw_dn
        sep #$20 : .as
        bra ncwdr_grow
ncwdr_go:
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_dcur
        lda @nes_chrw_dn             ; dlen = n * 1024 B de BG
        xba
        asl
        asl
        sta @nes_chrw_dlen
        sep #$20 : .as
        jsr nes_chrw_dma_step
        ; --- conclui as n janelas do run ---
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_di
        sep #$20 : .as
ncwdr_mark:
        rep #$30 : .al : .xl
        lda @nes_chrw_dk
        clc
        adc @nes_chrw_di
        asl
        tax
        sep #$20 : .as
        jsr nes_chrw_dclear
        rep #$20 : .al
        lda @nes_chrw_di
        inc
        sta @nes_chrw_di
        cmp @nes_chrw_dn
        sep #$20 : .as
        bcc ncwdr_mark
        rep #$20 : .al
        lda @nes_chrw_dk
        clc
        adc @nes_chrw_dn
        sta @nes_chrw_dk
        sep #$20 : .as
        bra ncwdr_tail
ncwdr_next:
        rep #$20 : .al
        lda @nes_chrw_dk
        inc
        sta @nes_chrw_dk
        sep #$20 : .as
ncwdr_tail:
        rep #$20 : .al
        lda @nes_chrw_dk
        cmp #$0008
        sep #$20 : .as
        bcs ncwdr_out
        brl ncwdr_loop
ncwdr_out:
        rts

; ------------------------------------------------------------
; nes_chrw_pick -- (NMI) escolhe/mantem o job de slice. Mantem o job em voo
; enquanto o bit dele seguir pendente (senao o cursor perderia o sentido);
; ao trocar de janela, ZERA o cursor. Prioridade: regiao CORRENTE primeiro
; (e' a que a tela mostra), depois a outra. Saida: @nes_chrw_jk = $ff quando
; nao ha nada a fazer.
; ------------------------------------------------------------
nes_chrw_pick:
        sep #$20 : .as
        lda @nes_chrw_jk
        cmp #$ff
        beq ncwpi_new
        ; job em voo: ainda pendente?
        lda @nes_chrw_jreg
        sta @nes_chrw_dreg
        rep #$30 : .al : .xl
        lda @nes_chrw_jk
        and #$00ff
        asl
        tax
        sep #$20 : .as
        jsr nes_chrw_bitof
        sta @nes_chrw_dtmp
        jsr nes_chrw_dpend
        and @nes_chrw_dtmp
        bne ncwpi_out                ; segue valido
ncwpi_new:
        ; --- ANTI-FOME (gate 2.4, bug de campo SMB2/SMB3). A ordem de varredura
        ;     era FIXA: corrente, depois a outra. Isso e' certo com trabalho
        ;     finito e e' RUINA com trabalho PERPETUO -- e a animacao continua
        ;     de CHR do MMC3 e' perpetua por construcao: SMB2 e SMB3 ciclam
        ;     DUAS janelas de 1KB a cada 8 frames, e 2 x 3072 B / 8 frames =
        ;     768 B/vblank = EXATAMENTE a banda do slice. Com a corrente sempre
        ;     ocupada, a regiao NAO-corrente (a que serve a faixa SECUNDARIA do
        ;     $15) nunca pegava um vblank: MEDIDO no golden do SMB3, 749 frames
        ;     em dois trechos de 320+ com ela armada e nunca servida => 781 de
        ;     3062 faixas (25,5%) exibindo o banco ERRADO pelo fallback do
        ;     resolve. Com este bloco: 354 (11,6%). NAO e' fix de livelock (o
        ;     restart de id novo mede 0 no SMB2 e 2 no SMB3 -- a clausula F5 do
        ;     diff ja o matou) e NAO cria banda (o teto de 768 B/vblank e'
        ;     fisico): so' impede o monopolio da banda que existe.
        ;     dreg e X ficam consistentes nos dois ramos porque quem os define
        ;     e' o nes_chrw_scan que ACHOU. ---
        lda @nes_chrw_starve
        cmp #NES_CHRW_STARVE_MAX
        bcc ncwpi_cur
        lda @nes_chr_cur_slot
        eor #$01
        sta @nes_chrw_dreg
        jsr nes_chrw_dpend
        beq ncwpi_cur                ; a outra nao espera nada: sem prioridade
        jsr nes_chrw_scan
        bcc ncwpi_found
ncwpi_cur:
        lda @nes_chr_cur_slot
        sta @nes_chrw_dreg
        jsr nes_chrw_scan
        bcc ncwpi_found
        lda @nes_chr_cur_slot
        eor #$01
        sta @nes_chrw_dreg
        jsr nes_chrw_scan
        bcc ncwpi_found
        lda #$ff
        sta @nes_chrw_jk             ; nada pendente
        rts
ncwpi_found:
        ; @nes_chrw_di = janela achada (X ja = di*2)
        sep #$20 : .as
        lda @nes_chrw_di
        sta @nes_chrw_jk
        lda @nes_chrw_dreg
        sta @nes_chrw_jreg
        ; --- contabilidade do anti-fome. Le o pend da regiao NAO-corrente
        ;     DIRETO (sem passar pelo nes_chrw_dpend) de proposito: mexer em
        ;     @nes_chrw_dreg aqui trocaria a regiao que o resto do pick e o
        ;     staging do passo usam. X fica intocado (o needof abaixo depende
        ;     dele). Job na OUTRA regiao => a fome acabou, zera. ---
        lda @nes_chr_cur_slot
        cmp @nes_chrw_jreg
        bne ncwpi_starve0
        lda @nes_chr_cur_slot
        bne ncwpi_oth1
        lda @nes_chrw_pend1
        bra ncwpi_othchk
ncwpi_oth1:
        lda @nes_chrw_pend0
ncwpi_othchk:
        beq ncwpi_starve0            ; ninguem esperando: nao ha fome
        lda @nes_chrw_starve
        inc
        sta @nes_chrw_starve
        bra ncwpi_needs
ncwpi_starve0:
        lda #$00
        sta @nes_chrw_starve
ncwpi_needs:
        jsr nes_chrw_needof
        sta @nes_chrw_jpl
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_jcur           ; janela nova: cursor do zero
        sep #$20 : .as
ncwpi_out:
        rts

; ------------------------------------------------------------
; nes_chrw_scan -- (NMI) primeira janela pendente da regiao @nes_chrw_dreg.
; carry CLEAR = achou (indice em @nes_chrw_di, X = di*2).
; ------------------------------------------------------------
nes_chrw_scan:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda #$0000
        sta @nes_chrw_di
        sep #$20 : .as
ncwsc_loop:
        rep #$30 : .al : .xl
        lda @nes_chrw_di
        asl
        tax
        sep #$20 : .as
        jsr nes_chrw_bitof
        sta @nes_chrw_dtmp
        jsr nes_chrw_dpend
        and @nes_chrw_dtmp
        bne ncwsc_hit
        rep #$20 : .al
        lda @nes_chrw_di
        inc
        sta @nes_chrw_di
        cmp #$0008
        sep #$20 : .as
        bcc ncwsc_loop
        sec
        rts
ncwsc_hit:
        clc
        rts

; ------------------------------------------------------------
; nes_chrw_service -- (NMI) servico de carga das janelas. Chamado do
; nes_apply_vblank ANTES do apply_tilebase, junto dos servicos v2.2.
;   full  = forced-blank + drena TUDO (transicao de tela)
;   slice = UM passo por vblank, gateado por V (NES_CHR_SLICE_V_MAX), com o
;           MESMO envelope de bytes do slice v2.2 validado em hardware:
;           2 planos -> 256 B de BG + 512 de OBJ (2 DMAs, 8.184 cyc)
;           1 plano  -> 512 B (1 DMA, 5.116 cyc)
; INERTE em CHR-RAM (nes_chr_ram_mode): la' a VRAM e' do caminho $41 e a
; fonte pre-convertida da PSRAM esta' ZERADA -- um DMA dali apagaria os
; tiles que o $41 escreveu (mesmo gate do nes_chr_load_h0/_h1).
; ------------------------------------------------------------
nes_chrw_service:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chrw_active
        beq ncwsv_out
        lda @nes_chr_ram_mode
        bne ncwsv_out
        lda @nes_chrw_pend0
        ora @nes_chrw_pend1
        bne ncwsv_work
        lda #$00
        sta @nes_chrw_full           ; nada a fazer: consome o pedido de full
        lda #$ff
        sta @nes_chrw_jk             ; e' o "sem job em voo"
ncwsv_out:
        rts
ncwsv_work:
        lda @nes_chrw_full
        bne ncwsv_dofull
        ; --- v2.11: o PASSO (slice) migrou para nes_chrw_slice_service, que
        ;     roda DEPOIS da OAM. Aqui fica so' o FULL, que continua ANTES de
        ;     tudo (ele apaga a tela e drena 24KB com a VRAM livre o frame
        ;     inteiro -- e a OAM daquele frame precisa sair sob o mesmo
        ;     blank, como sempre saiu). ---
        rts
ncwsv_dofull:
        ; ---------- FULL: 1 frame escuro, drena as duas regioes ----------
        lda #$80
        sta $2100                    ; forced blank (estamos em vblank)
        lda #$01
        sta @nes_chr_reblank         ; release adiado p/ o proximo vblank
        lda #$00
        sta @nes_chrw_dreg
        jsr nes_chrw_drain
        lda #$01
        sta @nes_chrw_dreg
        jsr nes_chrw_drain
        lda #$00
        sta @nes_chrw_full
        lda #$ff
        sta @nes_chrw_jk
        jmp nes_chr_count_bump       ; rts la'
; ------------------------------------------------------------
; nes_chrw_slice_service -- (NMI, v2.11) UM PASSO de carga de janela, com o
; tamanho DERIVADO DO V CORRENTE. Chamado DEPOIS da OAM (ver
; nes_apply_vblank), que e' a mudanca que torna o passo grande possivel:
;
;   * ate' a v2.10 o passo rodava ANTES da OAM com 768 B FIXOS. Os 768 vinham
;     da cauda que sobrava de uma tilemap de 4096 B FIXOS -- e essa tilemap
;     nao existe mais desde a v2.9/v2.9b (faixa suja + scrub, media medida
;     1.040-1.200 B/frame). O envelope virou constante herdada.
;   * rodar DEPOIS da OAM protege o transfer DESTRUTIVO: a OAM passa a fechar
;     sempre no mesmo ponto (~V 235), independente do tamanho do passo --
;     hoje ela fecha DEPOIS do passo e portanto mais tarde quanto maior ele
;     for. Ou seja, esta mudanca deixa a OAM ESTRITAMENTE mais segura que a
;     v2.10, que e' a invariante do hotfix v2.7a.
;   * o tamanho sai de tabela indexada pelo V lido AQUI (nes_equates
;     NES_CHRW_VTAB_*), derivada de (261-V)*1364 menos o piso da tilemap.
;     Estourar aqui NAO e' cosmetico (F1/A13): a cauda cairia depois de
;     V=261, a PPU descarta e o dclear marca a janela como carregada =>
;     meia janela corrompida PARA SEMPRE. Por isso: tabela, nunca constante.
;
; Ganho MEDIDO (modelo da casa sobre os goldens; a linha "hoje" reproduz o
; ground truth publicado do device): SMB3 89,7% -> 98,7%, SMB2 92,5% ->
; 99,2%; frames com fila 933 -> 162 (SMB3) e idade maxima de uma janela
; pendente 77 -> 9 frames.
; ------------------------------------------------------------
nes_chrw_slice_service:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chrw_active
        bne ncwss_go
ncwss_out:
        rts
ncwss_go:
        lda @nes_chr_ram_mode
        bne ncwss_out
        lda @nes_chrw_pend0
        ora @nes_chrw_pend1
        beq ncwss_out
        lda @nes_chrw_full
        bne ncwss_out                ; full pendente: ele roda no ponto CEDO
        ; --- instrumento: frames com fila pendente (satura em $ffff) ---
        rep #$20 : .al
        lda @nes_dbg_pendfr
        inc
        beq ncwss_pfsat
        sta @nes_dbg_pendfr
ncwss_pfsat:
        sep #$20 : .as
        ; --- V CORRENTE (nao o nes_cd_v do late-guard: entre um e outro
        ;     rodaram o full/pair, a CGRAM e a OAM). $213F reseta o
        ;     flip-flop, $2137 latcha, $213D devolve V[7:0]. ---
        lda $213f
        lda $2137
        lda $213d
        sta @nes_chrw_vraw           ; V cru deste ponto (byte)
        sec
        sbc #NES_CHRW_VTAB_LO
        bcc ncwss_out                ; V<225: display ativo -- ou V>=256, que
                                      ; $213D devolve como 0..5 e cai aqui
        cmp #NES_CHRW_VTAB_N
        bcs ncwss_out                ; defensivo (V<=255 => idx<=30)
        sta @nes_chrw_vidx
        ; --- max de V observado (instrumento de calibracao bancada x silicio) ---
        rep #$30 : .al : .xl
        lda #$0000
        sep #$20 : .as
        lda @nes_chrw_vraw
        rep #$20 : .al
        cmp @nes_dbg_vhead
        bcc ncwss_vnomax
        sta @nes_dbg_vhead
ncwss_vnomax:
        sep #$20 : .as
        ; --- orcamento zero ate' no caso mais barato (so-BG)? nem escolhe
        ;     job: chamar o pick mexeria no contador de anti-fome sem
        ;     trabalho nenhum. ---
        rep #$30 : .al : .xl
        lda @nes_chrw_vidx
        and #$00ff
        tax
        lda #$0000
        sep #$20 : .as
        lda @nes_chrw_vtab_bg,x
        beq ncwss_out
        jsr nes_chrw_pick
        lda @nes_chrw_jk
        cmp #$ff
        beq ncwss_out
        ; --- staging do passo ---
        lda @nes_chrw_jreg
        sta @nes_chrw_dreg
        lda @nes_chrw_jpl
        sta @nes_chrw_dpl
        beq ncwsv_finish             ; need==0 (defensivo): conclui sem DMA
        rep #$30 : .al : .xl
        lda @nes_chrw_jk
        and #$00ff
        sta @nes_chrw_dk
        asl
        tax
        sep #$20 : .as
        jsr nes_chrw_drd
        rep #$20 : .al
        sta @nes_chrw_dwin
        lda @nes_chrw_jcur
        sta @nes_chrw_dcur
        sep #$20 : .as
        ; --- chunk do passo, em BYTES DE BG. O discriminante e' "este passo
        ;     toca o OBJ?", NAO "quantos planos?": o nes_chrw_dma_obj DOBRA o
        ;     dlen (1 tile = 16 B em 2bpp, 32 B em 4bpp), entao SO-OBJ com
        ;     chunk 512 viraria 1024 B num unico DMA = 9.212 cyc, ACIMA do
        ;     envelope de 8.184 do slice v2.2 validado em HW.  E estourar aqui
        ;     nao e' cosmetico: a cauda do DMA cai depois de V=262, a PPU
        ;     DESCARTA esses bytes e o nes_chrw_dclear marca pl[k] como
        ;     carregado assim mesmo => meia janela corrompida PARA SEMPRE (o
        ;     diff nunca mais a acusa).  Fix do A13/F1:
        ;       so-BG    -> 512 B em 1 DMA  = 5.116 cyc (2 passos)
        ;       so-OBJ   -> 256 B -> 512 de OBJ em 1 DMA = 5.116 cyc (4 passos)
        ;       2 planos -> 256 BG + 512 OBJ em 2 DMAs   = 8.184 cyc (4 passos)
        ;
        ; v2.11: o discriminante CONTINUA sendo "toca o OBJ?" -- so' que o
        ; valor deixa de ser constante e vem da tabela indexada pelo V lido
        ; no topo desta rotina, com a mesma conta acima feita com o vblank
        ; que RESTA (ver nes_equates NES_CHRW_VTAB_*). Nos dois casos o
        ; valor tabelado ja' e' <= o que cabe, entao o piso historico
        ; (NES_CHRW_SLICE_BG/_1PL) nunca precisa ser reimposto.
        rep #$30 : .al : .xl
        lda @nes_chrw_vidx
        and #$00ff
        tax
        lda #$0000
        sep #$20 : .as
        lda @nes_chrw_dpl
        cmp #NES_CHRW_PLANE_BG
        beq ncwss_bgonly             ; SO-BG: 1 DMA de 8 cyc/byte
        lda @nes_chrw_vtab_obj,x
        bra ncwss_chunk
ncwss_bgonly:
        lda @nes_chrw_vtab_bg,x
ncwss_chunk:
        beq ncwss_bump               ; orcamento zerou p/ ESTE plano: nao
                                      ; toca o cursor, tenta no proximo vblank
        rep #$20 : .al
        xba                           ; unidade da tabela = 256 B (byte alto
                                      ; era 0 pelo lda #$0000 acima)
        sta nes_cd_chunk
        lda #NES_CHRW_BG_BYTES       ; len = min(chunk, restante da janela)
        sec
        sbc @nes_chrw_dcur
        cmp nes_cd_chunk
        bcc ncwss_len
        lda nes_cd_chunk
ncwss_len:
        sta @nes_chrw_dlen
        ; --- instrumento: bytes de BG do passo + max retido + contagem ---
        cmp @nes_dbg_wmax
        bcc ncwss_nowmax
        sta @nes_dbg_wmax
ncwss_nowmax:
        sta @nes_dbg_wbytes
        lda @nes_dbg_wsteps
        inc
        sta @nes_dbg_wsteps
        sep #$20 : .as
        jsr nes_chrw_dma_step
        ; ===============================================================
        ; v2.11c ESTAGIO 1 -- INSTRUMENTO DA GUARDA DE ESTOURO: CONTA E SEGUE.
        ;
        ; O furo F1/A13 e' real: se o passo TERMINA depois de V=261 a PPU
        ; descarta a cauda do DMA e o nes_chrw_dclear marca a janela como
        ; CARREGADA assim mesmo -- meia janela corrompida PARA SEMPRE, porque
        ; o diff nunca mais a acusa (id igual, planos "completos").
        ;
        ; MAS este bloco NAO AGE. Ele mede. O passo conta e segue EXATAMENTE
        ; como na base validada em silicio: nao descarta, nao mexe no cursor,
        ; nao mexe na pendencia. O unico efeito colateral sao dois contadores
        ; em WRAM. Motivo: o beneficio de DESCARTAR so' foi demonstrado na
        ; BANCADA (casos D/I do run_chrwin_gate); descartar em jogo real troca
        ; "meia janela corrompida" por "janela que nao fecha", e nao existe
        ; medicao de silicio que diga qual e' pior. Primeiro o numero, depois
        ; a acao -- o estagio 2 (descarte + escalada para o forced-blank que o
        ; renderer ja' tem) e' CONDICIONAL a nes_dbg_wovr > 0 no device.
        ;
        ; LER O V INTEIRO, NOVE BITS. $213F reseta o flip-flop hi/lo do latch,
        ; $2137 latcha H/V, a 1a leitura de $213D devolve V[7:0] e a 2a
        ; devolve V[8] no bit 0 (bits 1-7 = open bus do PPU2). Ler so' o byte
        ; baixo -- como fazem os gates CONSERVADORES deste arquivo, onde
        ; confundir apenas ADIA trabalho -- seria fatal AQUI: o frame NTSC tem
        ; 262 linhas, entao V em [256,261] AINDA E' VBLANK e le como 0..5, e
        ; [252,256] e' exatamente onde a tabela de passo foi dimensionada para
        ; terminar (ela reserva o piso do scrub + 1 linha; alvo ~256,25).
        ;
        ; JANELA DE DISPLAY ATIVO (a unica em que a escrita se perde), modo
        ; 224 linhas: V=0 e' linha de BLANKING (pre-render), V=1..224 e'
        ; display ATIVO, V=225..261 e' vblank. Logo estouro <=> 1 <= V <= 224.
        ; V==0 vale como blanking e NAO conta -- e e' justamente o unico valor
        ; observado em toda a bancada.
        ; ===============================================================
        lda $213f                    ; reseta o flip-flop hi/lo do latch
        lda $2137                    ; latcha H/V
        lda $213d                    ; 1a leitura = V[7:0]
        sta @nes_chrw_vend
        lda $213d                    ; 2a leitura = V[8] no bit 0
        and #$01
        sta @nes_chrw_vhi            ; vend/vhi contiguos = V de 9 bits
        ; --- HIGH-WATER do fim do passo, em escala MONOTONA (V se V>=225,
        ;     senao V+262): 225..261 fechou no vblank, 262 fechou na linha de
        ;     blanking, 263+ fechou N linhas DENTRO do display. E' a
        ;     calibracao do modelo de custo contra o silicio, e ela vale
        ;     mesmo quando o contador de estouro fica em zero. ---
        rep #$20 : .al
        lda @nes_chrw_vend           ; A = V completo (0..261)
        cmp #NES_CHRQ_V_MIN
        bcs ncwss_vnowrap
        clc
        adc #NES_CHRW_V_FRAME
ncwss_vnowrap:
        cmp @nes_dbg_vwmax
        bcc ncwss_vnohw
        sta @nes_dbg_vwmax
ncwss_vnohw:
        sep #$20 : .as
        ; --- ESTOURO: so' CONTA. Cai no caminho normal nos dois casos. ---
        lda @nes_chrw_vhi
        bne ncwss_valid              ; V em [256,261]: vblank
        lda @nes_chrw_vend
        beq ncwss_valid              ; V == 0: linha de BLANKING
        cmp #NES_CHRQ_V_MIN
        bcs ncwss_valid              ; V em [225,255]: vblank
        ; --- v2.12 ESTAGIO 2: ESTOURO (V em [1,224] = display ATIVO). O
        ;     passo NAO conta: cursor (nes_chrw_jcur) e pendencia ficam
        ;     INTACTOS e o MESMO intervalo desce de novo no vblank seguinte.
        ;     O retry e' IDEMPOTENTE -- fonte na PSRAM, destino no mesmo
        ;     endereco; nes_chrw_drd / _dma_bg / _dma_obj nao escrevem estado
        ;     nenhum, o dcur e' recomputado a cada staging e o dclear (que e'
        ;     quem MARCA a janela como carregada) so' roda no caminho valido.
        ;     ESCALADA, nao back-off: apos NES_CHRW_DISC_MAX descartes
        ;     seguidos no MESMO jk, arma o caminho FULL que o renderer ja'
        ;     tem (forced-blank + drena as duas regioes). Sem esse escape o
        ;     nes_chrw_pick sai cedo com job em voo valido e as DUAS regioes
        ;     param: e' o livelock pend=[224,0] que o gate rotula. Back-off
        ;     (nes_chrw_vpen) fica FORA -- medido no-op campo a campo.
        rep #$20 : .al
        lda @nes_dbg_wovr
        inc
        beq ncwss_ovsat              ; satura em $ffff
        sta @nes_dbg_wovr
ncwss_ovsat:
        sep #$20 : .as
        ; --- v2.12: o DESCARTE deste caminho fica FORA deste candidato. Ele
        ;     esta' isolado em STAGE2-CHRW.diff, com a medicao que o
        ;     desqualifica por ora: na bancada (run_chrwin_gate D e I) ele
        ;     ELIMINA a corrupcao de conteudo (as 3+5 comparacoes
        ;     "VRAM OBJ reg0 kN != janela" da base somem) mas reproduz a fome
        ;     medida em bancada -- 6 de 8 janelas nunca carregam
        ;     -- e a ESCALADA para o full dispara (wesc=1) sem resgatar. Ou
        ;     seja: a troca "meia janela corrompida" x "janela que nao fecha"
        ;     continua sem juiz, e este caminho NAO e' o do Bomberman II
        ;     (mapper 1 + CHR-RAM: ZERO troca de banco em 1800 frames). Aqui
        ;     fica o instrumento do ESTAGIO 1, intacto: CONTA E SEGUE.
ncwss_valid:
        rep #$20 : .al
        lda @nes_chrw_jcur
        clc
        adc @nes_chrw_dlen
        sta @nes_chrw_jcur
        cmp #NES_CHRW_BG_BYTES
        sep #$20 : .as
        bcc ncwss_bump
ncwsv_finish:
        rep #$30 : .al : .xl
        lda @nes_chrw_jk
        and #$00ff
        asl
        tax
        sep #$20 : .as
        jsr nes_chrw_dclear
        lda #$ff
        sta @nes_chrw_jk
ncwss_bump:
        jmp nes_chr_count_bump       ; rts la'

; ------------------------------------------------------------
; v2.11 -- TABELAS DE PASSO POR V (unidade = 256 B, teto 1024 = a janela
; inteira). Indice = V - NES_CHRW_VTAB_LO (225), 31 entradas (V 225..255).
; Derivacao (nes_equates NES_CHRW_VTAB_*):
;   reserva = 1 DMA + NES_TM_SCRUB_MIN(512 B) + 1 linha = 6.480 cyc
;   OBJ (2 planos, pior caso): L = ((261-V)*1364 - 6480 - 2040) / 24
;   BG  (1 DMA de 8 cyc/byte): L = ((261-V)*1364 - 6480 - 1020) /  8
; Valores = floor(L/256), saturado em 4. Recomputar AMBAS se qualquer
; termo do orcamento mudar (tamanho da OAM, piso do scrub, fim do vblank).
; ------------------------------------------------------------
nes_chrw_vtab_obj:
        ;   V=225..236 -> janela inteira; 237..241 -> 768; 242..245 -> 512;
        ;   246..250 -> 256; 251+ -> nao cabe nem o menor passo
        .byt 4,4,4,4,4,4,4,4,4,4,4,4
        .byt 3,3,3,3,3
        .byt 2,2,2,2
        .byt 1,1,1,1,1
        .byt 0,0,0,0,0
nes_chrw_vtab_bg:
        .byt 4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4
        .byt 3,2,2,1,1,0

; ------------------------------------------------------------
; nes_chr_shift -- srcbank:src = (nes_cd_src) << Y (24-bit). Contexto NMI.
; ------------------------------------------------------------
nes_chr_shift:
        sep #$20 : .as
        rep #$10 : .xl
        lda #$00
        sta nes_cd_srcbank
ncsh_loop:
        rep #$20 : .al
        asl nes_cd_src
        sep #$20 : .as
        rol nes_cd_srcbank
        dey
        bne ncsh_loop
        rts

; ------------------------------------------------------------
; nes_chr_dma_one -- 1 DMA VRAM (modo $01, $2118). Entrada: nes_cd_dst
; (word VRAM), nes_cd_srcbank, nes_cd_src, nes_cd_len. Contexto NMI.
; ------------------------------------------------------------
nes_chr_dma_one:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda nes_cd_dst
        sta $2116
        sep #$20 : .as
        lda #$01
        sta $4300
        lda #$18
        sta $4301
        lda nes_cd_srcbank
        sta $4304
        rep #$20 : .al
        lda nes_cd_src
        sta $4302
        lda nes_cd_len
        sta $4305
        sep #$20 : .as
        lda #$01
        sta $420b
        rts

; ------------------------------------------------------------
; nes_chr_dma_bg / nes_chr_dma_obj -- v2.2: loaders SO de METADE (geometria
; unificada; 8K = 2 metades). Computam src24/dst/len do staging (bank=id4k,
; dst=metade, reg=regiao, cursor em bytes BG) + nes_cd_chunk, e DMAm UM
; pedaco (full: chunk=$ffff; slice: chunk=SLICE). Contexto NMI.
; ------------------------------------------------------------
nes_chr_dma_bg:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda #$1000                   ; metade BG 2bpp = 4KB
        sta nes_cd_total
        sep #$20 : .as
        lda @nes_chr_dma_reg
        bne ncdbg_r1
        rep #$20 : .al
        lda #NES_CHR_SLOT0_BG_WORD
        bra ncdbg_rset
ncdbg_r1:
        rep #$20 : .al
        lda #NES_CHR_SLOT1_BG_WORD
ncdbg_rset:
        sta nes_cd_dst
        sep #$20 : .as
        lda @nes_chr_dma_dst         ; metade
        beq ncdbg_h0
        rep #$20 : .al
        lda nes_cd_dst
        clc
        adc #NES_CHR_HALF_BG_WORD
        sta nes_cd_dst
        sep #$20 : .as
ncdbg_h0:
        rep #$20 : .al
        lda @nes_chr_dma_bank
        sta nes_cd_src
        sep #$20 : .as
        ldy #12                      ; id4k * $1000
        jsr nes_chr_shift
        rep #$20 : .al
        lda nes_cd_src               ; src += cursor (bytes BG)
        clc
        adc @nes_chr_dma_cursor
        sta nes_cd_src
        sep #$20 : .as
        bcc ncdbg_c1
        inc nes_cd_srcbank
ncdbg_c1:
        rep #$20 : .al
        lda nes_cd_src               ; src += base_addr
        clc
        adc @nes_chr_bg_base_addr
        sta nes_cd_src
        sep #$20 : .as
        bcc ncdbg_c2
        inc nes_cd_srcbank
ncdbg_c2:
        lda nes_cd_srcbank
        clc
        adc @nes_chr_bg_base_bank
        sta nes_cd_srcbank
        rep #$20 : .al
        lda @nes_chr_dma_cursor      ; dst += cursor/2 (words)
        lsr
        clc
        adc nes_cd_dst
        sta nes_cd_dst
        lda nes_cd_total             ; len = min(chunk, total - cursor)
        sec
        sbc @nes_chr_dma_cursor
        cmp nes_cd_chunk
        bcc ncdbg_len
        lda nes_cd_chunk
ncdbg_len:
        sta nes_cd_len
        sep #$20 : .as
        jmp nes_chr_dma_one          ; rts la'

nes_chr_dma_obj:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda #$2000                   ; metade OBJ 4bpp = 8KB
        sta nes_cd_total
        lda @nes_chr_dma_cursor      ; cursor_obj = cursor*2
        asl
        sta nes_cd_tmp
        sep #$20 : .as
        lda @nes_chr_dma_reg
        bne ncdob_r1
        rep #$20 : .al
        lda #NES_CHR_SLOT0_OBJ_WORD
        bra ncdob_rset
ncdob_r1:
        rep #$20 : .al
        lda #NES_CHR_SLOT1_OBJ_WORD
ncdob_rset:
        sta nes_cd_dst
        sep #$20 : .as
        lda @nes_chr_dma_dst
        beq ncdob_h0
        rep #$20 : .al
        lda nes_cd_dst
        clc
        adc #NES_CHR_HALF_OBJ_WORD
        sta nes_cd_dst
        sep #$20 : .as
ncdob_h0:
        rep #$20 : .al
        lda @nes_chr_dma_bank
        sta nes_cd_src
        sep #$20 : .as
        ldy #13                      ; id4k * $2000
        jsr nes_chr_shift
        rep #$20 : .al
        lda nes_cd_src               ; src += cursor_obj
        clc
        adc nes_cd_tmp
        sta nes_cd_src
        sep #$20 : .as
        bcc ncdob_c1
        inc nes_cd_srcbank
ncdob_c1:
        rep #$20 : .al
        lda nes_cd_src
        clc
        adc @nes_chr_obj_base_addr
        sta nes_cd_src
        sep #$20 : .as
        bcc ncdob_c2
        inc nes_cd_srcbank
ncdob_c2:
        lda nes_cd_srcbank
        clc
        adc @nes_chr_obj_base_bank
        sta nes_cd_srcbank
        rep #$20 : .al
        lda @nes_chr_dma_cursor      ; dst += cursor (words == cursor_obj/2)
        clc
        adc nes_cd_dst
        sta nes_cd_dst
        lda nes_cd_total             ; len = min(chunk, total - cursor_obj)
        sec
        sbc nes_cd_tmp
        cmp nes_cd_chunk
        bcc ncdob_len
        lda nes_cd_chunk
ncdob_len:
        sta nes_cd_len
        sep #$20 : .as
        jmp nes_chr_dma_one          ; rts la'

; ------------------------------------------------------------
; nes_chr_stage0/1 -- (NMI) staging <- descritor 0/1 (bank/cursor/reg;
; dst = indice da metade).
; ------------------------------------------------------------
nes_chr_stage0:
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_chr_d0_bank
        sta @nes_chr_dma_bank
        lda @nes_chr_d0_cursor
        sta @nes_chr_dma_cursor
        sep #$20 : .as
        lda #$00
        sta @nes_chr_dma_dst
        lda @nes_chr_d0_reg
        sta @nes_chr_dma_reg
        rts
nes_chr_stage1:
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_chr_d1_bank
        sta @nes_chr_dma_bank
        lda @nes_chr_d1_cursor
        sta @nes_chr_dma_cursor
        sep #$20 : .as
        lda #$01
        sta @nes_chr_dma_dst
        lda @nes_chr_d1_reg
        sta @nes_chr_dma_reg
        rts

; ------------------------------------------------------------
; nes_chr_count_bump -- (NMI) nes_chr_dma_count++ (gate de convergencia).
; ------------------------------------------------------------
nes_chr_count_bump:
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_chr_dma_count
        inc
        sta @nes_chr_dma_count
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chr_dma_full_service -- (NMI) mode 1: forced-blank + DMA da(s)
; metade(s) FULL. Blanking: $2100=$80 AQUI (vblank) + nes_chr_reblank=1;
; o RELEASE ($0F) acontece SO NO PROXIMO VBLANK (topo do apply) -- NUNCA
; mid-display (era a linha branca de 1px do device; v2.2). 2 metades full
; no mesmo vblank = 24KB, teto ja validado.
; ------------------------------------------------------------
nes_chr_dma_full_service:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chr_d0_mode
        cmp #$01
        beq ncdfs_any
        lda @nes_chr_d1_mode
        cmp #$01
        beq ncdfs_any
        rts
ncdfs_any:
        lda #$80
        sta $2100                    ; forced blank (estamos em vblank)
        lda #$01
        sta @nes_chr_reblank         ; release adiado p/ o proximo vblank
        lda @nes_chr_d0_mode
        cmp #$01
        bne ncdfs_d1
        jsr nes_chr_stage0
        rep #$20 : .al               ; GUARD (race do upgrade v2.2b): cursor
        lda @nes_chr_dma_cursor      ; ja no fim -> len=0 viraria DMA de 64KB
        cmp #$1000
        sep #$20 : .as
        bcc ncdfs_d0_go
        lda #$00
        sta @nes_chr_d0_mode         ; nada a fazer (slice completou na race)
        bra ncdfs_d1
ncdfs_d0_go:
        rep #$20 : .al
        lda #$ffff
        sta nes_cd_chunk
        sep #$20 : .as
        jsr nes_chr_dma_bg
        rep #$20 : .al
        lda #$ffff
        sta nes_cd_chunk
        sep #$20 : .as
        jsr nes_chr_dma_obj
        lda #$00
        sta @nes_chr_d0_mode
        jsr nes_chr_count_bump
ncdfs_d1:
        lda @nes_chr_d1_mode
        cmp #$01
        bne ncdfs_done
        jsr nes_chr_stage1
        rep #$20 : .al               ; GUARD (idem d0)
        lda @nes_chr_dma_cursor
        cmp #$1000
        sep #$20 : .as
        bcc ncdfs_d1_go
        lda #$00
        sta @nes_chr_d1_mode
        bra ncdfs_done
ncdfs_d1_go:
        rep #$20 : .al
        lda #$ffff
        sta nes_cd_chunk
        sep #$20 : .as
        jsr nes_chr_dma_bg
        rep #$20 : .al
        lda #$ffff
        sta nes_cd_chunk
        sep #$20 : .as
        jsr nes_chr_dma_obj
        lda #$00
        sta @nes_chr_d1_mode
        jsr nes_chr_count_bump
ncdfs_done:
        rts

; ------------------------------------------------------------
; nes_chr_slice_step -- (NMI) um passo de fatia do loader STAGED (metade):
; SLICE_BG de BG + 2x de OBJ; cursor += SLICE; count++.
; ------------------------------------------------------------
nes_chr_slice_step:
        sep #$20 : .as
        rep #$20 : .al
        lda #NES_CHR_SLICE_BG
        sta nes_cd_chunk
        sep #$20 : .as
        jsr nes_chr_dma_bg
        rep #$20 : .al
        lda #NES_CHR_SLICE_BG+NES_CHR_SLICE_BG
        sta nes_cd_chunk
        sep #$20 : .as
        jsr nes_chr_dma_obj
        rep #$20 : .al
        lda @nes_chr_dma_cursor
        clc
        adc #NES_CHR_SLICE_BG
        sta @nes_chr_dma_cursor
        sep #$20 : .as
        jmp nes_chr_count_bump       ; rts la'

; ------------------------------------------------------------
; nes_chr_dma_slice_service -- (NMI) mode 2: fatia UM loader por vblank (d0
; primeiro). Gate V<=SLICE_V_MAX (tilemap/OAM inviolaveis). Termina quando
; cursor >= $1000 (metade BG).
; ------------------------------------------------------------
nes_chr_dma_slice_service:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chr_d0_mode
        cmp #$02
        beq ncdss_pick0
        lda @nes_chr_d1_mode
        cmp #$02
        beq ncdss_pick1
        rts
ncdss_pick0:
        lda nes_cd_v
        cmp #NES_CHR_SLICE_V_MAX+1
        bcs ncdss_out
        jsr nes_chr_stage0
        jsr nes_chr_slice_step
        rep #$20 : .al
        lda @nes_chr_dma_cursor
        sta @nes_chr_d0_cursor
        cmp #$1000
        sep #$20 : .as
        bcc ncdss_out
        lda #$00
        sta @nes_chr_d0_mode
        rts
ncdss_pick1:
        lda nes_cd_v
        cmp #NES_CHR_SLICE_V_MAX+1
        bcs ncdss_out
        jsr nes_chr_stage1
        jsr nes_chr_slice_step
        rep #$20 : .al
        lda @nes_chr_dma_cursor
        sta @nes_chr_d1_cursor
        cmp #$1000
        sep #$20 : .as
        bcc ncdss_out
        lda #$00
        sta @nes_chr_d1_mode
ncdss_out:
        rts

; ------------------------------------------------------------
; nes_chr_apply_tilebase -- (NMI) BG12NBA/OBSEL da REGIAO em exibicao.
; Gated em nes_chr_active (sem CHR_STATE visto -> defaults de boot).
; ------------------------------------------------------------
nes_chr_apply_tilebase:
        sep #$20 : .as
        lda @nes_chr_active
        beq ncat_done
        lda @nes_chr_cur_slot
        bne ncat_slot1
        lda #NES_CHR_BG12NBA_SLOT0
        sta $210b
        lda #NES_CHR_OBSEL_SLOT0
        sta $2101
        rts
ncat_slot1:
        lda #NES_CHR_BG12NBA_SLOT1
        sta $210b
        lda #NES_CHR_OBSEL_SLOT1
        sta $2101
ncat_done:
        rts

; ------------------------------------------------------------
; nes_chr_reblank_release -- (NMI, TOPO do apply, ANTES do gate de pending):
; se um full deixou a tela em forced-blank, religa ($0F) AGORA -- estamos
; em vblank => transicao de INIDISP nunca acontece mid-display (v2.2, fix
; da linha branca de 1px). Se o proprio apply blankar de novo (full novo),
; o $80 do servico re-apaga ainda em vblank (o $0F intermediario e' de
; microssegundos, invisivel).
; ------------------------------------------------------------
nes_chr_reblank_release:
        sep #$20 : .as
        lda @nes_chr_reblank
        beq ncrr_done
        lda $213f                    ; reseta o flip-flop do latch
        lda $2137                    ; latcha H/V
        lda $213d                    ; V[7:0]
        cmp #225
        bcc ncrr_done                ; fora da janela segura: tenta no proximo
        cmp #251
        bcs ncrr_done
        lda #$0f
        sta $2100                    ; screen on, brilho maximo (em vblank)
        lda #$00
        sta @nes_chr_reblank
ncrr_done:
        rts

; ============================================================
; ==== CHR-RAM: CMD_CHR_RUN ($41), swizzle + DMA em bloco ====
;
; CONTEXTO. Mapper 2/7 (UNROM/AxROM) nao tem CHR-ROM: os 8KB de padroes sao
; RAM que o jogo escreve em runtime. O loader nao tem o que pre-converter, e
; ate' aqui o renderer simplesmente IGNORAVA o $41 (parse-only) -- esses
; jogos carregavam e mostravam lixo. Este bloco conserta isso.
;
; ENCODING (contrato, ver nes_equates.i65 CMD_CHR_RUN):
;   $41 chr_off(2, LE, offset em BYTES na CHR-RAM 0..$1FFF) len(1) data(len)
; Payload INLINE em formato NES CRU -- o renderer NUNCA le a CHR-RAM de
; volta da PSRAM (seria contencao com o core).
;
; POR QUE SWIZZLE + DMA EM BLOCO (e nao plane-DMA por VMAIN). O truque do
; VMAIN ($2115 bit7 escolhendo se o endereco avanca no write de $2118 ou de
; $2119) produz o formato certo com ZERO ciclo de CPU, e foi a 1a versao
; deste bloco. Ele custa 2 DMAs por TILE por regiao, e a ancora MEDIDA da
; casa e' ~1020 master cyc por TRANSFERENCIA de DMA -- nao os 45+28 que o
; cost_model.py assumiu. Isso da' ~250 master por BYTE de payload: um run de
; 240 B (o REGIME sustentado do Battletoads) custaria ~44 scanlines, estouraria
; o vblank com o cursor de leitura ja' avancado, e a PPU descartaria a cauda =
; tile corrompido PARA SEMPRE. O proprio design (SS5.3) declarava o fallback
; para "muitos tiles onde o setup por DMA domina": SWIZZLE no 65816. E' este.
;
; FORMATO (identico ao contrato de utils/nes_chr_convert.py):
;   tile NES  = 16 B: [plano0 linhas 0-7][plano1 linhas 0-7]
;   tile SNES 2bpp (BG,  16 B) = por linha r: [plano0(r), plano1(r)]
;   tile SNES 4bpp (OBJ, 32 B) = os 16 acima + 16 B de planos 2/3 SEMPRE ZERO
;
; AS TRES PECAS (mapa e protocolo completos em nes_data.a65):
;   1. SHADOW (nes_chr_shadow, 8KB, formato NES) -- fonte de verdade. Todo
;      $41 escreve nela ANTES de tudo. E' o que faz um run que comeca ou
;      termina no MEIO de um tile nao precisar de tratamento parcial nenhum:
;      o tile inteiro e' reconvertido a partir do shadow (os bytes que o run
;      nao trouxe ja' estao la', de runs anteriores). E e' o que da' um
;      caminho de RECONSTRUCAO TOTAL, o fail-safe de estouro da fila.
;   2. ARRAYS CONVERTIDOS (bg 16 B/tile, ob 32 B/tile), PACKED com passo
;      FIXO. Um run de N tiles CONSECUTIVOS vira destino de VRAM CONTIGUO
;      nos dois => 1 DMA de 16N para o BG + 1 DMA de 32N para o OBJ. O passo
;      fixo tambem e' o que permite zerar os planos 2/3 (bytes 16..31 de cada
;      slot de OBJ) UMA VEZ no boot e nunca mais tocar neles.
;   3. DESCRITORES [t0(2) nt(2) tofs(2) pad(2)] -- o que a NMI precisa pra
;      montar os 2 DMAs: word de VRAM = BG_BASE + t0*8 / OBJ_BASE + t0*16.
;
; CUSTO (numeros revisados na W10c, contagem instrucao a instrucao).
;   MAIN, swizzle DESENROLADO: ~512 cyc de CPU/tile ~= 3600 master.
;   NMI: 2040 + 384*N master cyc = 1,50 + 0,281*N scanlines.
; Regime medido (15 tiles/frame): ~17,6% do display ativo + 5,7 scanlines de
; vblank. Pico do corpus (133 tiles, megaman1/2): 39 scanlines de DMA e ~156%
; do display -- os dois so' acontecem com a tela do NES APAGADA (100% dos
; despejos medidos), onde o frame gasta o quanto precisar.
; ============================================================

; ------------------------------------------------------------
; nes_chrq_swz -- converte nes_cqs_n tiles do shadow pros arrays do buffer.
; Entrada: X = offset do 1o tile no SHADOW (16*t), Y = offset do 1o tile no
; array BG (16*tofs), nes_cqs_bgp/bgb = base do array BG, nes_cqs_obp/obb =
; base do array OBJ JA COMPENSADA (ob_base + 16*tofs).
;
; O TRUQUE DO Y COMPARTILHADO: dentro de um tile, o byte k vai pra
; bg_base + 16*tofs + k e pra ob_base + 32*tofs + k. Com Y = 16*tofs + k, o
; BG sai direto de [bgp],y (bgp = bg_base) e o OBJ sai de [obp],y desde que
; obp = ob_base + 16*tofs -- porque ob_base + 16*tofs + (16*tofs + k) =
; ob_base + 32*tofs + k. Um unico indice serve aos dois arrays de passos
; DIFERENTES; obp avanca 16 por tile (e Y avanca 16 sozinho).
;
; CONTEXTO: chamada pelo MAIN (stage) E pela NMI (rebuild total). Nao ha
; race -- a NMI so' chama com nes_chrq_full setado, e sob esse flag o MAIN
; nao converte tile nenhum (INVARIANTE documentada em nes_data.a65).
; ------------------------------------------------------------
nes_chrq_swz:
        sep #$20 : .as
        rep #$10 : .xl
ncsw_tile:
        rep #$20 : .al
        lda nes_cqs_n
        sep #$20 : .as
        bne ncsw_go
        rts
ncsw_go:
        ; 8 linhas DESENROLADAS com offset FIXO no long,X: sem contador
        ; de linha (era rep/lda/dec/sta/sep/bne = ~16 dos ~59 cyc por
        ; linha) e sem os 8 'inx' (X so' anda 16 no fim do tile). Y anda
        ; 2 por linha => 16 por tile, sozinho.
        lda @nes_chr_shadow+0,x         ; plano 0, linha 0 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+8,x         ; plano 1, linha 0 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+1,x         ; plano 0, linha 1 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+9,x         ; plano 1, linha 1 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+2,x         ; plano 0, linha 2 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+10,x         ; plano 1, linha 2 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+3,x         ; plano 0, linha 3 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+11,x         ; plano 1, linha 3 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+4,x         ; plano 0, linha 4 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+12,x         ; plano 1, linha 4 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+5,x         ; plano 0, linha 5 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+13,x         ; plano 1, linha 5 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+6,x         ; plano 0, linha 6 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+14,x         ; plano 1, linha 6 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+7,x         ; plano 0, linha 7 -> byte BAIXO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        lda @nes_chr_shadow+15,x         ; plano 1, linha 7 -> byte ALTO
        sta [nes_cqs_bgp],y
        sta [nes_cqs_obp],y
        iny
        rep #$20 : .al
        txa                          ; proximo tile no shadow (16 B)
        clc
        adc #$0010
        tax
        lda nes_cqs_obp              ; OBJ avanca 16/tile (Y avanca sozinho)
        clc
        adc #$0010
        sta nes_cqs_obp
        lda nes_cqs_n
        dec
        sta nes_cqs_n
        sep #$20 : .as
        bra ncsw_tile

; ------------------------------------------------------------
; nes_chrq_setbuf -- (.as, A = id do buffer 1/2) resolve as bases do buffer
; no bloco de scratch do MAIN (nes_cq_*). ni = 0 (buf0) / 2 (buf1).
; ------------------------------------------------------------
nes_chrq_setbuf:
        sep #$20 : .as
        cmp #$02
        beq ncsb_b1
        rep #$20 : .al
        lda #!nes_chrq_dsc0
        sta nes_cq_dscb
        lda #!nes_chrq_bg0
        sta nes_cqs_bgp
        lda #!nes_chrq_ob0
        sta nes_cq_obb
        lda #$0000
        sta nes_cq_ni
        sep #$20 : .as
        rts
ncsb_b1:
        rep #$20 : .al
        lda #!nes_chrq_dsc1
        sta nes_cq_dscb
        lda #!nes_chrq_bg1
        sta nes_cqs_bgp
        lda #!nes_chrq_ob1
        sta nes_cq_obb
        lda #$0002
        sta nes_cq_ni
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chr_handle_run -- CMD_CHR_RUN ($41), contexto MAIN (display ativo).
; Devolve o tamanho TLV (4 + len CRU) em X. Nao escreve VRAM nenhuma.
; ------------------------------------------------------------
nes_chr_handle_run:
        sep #$20 : .as
        rep #$10 : .xl
        lda #$01
        sta @nes_chr_ram_mode        ; 1o $41 => a ROM usa CHR-RAM (gate da
                                      ; residencia v2.2/v2.3, ver load_h0)
        rep #$20 : .al
        ldy #$0001
        lda [nes_parse_ptr],y        ; chr_off (16 bits, LE)
        sta nes_cq_off
        sep #$20 : .as
        ldy #$0003
        lda [nes_parse_ptr],y        ; len (1..255)
        rep #$20 : .al
        and #$00ff
        sta nes_cq_len               ; len CRU -> define o tamanho TLV
        sta nes_cq_cl                ; copia (clampada abaixo)

        ; --- clamp na CHR-RAM de 8KB. O RTL ja' normaliza o offset; isto e'
        ;     fail-safe de FRONTEIRA: um off/len fora da faixa nunca pode
        ;     virar escrita fora do shadow nem fora da regiao 0 da VRAM. ---
        lda nes_cq_off
        cmp #NES_CHR_RAM_BYTES
        bcc nchru_inrange
        sep #$20 : .as
        brl nchru_size               ; off alem da CHR-RAM: nada a aplicar
nchru_inrange:
        rep #$20 : .al
        lda #NES_CHR_RAM_BYTES
        sec
        sbc nes_cq_off               ; espaco ate' o fim da CHR-RAM
        cmp nes_cq_cl
        bcs nchru_cl_ok
        sta nes_cq_cl                ; trunca
nchru_cl_ok:
        rep #$20 : .al
        lda nes_cq_cl
        bne nchru_have
        sep #$20 : .as
        brl nchru_size               ; len 0 (ou truncado a 0)
nchru_have:
        lda @nes_chrq_bacc           ; breadcrumb de banda (bytes/frame)
        clc
        adc nes_cq_cl
        sta @nes_chrq_bacc

        ; --- 1) SHADOW primeiro, SEMPRE: e' a fonte de verdade, e o rebuild
        ;     total depende dela estar em dia mesmo quando a fila estoura.
        ;     MVN da mailbox pro shadow (mesmo stub em WRAM do nt_run;
        ;     src-bank patchado por chamada). Tudo que vem de memoria e' lido
        ;     ANTES do MVN, com DBR ainda $00 -- o MVN deixa DBR = banco
        ;     DESTINO ($7F) e simbolo de pagina-0 monta ABSOLUTO
        ;     (= DBR-relativo), entao nada pode ser lido entre MVN e plb. ---
        sep #$20 : .as
        lda nes_parse_bank
        sta @nes_mvn_stub+2
        phb
        rep #$30 : .al : .xl
        lda nes_parse_ptr
        clc
        adc #$0004                   ; dados do run comecam em +4
        tax
        lda nes_cq_off
        clc
        adc #!nes_chr_shadow
        tay
        lda nes_cq_cl
        dec                          ; MVN move A+1 bytes
        jsl @nes_mvn_stub
        sep #$20 : .as
        plb

        ; --- 2) faixa de TILES tocada: t0 = off>>4, t1 = (off+cl-1)>>4 ---
        rep #$20 : .al
        lda nes_cq_off
        lsr : lsr : lsr : lsr
        sta nes_cq_t0
        lda nes_cq_off
        clc
        adc nes_cq_cl
        dec
        lsr : lsr : lsr : lsr
        sec
        sbc nes_cq_t0
        inc
        sta nes_cq_nt
        sep #$20 : .as

        ; --- 3) DESPACHO (v2.8). Tres caminhos, nesta ordem:
        ;
        ;  (a) rebuild total ja' pendente: o shadow (atualizado acima) e' tudo
        ;      que a NMI precisa -- nao converte nada.
        ;  (b) DESPEJO RAPIDO (modo ja' ativo, ou rendering OFF neste frame):
        ;      NAO converte nada aqui. So' amplia a faixa suja; a conversao
        ;      inteira vira passe fatiado em forced-blank (nes_chrfd_service).
        ;      E' a alavanca de CAPACIDADE: o custo do consumo cai de ~225
        ;      para ~64 master/byte, o ACK acompanha a bridge e ela para de
        ;      aposentar payload nao confirmado (a causa medida dos ~2727 B /
        ;      200 tiles perdidos no titulo do Mega Man).
        ;  (c) caminho normal (rendering LIGADO): stage incremental, byte a
        ;      byte identico ao de sempre. O teto FISICO com a tela ligada e'
        ;      ~24 tiles/frame, que o stage cobre com folga -- animacao de CHR
        ;      (Battletoads) nao muda de comportamento.
        ;
        ; O GATE E' O ppumask DO FRAME QUE ESTAMOS DECODIFICANDO: o CMD_REGS
        ; vem em offset FIXO (6) do frame, muito antes de qualquer $41, e quem
        ; escreveu nes_regs_ppumask foi este mesmo contexto (MAIN) -- nao ha'
        ; corrida com a NMI aqui. O lado da NMI usa o latch nes_chrfd_ron, que
        ; o publish tira do frame COMMITADO.
        lda @nes_chrq_full
        bne nchru_size
        lda @nes_chrfd_mode
        bne nchru_fast               ; ja' em despejo: so' marca a faixa
        lda @nes_regs_ppumask
        and #$18                     ; b3 = BG visivel, b4 = OBJ visivel
        bne nchru_stage              ; rendering LIGADO -> caminho normal
        lda #$01
        sta @nes_chrfd_mode
        rep #$20 : .al
        lda @nes_chrfd_ent           ; breadcrumb: episodios de despejo
        inc
        sta @nes_chrfd_ent
        sep #$20 : .as
nchru_fast:
        jsr nes_chrfd_mark
        bra nchru_size
nchru_stage:
        jsr nes_chrq_stage
nchru_size:
        rep #$20 : .al
        lda nes_cq_len
        clc
        adc #$0004
        rep #$10 : .xl
        tax
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrq_stage -- (MAIN) converte os nes_cq_nt tiles a partir de
; nes_cq_t0 pro buffer aberto, criando ou ESTENDENDO um descritor. Estouro
; (descritores ou tiles) escala pro rebuild total -- nunca descarta.
; ------------------------------------------------------------
nes_chrq_stage:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chrq_wr
        bne ncst_have_buf
        ; abre o buffer que NAO esta' publicado pra NMI e zera os contadores
        lda @nes_chrq_rdy
        cmp #$01
        beq ncst_pick2
        lda #$01
        bra ncst_pick_set
ncst_pick2:
        lda #$02
ncst_pick_set:
        sta @nes_chrq_wr
        jsr nes_chrq_setbuf
        rep #$30 : .al : .xl
        ldx nes_cq_ni
        lda #$0000
        sta @nes_chrq_nd0,x
        sta @nes_chrq_nt0,x
        sep #$20 : .as
        bra ncst_room
ncst_have_buf:
        jsr nes_chrq_setbuf
ncst_room:
        ; cabe em TILES?
        rep #$30 : .al : .xl
        ldx nes_cq_ni
        lda @nes_chrq_nt0,x
        sta nes_cq_tofs              ; 1o tile deste run nos arrays
        clc
        adc nes_cq_nt
        cmp #NES_CHRQ_TILES_MAX+1
        sep #$20 : .as
        bcs ncst_overflow
        ; --- MERGE: se o descritor anterior termina exatamente onde este
        ;     comeca, so' estende o nt dele (economiza 2 DMAs por run e e' o
        ;     caso comum de um jogo despejando CHR sequencialmente).
        ;
        ;     COM TETO (NES_CHRQ_MERGE_MAX) -- sem ele o merge vira RATCHET
        ;     MONOTONO e o sistema trava em pisca-preto. A cadeia: quando o
        ;     publish e' bloqueado (rdy != 0, a NMI ainda nao dreiou), o MAIN
        ;     CONTINUA no mesmo buffer, e o run do frame seguinte EMENDA no
        ;     descritor do frame anterior. A cauda real de vblank e' curta
        ;     (a NMI entra em V=225-227 e o tilemap+OAM levam ~27 linhas =>
        ;     V~254-257 quando o servico roda; V>=256 le como 0-4 e ADIA
        ;     tudo), entao um descritor que so' cresce nunca cabe: o
        ;     Battletoads em regime (14-15 tiles/frame) inflaria ate' nt>=125,
        ;     onde o unico caminho e' forced-blank -- com rendering LIGADO,
        ;     liberado pelo escape de 8 vblanks = frame preto RECORRENTE em
        ;     gameplay. Com o teto os descritores ficam pequenos, o
        ;     ncqs_loop dreia VARIOS por vblank e a producao (<=24
        ;     tiles/frame, teto fisico do NES) perde pro dreno (~14/vblank
        ;     a partir de V=254, mais com a cauda inteira livre). ---
        rep #$30 : .al : .xl
        ldx nes_cq_ni
        lda @nes_chrq_nd0,x
        beq ncst_newdsc              ; buffer vazio: nao ha o que estender
        dec                          ; indice do ULTIMO descritor
        jsr ncst_dsc_ptr             ; nes_cq_dp -> dsc[A]
        ldy #$0000
        lda [nes_cq_dp],y            ; t0 do descritor anterior
        ldy #$0002
        clc
        adc [nes_cq_dp],y            ; + nt  => 1o tile APOS ele
        cmp nes_cq_t0
        bne ncst_newdsc              ; nao emenda (inclui o caso de SOBREPOR:
                                      ; um descritor novo depois vence, porque
                                      ; a NMI aplica em ordem)
        ldy #$0002
        lda [nes_cq_dp],y
        clc
        adc nes_cq_nt
        cmp #NES_CHRQ_MERGE_MAX+1
        bcs ncst_newdsc              ; teto: acima disso abre descritor NOVO
        sta [nes_cq_dp],y            ; estende o descritor anterior
        sep #$20 : .as
        bra ncst_convert
ncst_newdsc:
        rep #$30 : .al : .xl
        ldx nes_cq_ni
        lda @nes_chrq_nd0,x
        cmp #NES_CHRQ_DSC_MAX
        sep #$20 : .as
        bcs ncst_overflow
        rep #$30 : .al : .xl
        ldx nes_cq_ni
        lda @nes_chrq_nd0,x
        jsr ncst_dsc_ptr             ; nes_cq_dp -> dsc[nd]
        ldy #$0000
        lda nes_cq_t0
        sta [nes_cq_dp],y
        ldy #$0002
        lda nes_cq_nt
        sta [nes_cq_dp],y
        ldy #$0004
        lda nes_cq_tofs
        sta [nes_cq_dp],y
        ldx nes_cq_ni
        lda @nes_chrq_nd0,x
        inc
        sta @nes_chrq_nd0,x
        sep #$20 : .as
ncst_convert:
        ; contadores: tiles usados + breadcrumb de banda do frame
        rep #$30 : .al : .xl
        ldx nes_cq_ni
        lda @nes_chrq_nt0,x
        clc
        adc nes_cq_nt
        sta @nes_chrq_nt0,x
        lda @nes_chrq_tacc
        clc
        adc nes_cq_nt
        sta @nes_chrq_tacc
        ; parametros do swizzle (nes_cqs_bgp ja' veio do setbuf)
        lda nes_cq_nt
        sta nes_cqs_n
        lda nes_cq_tofs              ; obp = ob_base + 16*tofs (Y compartilhado)
        asl : asl : asl : asl
        clc
        adc nes_cq_obb
        sta nes_cqs_obp
        lda nes_cq_t0                ; X = 16*t0 (offset no shadow)
        asl : asl : asl : asl
        tax
        lda nes_cq_tofs              ; Y = 16*tofs (offset no array BG)
        asl : asl : asl : asl
        tay
        sep #$20 : .as
        lda #^nes_chrq_bg0
        sta nes_cqs_bgb              ; bancos dos dois ponteiros long
        sta nes_cqs_obb
        jmp nes_chrq_swz             ; rts la'
ncst_overflow:
        ; A fila nao cabe. NADA e' descartado: o shadow ja' tem os bytes, e o
        ; rebuild total (NMI, forced-blank) reconstroi a CHR-RAM inteira a
        ; partir dele. Teoricamente inalcancavel -- o maximo medido no corpus
        ; e' 133 tiles/frame contra 192 de capacidade.
        sep #$20 : .as
        lda #$01
        sta @nes_chrq_full
        lda #$00
        sta @nes_chrq_wr             ; buffer aberto vira lixo (o rebuild cobre)
        rep #$20 : .al
        lda @nes_chrq_drop
        inc
        sta @nes_chrq_drop
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; ncst_dsc_ptr -- (MAIN, .al/.xl; A = indice de descritor) nes_cq_dp/dpb =
; nes_cq_dscb + A*NES_CHRQ_DSC_SZ. Sai .al/.xl, A destruido.
; ------------------------------------------------------------
ncst_dsc_ptr:
        rep #$30 : .al : .xl
        asl : asl : asl              ; *8
        clc
        adc nes_cq_dscb
        sta nes_cq_dp
        sep #$20 : .as
        lda #^nes_chrq_dsc0
        sta nes_cq_dpb
        rep #$20 : .al
        rts

; ------------------------------------------------------------
; nes_chrfd_mark -- (MAIN, .as/.xl) amplia a faixa suja PENDENTE com os tiles
; [nes_cq_t0, nes_cq_t0+nes_cq_nt) que este run tocou. Faixa (nao bitmap) e'
; a forma certa do dado: os despejos medidos sao SEQUENCIAIS (megaman1 escreve
; 0..8191 em ordem), entao a faixa e' justa; e mesmo um despejo espalhado
; converge, porque o teto e' a CHR-RAM inteira (512 tiles) e o passe seguinte
; so' roda depois que o despejo cala.
;
; NAO usa a pilha (o t1 e' recalculado): pha/pla com A de 16 bits atravessando
; sep/rep e' exatamente a classe de bug que a casa ja' pagou.
;
; nes_chrfd_ntdefer[_frame] -- os dois predicados do ADIAMENTO da tilemap
; (v2.8), logo abaixo.
; ------------------------------------------------------------
nes_chrfd_ntdefer_frame:
        ; (MAIN, fecho do frame) carry SET = adiar a conversao GLOBAL da
        ; tilemap. Le nes_chrq_bacc ANTES do nes_chrq_publish, que o zera
        ; logo adiante.
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_chrq_bacc
        sep #$20 : .as
        bne nes_chrfd_ntdefer        ; frame COM $41: usa o teste por-run
        ; --- v2.12: frame SEM $41. Normalmente e' a hora de pagar a divida.
        ;     MAS enquanto o passe de conversao do despejo ainda tem trabalho
        ;     (act ou pend) e a tela do NES esta' apagada, pagar aqui custa um
        ;     pass GLOBAL de 1920 celulas (~2 frames de CPU) POR FRAME: o
        ;     frame seguinte torna a adiar e torna a dever. MEDIDO no stream
        ;     do Bomberman II: 9 frames seguidos de update pequeno (36 B)
        ;     enquanto o passe roda. Segurar aqui e' BOUNDED -- o passe
        ;     converge (o teto e' a CHR-RAM inteira), ou o rendering liga, e
        ;     qualquer um dos dois libera. E a tela nao pode abrir no meio:
        ;     o nes_chrfd_service segura o forced-blank enquanto ntdef != 0.
        lda @nes_chrfd_ntdef
        beq ncnd_no                  ; nada devido
        lda @nes_regs_ppumask
        and #$18
        bne ncnd_no                  ; a tela vai ABRIR: paga AGORA
        lda @nes_chrfd_act
        ora @nes_chrfd_pend
        beq ncnd_no                  ; passe ocioso: paga AGORA
        sec
        rts
nes_chrfd_ntdefer:
        ; (MAIN, .as) carry SET = despejo de CHR-RAM em voo E rendering OFF.
        ; (v2.12: inalterado em relacao a' v2.8 -- o teste por TAMANHO foi
        ; retirado por ser INERTE; ver nes_chrfd_ntdefer_frame, que e' onde a
        ; mudanca que vale esta'.)
        sep #$20 : .as
        lda @nes_chrfd_mode
        beq ncnd_no
        lda @nes_regs_ppumask
        and #$18
        bne ncnd_no
        sec
        rts
ncnd_no:
        clc
        rts

nes_chrfd_mark:
        sep #$20 : .as
        ; v2.12: re-afirma o MODO. A NMI limpa nes_chrfd_mode quando o passe
        ; converge e nao ha' faixa pendente; se ela fizer isso na janela entre
        ; o "lda @nes_chrfd_mode / bne nchru_fast" do MAIN e o sta abaixo, a
        ; faixa nasce com o modo ja' desligado e NUNCA e' convertida (os bytes
        ; estao no shadow, mas nada mais os desce). Uma escrita idempotente de
        ; 1 byte fecha a corrida.
        lda #$01
        sta @nes_chrfd_mode
        lda @nes_chrfd_pend
        bne ncfm_extend
        ; primeira faixa deste episodio
        lda #$01
        sta @nes_chrfd_pend
        lda #$00
        sta @nes_chrfd_age
        rep #$20 : .al
        lda nes_cq_t0
        sta @nes_chrfd_plo
        clc
        adc nes_cq_nt
        sta @nes_chrfd_phi
        sep #$20 : .as
        rts
ncfm_extend:
        rep #$20 : .al
        lda nes_cq_t0
        cmp @nes_chrfd_plo
        bcs ncfm_hi                  ; t0 >= plo: nao baixa o piso
        sta @nes_chrfd_plo
ncfm_hi:
        lda nes_cq_t0
        clc
        adc nes_cq_nt                ; t1 (exclusive)
        cmp @nes_chrfd_phi
        bcc ncfm_done                ; t1 < phi: nao levanta o teto
        sta @nes_chrfd_phi
ncfm_done:
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrq_publish -- (MAIN, fecho do frame) fecha os breadcrumbs de banda e
; entrega o buffer de stage pra NMI, se ela estiver LIVRE. rdy != 0 = a NMI
; ainda nao dreiou o anterior -> NAO publica, e o MAIN CONTINUA ACUMULANDO no
; mesmo buffer. Nada se perde -- inclusive quando o commit do frame buffer e'
; pulado (nfc_skip), que e' exatamente por que a fila nao viaja no fb_regs. A
; escrita de rdy tem 1 BYTE = atomica pra NMI; e como a NMI so' escreve ZERO
; em rdy, a leitura "rdy == 0" logo antes nao pode envelhecer.
; ------------------------------------------------------------
nes_chrq_publish:
        sep #$20 : .as
        rep #$20 : .al
        lda @nes_chrq_tacc           ; banda: fecha o frame (o gate le tmax/
        cmp @nes_chrq_tmax           ; bmax e os acumuladores do frame)
        bcc ncqp_t_ok
        sta @nes_chrq_tmax
ncqp_t_ok:
        lda @nes_chrq_bacc
        cmp @nes_chrq_bmax
        bcc ncqp_b_ok
        sta @nes_chrq_bmax
ncqp_b_ok:
        sep #$20 : .as
        lda @nes_chrq_wr
        beq ncqp_zero                ; nada staged
        lda @nes_chrq_rdy
        bne ncqp_zero                ; NMI ocupada -> acumula
        lda @nes_chrq_wr
        sta @nes_chrq_rdy            ; PUBLICA (1 byte, atomico)
        lda #$00
        sta @nes_chrq_wr             ; proximo run abre um buffer NOVO
ncqp_zero:
        ; --- v2.8 despejo rapido: os DOIS latches POR FRAME que a NMI le.
        ;     Ficam aqui (fecho do frame, contexto MAIN) de proposito:
        ;
        ;     quiet -- "este frame fechou SEM payload $41". E' o gatilho
        ;       principal do passe: enquanto o despejo esta' rolando, converter
        ;       roubaria do MAIN justamente o CPU que mantem o ACK em dia.
        ;       Deriva do bacc, que ja' existe e e' zerado logo abaixo.
        ;     ron   -- rendering do frame COMMITADO (o MESMO byte que vira TM
        ;       em nes_apply_vblank). !=0 = a tela vai ABRIR, entao converter
        ;       agora, sob forced-blank, e' obrigatorio: melhor alguns frames
        ;       pretos que abrir a tela em cima de tiles nao convertidos.
        ;       Latchado por MAIN e lido por NMI = 1 byte, sem corrida (a
        ;       licao da casa: a NMI nunca le master que o decode reescreve).
        rep #$20 : .al
        lda @nes_chrq_bacc
        sep #$20 : .as
        beq ncqp_quiet               ; Z veio do 'lda' de 16 bits
        lda #$00
        sta @nes_chrfd_quiet
        bra ncqp_ron
ncqp_quiet:
        lda #$01
        sta @nes_chrfd_quiet
ncqp_ron:
        lda @nes_regs_ppumask
        and #$18
        sta @nes_chrfd_ron
        lda @nes_chrfd_pend
        beq ncqp_age_done
        lda @nes_chrfd_age
        cmp #$ff
        beq ncqp_age_done            ; satura (nunca envolve)
        inc
        sta @nes_chrfd_age
ncqp_age_done:
        rep #$20 : .al
        lda #$0000
        sta @nes_chrq_tacc
        sta @nes_chrq_bacc
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrq_blank_ok -- (NMI, .as) decide se PODE ligar forced-blank agora.
; Devolve carry SET = pode. Duas condicoes (achado P2 do A10):
;   (1) V >= NES_CHRQ_V_MIN: NUNCA ligar blank em display ativo. Sem isso,
;       uma NMI TARDE (que o late-guard do apply ja' descarta) apagava o
;       resto do frame visivel.
;   (2) rendering OFF no ppumask corrente -- medido: 100% dos despejos
;       acontecem com a tela do NES apagada, e o teto FISICO com rendering
;       LIGADO (24 tiles/frame = 8 scanlines) sempre cabe no vblank. O gate
;       tem ESCAPE por contador (NES_CHRQ_FBWAIT): fila travada seria pior
;       que um frame preto, e politica nenhuma aqui pode deadlockar.
; ------------------------------------------------------------
nes_chrq_blank_ok:
        sep #$20 : .as
        lda $213f                    ; reseta o flip-flop hi/lo do latch
        lda $2137                    ; latcha H/V
        lda $213d                    ; V[7:0]
        cmp #NES_CHRQ_V_MIN
        bcc ncbo_no                  ; display ativo (ou V>=256 lido como 0..5)
        lda @nes_regs_ppumask
        and #$18                     ; bit3 = BG visivel, bit4 = OBJ visivel
        beq ncbo_yes                 ; rendering OFF: pode blankar
        lda @nes_chrq_fbwait
        inc
        sta @nes_chrq_fbwait
        cmp #NES_CHRQ_FBWAIT
        bcc ncbo_no                  ; ainda esperando a tela apagar
ncbo_yes:
        lda #$00
        sta @nes_chrq_fbwait
        sec
        rts
ncbo_no:
        clc
        rts

; ------------------------------------------------------------
; nes_chrq_service -- (NMI, FIM do nes_apply_vblank) dreia a fila de CHR-RAM.
; Roda por ULTIMO de proposito: o tilemap e a OAM sao inviolaveis (escrita
; fora do vblank = bytes descartados / OAM espalhada), entao a CHR so' usa o
; que SOBRAR do vblank e o proprio servico le o V pra decidir quanto cabe.
; ------------------------------------------------------------
nes_chrq_service:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chrq_full
        beq ncqs_queue
        jmp nes_chrq_rebuild
ncqs_queue:
        lda @nes_chrq_rdy
        bne ncqs_have
        ; v2.8: fila VAZIA -> despejo rapido (se houver). A ordem importa e e'
        ; invariante: o passe so' arma com rdy == 0, senao um descritor
        ; estagiado ANTES da entrada no modo (swizzlado de um shadow VELHO)
        ; seria DMAiado DEPOIS do passe e sobrescreveria com dado velho o tile
        ; que o passe acabou de converter.
        lda @nes_chrfd_mode
        beq ncqs_idle
        jmp nes_chrfd_service
ncqs_idle:
        rts
ncqs_have:
        cmp #$02
        beq ncqs_b1
        rep #$20 : .al
        lda #!nes_chrq_dsc0
        sta nes_cqa_dscb
        lda #!nes_chrq_bg0
        sta nes_cqa_bgb
        lda #!nes_chrq_ob0
        sta nes_cqa_obb
        lda #$0000
        sta nes_cqa_ni
        sep #$20 : .as
        bra ncqs_b_ok
ncqs_b1:
        rep #$20 : .al
        lda #!nes_chrq_dsc1
        sta nes_cqa_dscb
        lda #!nes_chrq_bg1
        sta nes_cqa_bgb
        lda #!nes_chrq_ob1
        sta nes_cqa_obb
        lda #$0002
        sta nes_cqa_ni
        sep #$20 : .as
ncqs_b_ok:
        lda #^nes_chrq_dsc0
        sta nes_cqa_dpb              ; banco CONTIGUO -> [nes_cqa_dp],y
        lda #$00
        sta nes_cqa_fb
        jsr nes_chrq_dma_init
ncqs_loop:
        rep #$30 : .al : .xl
        ldx nes_cqa_ni
        lda @nes_chrq_rd
        cmp @nes_chrq_nd0,x
        sep #$20 : .as
        bcs ncqs_done                ; cursor no fim: buffer dreiado
        ; le o descritor corrente SEM consumir (o gate de V precisa do nt)
        rep #$30 : .al : .xl
        lda @nes_chrq_rd
        asl : asl : asl
        clc
        adc nes_cqa_dscb
        sta nes_cqa_dp
        ldy #$0000
        lda [nes_cqa_dp],y
        sta nes_cqa_t0
        ldy #$0002
        lda [nes_cqa_dp],y
        sta nes_cqa_nt
        ldy #$0004
        lda [nes_cqa_dp],y
        sta nes_cqa_tofs
        ; custo em scanlines = 2 + (nt*9)>>5   (0,281 linha/tile)
        lda nes_cqa_nt
        asl : asl : asl
        clc
        adc nes_cqa_nt
        lsr : lsr : lsr : lsr : lsr
        clc
        adc #$0002
        sta nes_cqa_cost
        sep #$20 : .as
        lda nes_cqa_fb
        bne ncqs_apply               ; ja' em forced-blank: sem gate de V
        rep #$20 : .al
        lda nes_cqa_cost
        cmp #NES_CHRQ_VB_LINES+1
        sep #$20 : .as
        bcs ncqs_need_blank          ; nao cabe em vblank NENHUM (nt >= 125)
        lda $213f
        lda $2137
        lda $213d                    ; V[7:0]
        cmp #NES_CHRQ_V_MIN
        bcc ncqs_defer               ; display ativo -> ADIA (cursor INTACTO)
        rep #$20 : .al
        and #$00ff                   ; A16 = V: limpa o byte ALTO ESCONDIDO
        clc                           ; que o 'lda' de 8 bits nao tocou
        adc nes_cqa_cost
        cmp #NES_CHRQ_V_LIMIT+1
        sep #$20 : .as
        bcc ncqs_apply
ncqs_defer:
        rts                          ; nao cabe agora: sai no proximo vblank
ncqs_need_blank:
        jsr nes_chrq_blank_ok
        bcc ncqs_defer               ; ainda nao pode blankar: adia
        lda #$01
        sta nes_cqa_fb
        lda #$80
        sta $2100                    ; forced blank (V>=225 garantido acima)
        lda #$01
        sta @nes_chr_reblank         ; release ($0f) SO' no proximo vblank
ncqs_apply:
        jsr nes_chrq_dma_dsc
        rep #$20 : .al
        lda @nes_chrq_rd
        inc
        sta @nes_chrq_rd
        sep #$20 : .as
        bra ncqs_loop
ncqs_done:
        lda #$00
        sta @nes_chrq_fbwait         ; dreno normal reseta o escape do gate de
                                      ; blank: sem isso um episodio ANTIGO de
                                      ; N vblanks barrados deixava o contador
                                      ; carregado e o proximo need_blank
                                      ; blankava na 1a tentativa (escape
                                      ; nao-deterministico)
        sta @nes_chrq_rdy            ; buffer LIBERADO pro produtor
        rep #$20 : .al
        lda #$0000
        sta @nes_chrq_rd
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrq_dma_init -- (NMI) parte FIXA dos 2 DMAs: canal 0 (contexto NMI),
; modo 1 = 2 bytes alternando $2118/$2119 (VRAM word), banco da fonte $7F.
; ------------------------------------------------------------
nes_chrq_dma_init:
        sep #$20 : .as
        lda #$80
        sta $2115                    ; VMAIN: +1 word APOS o write de $2119
        lda #$01
        sta $4300                    ; modo 1: 2 registradores
        lda #$18
        sta $4301                    ; B-bus = $2118/$2119
        lda #^nes_chrq_bg0
        sta $4304
        rts

; ------------------------------------------------------------
; nes_chrq_dma_dsc -- (NMI) os 2 DMAs do descritor corrente
; (nes_cqa_t0/nt/tofs + as bases nes_cqa_bgb/obb):
;   BG : VRAM word VRAM_BG_CHR_WORD  + t0*8,  16*nt bytes de bg[tofs]
;   OBJ: VRAM word VRAM_OBJ_CHR_WORD + t0*16, 32*nt bytes de ob[tofs]
; Os dois destinos sao CONTIGUOS porque os arrays sao packed com o MESMO
; passo do formato de tile do SNES -- e' o ponto todo do desenho.
; ------------------------------------------------------------
nes_chrq_dma_dsc:
        sep #$20 : .as
        rep #$10 : .xl
        rep #$20 : .al
        lda nes_cqa_t0               ; --- BG ---
        asl : asl : asl
        clc
        adc #VRAM_BG_CHR_WORD
        sta $2116
        lda nes_cqa_tofs
        asl : asl : asl : asl
        clc
        adc nes_cqa_bgb
        sta $4302
        lda nes_cqa_nt
        asl : asl : asl : asl
        sta $4305
        sep #$20 : .as
        lda #$01
        sta $420b
        rep #$20 : .al
        lda nes_cqa_t0               ; --- OBJ ---
        asl : asl : asl : asl
        clc
        adc #VRAM_OBJ_CHR_WORD
        sta $2116
        lda nes_cqa_tofs
        asl : asl : asl : asl : asl
        clc
        adc nes_cqa_obb
        sta $4302
        lda nes_cqa_nt
        asl : asl : asl : asl : asl
        sta $4305
        sep #$20 : .as
        lda #$01
        sta $420b
        rts

; ------------------------------------------------------------
; nes_chrq_rebuild -- (NMI) RECONSTRUCAO TOTAL da CHR-RAM a partir do
; shadow, em forced-blank. E' o fail-safe de estouro da fila: nenhum run e'
; descartado nunca, porque o shadow sempre tem os bytes. Trabalha em pedacos
; de NES_CHRQ_TILES_MAX tiles usando o BUFFER 0 como area de rascunho (a
; fila e' descartada -- o shadow e' um superconjunto dela).
; Custo: ~512*2200 cyc de conversao + 24KB de DMA ~= 2 frames apagados. So'
; roda em caso teoricamente inalcancavel (max medido = 133 tiles contra 192
; de capacidade); o breadcrumb nes_chrq_drop conta as ocorrencias.
; ------------------------------------------------------------
; INVARIANTE DO RENDERER (versao renderer do ABI que a bridge ja' carrega):
; NENHUM caminho de NMI pode exceder UM FRAME de trabalho.  Carga maxima por
; NMI = NES_CHRQ_TILES_MAX (192 tiles) -- o MESMO teto que o resto do desenho
; respeita e o mesmo que o ABI da bridge usa (nes_bridge.v RETX_CHUNK).
; Antes desta correcao o rebuild convertia+DMAiava os 512 tiles NUMA PASSADA
; (~4-5 frames de CPU) e so' limpava nes_chrq_full no fim; como nada mascara
; NMI, o vblank seguinte re-entrava, via o flag ainda armado e RECOMECAVA do
; tile 0 -- recursao sem fundo, confirmada no device (profundidade 7, depois
; 14, depois colapso).  Agora e' UMA FATIA por NMI, com o cursor persistido em
; nes_chrq_rb_t; o forced blank fica ligado ate' a ultima fatia.
; NB: este bug e' LATENTE tambem no core 2.3 -- o renderer corrigido tem de ser
; deployado JUNTO com qualquer core.
; EFEITO COLATERAL ACEITO do fatiamento (documentado, nao corrigido): um tile
; ABAIXO do cursor que o jogo reescreva ENTRE fatias fica stale na VRAM ate' o
; jogo o reescrever depois que nes_chrq_full cair -- janela de ~3 NMIs.  E'
; benigno: a tela esta' sob forced blank durante todo o rebuild (nada disso e'
; exibido), e o que a bridge estiver segurando e' re-entregue pela
; retransmissao.  A alternativa (reiniciar o rebuild a cada escrita nova) e'
; justamente o ratchet que este fix existe para eliminar.
nes_chrq_rebuild:
        sep #$20 : .as
        rep #$10 : .xl
        ; O gate de blank vale para COMECAR um rebuild.  Uma vez comecado
        ; (rb_t != 0) a tela JA esta' em forced blank e o rebuild esta'
        ; comprometido: re-pedir permissao a cada fatia faria cada uma esperar
        ; o escape de 8 vblanks, e um rebuild de 3 fatias com rendering ligado
        ; levaria ~24 frames em vez de ~8 -- medido, e' o que fazia o teste
        ; dirigido (--rebuild-at) NAO convergir na janela do gate.
        rep #$20 : .al
        lda @nes_chrq_rb_t
        sep #$20 : .as
        bne ncrb_go                  ; continuacao: seguir sem re-consultar
        jsr nes_chrq_blank_ok
        bcs ncrb_go
        rts                          ; ainda nao pode blankar: proximo vblank
ncrb_go:
        lda #$80
        sta $2100                    ; forced blank (segue ligado entre fatias)
        lda #$01
        sta @nes_chr_reblank
        jsr nes_chrq_dma_init
        rep #$20 : .al
        lda @nes_chrq_rb_t           ; cursor PERSISTIDO entre NMIs
        sta nes_cqa_t
        lda #$0000
        sta nes_cqa_tofs             ; o rascunho sempre comeca no tile 0
        lda #!nes_chrq_bg0
        sta nes_cqa_bgb
        lda #!nes_chrq_ob0
        sta nes_cqa_obb
        sep #$20 : .as
        rep #$20 : .al
        lda #NES_CHR_TILES           ; n = min(TILES_MAX, 512 - t)
        sec
        sbc nes_cqa_t
        sep #$20 : .as
        beq ncrb_done
        rep #$20 : .al
        cmp #NES_CHRQ_TILES_MAX+1
        bcc ncrb_n_ok
        lda #NES_CHRQ_TILES_MAX
ncrb_n_ok:
        sta nes_cqa_nt
        sta nes_cqs_n
        lda nes_cqa_t
        sta nes_cqa_t0
        asl : asl : asl : asl        ; X = 16*t (offset no shadow)
        tax
        ldy #$0000                   ; Y = 0 (rascunho comeca no tile 0)
        lda #!nes_chrq_bg0
        sta nes_cqs_bgp
        lda #!nes_chrq_ob0
        sta nes_cqs_obp
        sep #$20 : .as
        lda #^nes_chrq_bg0
        sta nes_cqs_bgb
        sta nes_cqs_obb
        jsr nes_chrq_swz
        jsr nes_chrq_dma_dsc
        rep #$20 : .al
        lda nes_cqa_t
        clc
        adc nes_cqa_nt
        sta nes_cqa_t
        sta @nes_chrq_rb_t           ; persiste: proxima NMI continua daqui
        cmp #NES_CHR_TILES
        sep #$20 : .as
        bcs ncrb_done                ; ultima fatia: cai no done
        rts                          ; UMA fatia por NMI -- nunca >1 frame
ncrb_done:
        sep #$20 : .as
        rep #$20 : .al
        lda #$0000
        sta @nes_chrq_rb_t           ; cursor pronto para o proximo rebuild
        sep #$20 : .as
        lda #$00
        sta @nes_chrq_full
        sta @nes_chrq_rdy            ; a fila e' subconjunto do shadow: some
        rep #$20 : .al
        lda #$0000
        sta @nes_chrq_rd
        sep #$20 : .as
        rts

; ------------------------------------------------------------
; nes_chrfd_service -- (NMI) UMA FATIA do passe de conversao do DESPEJO
; RAPIDO (v2.8). Chamada pelo nes_chrq_service com a fila VAZIA.
;
; POR QUE ELE EXISTE. Ver o bloco NES_CHRFD_* em nes_equates.i65: com a tela
; do NES apagada o jogo despeja a CHR-RAM inteira a ~2120 B/frame, e o
; caminho normal (swizzle no MAIN, ~225 master/byte) tem teto de 1588
; B/frame. O renderer pulava frames, a bridge deixava de ver ACK e ABANDONA
; payload nao confirmado -- perda PERMANENTE numa tela one-shot. Aqui o
; trabalho de conversao sai do caminho do ACK: o MAIN so' copia pro shadow e
; marca a faixa; a conversao roda por fatias, em forced-blank, quando ela nao
; disputa CPU com o despejo.
;
; QUANDO ARMA (qualquer um dos tres; nunca "sempre", que era o erro obvio):
;   quiet -- o despejo CALOU (frame sem $41). Caso normal.
;   ron   -- a tela do frame commitado vai ABRIR. Obrigatorio: nunca deixar
;            o rendering ligar sobre tiles nao convertidos. Como o passe
;            mantem forced-blank ate' terminar, a tela abre PRETA e depois
;            certa -- nunca com lixo (que e' o sintoma de campo).
;   age   -- escape de NES_CHRFD_MAXWAIT frames: um produtor que nunca cala
;            nem liga o rendering nao pode adiar a conversao para sempre.
; E SEMPRE com V >= NES_CHRQ_V_MIN: forced-blank nunca em display ativo.
;
; UMA VEZ ARMADO o passe NAO re-consulta o gate (nes_chrfd_act): a tela ja'
; esta' preta e o passe esta' comprometido -- mesma razao do rb_t no rebuild
; total (re-pedir permissao por fatia multiplicaria o tempo de tela preta).
;
; RE-ARME. Escritas que cheguem DURANTE o passe vao pro shadow e para a faixa
; PENDENTE nova; ao terminar, o passe seguinte as cobre. E' isto que fecha o
; furo conhecido do rebuild fatiado ("tile abaixo do cursor reescrito entre
; fatias fica stale"): aqui ele nao fica stale, fica PENDENTE. Converge
; porque o despejo one-shot termina -- e o teto por passe e' a CHR-RAM
; inteira.
;
; CUSTO. NES_CHRFD_SLICE tiles x ~3600 master = 0,64 frame por NMI (a
; invariante da casa e' <= 1 frame); com trafego no frame anterior o teto cai
; para SLICE_BUSY (0,32 frame) para que o MAIN continue tendo CPU para drenar
; e dar ACK. Rascunho = BUFFER 0, autorizado pelas duas invariantes do bloco
; nes_chrfd_* em nes_data.a65.
; ------------------------------------------------------------
nes_chrfd_service:
        sep #$20 : .as
        rep #$10 : .xl
        lda @nes_chrfd_act
        bne ncfs_go                  ; passe em curso: continua sem re-gate
        lda @nes_chrfd_pend
        bne ncfs_trig
        ; SAIDA do modo. So' pode acontecer com a divida da tilemap tambem
        ; paga: enquanto nes_chrfd_ntdef estiver setado a conversao global
        ; ainda nao rodou, e soltar o forced-blank aqui abriria a tela sobre
        ; uma tilemap PARCIAL. Segurar e' bounded e nao deadlocka: o
        ; npf_finish paga a divida no primeiro frame sem $41 OU assim que o
        ; rendering liga (ver nes_chrfd_ntdefer_frame).
        ; --- v2.12 RETENCAO DO INIDISP. O release do forced-blank so' pode
        ;     acontecer quando NAO SOBRA trabalho adiado, e sao DOIS:
        ;       (1) a divida de CONVERSAO global da tilemap (nes_chrfd_ntdef);
        ;       (2) a ENTREGA dela -- a conversao escreve o SHADOW, quem desce
        ;           pra VRAM e' a faixa suja do nav_tm_*, a ~1100 B/frame.
        ;     Soltar com a faixa em voo E' o sintoma de campo "a tela abre
        ;     bugada e se ajusta em segundos": o que aparece e' a tilemap
        ;     ANTERIOR sendo dissolvida linha a linha. Ate' a v2.11 o
        ;     ncfs_done limpava nes_chrfd_mode no MESMO vblank em que o passe
        ;     terminava, entao este bloco (que ja' existia para (1)) era
        ;     INALCANCAVEL: o servico nunca mais era chamado.
        ;     TETO OBRIGATORIO: politica nenhuma aqui pode prender a tela em
        ;     preto (NES_CHRFD_HOLD_MAX vblanks; o caminho normal fecha em
        ;     <= 6).
        lda @nes_chrfd_hold
        cmp #NES_CHRFD_HOLD_MAX
        bcs ncfs_exit                ; teto atingido: solta de qualquer jeito
        lda @nes_chrfd_ntdef
        bne ncfs_hold
        rep #$20 : .al
        lda @nes_tm_hi
        cmp @nes_tm_lo
        sep #$20 : .as               ; sep/rep nao mexem em N/Z/C
        bcc ncfs_exit                ; hi < lo (sentinela) = faixa VAZIA
        beq ncfs_exit                ; faixa vazia
ncfs_hold:
        lda @nes_chrfd_hold
        inc
        sta @nes_chrfd_hold
        rep #$20 : .al
        lda @nes_dbg_hold
        inc
        beq ncfs_hsat
        sta @nes_dbg_hold
ncfs_hsat:
        sep #$20 : .as
        lda #$80
        sta $2100                    ; segura o blank mais um vblank
        lda #$01
        sta @nes_chr_reblank
        rts
ncfs_exit:
        lda #$00
        sta @nes_chrfd_mode          ; nada pendente: sai do modo despejo
        sta @nes_chrfd_hold
        rts
ncfs_trig:
        lda @nes_chrfd_quiet
        bne ncfs_arm
        lda @nes_chrfd_ron
        bne ncfs_arm
        lda @nes_chrfd_age
        cmp #NES_CHRFD_MAXWAIT
        bcs ncfs_arm
        rts                          ; despejo em curso: acumula mais
ncfs_arm:
        lda $213f                    ; reseta o flip-flop hi/lo do latch
        lda $2137                    ; latcha H/V
        lda $213d                    ; V[7:0]
        cmp #NES_CHRQ_V_MIN
        bcc ncfs_ret                 ; display ativo: tenta no proximo vblank
        rep #$20 : .al
        lda @nes_chrfd_plo
        sta @nes_chrfd_lo
        sta @nes_chrfd_t
        lda @nes_chrfd_phi
        sta @nes_chrfd_hi
        sep #$20 : .as
        lda #$00
        sta @nes_chrfd_pend          ; a faixa passou de PENDENTE para ATIVA;
        sta @nes_chrfd_age           ; o que chegar agora abre uma faixa nova
        sta @nes_chrfd_hold          ; v2.12: passe novo zera o teto de hold
        lda #$01
        sta @nes_chrfd_act
ncfs_go:
        lda #$80
        sta $2100                    ; forced blank (segue ligado entre fatias)
        lda #$01
        sta @nes_chr_reblank         ; release ($0f) SO' em vblank
        jsr nes_chrq_dma_init
        rep #$20 : .al
        lda @nes_chrfd_hi
        sec
        sbc @nes_chrfd_t             ; tiles restantes na faixa
        sta nes_cqa_nt
        sep #$20 : .as               ; sep/rep nao mexem em N/Z/C: os dois
        beq ncfs_done                ; branches abaixo leem o SBC
        bcc ncfs_done                ; defensivo (hi < t e' inalcancavel)
        ; TETO DA FATIA. O teto reduzido (SLICE_BUSY) existe para UM caso: um
        ; despejo de tela apagada em curso, onde o MAIN gasta ~0,53 frame so'
        ; drenando e copiando pro shadow e precisa do resto do frame para dar
        ; ACK em dia. Ele NAO se aplica quando a tela esta' LIGADA: ali o teto
        ; FISICO do NES e' ~24 tiles/frame (~380 B), o MAIN fica ocioso e a
        ; fatia cheia e' o que garante CONVERGENCIA -- com 64 convertidos por
        ; NMI contra <=24 chegando, a faixa pendente encolhe ~40 tiles/frame.
        ; Com o teto reduzido a margem cairia para 8 tiles/frame e um jogo que
        ; anima CHR logo depois de um despejo ficaria segundos em tela preta.
        lda @nes_chrfd_quiet
        bne ncfs_cap_q
        lda @nes_chrfd_ron
        beq ncfs_cap_busy
ncfs_cap_q:
        rep #$20 : .al
        lda #NES_CHRFD_SLICE
        bra ncfs_cap_cmp
ncfs_cap_busy:
        rep #$20 : .al
        lda #NES_CHRFD_SLICE_BUSY
ncfs_cap_cmp:
        cmp nes_cqa_nt
        bcs ncfs_cap_ok              ; cap >= restante: converte o restante
        sta nes_cqa_nt
ncfs_cap_ok:
        ; parametros do swizzle: BUFFER 0 como rascunho, tofs = 0
        lda nes_cqa_nt
        sta nes_cqs_n
        lda @nes_chrfd_t
        sta nes_cqa_t0
        asl : asl : asl : asl        ; X = 16*t (offset no shadow)
        tax
        ldy #$0000                   ; Y = 0: o rascunho comeca no tile 0
        lda #$0000
        sta nes_cqa_tofs
        lda #!nes_chrq_bg0
        sta nes_cqs_bgp
        sta nes_cqa_bgb
        lda #!nes_chrq_ob0
        sta nes_cqs_obp              ; tofs = 0 => obp = ob_base (ver swz)
        sta nes_cqa_obb
        sep #$20 : .as
        lda #^nes_chrq_bg0
        sta nes_cqs_bgb              ; bancos dos dois ponteiros long
        sta nes_cqs_obb
        jsr nes_chrq_swz
        jsr nes_chrq_dma_dsc
        rep #$20 : .al
        lda @nes_chrfd_t
        clc
        adc nes_cqa_nt
        sta @nes_chrfd_t             ; cursor PERSISTIDO entre NMIs
        lda @nes_chrfd_tacc
        clc
        adc nes_cqa_nt
        sta @nes_chrfd_tacc          ; breadcrumb de trabalho
        lda @nes_chrfd_t
        cmp @nes_chrfd_hi
        sep #$20 : .as
        bcc ncfs_ret                 ; falta faixa: UMA fatia por NMI
ncfs_done:
        lda #$00
        sta @nes_chrfd_act
        rep #$20 : .al
        lda @nes_chrfd_pass
        inc
        sta @nes_chrfd_pass
        sep #$20 : .as
        ; v2.12: NAO limpa mais o nes_chrfd_mode aqui. Quem decide a saida do
        ; modo (e o release do INIDISP) e' o topo deste mesmo servico, no
        ; vblank seguinte, DEPOIS de conferir a divida de tilemap e a faixa
        ; suja -- ver o bloco ncfs_hold/ncfs_exit. Limpar aqui tornava aquele
        ; bloco inalcancavel e abria a tela sobre uma tilemap parcial.
ncfs_ret:
        rts

; ============================================================
; nes_apply_vblank -- DMA de verdade p/ VRAM/OAM/CGRAM + escreve BG1HOFS/
; VOFS. Chamada SO durante o V-Blank (pela NMI do topo). Poucos DMAs
; grandes (SS1.3 da spec: ~40-50 cyc de setup cada, encoste tudo num bloco
; e faca poucos DMAs). Registradores PPU: ver book1 Appendix A (2-27),
; citados no relatorio final.
;
; v1.5.1: so' roda com FRAME COMMITADO (nes_fb_pending != 0) e le TODO o
; estado por-frame (OAM/CGRAM/regs/HDMA) do buffer commitado -- nunca dos
; masters (que o decode do frame seguinte pode estar reescrevendo AGORA,
; concorrencia do ping-pong). pending==0 -> mantem o frame anterior na
; tela (regs/HDMA retem seus valores; re-escrever seria no-op). So' a
; TILEMAP desce do master (mistura de celulas de frames adjacentes e'
; benigna -- ver nota do bloco fb em nes_data.a65).
; ============================================================
; ============================================================
; nav_tm_xfer -- v2.9b: dispara UM GP-DMA (canal 0, contexto NMI) de
; @nes_tilemap_shadow+A p/ a VRAM da tilemap, com @nes_tm_len bytes.
; Entra .al com A = offset de BYTE no shadow (sempre PAR: dst = 2*celula +
; dstoff, e os cursores so' andam em passos pares); sai .as; nao toca X/Y.
; @nes_tm_len TEM que ser > 0 -- $4305 = 0 significa 64 KB (o mesmo pe' de
; ouvido do guard 'cursor >= $1000' do full service de CHR do v2.2b).
; ============================================================
nav_tm_xfer:
        rep #$20 : .al
        pha                        ; guarda o offset de byte
        lsr                        ; -> offset de WORD de VRAM
        clc
        adc #VRAM_TILEMAP_WORD
        sta $2116                  ; VMADD (16-bit = VMADDL+VMADDH)
        pla
        clc
        adc #!nes_tilemap_shadow
        sta $4302
        lda @nes_tm_len
        sta $4305
        sep #$20 : .as
        lda #$01
        sta $4300                  ; modo 1: 2 bytes -> 2 registradores
        lda #$18
        sta $4301                  ; $2118/$2119
        lda #^nes_tilemap_shadow
        sta $4304
        lda #$01
        sta $420b
        rts

nes_apply_vblank:
        php
        sep #$20 : .as
        rep #$10 : .xl

        jsr nes_chr_reblank_release ; v2.2: release de forced-blank SO em
                                     ; vblank (antes do gate de pending --
                                     ; roda TODA NMI, nunca fica preso)

        lda @nes_fb_pending
        bne nav_chk_late
        brl nav_tail               ; nada commitado: mantem o frame anterior na
                                    ; tela -- mas a fila de CHR-RAM AINDA e'
                                    ; dreiada (v2.2-lite: um frame sem commit e'
                                    ; justamente o que tem o vblank inteiro
                                    ; livre; se ela ficasse presa aqui, uma
                                    ; sequencia de commits pulados seguraria
                                    ; tiles ja' escritos pelo jogo)
nav_chk_late:
        ; --- v1.5.3 LATE-GUARD: se a NMI entrou TARDE no vblank (vetor
        ;     atrasado por um GP-DMA em voo -- drain grande -- ou qualquer
        ;     outra causa), o apply (~28-30 scanlines de DMA) nao cabe ate'
        ;     o fim do vblank (262) e a CAUDA do DMA de OAM cairia no
        ;     display ativo = escrita de OAM espalhada (a PPU controla o
        ;     endereco interno durante o render) = fragmentos PRESOS em
        ;     sprites 64-127 (DK/SMB device). PULA o apply SEM limpar
        ;     pending -> o proximo vblank aplica (stale 1 frame invisivel;
        ;     espalhar OAM = o bug). Leitura do V: $213F reseta o flip-flop
        ;     hi/lo do latch, $2137 latcha H/V, $213D (OPVCT) 1a leitura =
        ;     V[7:0]. Janela boa = V em [225, 232] (NMI normal entra em
        ;     225-227; V>=256 le como 0..5 e cai no "bcc" = tarde). ---
        lda $213f
        lda $2137
        lda $213d                  ; V[7:0]
        sta nes_cd_v               ; v2.0a: gate do slice de CHR (nes_chr_dma_slice_service)
        cmp #225
        bcc nav_late               ; <225: display ativo ou V>=256 -> tarde
        cmp #233
        bcc nav_ok                 ; 225..232: cabe
nav_late:
        brl nav_tail               ; tarde: mantem frame anterior na tela;
                                    ; pending FICA -> aplica no proximo vblank.
                                    ; A fila de CHR-RAM passa pela cauda e o
                                    ; proprio gate de V dela decide (V fora da
                                    ; janela => adia sozinha)
nav_ok:
        lda @nes_fb_pending
nav_have:
        sta @nes_fb_active         ; este buffer entra em exibicao agora
        cmp #$02
        beq nav_src1
        rep #$20 : .al
        lda #!nes_fb_oam0          ; fontes do frame (dp contexto NMI --
        sta nes_av_fbo             ; nunca os nes_fb_d* do contexto MAIN)
        lda #!nes_fb_cg0
        sta nes_av_fbc
        lda #!nes_fb_regs0
        sta nes_av_fbr
        sep #$20 : .as
        bra nav_src_ok
nav_src1:
        rep #$20 : .al
        lda #!nes_fb_oam1
        sta nes_av_fbo
        lda #!nes_fb_cg1
        sta nes_av_fbc
        lda #!nes_fb_regs1
        sta nes_av_fbr
        sep #$20 : .as
nav_src_ok:

        ; --- v2.0a CHR-bank: forced-blank full (mode 1) + slice (mode 2) +
        ;     tile-base (BG12NBA/OBSEL do slot em exibicao). Rodam ANTES do
        ;     tilemap/OAM. Full: apaga a tela (INIDISP $80) e DMAa 24KB; o
        ;     baseline roda com a tela apagada (VRAM livre) e o fim religa
        ;     ($0f adiado p/ o proximo vblank -- nes_chr_reblank, v2.2).
        ;     Slice: gateado por V (so' fatia se
        ;     slice+baseline caibam ate' 262 -> tilemap/OAM nunca sacrificados).
        ;     No-op quando nenhum DMA pendente (o caso comum, incl. os HITs). ---
        jsr nes_chr_dma_full_service
        jsr nes_chr_dma_slice_service
        ; --- v2.3w: servico das JANELAS de 1KB (mapper 4). Mutuamente
        ;     exclusivo com os dois de cima por construcao: em modo janela o
        ;     $12 e' ignorado, entao nenhum loader de PAR chega a ser armado
        ;     (e vice-versa: sem $14 o nes_chrw_active fica 0 e este e'
        ;     no-op). Roda ANTES do apply_tilebase, que le o cur_slot que o
        ;     reconcilio pode ter trocado. ---
        jsr nes_chrw_service         ; v2.11: SO' o full mora aqui; o PASSO
                                      ; (slice) migrou p/ depois da OAM
        jsr nes_chr_apply_tilebase
        jsr nes_chr_cool_tick        ; v2.1: histerese da escalada anti-thrash

        ; --- BG1SC: staged por arrangement (v1.1) -- fb_regs+9 ---
        ldx nes_av_fbr
        lda @$7f0009,x
        sta $2107

        ; --- v2.2: CGRAM ANTES do conteudo (tilemap/OAM) -- paleta nunca
        ;     chega DEPOIS do primeiro conteudo no boot burst ---
        ; --- CGRAM: so quando algum CMD_PALETTE(_FULL) chegou NAQUELE
        ;     frame (gate = pal_dirty snapshotado em fb_regs+11; evita DMA
        ;     gratis todo frame). Fonte = fb_cg (bg em +0, obj em +32).
        ;     $2122 (modo 0), CGADD em unidade de word (book1 p.2-27-11). ---
        ldx nes_av_fbr
        lda @$7f000b,x
        beq nav_no_pal
        lda #CGRAM_BG_ADDR
        sta $2121
        lda #$00
        sta $4300
        lda #$22
        sta $4301
        lda #^nes_fb_cg0
        sta $4304
        ldx nes_av_fbc
        stx $4302
        ldx #32
        stx $4305
        lda #$01
        sta $420b

        lda #CGRAM_OBJ_ADDR
        sta $2121
        lda #$00
        sta $4300
        lda #$22
        sta $4301
        lda #^nes_fb_cg0
        sta $4304
        rep #$20 : .al
        lda nes_av_fbc
        clc
        adc #$0020                 ; +32: obj vem depois do bg no snapshot
        tax
        sep #$20 : .as
        stx $4302
        ldx #128
        stx $4305
        lda #$01
        sta $420b
nav_no_pal:

        ; --- OAM: e' o PRIMEIRO conteudo do apply (v2.7a). INVARIANTE DE
        ;     ORDEM, nao gosto: um DMA que estoura o fim do vblank tem dois
        ;     desfechos MUITO diferentes -- VRAM/CGRAM apenas PERDE as
        ;     escritas (a PPU as descarta) e o tilemap desce INTEIRO do
        ;     master no vblank seguinte (auto-cura), enquanto a OAM e'
        ;     DESTRUTIVA: durante o display ativo quem manda no endereco
        ;     interno da OAM e' a PPU, entao a cauda do DMA se ESPALHA por
        ;     slots aleatorios (fragmentos = a classe do v1.5.3). Logo: o
        ;     transfer destrutivo vai na FRENTE (termina a ~1,4KB dos ~6,4KB
        ;     de orcamento) e o adiavel (tilemap) fica na cauda -- que desde
        ;     a v2.9 NAO estoura mais: ela desce so' a faixa suja e so' o
        ;     que cabe no vblank restante (ver nes_tm_* em nes_data.a65).
        ;     NAO reordenar: com a OAM por ultimo o apply de um frame com
        ;     servico de CHR (slice 768B) + CGRAM + tilemap encosta no teto
        ;     do vblank e e' EXATAMENTE a OAM que vaza.
        ; --- refresh COMPLETO de 544B todo frame, em 3 DMAs (o endereco
        ;     interno de OAM auto-incrementa entre eles, mas cada transfer
        ;     RE-ARMA o $2102 -- assim um estouro so' pode estragar o proprio
        ;     segmento, nunca deslocar os seguintes):
        ;     256B do fb_oam do frame commitado (sprites 0-63) +
        ;     256B da pagina alta (sprites 64-127) -- em 8x8 a PARKED
        ;     estatica @nes_oam_park (Y=$F0 = invisivel sem wrap, escrita
        ;     1x no boot, o decode nunca a toca), em 8x16 o fb_oam?b do
        ;     frame commitado (dado VIVO; v2.7, ver abaixo) --
        ;     + 32B de zeros (high table: X-high 0 +
        ;     size small). AUTO-CURA: qualquer byte espalhado por um apply
        ;     atrasado historico (a classe dos fragmentos presos) dura no
        ;     maximo 1 frame. OAMADD ($2102/$2103) em WORDS: 0 / 128 (=byte
        ;     256) / 256 (=high table); $2104 modo 0 (1 byte/1 reg),
        ;     book1 p.2-27-2. ---
        ldx #$0000
        stx $2102
        lda #$00
        sta $4300
        lda #$04
        sta $4301
        lda #^nes_fb_oam0
        sta $4304
        ldx nes_av_fbo
        stx $4302
        ldx #256
        stx $4305
        lda #$01
        sta $420b                  ; sprites 0-63 (frame)
        ; --- v2.7: slots 64-127. Em 8x16 sao dado VIVO do frame (metades
        ;     pareadas dos sprites 32-63): fonte = fb_oam?b, derivado do
        ;     PROPRIO nes_av_fbo por '+$0600' (fb_oam0 $7F4000 -> $7F4600,
        ;     fb_oam1 $7F4100 -> $7F4700; ver nes_data.a65). Em 8x8 = a
        ;     pagina PARKED estatica @nes_oam_park, que o decode NUNCA
        ;     escreve -> a transicao 8x16 -> 8x8 esconde os slots altos por
        ;     construcao, sem latch de modo. Gate = PPUCTRL do frame
        ;     COMMITADO (fb_regs+4), nunca o master (que o decode ja pode
        ;     ter avancado). ---
        ldx #$0080                 ; OAMADD re-armado: word 128 = byte 256
        stx $2102
        lda #^nes_oam_park         ; ($7F -- mesmo banco dos fb_oam?b)
        sta $4304
        ldx nes_av_fbr
        lda @$7f0004,x             ; PPUCTRL do frame commitado
        and #$20
        beq nav_oam_hi_park
        rep #$20 : .al
        lda nes_av_fbo
        clc
        adc #$0600
        tax
        sep #$20 : .as
        stx $4302
        bra nav_oam_hi_go
nav_oam_hi_park:
        ldx #!nes_oam_park
        stx $4302
nav_oam_hi_go:
        ldx #256
        stx $4305
        lda #$01
        sta $420b                  ; sprites 64-127
        ldx #$0100                 ; OAMADD re-armado: word 256 = high table
        stx $2102
        lda #^nes_oam_hi_zero
        sta $4304
        ldx #!nes_oam_hi_zero
        stx $4302
        ldx #32
        stx $4305
        lda #$01
        sta $420b                  ; high table (32B de zeros)

        ; --- v2.11: PASSO de carga de janela de CHR (mapper 4). Roda AQUI, e
        ;     nao antes da CGRAM/OAM como ate' a v2.10, por DOIS motivos:
        ;     (1) a OAM e' o transfer DESTRUTIVO e agora fecha SEMPRE no
        ;         mesmo ponto, independente do tamanho do passo (na ordem
        ;         antiga, um passo maior empurrava a OAM para mais tarde --
        ;         exatamente o que o hotfix v2.7a existe para impedir);
        ;     (2) o passo passa a ser dimensionado pelo vblank que RESTA,
        ;         que so' e' conhecido aqui. Ele e a tilemap logo abaixo
        ;         dividem a mesma cauda: o passo reserva o piso do scrub e a
        ;         tilemap re-le o V depois dele. ---
        jsr nes_chrw_slice_service

        ; --- tilemap (v2.9b): FAIXA SUJA + SCRUB ROTATIVO, os dois
        ;     limitados pelo MESMO orcamento de vblank ($2118/$2119, modo 1
        ;     = 2 bytes/2 regs, A-bus incrementa). Vem DEPOIS da OAM
        ;     (invariante de ordem acima); ate' a v2.7a eram 4096 B FIXOS e
        ;     a cauda caia no display ativo em TODO frame com passo de CHR
        ;     (SMB2/SMB3), congelando a mesma faixa de cenario por segundos.
        ;
        ;     1) a FAIXA SUJA [nes_tm_lo, nes_tm_hi) desce primeiro, inteira
        ;        sempre que couber (latencia 0 pro que a conversao mudou);
        ;     2) o que SOBRA do orcamento vai no SCRUB: um cursor circular
        ;        (nes_tm_sc) que reescreve a tilemap inteira a cada ~4
        ;        frames. E' ele que devolve a AUTO-CURA que o DMA de 4096 B
        ;        dava de graca -- sem ela, divergencia que a faixa nao
        ;        conhece (cauda perdida, corrida NMI x hook, escritor que
        ;        esqueceu de marcar) vira PERMANENTE. Ver nes_data.a65.
        ;
        ;     ORCAMENTO (conservador de proposito, ancora do nes_equates:
        ;     ~1020 cyc/transferencia + 8 cyc/byte, 1 linha = 1364 cyc):
        ;       bytes = linhas_restantes * 160 - 256, saturado em 4096 e
        ;       arredondado PARA BAIXO em multiplos de 64 (1 linha de
        ;       tilemap = 32 words). 160 < 1364/8 = 170,5 e o -256 paga os
        ;       DOIS setups de GP-DMA (2 x 1020/8 = 255).
        ;     V lido AQUI (nao o nes_cd_v do late-guard): entre um e outro
        ;     rodaram o passo de CHR, a CGRAM e a OAM. ---
        sep #$20 : .as
        lda $213f                  ; reseta o flip-flop do latch
        lda $2137                  ; latcha H/V
        lda $213d                  ; V[7:0]
        ; --- v2.11 instrumento: este V e' o FIM REAL do apply no silicio
        ;     (tudo o que vem depois e' escrita de registrador). Com o
        ;     nes_dbg_vhead fecha "onde comeca e onde termina" sem sonda
        ;     externa -- e' o numero que calibra o modelo de vblank. ---
        pha
        rep #$30 : .al : .xl
        and #$00ff
        sta @nes_dbg_vtail
        cmp @nes_dbg_vtmax
        bcc nav_tm_novtmax
        sta @nes_dbg_vtmax
nav_tm_novtmax:
        sep #$20 : .as
        pla
        cmp #225
        bcc nav_tm_done            ; display ativo (ou V>=256): nao arrisca
        rep #$20 : .al
        and #$00ff
        eor #$ffff
        sec
        adc #261                   ; A = 261 - V = linhas restantes (0..36)
        sta @nes_tm_tmp
        asl : asl
        clc
        adc @nes_tm_tmp            ; linhas*5
        asl : asl : asl : asl : asl ; *32 -> linhas*160
        sec
        sbc #256                   ; desconta os 2 setups de transferencia
        bcc nav_tm_off             ; nao cabe nem o setup
        cmp #4096
        bcc nav_tm_cap_ok
        lda #4096
nav_tm_cap_ok:
        and #$ffc0                 ; piso de 1 linha de tilemap (64B)
        beq nav_tm_off
        sta @nes_tm_rem

        ; --- 1) FAIXA SUJA ---
        lda @nes_tm_hi
        sec
        sbc @nes_tm_lo
        bcc nav_tm_scrub           ; hi < lo (sentinela) -> vazia
        beq nav_tm_scrub           ; faixa vazia
        cmp @nes_tm_rem
        bcc nav_tm_dset            ; pendente < orcamento: desce tudo
        beq nav_tm_dset
        lda @nes_tm_rem            ; nao cabe -> reserva o piso do scrub
        cmp #NES_TM_SCRUB_MIN      ;    (unico caso em que a faixa poderia
        bcc nav_tm_dset            ;     monopolizar o vblank pra sempre)
        beq nav_tm_dset
        sec
        sbc #NES_TM_SCRUB_MIN
nav_tm_dset:
        sta @nes_tm_len            ; > 0 por construcao nos 4 caminhos
        lda @nes_tm_rem
        sec
        sbc @nes_tm_len
        sta @nes_tm_rem
        lda @nes_tm_lo
        jsr nav_tm_xfer            ; sai .as
        ; --- avanca o cursor; faixa esgotada -> sentinela de VAZIA ---
        rep #$20 : .al
        lda @nes_tm_lo
        clc
        adc @nes_tm_len
        sta @nes_tm_lo
        cmp @nes_tm_hi
        bcc nav_tm_scrub           ; sobrou faixa: sai no proximo vblank
        lda #$1000
        sta @nes_tm_lo
        lda #$0000
        sta @nes_tm_hi

        ; --- 2) SCRUB ROTATIVO (o que sobrou do orcamento, ate' o teto) ---
nav_tm_scrub:
        lda @nes_tm_rem
        beq nav_tm_off
        cmp #NES_TM_SCRUB_MAX
        bcc nav_tm_smax_ok
        lda #NES_TM_SCRUB_MAX
nav_tm_smax_ok:
        sta @nes_tm_len
        lda #$1000
        sec
        sbc @nes_tm_sc             ; bytes ate' o fim do shadow
        cmp @nes_tm_len
        bcs nav_tm_slen_ok
        sta @nes_tm_len            ; corta no fim (o DMA nao da' a volta)
nav_tm_slen_ok:
        lda @nes_tm_sc
        jsr nav_tm_xfer            ; sai .as
        rep #$20 : .al
        lda @nes_tm_sc
        clc
        adc @nes_tm_len
        cmp #$1000
        bcc nav_tm_swrap
        lda #$0000                 ; deu a volta
nav_tm_swrap:
        sta @nes_tm_sc
nav_tm_off:
        sep #$20 : .as
nav_tm_done:


        ; --- v1.3/v1.5.1: HDMA de splits (BG1HOFS por faixa, canal 2).
        ;     GOTCHA DURAVEL DA CASA (ja custou tela preta no
        ;     menu): $420C SO' DEPOIS de TODOS os GP-DMAs, EM VBLANK --
        ;     este bloco fica apos o ultimo $420b acima; a tabela mora em
        ;     WRAM (nes_hdma_tab0/1, cada uma amarrada ao seu frame buffer
        ;     -- ver nes_handle_splits). Canal 2 nao conflita com ch0 (GP
        ;     da NMI) nem ch1 (drain do main) -- canal-por-contexto. Sem
        ;     splits no frame (fb_regs+12 == 0): canal off e o HOFS unico
        ;     v1.2 vale sozinho. ---
        ; --- v2.3: os DOIS canais de HDMA (ch2 scroll + ch3 tile-base de
        ;     CHR) sao ligados por UMA UNICA escrita de $420C com a MASCARA
        ;     COMBINADA, no fim do bloco. Um 'sta $420c' por canal (como era
        ;     na v1.3, com 'sta $420c' de A=0 no ramo sem split) DESLIGARIA
        ;     o outro canal -- e' exatamente o bug a evitar aqui. mascara 0
        ;     = ambos off (o HOFS unico v1.2 e a tile-base estatica do
        ;     nes_chr_apply_tilebase valem sozinhos). ---
        lda #$00
        sta nes_av_hmask
        ldx nes_av_fbr
        lda @$7f000c,x
        beq nav_hdma_done          ; frame sem split de scroll: ch2 fica off
        lda #$02
        sta $4320                  ; mode 2: 1 reg / write-twice ($210D e'
                                   ; write-twice -- casa com o latch duplo)
        lda #$0d
        sta $4321                  ; B-bus = $210D (BG1HOFS)
        ; --- copia a tabela do frame pra nes_hdma_live (28B, ~240 cyc) --
        ;     o DISPLAY le a live o frame INTEIRO; tab0/tab1 ficam livres
        ;     pro decode back-to-back (e' o que elimina o stall do
        ;     produtor -- ver protocolo em nes_data.a65). Dois ramos com
        ;     enderecos IMEDIATOS (nada de ponteiro em memoria: contexto
        ;     NMI, e a licao do DBR do fb_commit vale como principio). ---
        ldx nes_av_fbr             ; hdma do frame commitado (fb_regs+12)
        lda @$7f000c,x
        cmp #$02
        beq nav_hcopy1
        rep #$30 : .al : .xl
        ldx #$0000
nav_hc0_loop:
        lda @nes_hdma_tab0,x
        sta @nes_hdma_live,x
        inx
        inx
        cpx #28
        bcc nav_hc0_loop
        sep #$20 : .as
        bra nav_hdma_arm
nav_hcopy1:
        rep #$30 : .al : .xl
        ldx #$0000
nav_hc1_loop:
        lda @nes_hdma_tab1,x
        sta @nes_hdma_live,x
        inx
        inx
        cpx #28
        bcc nav_hc1_loop
        sep #$20 : .as
nav_hdma_arm:
        ldx #!nes_hdma_live
        stx $4322                  ; A1T2 = tabela LIVE
        lda #^nes_hdma_live
        sta $4324                  ; banco da tabela ($7F)
        lda nes_av_hmask
        ora #$04                   ; canal 2 entra na mascara
        sta nes_av_hmask
nav_hdma_done:

        ; --- v2.3: HDMA de TILE-BASE de CHR (BG12NBA por faixa, canal 3).
        ;     Mode 0 = 1 registrador / 1 byte por bloco; tabela non-repeat
        ;     [line_count, byte de $210B]* + $00 (16B, ver
        ;     nes_chr_handle_splits). Canal 3 nao conflita com ch0 (GP da
        ;     NMI), ch1 (drain do main) nem ch2 (scroll) -- canal-por-
        ;     contexto. A tabela do frame e' COPIADA pra nes_chdma_live
        ;     (16B) aqui dentro, pela mesma razao do ch2: o display le a
        ;     live o frame inteiro e chdma_tab0/1 ficam livres pro decode.
        ;     Dois ramos com enderecos IMEDIATOS (nada de ponteiro em
        ;     memoria: contexto NMI, a licao do DBR do fb_commit vale como
        ;     principio). Frame sem $13 (fb_regs+13 == 0): canal off e a
        ;     tile-base ESTATICA (nes_chr_apply_tilebase, intocado) vale pro
        ;     frame inteiro = comportamento v2.2. ---
        ldx nes_av_fbr
        lda @$7f000d,x
        beq nav_chdma_done
        lda #$00
        sta $4330                  ; mode 0: 1 reg / 1 byte por bloco
        lda #$0b
        sta $4331                  ; B-bus = $210B (BG12NBA)
        ldx nes_av_fbr
        lda @$7f000d,x
        cmp #$02
        beq nav_ccopy1
        rep #$30 : .al : .xl
        ldx #$0000
nav_cc0_loop:
        lda @nes_chdma_tab0,x
        sta @nes_chdma_live,x
        inx
        inx
        cpx #16
        bcc nav_cc0_loop
        sep #$20 : .as
        bra nav_chdma_arm
nav_ccopy1:
        rep #$30 : .al : .xl
        ldx #$0000
nav_cc1_loop:
        lda @nes_chdma_tab1,x
        sta @nes_chdma_live,x
        inx
        inx
        cpx #16
        bcc nav_cc1_loop
        sep #$20 : .as
nav_chdma_arm:
        ldx #!nes_chdma_live
        stx $4332                  ; A1T3 = tabela LIVE
        lda #^nes_chdma_live
        sta $4334                  ; banco da tabela ($7F)
        lda nes_av_hmask
        ora #$08                   ; canal 3 entra na mascara
        sta nes_av_hmask
nav_chdma_done:
        ; --- v2.10: a UNICA escrita de $420C migrou pro fim do bloco de
        ;     scroll abaixo -- o canal 4 (costura das rows 30/31) so' sabe
        ;     se vai ser armado DEPOIS do BG1VOFS do frame estar calculado.
        ;     A regra da casa continua respeitada (o $420C segue depois de
        ;     TODOS os GP-DMAs e dentro do vblank); o que vem entre este
        ;     ponto e a escrita sao writes de registrador de PPU, nunca
        ;     DMA. ---

        ; --- scroll v1.1: espaco LOGICO multi-nametable (book1 p.2-27-5,
        ;     2 escritas low,high). CMD_REGS traz scroll_x/y = loopy_t
        ;     resolvido (coarse*8+fine, 0-255) e nt_select = PPUCTRL bits
        ;     0-1 (== loopy_t bits 10-11). O bit de tela so' e' somado no
        ;     EIXO em que o arrangement realmente tem 2 telas (no eixo
        ;     espelhado ele e' alias da mesma tela -- somar deslocaria pro
        ;     lixo):
        ;       HOFS: +256 se nt_select bit0 E arrangement V (64x32).
        ;       VOFS: +240 se nt_select bit1 E arrangement H (32x64);
        ;             depois, MAPEAMENTO DO GAP: o espaco logico NES tem
        ;             240 linhas/tela mas o screen SNES tem 256 -- linha
        ;             logica L >= 240 vive na SNES 256+(L-240), entao
        ;             posicoes >= 240 ganham +16. DECISAO DOCUMENTADA
        ;             (opcao padrao da missao): viewport que STRADDLA a
        ;             fronteira das telas mostra as 2 linhas-fantasma
        ;             (rows 30/31, zeradas no boot) -- limitacao aceita;
        ;             o alvo v1.1 e' o scroll HORIZONTAL (SMB1). ---
        ; (v1.5.1: sx/sy/ntarr/ntselect lidos do fb_regs do frame commitado
        ;  -- offsets +0 sx, +2 sy, +6 ntsel, +8 ntarr; X recarregado de
        ;  nes_av_fbr a cada acesso, barato e a prova de clobber)
        rep #$20 : .al
        ldx nes_av_fbr
        lda @$7f0000,x             ; scrollx
        sta @nes_nav_vofs_tmp      ; reusa o tmp p/ o HOFS primeiro
        sep #$20 : .as
        ldx nes_av_fbr
        lda @$7f0008,x             ; ntarr
        cmp #NTARR_V
        bne nav_hofs_ready         ; so' V tem 2 telas no eixo X
        ldx nes_av_fbr
        lda @$7f0006,x             ; ntselect
        and #$01
        beq nav_hofs_ready
        rep #$20 : .al
        lda @nes_nav_vofs_tmp
        clc
        adc #$0100                 ; tela logica da direita
        sta @nes_nav_vofs_tmp
        sep #$20 : .as
nav_hofs_ready:
        lda @nes_nav_vofs_tmp
        sta $210d
        lda @nes_nav_vofs_tmp+1
        sta $210d

        sep #$20 : .as
        ldx nes_av_fbr
        lda @$7f0008,x             ; ntarr
        cmp #NTARR_H
        bne nav_vofs_nosel         ; so' H tem 2 telas no eixo Y
        ldx nes_av_fbr
        lda @$7f0006,x             ; ntselect
        and #$02
        beq nav_vofs_nosel
        rep #$20 : .al
        ldx nes_av_fbr
        lda @$7f0002,x             ; scrolly
        clc
        adc #240                   ; tela logica de baixo
        bra nav_vofs_crop
nav_vofs_nosel:
        rep #$20 : .al
        ldx nes_av_fbr
        lda @$7f0002,x             ; scrolly
nav_vofs_crop:
        clc
        adc #VIEWPORT_CROP_Y       ; topo do viewport no espaco logico
        ; --- v2.10: WRAP do espaco logico. Em H o espaco tem 480 linhas
        ;     (2 nametables de 240) e o NES volta pra NT A depois delas.
        ;     scrolly 232-239 COM ntsel.b1 dava topo 480-487, que o mapa
        ;     do gap levava pra 496-503 = DENTRO das rows mortas 30/31 do
        ;     screen 1 -- a costura colada no TOPO da tela. Fora dessa
        ;     faixa o cmp e' sempre falso (V/single nunca passa de 247),
        ;     entao o comportamento validado nao muda. ---
        cmp #480
        bcc nav_vofs_nowrap
        sec
        sbc #480
nav_vofs_nowrap:
        sta @nes_vg_topo           ; v2.10: entrada do nav_vgap_build
        cmp #240                   ; gap: logico >=240 vive 16 linhas depois
        bcc nav_vofs_ok
        clc
        adc #16
nav_vofs_ok:
        dec                        ; -1: o BG do SNES exibe a linha VOFS+n+1
                                   ; (OFF-BY-ONE pego no gate de BOOT-FIDELITY,
                                   ; iteracao 9: o titulo do Excitebike rendia
                                   ; 1 linha ACIMA do Mesen -- 85.6% -> 99.9%
                                   ; de match ao compensar; mesma CLASSE do
                                   ; OBJ Y+1 da iteracao 5, agora no BG).
                                   ; Nunca underflowa: minimo aqui = CROP 8 -> 7.
        sta @nes_nav_vofs_tmp
        sta @nes_vg_v1             ; v2.10: VOFS da regiao 1 da costura
        sep #$20 : .as
        lda @nes_nav_vofs_tmp
        sta $210e
        lda @nes_nav_vofs_tmp+1
        sta $210e

        ; --- v2.10: costura das rows mortas 30/31 (canal 4) + a UNICA
        ;     escrita de $420C do frame, agora com a mascara dos TRES
        ;     canais (ch2 scroll, ch3 tile-base, ch4 costura). ---
        jsr nav_vgap_build
        lda nes_av_hmask
        sta $420c                  ; UMA escrita: liga/desliga ch2, ch3 e ch4

        ; --- mascara da COLUNA ESQUERDA (ppumask bits 1-2) via window 1
        ;     (boot-fidelity, iteracao 9): bit1==0 esconde os 8px esquerdos
        ;     do BG, bit2==0 os dos SPRITES -- jogos ESTACIONAM sprites em
        ;     x=0 contando com a mascara (Excitebike: ppumask $1a, bit2=0;
        ;     sem isso um sprite-xadrez aparecia no canto (0,0) que o Mesen
        ;     esconde). Window 1 = [0,7], habilitada por camada conforme os
        ;     bits; TMW aplica a mascara so' no main screen. Re-escrito
        ;     todo vblank (sem branch de estado -- deriva sempre do ppumask
        ;     staged corrente). ---
        lda #$00
        sta $2126                  ; WH0 = 0
        lda #$07
        sta $2127                  ; WH1 = 7 (janela = px 0..7)
        ; scratch dp DEDICADO de contexto NMI (nes_av_*) -- os nes_ho_*
        ; sao do loop de OAM (contexto MAIN): a NMI no meio do loop
        ; corrompia o attr do sprite corrente (bug real pego na regressao
        ; DK; mesma regra do canal-de-DMA-por-contexto da iteracao 7)
        lda #$00
        sta nes_av_w12             ; W12SEL acc
        sta nes_av_tmw             ; TMW acc
        ldx nes_av_fbr
        lda @$7f0005,x             ; ppumask do frame commitado (fb_regs+5)
        and #$02
        bne nav_lc_bg_ok           ; bit1=1 -> BG visivel na coluna
        lda #$02
        sta nes_av_w12             ; W12SEL: window1 enable no BG1
        lda nes_av_tmw
        ora #$01
        sta nes_av_tmw             ; TMW: mascara BG1 no main
nav_lc_bg_ok:
        ldx nes_av_fbr
        lda @$7f0005,x             ; ppumask
        and #$04
        bne nav_lc_obj_ok          ; bit2=1 -> sprites visiveis na coluna
        lda nes_av_tmw
        ora #$10
        sta nes_av_tmw             ; TMW: mascara OBJ no main
        lda #$02
        sta $2125                  ; WOBJSEL: window1 enable no OBJ
        bra nav_lc_wsel
nav_lc_obj_ok:
        lda #$00
        sta $2125
nav_lc_wsel:
        lda nes_av_w12
        sta $2123                  ; W12SEL
        lda nes_av_tmw
        sta $212e                  ; TMW

        ; --- v1.5.2 ppumask RENDERING-OFF (gap documentado desde a Fase 1:
        ;     "transicoes mostram NT onde o NES mostra backdrop" -- a tela
        ;     de donuts do DK): NES PPUMASK bit3=BG visivel, bit4=OBJ
        ;     visivel -> espelhados DIRETO no TM ($212C) por frame. Ambos
        ;     off => TM=0 = so' o backdrop (CGRAM[0] = a cor de fundo NES,
        ;     mantida pelo shadow de paleta) -- exatamente o que o NES
        ;     mostra com rendering desligado. INIDISP NAO e' tocado
        ;     (religar forced-blank mid-frame tem quirk de OAM; TM e' um
        ;     write inofensivo em vblank e restaura sozinho quando o mask
        ;     religa). Granularidade por frame (mid-frame = Fase 3). O
        ;     boot nao muda: antes do 1o frame commitado o apply nem roda
        ;     (pending=0) e o TM fica no $11 do nes_boot_init. ---
        lda #$00
        sta nes_av_tm
        ldx nes_av_fbr
        lda @$7f0005,x             ; ppumask do frame
        and #$08                   ; bit3: BG visivel
        beq nav_tm_nobg
        lda nes_av_tm
        ora #$01                   ; TM bit0 = BG1
        sta nes_av_tm
nav_tm_nobg:
        ldx nes_av_fbr
        lda @$7f0005,x
        and #$10                   ; bit4: OBJ visivel (ja na posicao do
        beq nav_tm_noobj           ; TM bit4 = OBJ)
        lda nes_av_tm
        ora #$10
        sta nes_av_tm
nav_tm_noobj:
        lda nes_av_tm
        sta $212c                  ; TM main screen

        ; --- v1.5.1: frame consumido -- libera o buffer p/ o produtor.
        ;     active continua marcando este buffer como "em exibicao". ---
        lda #$00
        sta @nes_fb_pending

nav_tail:
        ; --- v2.2-lite CHR-RAM: dreno da fila do CMD_CHR_RUN, POR ULTIMO.
        ;     Tilemap/OAM sao inviolaveis (escrita fora do vblank = bytes
        ;     descartados / OAM espalhada), entao a CHR so' usa a SOBRA do
        ;     vblank e o proprio servico le o V p/ decidir quanto cabe.
        ;     Cauda COMUM aos tres caminhos (aplicou / sem commit / NMI
        ;     tarde): a fila nunca fica presa por falta de frame novo. ---
        sep #$20 : .as
        jsr nes_chrq_service

        plp
        rts

; ============================================================
; nav_vgap_build -- v2.10: COSTURA das 2 rows mortas (30/31) de cada
; screen SNES, por HDMA de BG1VOFS ($210E) no canal 4.
;
; O SINTOMA. A nametable do NES tem 30 rows (240px) e o screen SNES tem
; 32 (256px). O nes_convert_range converte as 960 celulas de cada banco,
; entao as rows 30/31 de cada screen NUNCA sao escritas e guardam a word
; $0000 do nes_boot_zero_tilemap_shadow -- que NAO e' vazio: e' o TILE 0
; do pattern table corrente, palette 0, repetido nas 32 colunas. E' a
; faixa de 16px de um tile so' que rola junto com o cenario no scroll
; vertical (Mega Man, 10-Yard Fight, Road Fighter).
;
; POR QUE NAO DA' PRA "APAGAR" A FAIXA. Nao existe indice de tile
; garantidamente vazio: a unica VRAM livre e' words $3000-$3FFF, so'
; enderecavel com BG12NBA no slot1, e desde a v2.3 o $210B e'
; HDMA-chaveado POR FAIXA -- qualquer indice fixo cai em CHR real em
; alguma faixa do frame.
;
; O FIX. Um BG1VOFS por frame nao pula o buraco: o 'adc #16' do
; nav_vofs_crop compensa o gap com UM valor, certo so' enquanto o
; viewport nao STRADDLA a fronteira das telas -- e em scroll vertical ele
; straddla quase sempre. Com DOIS valores no mesmo frame o buraco some:
;
;   d = linhas do viewport antes da costura
;     = distancia do topo LOGICO ate' a proxima multipla de 240
;   linhas 1..d      -> VOFS = V1      (o valor unico de hoje)
;   linhas d+1..224  -> VOFS = V1 + 16 (pula as 2 rows mortas)
;
; O +16 vale nos DOIS arranjos, sem branch: em H o salto atravessa o gap
; do screen 1 (tilemap 32x64 wrappa em 512); em V/single e' o wrap da
; tela de 32 rows (240 logicas + 16 mortas = 256). d >= 224 = nao
; straddla: o canal fica off e o VOFS unico vale sozinho -- nesse caso o
; frame sai BIT-A-BIT igual ao pre-v2.10.
;
; A fronteira on-screen segue a MESMA convencao do canal 2 (validada em
; hardware no billboard do Excitebike): um bloco de count N a partir da
; linha acumulada R cobre as linhas de viewport [R, R+N). Se algum dia o
; silicio mostrar 1 linha residual da faixa, o unico knob e' o 'd' aqui.
;
; Tabela: mode 2 (1 registrador / write-twice -- $210E e' write-twice,
; igual ao $210D do canal 2), [count(1..127), lo, hi]* + $00; regiao com
; mais de 127 linhas vira 2 blocos (mesma regra do nhs_emit3). Teto: 2
; regioes x 2 blocos = 12B + terminador, e nes_vg_tab tem 16.
;
; Montada AQUI, no vblank, e lida pelo display do frame seguinte => nao
; precisa do double-buffer dos canais 2/3 (montados pelo main loop, com o
; display ATIVO). O $420C combinado e' escrito pelo chamador, logo apos.
;
; Entra .as/.xl; sai .as/.xl. Toca A/X e as nes_vg_*; nao usa Y.
; ============================================================
nav_vgap_build:
        rep #$30 : .al : .xl
        ; d = (topo <= 240) ? 240-topo : 480-topo ; topo==240 -> 240 (a
        ; costura cai exatamente no topo, a PROXIMA so' em 480)
        lda #240
        sec
        sbc @nes_vg_topo
        bcs nvg_d_have
        clc
        adc #240
nvg_d_have:
        bne nvg_d_ok
        lda #240
nvg_d_ok:
        sta @nes_vg_d
        cmp #224
        bcc nvg_straddle
        sep #$20 : .as             ; nao straddla: canal 4 fica fora da
        rep #$10 : .xl             ; mascara e nada muda
        rts
nvg_straddle:
        .al : .xl                  ; declaracao TEXTUAL: o ramo curto acima
                                   ; saiu .as e o snescom rastreia o modo
                                   ; pelo texto, nao pelo fluxo (gotcha da
                                   ; casa -- sem isto o 'and #$03ff' abaixo
                                   ; nao monta)
        ldx #$0000                 ; X = cursor de escrita em nes_vg_tab
                                   ; (vive nos dois nvg_emit*; LDX nao tem
                                   ; modo long, entao o cursor NAO pode ser
                                   ; relido de $7F a cada bloco)
        ; --- regiao 1: d linhas com o VOFS de hoje ---
        lda @nes_vg_d
        sta @nes_vg_c
        lda @nes_vg_v1
        and #$03ff                 ; BG1VOFS tem 10 bits
        sta @nes_vg_val
        jsr nvg_emit
        ; --- regiao 2: 224-d linhas com VOFS+16 ---
        lda #224
        sec
        sbc @nes_vg_d
        sta @nes_vg_c
        lda @nes_vg_v1
        clc
        adc #16
        and #$03ff
        sta @nes_vg_val
        jsr nvg_emit
        ; --- terminador ---
        sep #$20 : .as
        lda #$00
        sta @nes_vg_tab,x
        ; --- arma o canal 4 ---
        lda #$02
        sta $4340                  ; mode 2: 1 reg / write-twice
        lda #$0e
        sta $4341                  ; B-bus = $210E (BG1VOFS)
        rep #$10 : .xl
        ldx #!nes_vg_tab
        stx $4342                  ; A1T4 = tabela
        lda #^nes_vg_tab
        sta $4344                  ; banco da tabela ($7F)
        lda nes_av_hmask
        ora #$10                   ; canal 4 entra na mascara
        sta nes_av_hmask
        rts

; ------------------------------------------------------------
; nvg_emit -- emite nes_vg_c linhas com o valor nes_vg_val, quebrando em
; blocos de ate' 127 (o count do HDMA tem 7 bits; bit7 = repeat mode).
; Entra/sai .al/.xl; X = cursor de escrita (preservado pelos jsr).
; ------------------------------------------------------------
nvg_emit:
        .al : .xl                  ; declaracao TEXTUAL (ver nvg_straddle)
nvg_emit_loop:
        lda @nes_vg_c
        cmp #$0080
        bcc nvg_emit_last
        sec
        sbc #$007f
        sta @nes_vg_c
        lda #$007f
        jsr nvg_emit3
        bra nvg_emit_loop
nvg_emit_last:
        jsr nvg_emit3              ; A = nes_vg_c (1..127)
        rts

; ------------------------------------------------------------
; nvg_emit3 -- escreve [A(count 1..127), val_lo, val_hi] em nes_vg_tab
; pelo cursor X (que avanca 3). Entra/sai .al/.xl com A = count.
; ------------------------------------------------------------
nvg_emit3:
        .al : .xl                  ; declaracao TEXTUAL (ver nvg_straddle)
        sep #$20 : .as
        sta @nes_vg_tab,x
        inx
        lda @nes_vg_val
        sta @nes_vg_tab,x
        inx
        lda @nes_vg_val+1
        sta @nes_vg_tab,x
        inx
        rep #$20 : .al
        rts

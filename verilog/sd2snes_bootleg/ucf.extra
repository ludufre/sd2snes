# GUARD BAND on the CLK2 domain -- do not drop this line.  common.mk builds this variant's
# main.ucf as this file followed by sd2snes_base/main.ucf, so only the delta lives here and
# the pin and timing constraints follow the base file.  Spartan-3 timing computes no clock uncertainty by
# itself (trce INFO Timing:3389/3390, "Clock Uncertainty: 0.000ns"), but CLK2 is the CLKFX
# of a DCM whose measured period jitter is 0.75 ns peak to peak (DCM header).  SYSTEM_JITTER
# becomes a per-path uncertainty of jitter/sqrt(2) = 0.339 ns, the value the sa1, spc7110
# and gsu3 use, so Timing Score 0 here means that much real margin.
SYSTEM_JITTER = 0.48 ns;
